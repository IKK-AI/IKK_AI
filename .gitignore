-- SAFE SERVICE GETTERS
-- ═══════════════════════════════════════════════════════════════
local function safeGetService(name)
        local ok, svc = pcall(function() return game:GetService(name) end)
        if ok and svc then return svc end
        return nil
end

local Players       = safeGetService("Players")
local RunService    = safeGetService("RunService")
local TweenService  = safeGetService("TweenService")
local UIS           = safeGetService("UserInputService")
local HttpService   = safeGetService("HttpService")
local TextChat      = safeGetService("TextChatService")
local RepStorage    = safeGetService("ReplicatedStorage")
local CoreGui       = safeGetService("CoreGui")
local GuiService    = safeGetService("GuiService")
local StarterGui    = safeGetService("StarterGui")
local SoundService  = safeGetService("SoundService")

if not Players or not RunService or not TweenService or not UIS then
        warn("[Sebas AI] core services unavailable")
        return
end

-- ═══════════════════════════════════════════════════════════════
-- BOOT-SAFE — กัน "รันแล้วเงียบ" ไปทั้งชีวิต
--   1) splash "กำลังโหลด" ขึ้นทันทีที่รัน (p03 จะปิดให้เมื่อ GUI พร้อม)
--   2) BOOT_ERR(msg) = กล่องแดงบนจอ บอกสาเหตุที่สคริปต์หยุด
-- ═══════════════════════════════════════════════════════════════
local function bootRoot()
        if CoreGui then return CoreGui end
        local ok, pg = pcall(function()
                local lp = Players and Players.LocalPlayer
                if not lp then return nil end
                return lp:WaitForChild("PlayerGui", 3)
        end)
        if ok and pg then return pg end
        return nil
end

function BOOT_ERR(msg)   -- global: เรียกได้ทุกที่ กันตายเงียบ
        warn("[Sebas AI] " .. tostring(msg))
        pcall(function()
                local root = bootRoot()
                if not root then return end
                local old = root:FindFirstChild("SebasAI_BootErr")
                if old then old:Destroy() end
                local b = Instance.new("ScreenGui")
                b.Name = "SebasAI_BootErr"; b.ResetOnSpawn = false
                b.DisplayOrder = 9999; b.IgnoreGuiInset = true
                b.Parent = root
                local card = Instance.new("Frame")
                card.Size = UDim2.new(1, -24, 0, 100)
                card.Position = UDim2.new(0, 12, 0, 60)
                card.BackgroundColor3 = Color3.fromRGB(46, 12, 16)
                card.BorderSizePixel = 0; card.ZIndex = 10
                card.Parent = b
                Instance.new("UICorner", card).CornerRadius = UDim.new(0, 10)
                local st = Instance.new("UIStroke", card)
                st.Color = Color3.fromRGB(255, 84, 100); st.Thickness = 1.5
                local t1 = Instance.new("TextLabel")
                t1.Size = UDim2.new(1, -20, 0, 18)
                t1.Position = UDim2.new(0, 10, 0, 8)
                t1.BackgroundTransparency = 1
                t1.Text = "⚠ SEBAS AI — ผิดพลาด"; t1.Font = Enum.Font.GothamBold
                t1.TextSize = 13; t1.TextColor3 = Color3.fromRGB(255, 120, 130)
                t1.TextXAlignment = Enum.TextXAlignment.Left; t1.ZIndex = 11
                t1.Parent = card
                local t2 = Instance.new("TextLabel")
                t2.Size = UDim2.new(1, -20, 0, 66)
                t2.Position = UDim2.new(0, 10, 0, 28)
                t2.BackgroundTransparency = 1
                t2.Text = tostring(msg); t2.Font = Enum.Font.Gotham
                t2.TextSize = 11; t2.TextColor3 = Color3.fromRGB(255, 220, 222)
                t2.TextWrapped = true; t2.TextXAlignment = Enum.TextXAlignment.Left
                t2.TextYAlignment = Enum.TextYAlignment.Top; t2.ZIndex = 11
                t2.Parent = card
                task.delay(14, function() pcall(function() b:Destroy() end) end)
        end)
end

BOOT_SPLASH = nil
pcall(function()
        local root = bootRoot()
        if not root then return end
        local sp = Instance.new("ScreenGui")
        sp.Name = "SebasAI_Splash"; sp.ResetOnSpawn = false
        sp.DisplayOrder = 9998; sp.IgnoreGuiInset = true
        sp.Parent = root
        local pill = Instance.new("Frame")
        pill.AnchorPoint = Vector2.new(0.5, 0.5)
        pill.Size = UDim2.fromOffset(196, 46)
        pill.Position = UDim2.new(0.5, 0, 0.5, 0)
        pill.BackgroundColor3 = Color3.fromRGB(22, 24, 34)
        pill.BorderSizePixel = 0; pill.ZIndex = 10
        pill.Parent = sp
        Instance.new("UICorner", pill).CornerRadius = UDim.new(0, 12)
        local ps = Instance.new("UIStroke", pill)
        ps.Color = Color3.fromRGB(90, 130, 255); ps.Thickness = 1.5; ps.Transparency = 0.2
        local pt = Instance.new("TextLabel")
        pt.Size = UDim2.new(1, -16, 1, 0)
        pt.Position = UDim2.new(0, 8, 0, 0)
        pt.BackgroundTransparency = 1
        pt.Text = "SEBAS AI · กำลังโหลด..."; pt.Font = Enum.Font.GothamBold
        pt.TextSize = 13; pt.TextColor3 = Color3.fromRGB(235, 240, 255)
        pt.ZIndex = 11; pt.Parent = pill
        BOOT_SPLASH = sp
        task.delay(30, function()   -- กันค้าง: ปิดเองถ้า 30 วิยังไม่ถูกปิด
                pcall(function()
                        if BOOT_SPLASH == sp then
                                BOOT_SPLASH = nil
                                sp:Destroy()
                        end
                end)
        end)
end)

local loadT = 0
repeat task.wait(0.1); loadT = loadT + 1
until game:IsLoaded() or loadT > 80

-- ═══════════════════════════════════════════════════════════════
-- HTTP DETECTION
-- ═══════════════════════════════════════════════════════════════
local Http = nil
pcall(function()
        local function tryFn(f) return type(f) == "function" and f or nil end
        Http = (syn and tryFn(syn.request))
                or (http and tryFn(http.request))
                or tryFn(http_request)
                or (fluxus and tryFn(fluxus.request))
                or tryFn(request)
end)

if type(Http) ~= "function" then
        Http = nil
        pcall(function()
                if StarterGui then
                        StarterGui:SetCore("SendNotification", {
                                Title = "Sebas AI", Text = "Executor ไม่รองรับ HTTP", Duration = 6
                        })
                end
        end)
        BOOT_ERR("Executor ไม่รองรับ HTTP — สคริปต์นี้ต้องใช้เน็ตเรียก Ollama (ลอง executor อื่น เช่น Delta / Fluxus / Solara)")
        warn("[Sebas AI] HTTP not available")
        return
end

-- ═══════════════════════════════════════════════════════════════
-- NORM RES — มาตรฐานผลลัพธ์ HTTP จากทุก executor
--   สเปก Roblox = {StatusCode, Body, Headers} แต่ executor บางตัวคืน
--   {status, body, headers} ตัวเล็ก — ถ้าอ่านตรง ๆ จะกลายเป็น "ต่อไม่ได้"
--   ทั้งที่เซิร์ฟเวอร์ตอบ 200 ปกติ (สาเหตุจริงของ "local api ต่อไม่ได้"
--   บน executor บางตัว + "ไม่ได้รับคำตอบ" บนค่ายคลาวด์)
--   ใช้: local r = normRes(res) → r.status (number) / r.body (string) / r.headers
-- ═══════════════════════════════════════════════════════════════
function normRes(res)
        if type(res) ~= "table" then return nil end
        local st = tonumber(res.StatusCode or res.status or res.Status) or 0
        local bd = res.Body or res.body or ""
        local hd = type(res.Headers) == "table" and res.Headers
                or (type(res.headers) == "table" and res.headers or {})
        return { status = st, body = type(bd) == "string" and bd or "", headers = hd }
end

-- ═══════════════════════════════════════════════════════════════
-- CONSTANTS
-- ═══════════════════════════════════════════════════════════════
local LP = Players.LocalPlayer
if not LP then
        -- บาง executor รันเร็วกว่า LocalPlayer พร้อม — รอแทนการตายเงียบ
        local lpT = 0
        repeat task.wait(0.1); lpT = lpT + 1; LP = Players.LocalPlayer
        until LP or lpT > 100
end
if not LP then
        BOOT_ERR("ไม่พบ LocalPlayer — รันสคริปต์ตอนอยู่ในเกมแล้วเท่านั้น")
        return
end

local Camera = workspace.CurrentCamera
if not Camera then
        local cmT = 0
        repeat task.wait(0.1); cmT = cmT + 1; Camera = workspace.CurrentCamera
        until Camera or cmT > 50
end
if not Camera then
        BOOT_ERR("ไม่พบกล้อง (CurrentCamera) — ลองรันสคริปต์อีกครั้ง")
        return
end

