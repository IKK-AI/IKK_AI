-- ═══════════════════════════════════════════════════════════════
-- DRAG SYSTEM — สมูทแบบมีหน่วง (damped smooth follow)
--   เป้าหมายอัปเดตตามนิ้วทันที แต่ GUI ไหลตามแบบ lerp ทุกเฟรม
--   = ลื่น นิ่ง มีความหน่วงสมูท ไม่กระตุก ไม่ตามมือแบบแข็ง ๆ
--   loop รันเฉพาะตอนลาก/กำลังเก็บตัว (event-driven ประหยัด resource)
-- ═══════════════════════════════════════════════════════════════
local dragActive = {}
local dragLoopConn = nil
local DRAG_SMOOTH = 16      -- ความเร็วการไหลตาม (สูง = เร็วขึ้น, ต่ำ = หน่วงมากขึ้น)

local function dragEnsureLoop()
        if dragLoopConn or not RunService then return end
        dragLoopConn = RunService.RenderStepped:Connect(function(dt)
                local a = 1 - math.exp(-math.max(dt or 0.016, 0.005) * DRAG_SMOOTH)
                local any = false
                for st in pairs(dragActive) do
                        st.cx = st.cx + (st.tx - st.cx) * a
                        st.cy = st.cy + (st.ty - st.cy) * a
                        local settled = (not st.on)
                                and math.abs(st.tx - st.cx) < 0.5 and math.abs(st.ty - st.cy) < 0.5
                        if settled then st.cx, st.cy = st.tx, st.ty end
                        local ok = true
                        if st.apply then ok = pcall(st.apply, st.cx, st.cy, settled) end
                        if settled or not ok then
                                dragActive[st] = nil
                        else
                                any = true
                        end
                end
                if not any and dragLoopConn then
                        dragLoopConn:Disconnect()
                        dragLoopConn = nil
                end
        end)
end

local function makeDraggable(hitArea, opts)
        local st = { on = false, tx = 0, ty = 0, cx = 0, cy = 0 }
        st.apply = opts.apply
        hitArea.InputBegan:Connect(function(i)
                if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
                        local fx, fy = opts.getPos()
                        st.on = true; st.moved = false
                        st.sx, st.sy = i.Position.X, i.Position.Y
                        st.fx, st.fy = fx, fy
                        st.tx, st.ty = fx, fy
                        st.cx, st.cy = fx, fy
                        if opts.onGrab then pcall(opts.onGrab) end
                        dragActive[st] = true
                        dragEnsureLoop()
                end
        end)
        UIS.InputChanged:Connect(function(i)
                if not st.on then return end
                if i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch then
                        local dx, dy = i.Position.X - st.sx, i.Position.Y - st.sy
                        if not st.moved then
                                if math.abs(dx) > 4 or math.abs(dy) > 4 then
                                        st.moved = true
                                        st.sx, st.sy = i.Position.X, i.Position.Y   -- re-anchor จุดเริ่ม = หน้าต่างไม่สะดุด 4px ตอนเริ่มลาก
                                        st.fx, st.fy = st.tx, st.ty
                                        dx, dy = 0, 0              -- เริ่มนับจาก 0 ที่จุดที่จับจริง
                                        SND.play("drag")       -- เสียง "จับ" สั้น ๆ
                                else return end
                        end
                        local nx, ny = st.fx + dx, st.fy + dy
                        if opts.clamp then nx, ny = opts.clamp(nx, ny) end
                        st.tx, st.ty = nx, ny
                end
        end)
        UIS.InputEnded:Connect(function(i)
                if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
                        if st.on then
                                st.on = false
                                if st.moved then SND.play("place") end   -- เสียง "วาง" สั้น ๆ ตอนปล่อย (คู่จับ-วาง)
                                if math.abs(st.tx - st.cx) < 0.5 and math.abs(st.ty - st.cy) < 0.5 then
                                        dragActive[st] = nil   -- อยู่ตำแหน่งแล้ว ไม่ต้องรอเก็บตัว
                                end
                                if opts.onRelease then pcall(opts.onRelease, st.moved, st) end
                        end
                end
        end)
        return st
end

-- grab feedback — เงาเข้มขึ้น + ขอบสว่าง + จุดเกาะชัดขึ้น (นุ่ม ๆ ด้วย tween)
local function grabFX(on)
        if on then
                ANIM.play(winShadow, { BackgroundTransparency = 0.45 },
                        { t = 0.16, style = Enum.EasingStyle.Quint, dir = Enum.EasingDirection.Out, tag = "gsh" })
                ANIM.play(mainSk, { Transparency = 0.05 },
                        { t = 0.14, style = Enum.EasingStyle.Quint, dir = Enum.EasingDirection.Out, tag = "gsk" })
                for _, d in ipairs(gripDots) do
                        ANIM.play(d, { BackgroundTransparency = 0.08 },
                                { t = 0.14, style = Enum.EasingStyle.Quint, dir = Enum.EasingDirection.Out, tag = "gd" })
                end
        else
                ANIM.play(winShadow, { BackgroundTransparency = 0.62 },
                        { t = 0.26, style = Enum.EasingStyle.Quint, dir = Enum.EasingDirection.Out, tag = "gsh" })
                ANIM.play(mainSk, { Transparency = 0.25 },
                        { t = 0.22, style = Enum.EasingStyle.Quint, dir = Enum.EasingDirection.Out, tag = "gsk" })
                for _, d in ipairs(gripDots) do
                        ANIM.play(d, { BackgroundTransparency = 0.35 },
                                { t = 0.22, style = Enum.EasingStyle.Quint, dir = Enum.EasingDirection.Out, tag = "gd" })
                end
        end
end

-- clamp เต็มขอบจอ: หน้าต่างหลักอยู่ในจอทั้ง 4 ด้านเสมอ (ไม่มีทางหลุดออกนอกจอ)
local function mainClamp(x, y)
        local vps = Camera.ViewportSize
        local fs = Main.AbsoluteSize
        return math.clamp(x, 0, math.max(0, vps.X - fs.X)),
               math.clamp(y, 0, math.max(0, vps.Y - fs.Y))
end

local function mainApply(x, y)
        Main.Position = UDim2.fromOffset(x, y)
        winShadow.Position = UDim2.fromOffset(x - 10, y - 6)
        if tutReposition then pcall(tutReposition) end
end

local function mainRelease(moved)
        grabFX(false)
        if moved then
                -- เสียง "วาง" เล่นแล้วใน makeDraggable (คู่จับ-วาง) — ที่นี่แค่บันทึกตำแหน่ง
                S.guiX = math.round(Main.Position.X.Offset)
                S.guiY = math.round(Main.Position.Y.Offset)
                saveSettings()
                if tutReposition then pcall(tutReposition) end
        end
end

local function mainDragOpts()
        return {
                getPos = function() return Main.Position.X.Offset, Main.Position.Y.Offset end,
                clamp = mainClamp, apply = mainApply,
                onGrab = function() grabFX(true) end,
                onRelease = mainRelease,
        }
end
makeDraggable(TopBar, mainDragOpts())
makeDraggable(dragHit, mainDragOpts())

-- ให้ p04 (mini pill) ใช้ drag แบบสมูทเดียวกัน
UIX.smoothDrag = makeDraggable

-- ⊢ FLOATS — ทะเบียนหน้าต่างลอย (modal/popup/login card) ทุกตัวในระบบ
--   (1) ลากได้ด้วย smoothDrag (2) จอเปลี่ยนขนาด/หมุน → clamp กลับเข้าจอ
FLOATS = {}   -- [frame] = clampFn (global: ใช้ข้าม part)
UIX._fp = {}  -- [frame] = {x, y} ตำแหน่งสุดท้ายที่ผู้ใช้ลากไว้ (popup เปิดครั้งหน้าใช้ตำแหน่งนี้)
UIX.addFloat = function(frame, clampFn)
        if frame and clampFn then FLOATS[frame] = clampFn end
end
UIX.clampFloats = function()
        for f, fn in pairs(FLOATS) do
                if f.Parent and f.Visible then pcall(fn) end
        end
end

-- ⊢ BLUR — เบลอพื้นหลังจริง (BlurEffect บน Lighting) ใช้กับ login + modal
--   เปิดครั้งเดียวสร้าง/ปิดทำลาย ไม่ทับ effect ของเกม (ตั้งชื่อ SebasBlur)
UIX.setBlur = function(on)
        pcall(function()
                local lng = game:GetService("Lighting")
                if not lng then return end
                local b = lng:FindFirstChild("SebasBlur")
                if on then
                        if not b then
                                b = Instance.new("BlurEffect")
                                b.Name = "SebasBlur"
                                b.Size = 0
                                b.Parent = lng
                        end
                        ANIM.play(b, { Size = 16 }, { t = 0.24, tag = "sbl" })
                elseif b then
                        ANIM.play(b, { Size = 0 }, { t = 0.2, tag = "sbl",
                                cb = function() pcall(function() if b.Parent and b.Size == 0 then b:Destroy() end end) end })
                end
        end)
end

-- ตัวช่วยทำ modal/popup เป็นหน้าต่างลอย: ลากได้ + clamp เต็มขอบจอ + ลงทะเบียน FLOATS
--   (popup ทุกตัวอยู่ในจอทั้ง 4 ด้านเสมอ — จอหมุน/เปลี่ยนขนาดก็ถูกดึงกลับ)
UIX.floatDrag = function(m, handle, opts)
        if not m or not handle then return end
        opts = opts or {}
        local function clampXY(x, y)
                local vps = Camera.ViewportSize
                local w, h = m.AbsoluteSize.X, m.AbsoluteSize.Y
                return math.clamp(x, 0, math.max(0, vps.X - w)),
                       math.clamp(y, 0, math.max(0, vps.Y - h))
        end
        UIX.smoothDrag(handle, {
                -- ⚠ FIX "เมนูกดค้างเลื่อนขึ้นเรื่อย ๆ": อ่านจาก Position offset เอง (space เดียวกับที่เขียน)
                --   เดิมอ่าน AbsolutePosition ที่บาง executor/อุปกรณ์มี offset จาก gui inset
                --   → อ่าน-เขียนคนละ space → hammer clamp ซ้ำเป็น feedback loop แล้ว popup ทะยอยหนี
                getPos = function() return m.Position.X.Offset, m.Position.Y.Offset end,
                clamp = clampXY,
                apply = function(x, y) m.Position = UDim2.fromOffset(x, y) end,
                onGrab = opts.onGrab,
                onRelease = function(moved)
                        -- จำตำแหน่งที่ผู้ใช้ลากไว้ → ครั้งหน้าเปิดที่ตำแหน่งเดิม (ไม่ใช่กลางจอ)
                        if moved then
                                UIX._fp[m] = { x = math.round(m.Position.X.Offset), y = math.round(m.Position.Y.Offset) }
                        end
                end,
        })
        UIX.addFloat(m, function()
                local x, y = m.Position.X.Offset, m.Position.Y.Offset
                local nx, ny = clampXY(x, y)
                if nx ~= x or ny ~= y then m.Position = UDim2.fromOffset(nx, ny) end
        end)
end

-- ═══════════════════════════════════════════════════════════════
-- RESIZE SYSTEM — จับมุมล่างซ้าย (ขอบขวาคงที่ ลากซ้าย=กว้างขึ้น)
--   ตอบสนองทันที 1:1 ตามนิ้ว (ไม่ lerp ไม่หน่วง) = เสถียร ไม่กระตุก
-- ═══════════════════════════════════════════════════════════════
local rsSt = { on = false }
rsSt.apply = function(w, h)
        local x = rsSt.sr - w
        Main.Size = UDim2.fromOffset(w, h)
        Main.Position = UDim2.fromOffset(x, Main.Position.Y.Offset)
        gW, gH = w, h
        winShadow.Size = UDim2.fromOffset(w + 24, h + 28)
        winShadow.Position = UDim2.fromOffset(x - 10, Main.Position.Y.Offset - 6)
        if math.abs(w - (rsSt.lastW or 0)) >= 1 or math.abs(h - (rsSt.lastH or 0)) >= 1 then
                rsSt.lastW, rsSt.lastH = w, h
                if UIX.onResize then pcall(UIX.onResize) end
        end
        if tutReposition then pcall(tutReposition) end
end

resizeGrip.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
                rsSt.on = true
                rsSt.sx, rsSt.sy = i.Position.X, i.Position.Y
                rsSt.sw, rsSt.sh = Main.AbsoluteSize.X, Main.AbsoluteSize.Y
                rsSt.sr = Main.Position.X.Offset + Main.AbsoluteSize.X
                rsSt.tx, rsSt.ty = rsSt.sw, rsSt.sh
                rsSt.lastW, rsSt.lastH = 0, 0
                for _, ln in ipairs(gripLines) do
                        ANIM.play(ln, { BackgroundTransparency = 0 }, { t = 0.12, tag = "gl" })
                end
        end
end)
UIS.InputChanged:Connect(function(i)
        if not rsSt.on then return end
        if i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch then
                local vps = Camera.ViewportSize
                local dx = i.Position.X - rsSt.sx
                local dy = i.Position.Y - rsSt.sy
                local mnW = math.max(math.min(MIN_W, vps.X - 30), 240)   -- จอจิ๋วย่อได้ถึง 240
                local mnH = math.max(math.min(MIN_H, vps.Y - 30), 240)
                local w = math.clamp(math.round(rsSt.sw - dx), mnW, math.max(mnW, vps.X - 30))
                local h = math.clamp(math.round(rsSt.sh + dy), mnH, math.max(mnH, vps.Y - 30))
                rsSt.tx, rsSt.ty = w, h
                pcall(rsSt.apply, w, h)   -- ตอบทันที 1:1 = เสถียรสุด
        end
end)
UIS.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
                if rsSt.on then
                        rsSt.on = false
                        SND.play("slide")
                        for _, ln in ipairs(gripLines) do
                                ANIM.play(ln, { BackgroundTransparency = 0.3 }, { t = 0.2, tag = "gl" })
                        end
                        S.guiW, S.guiH = math.round(rsSt.tx or rsSt.sw), math.round(rsSt.ty or rsSt.sh)
                        S.guiX = math.round(rsSt.sr - (rsSt.tx or rsSt.sw))
                        S.guiY = math.round(Main.Position.Y.Offset)
                        saveSettings()
                        if tutReposition then pcall(tutReposition) end
                end
        end
end)

-- layout audit ตอน resize: tagline / ชื่อผู้ใช้ / carousel จัดวางใหม่ตามความกว้าง
UIX.onResize = function()
        local w = Main.AbsoluteSize.X
        tagline.Visible = w >= 400
        if avaName then
                avaName.Visible = w >= 450 and not searchFrame.Visible
        end
        if UIX.carKick then UIX.carKick() end   -- การ์ดคำนวณ halfW ใหม่ตามความกว้าง
end

-- ⊢ VIEWPORT CHANGE GUARD — จอหมุน/เปลี่ยนขนาด (มือถือสำคัญมาก)
--   หน้าต่างหลัก + ทุก popup ที่เปิดอยู่ ถูกดึงกลับเข้าจอทั้ง 4 ขอบ
--   (ซ้าย/ขวา/บน/ล่าง) + ย่อหน้าต่างให้พอดีจอใหม่ → ไม่มีอะไรหลุดจอเด็ดขาด
pcall(function()
        local lastFitW, lastFitH = 0, 0
        local vpSaved = nil      -- {w, h} ขนาดจริงก่อนโดนบีบชั่วคราว
        Camera:GetPropertyChangedSignal("ViewportSize"):Connect(function()
                local vps = Camera.ViewportSize
                local fitW, fitH = math.max(vps.X - 12, 240), math.max(vps.Y - 12, 240)
                local w, h = Main.AbsoluteSize.X, Main.AbsoluteSize.Y
                -- 1) จอกลับมาใหญ่ขึ้น → คืนขนาดที่เคยถูกบีบไว้ (ถ้ายังพอดีจอ)
                if vpSaved and (fitW > lastFitW + 4 or fitH > lastFitH + 4) then
                        local rw, rh = math.min(vpSaved.w, fitW), math.min(vpSaved.h, fitH)
                        if rw > w or rh > h then
                                w, h = rw, rh
                                Main.Size = UDim2.fromOffset(w, h)
                                winShadow.Size = UDim2.fromOffset(w + 24, h + 28)
                                gW, gH = w, h
                                if UIX.onResize then pcall(UIX.onResize) end
                        end
                        if rw >= vpSaved.w and rh >= vpSaved.h then vpSaved = nil end
                end
                lastFitW, lastFitH = fitW, fitH
                -- 2) ย่อลงเฉพาะเมื่อใหญ่กว่าจอจริง — และไม่ชนระหว่างลาก resize (จับมุมอยู่)
                --    ⚠ FIX เดิม: cap 330 → พิมพ์ในกล่องใด ๆ (คีย์บอร์ดเปิด = viewport หด)
                --    แล้วหน้าต่างโดนบีบตลอดกาล + ไม่เคยคืนขนาดเดิมเมื่อปิดคีย์บอร์ด
                if not rsSt.on then
                        local nw, nh = math.min(w, fitW), math.min(h, fitH)
                        if nw ~= w or nh ~= h then
                                if not vpSaved then vpSaved = { w = w, h = h } end
                                Main.Size = UDim2.fromOffset(nw, nh)
                                winShadow.Size = UDim2.fromOffset(nw + 24, nh + 28)
                                gW, gH = nw, nh
                        end
                end
                -- 3) clamp ตำแหน่งหน้าต่างหลักกลับเข้าจอ (เต็มขอบ 4 ด้าน — ใช้ w,h ที่คำนวณแล้ว
                --    ไม่พึ่ง AbsoluteSize ที่อาจ delay หนึ่งเฟรมบนเครื่องจริง)
                local x, y = Main.Position.X.Offset, Main.Position.Y.Offset
                local nx = math.clamp(x, 0, math.max(0, vps.X - w))
                local ny = math.clamp(y, 0, math.max(0, vps.Y - h))
                Main.Position = UDim2.fromOffset(nx, ny)
                winShadow.Position = UDim2.fromOffset(nx - 10, ny - 6)
                -- 4) clamp ทุก popup/modal ที่เปิดอยู่ + จัด carousel/tutorial ใหม่
                if UIX.clampFloats then pcall(UIX.clampFloats) end
                if UIX.carKick then pcall(UIX.carKick) end
                if tutReposition then pcall(tutReposition) end
                if UIX.onResize then pcall(UIX.onResize) end
                -- 5) จดจำตำแหน่ง/ขนาดใหม่
                S.guiX, S.guiY = nx, ny
                S.guiW, S.guiH = w, h
                pcall(saveSettings)
        end)
end)

-- ⊢ SCREEN HAMMER — ตัวบังคับกลับเข้าจอถาวร (ทุก 0.4 วิ) ⚠ ตัวช่วยสำรอง
--   แม้อะไรจะพา GUI หลุดจอ (camera เปลี่ยน/เกมเปลี่ยน viewport/บั๊กจุดไหน)
--   ตัวนี้จะดึงหน้าต่างหลัก + pill + ทุก popup กลับเข้าจอ 4 ด้านเสมอ
--   + เฝ้าดู CurrentCamera ถูกเปลี่ยน (บางเกม respawn = camera ใหม่)
--     → อัปเดตตัวแปร Camera ที่ทั้งระบบใช้ ให้ชี้กล้องปัจจุบันเสมอ
do
        local function hammerClamp()
                local cam = workspace.CurrentCamera or Camera
                if cam ~= Camera then Camera = cam end   -- ฟื้นฟูอ้างอิงกล้อง (Camera = local ร่วมทั้งไฟล์)
                local vp = cam and cam.ViewportSize
                if not vp then return end
                if Main.Visible then
                        local w, h = Main.AbsoluteSize.X, Main.AbsoluteSize.Y
                        -- ⚠ FIX "ขยายแล้วเด้งกลับ": ย่อเฉพาะใหญ่กว่าจอจริง (vp-12, floor 240)
                        --   เดิม cap 330 → ขยายเกิน 330 ปุ๊บโดนดึงกลับใน 0.4 วิทุกครั้ง
                        local mw, mh = math.min(w, math.max(vp.X - 12, 240)),
                                        math.min(h, math.max(vp.Y - 12, 240))
                        local ew, eh = w, h
                        if (mw ~= w or mh ~= h) and not rsSt.on then   -- ไม่ชนมือที่กำลังลาก resize
                                Main.Size = UDim2.fromOffset(mw, mh)
                                winShadow.Size = UDim2.fromOffset(mw + 24, mh + 28)
                                gW, gH = mw, mh
                                ew, eh = mw, mh
                                if UIX.onResize then pcall(UIX.onResize) end
                                if UIX.carKick then pcall(UIX.carKick) end
                        end
                        local x, y = Main.Position.X.Offset, Main.Position.Y.Offset
                        local nx = math.clamp(x, 0, math.max(0, vp.X - ew))
                        local ny = math.clamp(y, 0, math.max(0, vp.Y - eh))
                        if nx ~= x or ny ~= y then
                                Main.Position = UDim2.fromOffset(nx, ny)
                                winShadow.Position = UDim2.fromOffset(nx - 10, ny - 6)
                                if tutReposition then pcall(tutReposition) end
                        end
                end
                if UIX.miniPill and UIX.miniPill.Parent and UIX.miniPill.Visible then
                        local pw, ph = UIX.miniPill.AbsoluteSize.X, UIX.miniPill.AbsoluteSize.Y
                        local px_, py_ = UIX.miniPill.Position.X.Offset, UIX.miniPill.Position.Y.Offset
                        local ax, ay = UIX.miniPill.AnchorPoint.X, UIX.miniPill.AnchorPoint.Y
                        local lx = px_ - pw * ax
                        local ly = py_ - ph * ay
                        local nx = math.clamp(lx, 0, math.max(0, vp.X - pw))
                        local ny = math.clamp(ly, 0, math.max(0, vp.Y - ph))
                        if nx ~= lx or ny ~= ly then
                                UIX.miniPill.Position = UDim2.fromOffset(nx + pw * ax, ny + ph * ay)
                        end
                end
                if UIX.clampFloats then pcall(UIX.clampFloats) end
        end
        task.spawn(function()
                task.wait(1.2)
                while true do
                        task.wait(0.4)
                        pcall(hammerClamp)
                end
        end)
end

-- คลิกโลโก้ = กลับหน้าแรก (home) — เช็คระยะกันกดตอนปล่อยหลังลากหน้าต่าง
local logoPress = nil
logoBox.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
                logoPress = { x = i.Position.X, y = i.Position.Y }
        end
end)
logoBox.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
                if logoPress then
                        local dist = math.abs(i.Position.X - logoPress.x) + math.abs(i.Position.Y - logoPress.y)
                                logoPress = nil
                        if dist < 12 then
                                carGoTo(1)
                                switchTab("profile")
                                ANIM.popIn(logoBox, { from = 0.9, t = 0.2 })
                        end
                end
        end
end)

-- เริ่มต้นสถานะ tagline / ชื่อผู้ใช้ (ใช้ gW เพราะ AbsoluteSize ยังเป็น 0 ก่อน render)
do
        tagline.Visible = gW >= 400
        avaName.Visible = gW >= 450
end

-- GUI พร้อมใช้งานแล้ว → ปิด splash ตอนบูต (ถ้ายังค้าง)
if BOOT_SPLASH and BOOT_SPLASH.Parent then
        local sp = BOOT_SPLASH
        BOOT_SPLASH = nil
        pcall(function() sp:Destroy() end)
end

end -- part wrap

do -- p04 COMPONENTS (locals หมดอายุตอนจบ part)

-- ═══════════════════════════════════════════════════════════════
-- ⊢ MINI PILL (สถานะย่อ)
-- ═══════════════════════════════════════════════════════════════
local savedPillPos = UDim2.fromOffset(20, 70)
local savedMainPos, savedMainSize = nil, nil

-- เงาใต้ pill (แยกต่างหาก — ให้ pill เองทึบสนิท มองเห็นง่าย)
local pillShadow = Instance.new("Frame", sg)
pillShadow.Size = UDim2.fromOffset(62, 62)
pillShadow.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
pillShadow.BackgroundTransparency = 0.45
pillShadow.BorderSizePixel = 0
pillShadow.ZIndex = 899
pillShadow.Visible = false
Instance.new("UICorner", pillShadow).CornerRadius = UDim.new(0, 18)

local miniPill = Instance.new("Frame", sg)
miniPill.Size = UDim2.fromOffset(54, 54)
miniPill.Position = savedPillPos
miniPill.BackgroundColor3 = C.CARD
miniPill.BackgroundTransparency = 0            -- ทึบ 100% — เห็นชัดบนฉากไหนก็ได้ (ไม่โปร่งใส)
miniPill.BorderSizePixel = 0
miniPill.ZIndex = 900
miniPill.Visible = false
themed(miniPill, "BackgroundColor3", "CARD")
Instance.new("UICorner", miniPill).CornerRadius = UDim.new(0, 16)
local pillSk = Sk(miniPill, "AC", 2, 0.1)      -- ขอบหนาชัดเจน

do
        -- เคลือบมัน ๆ บาง ๆ (ยังคงสีพื้นทึบ — ไม่ใช่ความโปร่งใสแบบเดิม)
        local pillGrad = Instance.new("UIGradient", miniPill)
        pillGrad.Rotation = 90
        pillGrad.Transparency = NumberSequence.new({
                NumberSequenceKeypoint.new(0, 0),
                NumberSequenceKeypoint.new(1, 0.12),
        })
end

L(miniPill, "S", UDim2.fromOffset(30, 24), UDim2.fromOffset(12, 5), 17, BF, C.T1, Enum.TextXAlignment.Center, 901)
local pillToken = L(miniPill, "--", UDim2.new(1, 0, 0, 13), UDim2.fromOffset(0, 30), 9, BF, C.T2, Enum.TextXAlignment.Center, 901)
pillDot = Instance.new("Frame", miniPill)
pillDot.Size = UDim2.fromOffset(9, 9)
pillDot.Position = UDim2.new(1, -14, 0, 5)
pillDot.BackgroundColor3 = C.NO; pillDot.BorderSizePixel = 0; pillDot.ZIndex = 902
Instance.new("UICorner", pillDot).CornerRadius = UDim.new(1, 0)
Sk(pillDot, nil, 1, 0.4).Color = Color3.fromRGB(255, 255, 255)

local pillBtn = Instance.new("TextButton", miniPill)
pillBtn.Size = UDim2.new(1, 0, 1, 0)
pillBtn.BackgroundTransparency = 1; pillBtn.Text = ""
pillBtn.ZIndex = 903

-- ═══════════════════════════════════════════════════════════════
-- ⊢ VORTEX MINIMIZE / MAXIMIZE (แอนิเมชั่นใหม่ — ไม่ซ้ำเดิม)
--   window ดูดเข้าหา pill + streak particles + pill หมุนเด้งเข้า
-- ═══════════════════════════════════════════════════════════════
local streaks = {}
for i = 1, 6 do
        local f = Instance.new("Frame", sg)
        f.BackgroundColor3 = C.AC
        f.BorderSizePixel = 0
        f.ZIndex = 940
        f.Visible = false
        Instance.new("UICorner", f).CornerRadius = UDim.new(1, 0)
        streaks[i] = f
end

local function streakBurst(winC, winS, pillC, reverse)
        for i, f in ipairs(streaks) do
                local ang = (i / #streaks) * math.pi * 2 + 0.35   -- มุมคงที่ สวยซิมเมตริก ไม่สุ่มแล้ว
                local ex = winC.X + math.cos(ang) * winS.X * 0.42
                local ey = winC.Y + math.sin(ang) * winS.Y * 0.42
                local sx, sy, tx, ty
                if reverse then
                        -- burst ออกจาก pill ไปยังขอบ window
                        sx, sy = pillC.X, pillC.Y
                        tx, ty = ex, ey
                else
                        -- พุ่งจากขอบ window เข้าหา pill
                        sx, sy = ex, ey
                        tx, ty = pillC.X, pillC.Y
                end
                f.BackgroundColor3 = C.AC
                f.Size = UDim2.fromOffset(34, 2)
                f.Position = UDim2.fromOffset(sx, sy)
                f.Rotation = math.deg(math.atan(ty - sy, tx - sx))   -- atan(y,x): ใช้ได้ทั้ง Luau และ Lua 5.3 (atan2 ถูกลบแล้ว)
                f.BackgroundTransparency = 0.3
                f.Visible = true
                task.delay(i * 0.018, function()
                        ANIM.play(f, {
                                Position = UDim2.fromOffset(tx, ty),
                                Size = UDim2.fromOffset(5, 2),
                                BackgroundTransparency = 1,
                        }, { t = 0.3, style = Enum.EasingStyle.Quart, dir = Enum.EasingDirection.In, tag = "st" })
                end)
        end
        task.delay(0.55, function()
                for _, f in ipairs(streaks) do f.Visible = false end
        end)
end

local minBusy = false

function Minimize()
        if minBusy then return end
        minBusy = true
        savedMainPos = Main.Position
        savedMainSize = Main.Size
        SND.play("min")

        local mp, ms = Main.AbsolutePosition, Main.AbsoluteSize
        local pcx = savedPillPos.X.Offset + 27
        local pcy = savedPillPos.Y.Offset + 27
        streakBurst(Vector2.new(mp.X + ms.X / 2, mp.Y + ms.Y / 2), ms, Vector2.new(pcx, pcy), false)

        -- window ดูดเข้า pill อย่างนุ่มนวล (ไม่หมุน — หมุนทั้งหน้าต่างทำให้ดูสั่น/ไม่เสถียร)
        ANIM.play(Main, {
                Size = UDim2.fromOffset(28, 28),
                Position = UDim2.fromOffset(pcx - 14, pcy - 14),
                BackgroundTransparency = 0.35,
        }, { t = 0.3, style = Enum.EasingStyle.Quint, dir = Enum.EasingDirection.In, tag = "mm" })
        ANIM.play(winShadow, { BackgroundTransparency = 1 },
                { t = 0.28, style = Enum.EasingStyle.Quint, dir = Enum.EasingDirection.In, tag = "ws" })

        task.delay(0.31, function()
                Main.Visible = false
                Main.BackgroundTransparency = 0
                winShadow.Visible = false
                winShadow.BackgroundTransparency = 0.62
                miniPill.Visible = true
                pillShadow.Visible = true
                pillShadow.Position = UDim2.fromOffset(savedPillPos.X.Offset - 4, savedPillPos.Y.Offset - 4)
                miniPill.Position = savedPillPos
                miniPill.Size = UDim2.fromOffset(0, 0)
                miniPill.Rotation = 0
                ANIM.play(miniPill, { Size = UDim2.fromOffset(54, 54) },
                        { t = 0.34, style = Enum.EasingStyle.Back, dir = Enum.EasingDirection.Out, tag = "pp" })
                SND.play("popup")
                task.delay(0.38, function() minBusy = false end)
        end)
end

local MaximizeGUI
MaximizeGUI = function()
        if minBusy then return end
        minBusy = true
        savedPillPos = miniPill.Position
        local pcx = savedPillPos.X.Offset + 27
        local pcy = savedPillPos.Y.Offset + 27

        ANIM.play(miniPill, { Size = UDim2.fromOffset(0, 0) },
                { t = 0.22, style = Enum.EasingStyle.Quint, dir = Enum.EasingDirection.In, tag = "pp" })

        task.delay(0.23, function()
                miniPill.Visible = false
                pillShadow.Visible = false
                miniPill.Rotation = 0

                local rPos = savedMainPos or Main.Position
                local rSize = savedMainSize or Main.Size
                if not rSize or rSize.X.Offset < 100 then rSize = UDim2.fromOffset(gW, gH) end

                -- ปรับกันหลุดจอ (เคยย่อไว้ตอนจอเล็ก) — เต็มขอบ 4 ด้าน
                local vps = Camera.ViewportSize
                local rw = math.clamp(rSize.X.Offset, MIN_W, math.max(MIN_W, vps.X - 20))
                local rh = math.clamp(rSize.Y.Offset, MIN_H, math.max(MIN_H, vps.Y - 20))
                rSize = UDim2.fromOffset(rw, rh)
                local rx = math.clamp(rPos.X.Offset, 0, math.max(0, vps.X - rw))
                local ry = math.clamp(rPos.Y.Offset, 0, math.max(0, vps.Y - rh))
                rPos = UDim2.fromOffset(rx, ry)

                Main.Visible = true
                Main.Size = UDim2.fromOffset(28, 28)
                Main.Position = UDim2.fromOffset(pcx - 14, pcy - 14)
                Main.Rotation = 0
                winShadow.Visible = true
                winShadow.BackgroundTransparency = 0.62
                winShadow.Size = UDim2.fromOffset(rw + 24, rh + 28)
                winShadow.Position = UDim2.fromOffset(rx - 10, ry - 6)

                streakBurst(Vector2.new(rx + rw / 2, ry + rh / 2), Vector2.new(rw, rh), Vector2.new(pcx, pcy), true)

                ANIM.play(Main, { Size = rSize, Position = rPos },
                        { t = 0.34, style = Enum.EasingStyle.Back, dir = Enum.EasingDirection.Out, tag = "mm" })
                SND.play("max")

                task.delay(0.4, function()
                        minBusy = false
                        Main.Rotation = 0
                        gW, gH = Main.AbsoluteSize.X, Main.AbsoluteSize.Y
                        if tutReposition then pcall(tutReposition) end
                end)
        end)
end

minBtn.MouseButton1Click:Connect(Minimize)

-- pill: ลากได้ (สมูทเดียวกับ window) + แตะเพื่อขยาย
UIX.miniPill = miniPill   -- hammer clamp (p03) ใช้ดึง pill กลับเข้าจอด้วย
if UIX.smoothDrag then
        UIX.smoothDrag(pillBtn, {
                getPos = function() return miniPill.Position.X.Offset, miniPill.Position.Y.Offset end,
                clamp = function(x, y)
                        local vps = Camera.ViewportSize
                        return math.clamp(x, 0, vps.X - 54), math.clamp(y, 0, vps.Y - 54)
                end,
                apply = function(x, y)
                        miniPill.Position = UDim2.fromOffset(x, y)
                        pillShadow.Position = UDim2.fromOffset(x - 4, y - 4)
                end,
                onRelease = function(moved, st)
                        if moved then
                                savedPillPos = UDim2.fromOffset(math.round(st.tx), math.round(st.ty))
                        else
                                MaximizeGUI()
                        end
                end,
        })
else
        do
                local pd = { on = false }
                pillBtn.InputBegan:Connect(function(i)
                        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
                                pd = { on = true, moved = false, sx = i.Position.X, sy = i.Position.Y,
                                        ox = savedPillPos.X.Offset, oy = savedPillPos.Y.Offset }
                        end
                end)
                UIS.InputChanged:Connect(function(i)
                        if not pd.on then return end
                        if i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch then
                                local dx, dy = i.Position.X - pd.sx, i.Position.Y - pd.sy
                                if not pd.moved then
                                        if Vector2.new(dx, dy).Magnitude > 5 then
                                                pd.moved = true
                                                SND.play("drag")
                                        else return end
                                end
                                local vps = Camera.ViewportSize
                                local np = UDim2.fromOffset(
                                        math.clamp(pd.ox + dx, 0, vps.X - 54),
                                        math.clamp(pd.oy + dy, 0, vps.Y - 54))
                                miniPill.Position = np; savedPillPos = np
                        end
                end)
                UIS.InputEnded:Connect(function(i)
                        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
                                if pd.on then
                                        pd.on = false
                                        if not pd.moved then MaximizeGUI() end
                                end
                        end
                end)
        end
end

-- keybind: RightShift = ย่อ/ขยาย
UIS.InputBegan:Connect(function(i, gpe)
        if gpe then return end
        if i.KeyCode == Enum.KeyCode.RightShift then
                if Main.Visible then Minimize() else MaximizeGUI() end
        end
end)

-- ═══════════════════════════════════════════════════════════════
-- ⊢ BUTTON FEEDBACK SYSTEM — ตอบสนองทันที (ไม่มี delay)
--   press ทันทีที่แตะ + hover เฉพาะเมาส์ + เสียงคลิก
-- ═══════════════════════════════════════════════════════════════
do
        local function lighten(c, amt)
                return Color3.new(
                        math.clamp(c.R + (1 - c.R) * amt, 0, 1),
                        math.clamp(c.G + (1 - c.G) * amt, 0, 1),
                        math.clamp(c.B + (1 - c.B) * amt, 0, 1))
        end

local function matchThemeKey(c)
        for k, v in pairs(C) do
                if v == c then return k end
        end
        return nil
end

        hookBtn = function(btn, opts)
                if not btn then return end
        opts = opts or {}
        local sound = opts.sound ~= nil and opts.sound or "click"
        local us = addScale(btn, 1)

        -- หา theme key ของสีพื้น (เพื่อ restore ถูกต้องหลังเปลี่ยนธีม)
        local baseKey = matchThemeKey(btn.BackgroundColor3)
        local baseCol = btn.BackgroundColor3
        local pressing = false

        btn.InputBegan:Connect(function(i)
                if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
                        pressing = true
                        -- กดแบบมีหน่วงนุ่ม ๆ (tween สั้นมาก ยังรู้สึกทันที แต่ไม่ดีดแข็ง ๆ)
                        ANIM.play(us, { Scale = 0.93 }, { t = 0.05, style = Enum.EasingStyle.Quart, dir = Enum.EasingDirection.Out, tag = "prs" })
                        if btn.BackgroundTransparency < 1 then
                                btn.BackgroundColor3 = lighten(baseKey and C[baseKey] or baseCol, 0.12)
                        end
                end
        end)
        local function release()
                if not pressing then return end
                pressing = false
                ANIM.play(us, { Scale = 1 }, { t = 0.18, style = Enum.EasingStyle.Back, dir = Enum.EasingDirection.Out, tag = "prs" })
                if btn.BackgroundTransparency < 1 then
                        ANIM.play(btn, { BackgroundColor3 = baseKey and C[baseKey] or baseCol },
                                { t = 0.14, tag = "prs" })
                end
        end
        btn.InputEnded:Connect(release)
        btn.MouseLeave:Connect(release)

        if UIS.MouseEnabled then
                btn.MouseEnter:Connect(function()
                        if pressing then return end
                        SND.play("hover")
                        if btn.BackgroundTransparency < 1 then
                                ANIM.play(btn, { BackgroundColor3 = lighten(baseKey and C[baseKey] or baseCol, 0.07) },
                                        { t = 0.13, tag = "hov" })
                        end
                end)
                btn.MouseLeave:Connect(function()
                        if pressing then return end
                        ANIM.play(btn, { BackgroundColor3 = baseKey and C[baseKey] or baseCol },
                                { t = 0.13, tag = "hov" })
                end)
        end

                if sound ~= false then
                        btn.MouseButton1Click:Connect(function()
                                SND.play(sound)
                        end)
                end
                return btn
        end
end -- do: button feedback

-- ปุ่มมาตรฐาน: style = accent | soft | ghost | danger | success
function mkBtn(parent, text, sz, pos, style, fs, zi)
        style = style or "soft"
        local b = Instance.new("TextButton")
        b.Size = sz; b.Position = pos or UDim2.new()
        b.BorderSizePixel = 0
        b.Text = text or ""; b.Font = BF; b.TextSize = fs or 10
        b.AutoButtonColor = false
        b.ZIndex = zi or 15
        b.Parent = parent
        Instance.new("UICorner", b).CornerRadius = UDim.new(0, 8)

        if style == "accent" then
                b.BackgroundColor3 = C.AC; b.TextColor3 = C.WIN
                themed(b, "BackgroundColor3", "AC"); themed(b, "TextColor3", "WIN")
        elseif style == "danger" then
                b.BackgroundColor3 = C.NO; b.TextColor3 = C.WIN
                themed(b, "BackgroundColor3", "NO"); themed(b, "TextColor3", "WIN")
        elseif style == "success" then
                b.BackgroundColor3 = C.OK; b.TextColor3 = C.WIN
                themed(b, "BackgroundColor3", "OK"); themed(b, "TextColor3", "WIN")
        elseif style == "ghost" then
                b.BackgroundTransparency = 1; b.BackgroundColor3 = C.CD
                b.TextColor3 = C.T1
                themed(b, "TextColor3", "T1")
                Sk(b, "BD", 1.2, 0.2)
        else
                b.BackgroundColor3 = C.CD; b.TextColor3 = C.T1
                themed(b, "BackgroundColor3", "CD"); themed(b, "TextColor3", "T1")
        end
        hookBtn(b)
        return b
end

-- ═══════════════════════════════════════════════════════════════
-- ⊢ COMPONENT HELPERS (การ์ด / toggle / input / slider)
-- ═══════════════════════════════════════════════════════════════
function mkCard(pg, h, order)
        local c = F(pg, UDim2.new(1, -3, 0, h), nil, C.CARD, 12, 14)
        c.LayoutOrder = order
        Sk(c, "BD", 1, 0.55)
        return c
end

function mkLabel(card, text, y)
        return Lk(card, text, UDim2.new(1, -12, 0, 13), UDim2.fromOffset(10, y), 8, BF, "T2", Enum.TextXAlignment.Left, 15)
end

-- toggle แบบ pill switch ทันสมัย
function mkToggleX(card, y, label, getFn, setFn)
        local row = Instance.new("Frame", card)
        row.Size = UDim2.new(1, -16, 0, 32); row.Position = UDim2.fromOffset(8, y)
        row.BackgroundTransparency = 1; row.ZIndex = 15
        Lk(row, label, UDim2.new(1, -60, 1, 0), nil, 10, RF, "T1", Enum.TextXAlignment.Left, 16)

        local sw = Instance.new("TextButton", row)
        sw.Size = UDim2.fromOffset(42, 22)
        sw.Position = UDim2.new(1, -42, 0.5, -11)
        sw.BorderSizePixel = 0
        sw.Text = ""; sw.AutoButtonColor = false
        sw.ZIndex = 16
        Instance.new("UICorner", sw).CornerRadius = UDim.new(1, 0)

        local knob = Instance.new("Frame", sw)
        knob.Size = UDim2.fromOffset(16, 16)
        knob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
        knob.BorderSizePixel = 0; knob.ZIndex = 17
        Instance.new("UICorner", knob).CornerRadius = UDim.new(1, 0)
        local kSk = Sk(knob, nil, 1, 0.6)
        kSk.Color = Color3.fromRGB(0, 0, 0)

        local function paint(on, instant)
                sw.BackgroundColor3 = on and C.OK or C.CD
                local tx = on and 22 or 4
                if instant then
                        knob.Position = UDim2.fromOffset(tx, 3)
                else
                        ANIM.play(knob, { Position = UDim2.fromOffset(tx, 3) },
                                { t = 0.18, style = Enum.EasingStyle.Back, dir = Enum.EasingDirection.Out, tag = "kn" })
                end
        end
        paint(getFn(), true)

        sw.MouseButton1Click:Connect(function()
                local on = not getFn()
                setFn(on)
                paint(on)
                SND.play("toggle")
        end)
        hookBtn(sw, { sound = false })
        return row
end

function mkToggle(card, y, label, key)
        return mkToggleX(card, y, label,
                function() return S[key] == true end,
                function(v) S[key] = v; saveSettings() end)
end

-- input พร้อม stroke เรืองตอนโฟกัส
function mkInput(card, y, label, key, minV, maxV, cb)
        local row = Instance.new("Frame", card)
        row.Size = UDim2.new(1, -16, 0, 30); row.Position = UDim2.fromOffset(8, y)
        row.BackgroundTransparency = 1; row.ZIndex = 15
        Lk(row, label, UDim2.new(1, -74, 1, 0), nil, 10, RF, "T1", Enum.TextXAlignment.Left, 16)

        local box = Instance.new("TextBox", row)
        box.Size = UDim2.fromOffset(62, 24); box.Position = UDim2.new(1, -62, 0.5, -12)
        box.BackgroundColor3 = C.CD; box.BorderSizePixel = 0
        box.Text = tostring(S[key]); box.TextColor3 = C.T1
        box.PlaceholderColor3 = C.T2; box.Font = BF; box.TextSize = 10
        box.ZIndex = 16; box.ClearTextOnFocus = false
        box.TextXAlignment = Enum.TextXAlignment.Center
        themed(box, "BackgroundColor3", "CD")
        themed(box, "TextColor3", "T1")
        Instance.new("UICorner", box).CornerRadius = UDim.new(0, 7)
        local bSk = Sk(box, "BD", 1, 0.35)

        box.Focused:Connect(function()
                ANIM.play(bSk, { Color = C.AC, Transparency = 0 }, { t = 0.15, tag = "fc" })
                SND.play("hover")
        end)
        box.FocusLost:Connect(function()
                ANIM.play(bSk, { Color = C.BD, Transparency = 0.35 }, { t = 0.2, tag = "fc" })
                local n = tonumber(box.Text)
                if n then
                        n = math.clamp(n, minV or 0, maxV or 9999)
                        S[key] = n; saveSettings()
                        if cb then cb(n) end
                        box.Text = tostring(n)
                else
                        box.Text = tostring(S[key])
                end
        end)
        return row, box
end

-- slider ทันสมัย: label+value บรรทัดบน track เต็มความกว้างล่าง
function mkSlider(card, y, label, key)
        local row = Instance.new("Frame", card)
        row.Size = UDim2.new(1, -16, 0, 36); row.Position = UDim2.fromOffset(8, y)
        row.BackgroundTransparency = 1; row.ZIndex = 15

        Lk(row, label, UDim2.new(0.6, 0, 0, 14), nil, 10, BF, "T1", Enum.TextXAlignment.Left, 16)
        local vl = Lk(row, tostring(S.traits[key]), UDim2.new(0.4, 0, 0, 14), UDim2.new(0.6, 0, 0, 0), 10, BF, "AC", Enum.TextXAlignment.Right, 16)

        local track = Instance.new("Frame", row)
        track.Size = UDim2.new(1, 0, 0, 6)
        track.Position = UDim2.new(0, 0, 0, 22)
        track.BackgroundColor3 = C.CD; track.BorderSizePixel = 0
        track.ZIndex = 16
        themed(track, "BackgroundColor3", "CD")
        Instance.new("UICorner", track).CornerRadius = UDim.new(1, 0)

        local fill = Instance.new("Frame", track)
        fill.Size = UDim2.new(S.traits[key] / 10, 0, 1, 0)
        fill.BackgroundColor3 = C.AC; fill.BorderSizePixel = 0
        fill.ZIndex = 17
        themed(fill, "BackgroundColor3", "AC")
        Instance.new("UICorner", fill).CornerRadius = UDim.new(1, 0)

        local knob = Instance.new("Frame", track)
        knob.AnchorPoint = Vector2.new(0.5, 0.5)
        knob.Size = UDim2.fromOffset(14, 14)
        knob.Position = UDim2.new(S.traits[key] / 10, 0, 0.5, 0)
        knob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
        knob.BorderSizePixel = 0; knob.ZIndex = 18
        Instance.new("UICorner", knob).CornerRadius = UDim.new(1, 0)
        local knSk = Sk(knob, "AC", 2, 0.15)

        -- hit area ใหญ่ (สัมผัสง่ายบนมือถือ)
        local hit = Instance.new("TextButton", row)
        hit.Size = UDim2.new(1, 0, 0, 22)
        hit.Position = UDim2.new(0, 0, 0, 14)
        hit.BackgroundTransparency = 1
        hit.Text = ""; hit.AutoButtonColor = false
        hit.ZIndex = 19

        local lastInt = S.traits[key]
        local function upd(i)
                local rx = math.clamp((i.Position.X - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1), 0, 1)
                local v = math.floor(rx * 10 + 0.5)
                if v ~= S.traits[key] then
                        S.traits[key] = v
                        vl.Text = tostring(v)
                        fill.Size = UDim2.new(rx, 0, 1, 0)
                        knob.Position = UDim2.new(rx, 0, 0.5, 0)
                        if v ~= lastInt then
                                lastInt = v
                                SND.play("slide")
                        end
                end
        end
        local dr = false
        hit.InputBegan:Connect(function(i)
                if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
                        dr = true; upd(i)
                        ANIM.play(knSk, { Thickness = 3 }, { t = 0.1, tag = "kn" })
                end
        end)
        UIS.InputChanged:Connect(function(i)
                if dr and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
                        upd(i)
                end
        end)
        UIS.InputEnded:Connect(function(i)
                if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
                        if dr then
                                dr = false
                                saveSettings()
                                ANIM.play(knSk, { Thickness = 2 }, { t = 0.15, tag = "kn" })
                        end
                end
        end)
        return row
end

-- ═══════════════════════════════════════════════════════════════
-- ⊢ TOAST NOTIFICATIONS (แจ้งเตือนแบบ premium แทน SetCore)
-- ═══════════════════════════════════════════════════════════════
local toastHolder = Instance.new("Frame", sg)
toastHolder.AnchorPoint = Vector2.new(1, 0)
toastHolder.Position = UDim2.new(1, -10, 0, 56)
toastHolder.Size = UDim2.fromOffset(240, 400)
toastHolder.BackgroundTransparency = 1
toastHolder.ZIndex = 960

local toastList = {}

function notify(title, text, kind)
        kind = kind or "info"
        SND.play(kind == "ok" and "success" or kind == "err" and "error" or "notify")

        -- จำกัด 3 อัน — ทิ้งของเก่าทันที
        while #toastList >= 3 do
                local old = table.remove(toastList, 1)
                if old and old.Parent then old:Destroy() end
        end

        local col = kind == "ok" and C.OK or kind == "err" and C.NO or kind == "warn" and C.WN or C.AC
        -- ข้อความหลายบรรทัด (มี \n) → toast สูงขึ้นตามจำนวนบรรทัด (สูงสุด 4)
        local nLines = 1
        if type(text) == "string" then
                nLines = nLines + select(2, text:gsub("\n", ""))
                if nLines > 4 then nLines = 4 end
        end
        local tH = 52 + (nLines - 1) * 24
        local t = Instance.new("Frame", toastHolder)
        t.Size = UDim2.fromOffset(236, tH)
        t.BackgroundColor3 = C.POP
        t.BorderSizePixel = 0
        t.ZIndex = 961
        themed(t, "BackgroundColor3", "POP")
        Instance.new("UICorner", t).CornerRadius = UDim.new(0, 10)
        Sk(t, nil, 1.2, 0.25).Color = col

        local dot = Instance.new("Frame", t)
        dot.Size = UDim2.fromOffset(8, 8)
        dot.Position = UDim2.fromOffset(10, 12)
        dot.BackgroundColor3 = col; dot.BorderSizePixel = 0
        dot.ZIndex = 962
        Instance.new("UICorner", dot).CornerRadius = UDim.new(1, 0)

        Lk(t, title, UDim2.new(1, -58, 0, 15), UDim2.fromOffset(26, 6), 10, BF, "T1", Enum.TextXAlignment.Left, 962)
        local body = Lk(t, text or "", UDim2.new(1, -58, 0, 24 + (nLines - 1) * 24), UDim2.fromOffset(26, 21), 9, RF, "T2", Enum.TextXAlignment.Left, 962)
        body.TextWrapped = true
        body.TextYAlignment = Enum.TextYAlignment.Top
        body.TextTruncate = Enum.TextTruncate.AtEnd

        -- ตำแหน่ง y ของ toast ลำดับที่ i (toast สูงไม่เท่ากันได้ — วางต่อกันตามความสูงจริง)
        local function stackY(i)
                local y = 0
                for j = 1, math.min(i - 1, #toastList) do
                        local tj = toastList[j]
                        if tj then y = y + tj.Size.Y.Offset + 6 end
                end
                return y
        end

        toastList[#toastList + 1] = t

        -- เรียงตำแหน่งใหม่ + สไลด์เข้า
        for i, tt in ipairs(toastList) do
                ANIM.play(tt, { Position = UDim2.fromOffset(0, stackY(i)) },
                        { t = 0.22, style = Enum.EasingStyle.Quad, dir = Enum.EasingDirection.Out, tag = "tpos" })
        end
        t.Position = UDim2.fromOffset(250, stackY(#toastList))
        ANIM.play(t, { Position = UDim2.fromOffset(0, stackY(#toastList)) },
                { t = 0.3, style = Enum.EasingStyle.Back, dir = Enum.EasingDirection.Out, tag = "tin" })
        ANIM.popIn(t, { from = 0.9, t = 0.26 })

        task.delay(3.4, function()
                if t.Parent == nil then return end
                for i, tt in ipairs(toastList) do
                        if tt == t then table.remove(toastList, i); break end
                end
                ANIM.play(t, { Position = UDim2.fromOffset(250, t.Position.Y.Offset), BackgroundTransparency = 1 },
                        { t = 0.22, style = Enum.EasingStyle.Quart, dir = Enum.EasingDirection.In, tag = "tout",
                                cb = function()
                                        if t and t.Parent then t:Destroy() end
                                end })
                for i, tt in ipairs(toastList) do
                        ANIM.play(tt, { Position = UDim2.fromOffset(0, stackY(i)) },
                                { t = 0.22, tag = "tpos" })
                end
        end)
end
UIX.notify = notify

-- ═══════════════════════════════════════════════════════════════
-- ⊢ HUD (event-driven — ไม่มี loop อัปเดต)
-- ═══════════════════════════════════════════════════════════════
local function fmtTok(n)
        n = tonumber(n) or 0
        if n >= 1000000 then return string.format("%.1fM", n / 1000000) end
        if n >= 1000 then return string.format("%.1fK", n / 1000) end
        return tostring(n)
end

updateHUD = function()
        local actN = math.clamp(tonumber(S.activeKeys) or 1, 1, MAX_KEYS)
        local okN = 0
        for i = 1, actN do
                if S.keyOk[i] then okN = okN + 1 end
        end
        -- 🖥️ Local AI: ปิดระบบคีย์ → pill บอกโหมด local แทนจำนวนคีย์
        local txt
        if EP.isLocal() then
                txt = "🖥️ Local  ⚡ " .. fmtTok(S.totalTokensUsed)
        else
                txt = "🔑 " .. okN .. "/" .. actN .. "  ⚡ " .. fmtTok(S.totalTokensUsed)
                if S.lastKeyIdx and S.lastKeyIdx > 0 then
                        txt = txt .. "  K" .. S.lastKeyIdx
                end
        end
        pcall(function() tokenLbl.Text = txt end)
        pcall(function() pillToken.Text = fmtTok(S.totalTokensUsed) end)
        local col = S.connected and ((EP.isLocal() or okN > 0) and C.OK or C.WN) or C.NO
        pcall(function() spDot.BackgroundColor3 = col end)
        pcall(function() pillDot.BackgroundColor3 = col end)
end
updateHUD()

-- ═══════════════════════════════════════════════════════════════
-- ⊢ PAGE SYSTEM + SWITCH TAB (cover flow carousel navigation)
-- ═══════════════════════════════════════════════════════════════
local PAGE_META = {
        profile  = { "Profile",    "Your account & premium status" },
        api       = { "API Keys",   "Local AI · Ollama · OpenRouter" },
        chat      = { "Chat",       "Talk to Sebas directly — no range limit" },
        controls  = { "Controls",   "Chat & observe behaviour" },
        settings  = { "Settings",   "Range, timing and interface" },
        mood      = { "Mood",       "Shape the personality" },
        persona   = { "Persona",    "Custom identity instructions" },
        memory    = { "Memory",     "Player history & profiles" },
        blacklist = { "Block List", "Players the AI ignores" },
        whitelist = { "Allow List", "Restrict who gets replies" },
        theme     = { "Themes",     "Pick your look" },
        sound     = { "Sounds",     "UI sound mixer" },
}

local tabPages = {}
activeTab = nil

function makePage(name)
        local pg = Instance.new("ScrollingFrame", Content)
        pg.Name = "Page_" .. name
        pg.Size = UDim2.new(1, 0, 1, -(HDR_H + CAR_H))   -- เริ่มใต้ carousel
        pg.Position = UDim2.fromOffset(0, HDR_H + CAR_H)
        pg.BackgroundTransparency = 1
        pg.ScrollBarThickness = 3
        pg.ScrollBarImageColor3 = C.BD
        pg.ScrollBarImageTransparency = 0.3
        pg.AutomaticCanvasSize = Enum.AutomaticSize.Y
        pg.CanvasSize = UDim2.new()
        pg.ZIndex = 13; pg.Visible = false; pg.ClipsDescendants = true
        pg.ElasticBehavior = Enum.ElasticBehavior.Never
        local ll = Instance.new("UIListLayout", pg)
        ll.Padding = UDim.new(0, 6); ll.SortOrder = Enum.SortOrder.LayoutOrder
        local pad = Instance.new("UIPadding", pg)
        pad.PaddingLeft = UDim.new(0, 8); pad.PaddingRight = UDim.new(0, 8)
        pad.PaddingTop = UDim.new(0, 6); pad.PaddingBottom = UDim.new(0, 10)
        tabPages[name] = pg
        return pg
end

local function navIdx(name)
        for i, td in ipairs(NAV_ITEMS) do
                if td.name == name then return i end   -- fix: เดิมอ่าน td.idx ซึ่งเป็น nil ทำให้ switchTab crash
        end
        return 99
end

switchTab = function(name)
        if activeTab == name then return end
        if not tabPages[name] then return end
        local prev = activeTab
        activeTab = name

        -- ขับ cover flow carousel ไปหน้านั้น (จะแอนิเมตนุ่ม ๆ เอง)
        local idx = navIdx(name) or 1
        if carGoTo then pcall(carGoTo, idx) end

        -- หัวเรื่อง + search box + ชื่อผู้ใช้ (ซ่อนชื่อตอน search โผล่ กันทับกัน)
        local meta = PAGE_META[name] or { name, "" }
        ctTitle.Text = meta[1]
        ctSub.Text = meta[2]
        local hasSearch = (name == "whitelist" or name == "blacklist")
        searchFrame.Visible = hasSearch
        if avaName then
                avaName.Visible = (not hasSearch) and Main.AbsoluteSize.X >= 450
        end

        -- สไลด์หน้าตามทิศทาง (ลง/ขึ้น ตาม index)
        local goDown = idx > navIdx(prev or "api")
        local off = goDown and 26 or -26

        if prev and tabPages[prev] then
                local op = tabPages[prev]
                ANIM.play(op, { Position = UDim2.fromOffset(0, HDR_H + CAR_H - off) },
                        { t = 0.16, style = Enum.EasingStyle.Quad, dir = Enum.EasingDirection.In, tag = "pg" })
                task.delay(0.17, function()
                        if activeTab ~= prev then
                                op.Visible = false
                                op.Position = UDim2.fromOffset(0, HDR_H + CAR_H)
                        end
                end)
        end

        local np = tabPages[name]
        np.Visible = true
        np.Position = UDim2.fromOffset(0, HDR_H + CAR_H + off)
        np.CanvasPosition = Vector2.new(0, 0)
        ANIM.play(np, { Position = UDim2.fromOffset(0, HDR_H + CAR_H) },
                { t = 0.26, style = Enum.EasingStyle.Quint, dir = Enum.EasingDirection.Out, tag = "pg" })

        SND.play("tab")
        -- หน้าโปรไฟล์: เติมข้อมูลสดทุกครั้งที่สลับมา (สถิติ/tier/สถานะคีย์)
        if name == "profile" and UIX.fillProfilePage then
                task.defer(function() pcall(UIX.fillProfilePage) end)
        end
        if tutReposition then
                task.defer(function() pcall(tutReposition) end)
                task.delay(0.32, function() pcall(tutReposition) end)  -- จัดวงอีกครั้งหลัง animation หน้าเพจจบ → ตรงจุด
        end
end

statusPill.MouseButton1Click:Connect(function()
        switchTab("api")
        ANIM.popIn(statusPill, { from = 0.9, t = 0.2 })
end)
hookBtn(minBtn, { sound = "min" })
hookBtn(tutBtn, { sound = "click" })
hookBtn(statusPill, { sound = "tab" })

end -- part wrap

do -- p05 API PAGE

-- ═══════════════════════════════════════════════════════════════
-- PAGE: API KEYS (LOCAL AI / OLLAMA / OPENROUTER)
-- ═══════════════════════════════════════════════════════════════
local pgAPI = makePage("api")

do
        local apiCard1 = mkCard(pgAPI, 486, 1)
        mkLabel(apiCard1, "🖥️ API PROVIDER — LOCAL AI · OLLAMA · OPENROUTER", 4)

        -- ─── Slider เลือกจำนวนคีย์ 1-10 (สไตล์ใหม่ ลากลื่น) ───
        local skRow = Instance.new("Frame", apiCard1)
        skRow.Name = "KeyCountRow"
        skRow.Size = UDim2.new(1, -16, 0, 42)
        skRow.Position = UDim2.fromOffset(8, 18)
        skRow.BackgroundTransparency = 1; skRow.ZIndex = 15

        Lk(skRow, "🔑  Active Keys", UDim2.new(0.6, 0, 0, 14), nil, 10, BF, "T1", Enum.TextXAlignment.Left, 16)
        local skVal = Lk(skRow, tostring(S.activeKeys) .. " / " .. MAX_KEYS, UDim2.new(0.4, 0, 0, 14), UDim2.new(0.6, 0, 0, 0), 10, BF, "AC", Enum.TextXAlignment.Right, 16)

        local skTrack = Instance.new("Frame", skRow)
        skTrack.Size = UDim2.new(1, 0, 0, 6)
        skTrack.Position = UDim2.new(0, 0, 0, 24)
        skTrack.BackgroundColor3 = C.CD; skTrack.BorderSizePixel = 0
        skTrack.ZIndex = 16
        themed(skTrack, "BackgroundColor3", "CD")
        Instance.new("UICorner", skTrack).CornerRadius = UDim.new(1, 0)

        local skFill = Instance.new("Frame", skTrack)
        skFill.Size = UDim2.new((S.activeKeys - 1) / (MAX_KEYS - 1), 0, 1, 0)
        skFill.BackgroundColor3 = C.AC; skFill.BorderSizePixel = 0
        skFill.ZIndex = 17
        themed(skFill, "BackgroundColor3", "AC")
        Instance.new("UICorner", skFill).CornerRadius = UDim.new(1, 0)

        local skKnob = Instance.new("Frame", skTrack)
        skKnob.AnchorPoint = Vector2.new(0.5, 0.5)
        skKnob.Size = UDim2.fromOffset(14, 14)
        skKnob.Position = UDim2.new((S.activeKeys - 1) / (MAX_KEYS - 1), 0, 0.5, 0)
        skKnob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
        skKnob.BorderSizePixel = 0; skKnob.ZIndex = 18
        Instance.new("UICorner", skKnob).CornerRadius = UDim.new(1, 0)
        local skKnSk = Sk(skKnob, "AC", 2, 0.15)

        local skHit = Instance.new("TextButton", skRow)
        skHit.Size = UDim2.new(1, 0, 0, 24)
        skHit.Position = UDim2.new(0, 0, 0, 16)
        skHit.BackgroundTransparency = 1
        skHit.Text = ""; skHit.AutoButtonColor = false
        skHit.ZIndex = 19

        local skDrag = false
        local function skUpd(inp, noSave)
                local rx = math.clamp((inp.Position.X - skTrack.AbsolutePosition.X) / math.max(skTrack.AbsoluteSize.X, 1), 0, 1)
                local v = math.floor(rx * (MAX_KEYS - 1) + 0.5) + 1
                if v ~= S.activeKeys then
                        -- 🔒 premium gate: Multi-Key 2-10 ดอก
                        if v > 1 and not AUTH.on("multikey") then
                                v = 1
                                notify("🔒 Premium", "Multi-Key (2-10 ดอก) เป็นฟีเจอร์ Premium — อัปเกรดที่หน้า Profile", "warn")
                                SND.play("error")
                        end
                        if v ~= S.activeKeys then
                                S.activeKeys = v
                                skVal.Text = tostring(v) .. " / " .. MAX_KEYS
                                skFill.Size = UDim2.new(rx, 0, 1, 0)
                                skKnob.Position = UDim2.new(rx, 0, 0.5, 0)
                                SND.play("slide")
                                if UIX.updateKeyDots then UIX.updateKeyDots() end
                                updateHUD()
                        end
                end
        end
        skHit.InputBegan:Connect(function(i)
                if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
                        skDrag = true; skUpd(i)
                        ANIM.play(skKnSk, { Thickness = 3 }, { t = 0.1, tag = "kn" })
                end
        end)
        UIS.InputChanged:Connect(function(i)
                if skDrag and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
                        skUpd(i)
                end
        end)
        UIS.InputEnded:Connect(function(i)
                if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
                        if skDrag then
                                skDrag = false
                                saveKeys()
                                ANIM.play(skKnSk, { Thickness = 2 }, { t = 0.15, tag = "kn" })
                        end
                end
        end)

        -- ─── PROVIDER — เหลือ 3 ตัวตามคำขอเจ้าของ เน้น Local AI ก่อน (ชิปเลื่อนแนวนอน) ───
        local provLbl = Lk(apiCard1, "🖥️  PROVIDER — Local AI แนะนำ (ไม่ต้องใช้คีย์) / Ollama Cloud / OpenRouter", UDim2.new(1, -16, 0, 14), UDim2.fromOffset(8, 60), 8, BF, "T2", Enum.TextXAlignment.Left, 15)

        local provScroll = Instance.new("ScrollingFrame", apiCard1)
        provScroll.Size = UDim2.new(1, -16, 0, 26)
        provScroll.Position = UDim2.fromOffset(8, 74)
        provScroll.BackgroundColor3 = C.CD; provScroll.BorderSizePixel = 0
        provScroll.ScrollBarThickness = 2
        provScroll.ScrollBarImageColor3 = C.BD
        provScroll.ScrollingDirection = Enum.ScrollingDirection.X
        provScroll.CanvasSize = UDim2.new(0, 0, 0, 0)
        provScroll.ZIndex = 15
        themed(provScroll, "BackgroundColor3", "CD")
        Instance.new("UICorner", provScroll).CornerRadius = UDim.new(0, 6)
        local provList = Instance.new("UIListLayout", provScroll)
        provList.FillDirection = Enum.FillDirection.Horizontal
        provList.Padding = UDim.new(0, 4)
        provList.SortOrder = Enum.SortOrder.LayoutOrder
        local provPad = Instance.new("UIPadding", provScroll)
        provPad.PaddingLeft = UDim.new(0, 4); provPad.PaddingTop = UDim.new(0, 2)

        local provChips = {}
        local totalW = 4
        for pi, p in ipairs(PROVIDERS) do
                local txt = p.icon .. " " .. p.name
                local w = math.clamp(24 + #txt * 5.2, 44, 132)
                local chip = Instance.new("TextButton", provScroll)
                chip.Name = "ProvChip_" .. p.id
                chip.Size = UDim2.fromOffset(math.floor(w), 22)
                chip.BackgroundColor3 = C.CD; chip.BorderSizePixel = 0
                chip.Text = txt; chip.Font = BF; chip.TextSize = 9
                chip.TextColor3 = C.T1
                chip.AutoButtonColor = false
                chip.LayoutOrder = pi
                chip.ZIndex = 16
                Instance.new("UICorner", chip).CornerRadius = UDim.new(0, 6)
                themed(chip, "BackgroundColor3", "CD")
                -- 🖥️ เน้น Local AI: ชิปตัวแรกมีขอบสี AC ให้เด่นกว่าตัวอื่น
                if p.id == "ollamalocal" then Sk(chip, "AC", 1, 0.4) end
                provChips[p.id] = chip
                totalW = totalW + w + 4
        end
        provScroll.CanvasSize = UDim2.fromOffset(math.floor(totalW) + 4, 0)

        -- ─── Base URL — ระบบเลือกโมเดล/แชทดึงจาก URL นี้ทั้งหมด ───
        local baseRow = Instance.new("Frame", apiCard1)
        baseRow.Size = UDim2.new(1, -16, 0, 24)
        baseRow.Position = UDim2.fromOffset(8, 106)
        baseRow.BackgroundTransparency = 1; baseRow.ZIndex = 15

        local baseBox = Instance.new("TextBox", baseRow)
        baseBox.Size = UDim2.new(1, 0, 1, 0)
        baseBox.BackgroundColor3 = C.CD; baseBox.BorderSizePixel = 0
        baseBox.Text = (type(S.baseURL) == "string" and #S.baseURL > 3) and S.baseURL or EP.DEFAULT
        baseBox.PlaceholderText = "🖥️ Base URL — เลือกด้านบน หรือพิมพ์เอง (เช่น http://192.168.1.50:11434)"
        baseBox.TextColor3 = C.T1; baseBox.PlaceholderColor3 = C.T2
        baseBox.Font = Enum.Font.Code; baseBox.TextSize = 9
        baseBox.TextTruncate = Enum.TextTruncate.AtEnd
        baseBox.ZIndex = 16; baseBox.ClearTextOnFocus = false
        themed(baseBox, "BackgroundColor3", "CD")
        themed(baseBox, "TextColor3", "T1")
        Instance.new("UICorner", baseBox).CornerRadius = UDim.new(0, 6)

        -- (FocusLost ของ baseBox ต่ออยู่ด้านล่าง หลัง refreshProviderUI — ใช้ร่วมกับชิปค่าย)

        -- ─── ลำดับคีย์ (ไม่มีโหมดให้เลือก — ใช้ตามลำดับตายตัว) ───
        --   🖥️ โหมด Local AI: ไม่ต้องใช้คีย์ → สลับข้อความเป็นคำแนะนำ (เน้นให้ใช้ได้เลย)
        local orderLbl = Lk(apiCard1, "ลำดับคีย์: ใช้ #1 จนติดลิมิต → ข้ามไป #2 → #3 ... (สลับให้เอง)",
                UDim2.new(1, -16, 0, 14), UDim2.fromOffset(8, 134), 8, RF, "T2", Enum.TextXAlignment.Left, 15)

        -- ─── ช่องคีย์ 10 ช่อง + จุดสถานะ ───
        local keyRows = {}
        for i = 1, MAX_KEYS do
                local y = 152 + (i - 1) * 26
                local row = Instance.new("Frame", apiCard1)
                row.Name = "KeyRow_" .. i
                row.Size = UDim2.new(1, -16, 0, 24)
                row.Position = UDim2.fromOffset(8, y)
                row.BackgroundTransparency = 1; row.ZIndex = 15

                local dot = Instance.new("Frame", row)
                dot.Size = UDim2.fromOffset(8, 8)
                dot.Position = UDim2.new(0, 2, 0.5, -4)
                dot.BackgroundColor3 = C.T2; dot.BorderSizePixel = 0; dot.ZIndex = 16
                dot.BackgroundTransparency = 0.35
                Instance.new("UICorner", dot).CornerRadius = UDim.new(1, 0)

                Lk(row, "#" .. i, UDim2.fromOffset(16, 14), UDim2.fromOffset(14, 5), 9, BF, "T2", Enum.TextXAlignment.Left, 16)

                local box = Instance.new("TextBox", row)
                box.Size = UDim2.new(1, -76, 1, -2)
                box.Position = UDim2.fromOffset(34, 1)
                box.BackgroundColor3 = C.CD; box.BorderSizePixel = 0
                box.PlaceholderText = "API key " .. i
                box.Text = S.keys[i] or ""
                box.TextColor3 = C.T1; box.PlaceholderColor3 = C.T2
                box.Font = Enum.Font.Code; box.TextSize = 9
                box.TextTruncate = Enum.TextTruncate.AtEnd
                box.ZIndex = 16; box.ClearTextOnFocus = false
                themed(box, "BackgroundColor3", "CD")
                themed(box, "TextColor3", "T1")
                Instance.new("UICorner", box).CornerRadius = UDim.new(0, 6)

                local st = Lk(row, "—", UDim2.fromOffset(38, 14), UDim2.new(1, -38, 0.5, -7), 8, BF, "T2", Enum.TextXAlignment.Center, 16)

                local idx = i
                box.FocusLost:Connect(function()
                        if type(box.Text) == "string" then
                                S.keys[idx] = box.Text:gsub("%s+", "")
                        end
                        saveKeys()
                        if UIX.updateKeyDots then UIX.updateKeyDots() end
                end)

                keyRows[i] = { row = row, dot = dot, box = box, st = st }
        end

        -- ─── 🖥️ LOCAL PANEL — ใช้แทนระบบคีย์ทั้งหมดเมื่อเป็น Local AI ───
        --   (ตามคำสั่งเจ้าของ: โหมด local = ปิดระบบคีย์ไปเลย ไม่มีช่องคีย์ให้เห็น)
        local localPanel = Instance.new("Frame", apiCard1)
        localPanel.Name = "LocalPanel"
        localPanel.Size = UDim2.new(1, -16, 0, 84)
        localPanel.Position = UDim2.fromOffset(8, 96)
        localPanel.BackgroundColor3 = C.CD; localPanel.BorderSizePixel = 0
        localPanel.ZIndex = 15; localPanel.Visible = false
        themed(localPanel, "BackgroundColor3", "CD")
        Instance.new("UICorner", localPanel).CornerRadius = UDim.new(0, 8)
        Sk(localPanel, "AC", 1, 0.35)

        Lk(localPanel, "🖥️  Local AI — Ollama ในเครื่อง ไม่ต้องใช้คีย์", UDim2.new(1, -16, 0, 14), UDim2.fromOffset(10, 8), 9, BF, "T1", Enum.TextXAlignment.Left, 16)
        local localStatLbl = Lk(localPanel, "ยังไม่เชื่อมต่อ — กด 🔗 Connect ได้เลย ไม่ต้องใส่คีย์", UDim2.new(1, -16, 0, 26), UDim2.fromOffset(10, 24), 8, RF, "T2", Enum.TextXAlignment.Left, 16)
        localStatLbl.TextWrapped = true
        local localHintLbl = Lk(localPanel, "💡 เปิดแอป Ollama ทิ้งไว้ที่เครื่องนี้ · เล่นคนละเครื่อง → พิมพ์ IP เครื่องที่รัน Ollama ในช่อง Base URL เช่น http://192.168.1.50:11434", UDim2.new(1, -16, 0, 30), UDim2.fromOffset(10, 50), 8, RF, "T2", Enum.TextXAlignment.Left, 16)
        localHintLbl.TextWrapped = true

        -- อัปเดตแถบสถานะของแผง local (เรียกจาก doConnect ตอนต่อสำเร็จ/ล้ม)
        UIX.setLocalStat = function(txt, col)
                pcall(function()
                        if type(txt) == "string" and #txt > 0 then localStatLbl.Text = txt end
                        localStatLbl.TextColor3 = col or C.T2
                end)
        end

        -- ─── สถานะ + ปุ่ม Connect ───
        local statusLbl = Lk(apiCard1, "● Disconnected", UDim2.new(1, -118, 0, 20), UDim2.fromOffset(10, 418), 10, BF, "T2", Enum.TextXAlignment.Left, 15)
        local connBtn = mkBtn(apiCard1, "🔗  Connect All", UDim2.fromOffset(106, 28), UDim2.new(1, -114, 0, 414), "accent", 10, 16)

        local creditLbl = Lk(apiCard1, "🌐  API: — (กด Connect All เพื่อตรวจ)", UDim2.new(1, -16, 0, 14), UDim2.fromOffset(10, 448), 8, RF, "T2", Enum.TextXAlignment.Left, 15)
        creditLbl.TextTruncate = Enum.TextTruncate.AtEnd

        local footLbl = Lk(apiCard1, "SEBAS " .. VERSION_TAG .. " · LOCAL · OLLAMA · OPENROUTER · by IKKYU", UDim2.new(1, -16, 0, 12), UDim2.fromOffset(10, 464), 8, RF, "T2", Enum.TextXAlignment.Left, 15)

        -- ─── updateKeyDots: จุดสถานะแต่ละคีย์ ───
        local function updateKeyDots()
                for i = 1, MAX_KEYS do
                        local r = keyRows[i]
                        if r then
                                local isActive = i <= S.activeKeys
                                local hasKey = (type(S.keys[i]) == "string" and #S.keys[i] >= 10)
                                        or (i == 1 and EP.isLocal() and S.connected)
                                local err = S.keyErr[i]
                                local dry = S.keyDry[i]

                                r.box.BackgroundTransparency = isActive and 0 or 0.55
                                r.box.TextTransparency = isActive and 0 or 0.45
                                r.box.TextColor3 = isActive and C.T1 or C.T2

                                if not isActive then
                                        r.dot.BackgroundColor3 = C.BD; r.dot.BackgroundTransparency = 0.5
                                        r.st.Text = "off"; r.st.TextColor3 = C.T2
                                elseif not hasKey then
                                        r.dot.BackgroundColor3 = C.T2; r.dot.BackgroundTransparency = 0.35
                                        r.st.Text = "—"; r.st.TextColor3 = C.T2
                                elseif err == "429" or (dry and tick() < dry) then
                                        r.dot.BackgroundColor3 = C.WN; r.dot.BackgroundTransparency = 0
                                        r.st.Text = "⏳"; r.st.TextColor3 = C.WN
                                elseif err == "srv" then
                                        -- เซิร์ฟเวอร์สะดุดชั่วคราว (เน็ต/5xx) — ไม่ใช่คีย์เสีย
                                        r.dot.BackgroundColor3 = C.WN; r.dot.BackgroundTransparency = 0
                                        r.st.Text = "srv"; r.st.TextColor3 = C.WN
                                elseif err then
                                        r.dot.BackgroundColor3 = C.NO; r.dot.BackgroundTransparency = 0
                                        r.st.Text = err; r.st.TextColor3 = C.NO
                                elseif S.keyOk[i] then
                                        if i == (tonumber(S.curKey) or 1) then
                                                -- คีย์ที่กำลังใช้อยู่ตอนนี้ (ตามลำดับ)
                                                r.dot.BackgroundColor3 = C.AC; r.dot.BackgroundTransparency = 0
                                                r.st.Text = "▶"; r.st.TextColor3 = C.AC
                                        else
                                                r.dot.BackgroundColor3 = C.OK; r.dot.BackgroundTransparency = 0
                                                r.st.Text = "✓"; r.st.TextColor3 = C.OK
                                        end
                                else
                                        r.dot.BackgroundColor3 = C.T2; r.dot.BackgroundTransparency = 0.35
                                        r.st.Text = "—"; r.st.TextColor3 = C.T2
                                end
                        end
                end
        end
        updateKeyDots()

        -- ─── applyModeLayout: 🖥️ Local AI = ปิดระบบคีย์ทั้งหมด · ☁️ คลาวด์ = คืนระบบคีย์ ───
        --   local:  ซ่อน slider จำนวนคีย์ + ป้ายลำดับคีย์ + ช่องคีย์ทั้ง 10 ช่อง
        --           โชว์แผงสถานะ Local AI แทน แล้วย่อการ์ดให้กระชับ
        --   cloud:  คืนทุกอย่างตามเลย์เอาต์เดิม
        local CARD_H_CLOUD, CARD_H_LOCAL = 486, 262
        local function applyModeLayout()
                local isL = EP.isLocal() == true
                skRow.Visible = not isL
                orderLbl.Visible = not isL
                for i = 1, MAX_KEYS do
                        local r = keyRows[i]
                        if r then r.row.Visible = not isL end
                end
                localPanel.Visible = isL
                provLbl.Position = UDim2.fromOffset(8, isL and 18 or 60)
                provScroll.Position = UDim2.fromOffset(8, isL and 32 or 74)
                baseRow.Position = UDim2.fromOffset(8, isL and 64 or 106)
                connBtn.Position = UDim2.new(1, -114, 0, isL and 188 or 414)
                statusLbl.Position = UDim2.fromOffset(10, isL and 192 or 418)
                creditLbl.Position = UDim2.fromOffset(10, isL and 222 or 448)
                footLbl.Position = UDim2.fromOffset(10, isL and 238 or 464)
                connBtn.Text = isL and "🔗  Connect Local AI" or "🔗  Connect All"
                apiCard1.Size = UDim2.new(1, -3, 0, isL and CARD_H_LOCAL or CARD_H_CLOUD)
                if isL then
                        if S.connected and type(S.localStatTxt) == "string" and #S.localStatTxt > 0 then
                                UIX.setLocalStat(S.localStatTxt, C.OK)
                        else
                                UIX.setLocalStat("ยังไม่เชื่อมต่อ — กด 🔗 Connect ได้เลย ไม่ต้องใส่คีย์", C.T2)
                        end
                end
        end
        applyModeLayout()

        connBtn.MouseButton1Click:Connect(function()
                if doConnect then doConnect() end
        end)

        -- ─── refreshKeyStatus: ตรวจคีย์ใหม่แบบเงียบ (real-time background) ───
        --   เรียกจาก maintenance loop ทุก 60s + หลัง callAI เจอ error
        --   อัปเดตจุดสถานะ/pill/status label ตามผลตรวจล่าสุดทันที
        --   ★ ประหยัดโควตาคลาวด์: ถ้าเพิ่งคุยสำเร็จไป (120 วิ) = คีย์+เซิร์ฟเวอร์ใช้ได้แน่ ๆ
        --     → ข้ามการตรวจเลย (เดิมยิง /tags ทุกคีย์ทุก 60 วิ + เครดิตอีกรอบทุก 300 วิ
        --       จนกินโควตา rate-limit ของคลาวด์ → แชทไปติด 429 จริงจัง ทั้งที่คีย์ปกติ)
        UIX.refreshKeyStatus = function(silent)
                if not S.connected then return end
                -- 🖥️ Local AI: ปิดระบบคีย์ — ตรวจเซิร์ฟเวอร์แบบเงียบแทน (ไม่ยุ่งกับคีย์)
                if EP.isLocal() then
                        task.spawn(function()
                                local okL = localProbe()
                                if okL then
                                        UIX.statusLbl.Text = "● Connected ✓ (Local AI)"
                                        UIX.statusLbl.TextColor3 = C.OK
                                else
                                        S.connected = false
                                        UIX.statusLbl.Text = "● Local AI ต่อไม่ได้ — เซิร์ฟเวอร์ไม่ตอบ"
                                        UIX.statusLbl.TextColor3 = C.NO
                                        pillDot.BackgroundColor3 = C.NO
                                        if UIX.setLocalStat then
                                                UIX.setLocalStat("❌ หลุดการเชื่อมต่อ — เซิร์ฟเวอร์ไม่ตอบ กด Connect ใหม่", C.NO)
                                        end
                                end
                                if updateHUD then pcall(updateHUD) end
                        end)
                        return
                end
                -- ☁️ คลาวด์: เพิ่งคุยสำเร็จ → ไม่ต้องตรวจ (คีย์ใช้ได้แน่นอน + ประหยัดโควตา)
                if S.lastOKT and (tick() - S.lastOKT) < 120 then return end
                local actN = math.clamp(tonumber(S.activeKeys) or 1, 1, MAX_KEYS)
                local filled = 0
                for i = 1, actN do
                        if type(S.keys[i]) == "string" and #S.keys[i] >= 10 then filled = filled + 1 end
                end
                if filled == 0 then return end
                task.spawn(function()
                        local okN, limN, badN = 0, 0, 0
                        for i = 1, actN do
                                local k = S.keys[i]
                                if type(k) == "string" and #k >= 10 then
                                        local ok, info, code = fastTest(k)
                                        if ok then
                                                okN = okN + 1
                                                S.keyOk[i] = true; S.keyErr[i] = nil; S.keyDry[i] = nil
                                        elseif code == "429" then
                                                -- ★ 429 = คีย์ถูกต้อง แค่ติดลิมิตชั่วคราว (ลิมิตมีผลเฉพาะ
                                                --   คีย์ที่ยืนยันตัวแล้ว) — ห้ามตำราว่า bad/ตัดการเชื่อมต่อ
                                                limN = limN + 1
                                                S.keyErr[i] = "429"
                                                S.keyDry[i] = tick() + 30
                                        elseif code == "401" or code == "403" or code == "402" then
                                                badN = badN + 1
                                                S.keyOk[i] = false
                                                S.keyErr[i] = code == "402" and "402$" or code
                                        else
                                                -- NET / 404 / 5xx = ปัญหาฝั่งเซิร์ฟเวอร์ — ไม่โทษคีย์
                                                S.keyErr[i] = "srv"
                                        end
                                        if UIX.updateKeyDots then UIX.updateKeyDots() end
                                end
                        end
                        -- ★ ตัดการเชื่อมต่อเฉพาะ "คีย์เสียจริงทุกดอก" (401/403/402) เท่านั้น
                        --   ติดลิมิต/เซิร์ฟเวอร์สะดุด ≠ คีย์เสีย (เดิมโทษทุกกรณี → สถานะแดง
                        --   "ทุกคีย์ใช้ไม่ได้" + ตัดการเชื่อมต่อ ทั้งที่คีย์ปกติ)
                        if badN > 0 and okN == 0 and limN == 0 and badN >= filled then
                                S.connected = false; S.key = ""
                                UIX.statusLbl.Text = "● ทุกคีย์ใช้ไม่ได้ (เช็คคีย์ใหม่)"
                                UIX.statusLbl.TextColor3 = C.NO
                                pillDot.BackgroundColor3 = C.NO
                        elseif okN > 0 then
                                UIX.statusLbl.Text = "● Connected ✓ (" .. okN .. "/" .. filled .. " keys · live)"
                                UIX.statusLbl.TextColor3 = C.OK
                        elseif limN > 0 then
                                UIX.statusLbl.Text = "● Connected ✓ (ติดลิมิตชั่วคราว — พักสักครู่)"
                                UIX.statusLbl.TextColor3 = C.WN
                        else
                                UIX.statusLbl.Text = "● เซิร์ฟเวอร์ไม่ตอบชั่วคราว (คีย์ยังใช้ได้)"
                                UIX.statusLbl.TextColor3 = C.WN
                        end
                        if updateHUD then pcall(updateHUD) end
                        if not silent and okN > 0 then SND.play("success") end
                end)
        end

        UIX.keyRows = keyRows
        UIX.statusLbl = statusLbl
        UIX.connBtn = connBtn
        UIX.creditLbl = creditLbl
        UIX.updateKeyDots = updateKeyDots
        UIX.keyBox = keyRows[1].box

        -- ─── refreshProviderUI: หน้าตาทั้งการ์ดตามตัวเลือกปัจจุบัน (ชิป/placeholder/เครดิต) ───
        local function refreshProviderUI()
                local cur = EP.provider()
                baseBox.Text = (type(S.baseURL) == "string" and #S.baseURL > 3) and S.baseURL or EP.base()
                -- 🖥️ Local AI: ป้ายกลางการ์ดบอกว่าไม่ต้องใช้คีย์ (เน้นให้ใช้ได้ทันที)
                orderLbl.Text = EP.isLocal()
                        and "🖥️ Local AI — Ollama ในเครื่อง ไม่ต้องใช้คีย์ กด Connect All ได้เลย"
                        or "ลำดับคีย์: ใช้ #1 จนติดลิมิต → ข้ามไป #2 → #3 ... (สลับให้เอง)"
                for i = 1, MAX_KEYS do
                        local r = keyRows[i]
                        if r then
                                if EP.isLocal() then
                                        r.box.PlaceholderText = "Ollama ในเครื่อง — ไม่ต้องใส่คีย์"
                                elseif cur and cur.keyurl then
                                        r.box.PlaceholderText = "API key " .. i .. " (" .. cur.keyurl .. ")"
                                else
                                        r.box.PlaceholderText = "API key " .. i
                                end
                        end
                end
                for pid, ch in pairs(provChips) do
                        local active = cur and cur.id == pid
                        ch.BackgroundColor3 = active and C.AC or C.CD
                        ch.TextColor3 = active and Color3.fromRGB(255, 255, 255) or C.T1
                end
                creditLbl.Text = (cur and (cur.icon .. "  " .. cur.name) or (EP.isLocal() and "🖥️  Local AI" or "🌐  Custom API"))
                        .. ": — (กด Connect All เพื่อตรวจ)"
                -- 🖥️ Local AI: ปิดระบบคีย์ทั้งหมด (ซ่อน slider/ช่องคีย์ โชว์แผง local แทน)
                applyModeLayout()
                -- ปุ่ม Auto: local → กลายเป็นปุ่มต่อ Local AI (ไม่ต้องสร้างคีย์)
                if UIX.setAutoKeyBtn then UIX.setAutoKeyBtn() end
                -- แถว "พิมพ์ชื่อโมเดลเอง" (การ์ด AI MODEL) โชว์เฉพาะ Local AI
                --   (การ์ดสร้างทีหลังฟังก์ชันนี้ — กันครั้งแรกที่ยังไม่มี)
                if UIX.setLocalModelUI then UIX.setLocalModelUI() end
        end

        -- ─── applyProvider: กดชิป → สลับ Base URL + ล้างแคชโมเดล + รีเฟรชการ์ด ───
        local function applyProvider(p)
                if p then
                        S.baseURL = p.url == EP.DEFAULT and "" or p.url
                        saveSettings()
                end
                -- สลับค่าย = ต้องต่อใหม่ (ล้างสถานะเดิม + ล้างแคชโมเดลของค่ายเดิม)
                S.connected = false; S.localStatTxt = nil
                if updateHUD then pcall(updateHUD) end
                OR.models = {}; OR.lastFetch = 0
                refreshProviderUI()
                if UIX.updateKeyDots then UIX.updateKeyDots() end
                if p then
                        notify("🌐 Provider", "สลับเป็น " .. p.icon .. " " .. p.name .. " — กด Connect เพื่อใช้งาน", "ok")
                        SND.play("success")
                end
        end

        -- กดชิป = เลือก provider (Base URL เปลี่ยนตาม โมเดลดึงสดใหม่)
        for _, p in ipairs(PROVIDERS) do
                local chip = provChips[p.id]
                if chip then
                        chip.MouseButton1Click:Connect(function()
                                SND.play("click")
                                applyProvider(p)
                        end)
                end
        end

        -- พิมพ์ Base URL เอง → บันทึก + รีเฟรชชิป/placeholder ตามค่าที่พิมพ์
        baseBox.FocusLost:Connect(function()
                if type(baseBox.Text) ~= "string" then return end
                local nb = baseBox.Text:gsub("%s+", ""):gsub("/+$", "")
                local old = EP.base()
                baseBox.Text = #nb > 3 and nb or EP.DEFAULT
                S.baseURL = baseBox.Text == EP.DEFAULT and "" or baseBox.Text
                saveSettings()
                if nb ~= old and #nb > 3 then
                        -- เปลี่ยน Base URL → ล้างแคชโมเดลเดิม + สถานะ local ให้ดึง/ต่อใหม่จาก URL ใหม่
                        S.localStatTxt = nil
                        OR.models = {}; OR.lastFetch = 0
                        refreshProviderUI()
                        notify("🌐 Base URL", "บันทึกแล้ว — กด Connect เพื่อใช้งาน", "ok")
                        SND.play("success")
                end
        end)

        refreshProviderUI()
        UIX.refreshProviderUI = refreshProviderUI
end

-- ─── AI MODEL card ───
do
        local apiCard2 = mkCard(pgAPI, 86, 2)
        mkLabel(apiCard2, "AI MODEL", 4)
        local currentModelLbl = Lk(apiCard2, "Current: " .. S.currentModel, UDim2.new(1, -16, 0, 14), UDim2.fromOffset(10, 20), 9, RF, "AC", Enum.TextXAlignment.Left, 15)
        currentModelLbl.TextTruncate = Enum.TextTruncate.AtEnd
        local modelBtn = mkBtn(apiCard2, "🤖  Select Model  ·  ดึงสดจาก Base URL", UDim2.new(1, -16, 0, 30), UDim2.fromOffset(8, 40), "soft", 10, 16)
        modelBtn.MouseButton1Click:Connect(function()
                if UIX.openModelSelector then UIX.openModelSelector() end
        end)
        UIX.currentModelLbl = currentModelLbl
        modelBtn.Name = "ModelBtn"
        UIX.modelBtn = modelBtn

        -- ─── ✏️ พิมพ์ชื่อโมเดลเอง — แสดงเฉพาะโหมด Local AI ───
        --   (Ollama เครื่องตัวเอง / LM Studio / llama.cpp ฯลฯ)
        --   ใช้กรณีรายการโมเดลดึงมาไม่ครบ หรืออยากระบุชื่อเองเลย
        local manRow = Instance.new("Frame", apiCard2)
        manRow.Name = "ManualModelRow"
        manRow.Size = UDim2.new(1, -16, 0, 30)
        manRow.Position = UDim2.fromOffset(8, 74)
        manRow.BackgroundTransparency = 1; manRow.ZIndex = 15
        manRow.Visible = false

        local manBox = Instance.new("TextBox", manRow)
        manBox.Name = "ManualModelBox"
        manBox.Size = UDim2.new(1, -68, 1, 0)
        manBox.BackgroundColor3 = C.CD; manBox.BorderSizePixel = 0
        manBox.PlaceholderText = "✏️  ชื่อโมเดลของ AI ในเครื่อง เช่น llama3.2"
        manBox.Text = ""; manBox.TextColor3 = C.T1; manBox.PlaceholderColor3 = C.T2
        manBox.Font = Enum.Font.Code; manBox.TextSize = 9
        manBox.TextTruncate = Enum.TextTruncate.AtEnd
        manBox.ZIndex = 16; manBox.ClearTextOnFocus = false
        themed(manBox, "BackgroundColor3", "CD")
        themed(manBox, "TextColor3", "T1")
        Instance.new("UICorner", manBox).CornerRadius = UDim.new(0, 6)
        Sk(manBox, "BD", 1, 0.45)

        local manBtn = mkBtn(manRow, "✓  ใช้", UDim2.fromOffset(60, 30), UDim2.new(1, -60, 0, 0), "accent", 10, 16)
        manBtn.Name = "ManualModelBtn"

        -- ใช้ชื่อโมเดลที่พิมพ์เอง (แก้ S.currentModel + MODEL + บันทึก + แจ้งเตือน)
        --   ใช้ร่วมกับ modal เลือกโมเดล (p09) — เรียกผ่าน UIX.applyManualModel
        UIX.applyManualModel = function(t)
                if type(t) ~= "string" then return false end
                t = t:gsub("%s+", "")
                if #t < 1 then
                        notify("✏️ Model", "พิมพ์ชื่อโมเดลก่อนกดใช้", "warn")
                        SND.play("error")
                        return false
                end
                S.currentModel = t; MODEL = t
                UIX.currentModelLbl.Text = "Current: " .. t
                saveSettings()
                notify("✏️ Model", "ใช้โมเดล (พิมพ์เอง): " .. t, "ok")
                SND.play("success")
                if updateHUD then pcall(updateHUD) end
                return true
        end

        manBtn.MouseButton1Click:Connect(function()
                UIX.applyManualModel(tostring(manBox.Text or ""))
        end)
        manBox.FocusLost:Connect(function(enter)
                if enter then UIX.applyManualModel(tostring(manBox.Text or "")) end
        end)

        -- ซ่อน/โชว์แถวพิมพ์เองตามโหมด Local + ปรับความสูงการ์ดให้พอดี
        UIX.setLocalModelUI = function()
                local isL = EP.isLocal()
                manRow.Visible = isL
                apiCard2.Size = UDim2.new(1, -3, 0, isL and 120 or 86)
                if isL then manBox.Text = S.currentModel end
        end
        UIX.setLocalModelUI()
end

-- ─── HTTP DEBUG + AUTO SETUP ───
do
        local dbCard = mkCard(pgAPI, 122, 3)
        mkLabel(dbCard, "CONNECTION TOOLS", 4)

        local dbStatusLbl = Lk(dbCard, "Press Test to check HTTP support", UDim2.new(1, -16, 0, 26), UDim2.fromOffset(10, 18), 9, RF, "T2", Enum.TextXAlignment.Left, 15)
        dbStatusLbl.TextWrapped = true

        local dbBtn = mkBtn(dbCard, "🔍  Test HTTP", UDim2.new(1, -16, 0, 28), UDim2.fromOffset(8, 44), "ghost", 10, 16)
        dbBtn.MouseButton1Click:Connect(function()
                dbStatusLbl.Text = "⏳ Testing..."; dbStatusLbl.TextColor3 = C.WN
                task.spawn(function()
                        if not Http then
                                dbStatusLbl.Text = "❌ No HTTP function"; dbStatusLbl.TextColor3 = C.NO
                                return
                        end
                        local key = (type(UIX.keyBox.Text) == "string" and UIX.keyBox.Text or ""):gsub("%s+", "")
                        -- ทดสอบยิงที่ Base URL จริง: มีคีย์/โหมด OpenAI-compat → /models · ไม่มี → /version (Ollama)
                        local testUrl = (#key >= 10 or EP.oai()) and EP.tags() or EP.ver()
                        local headers = {}
                        if #key >= 10 then headers["Authorization"] = "Bearer " .. key end
                        local ok, res = pcall(Http, { Url = testUrl, Method = "GET", Headers = headers })
                        local rr = normRes(res)
                        if ok and rr and rr.status > 0 then
                                local s = rr.status
                                if s == 200 then
                                        dbStatusLbl.Text = "✅ HTTP OK — Base URL ตอบสนอง" .. (#key >= 10 and " · key #1 ใช้ได้!" or "!"); dbStatusLbl.TextColor3 = C.OK
                                elseif s == 401 then
                                        dbStatusLbl.Text = "✅ HTTP OK — key invalid (401)"; dbStatusLbl.TextColor3 = C.WN
                                elseif s == 429 then
                                        dbStatusLbl.Text = "✅ HTTP OK — rate limited (คีย์ถูกต้อง)"; dbStatusLbl.TextColor3 = C.WN
                                else
                                        dbStatusLbl.Text = "⚠️ HTTP sent — status " .. tostring(s); dbStatusLbl.TextColor3 = C.WN
                                end
                        else
                                dbStatusLbl.Text = "❌ HTTP call failed"; dbStatusLbl.TextColor3 = C.NO
                        end
                end)
        end)

        local autoBtn = mkBtn(dbCard, "⚡  Auto Create API Key", UDim2.new(1, -16, 0, 28), UDim2.fromOffset(8, 78), "accent", 10, 16)
        autoBtn.Name = "AutoKeyBtn"
        -- 🖥️ Local AI: ปุ่มนี้กลายเป็น "ต่อ Local AI" — ไม่ต้องสร้างคีย์
        UIX.setAutoKeyBtn = function()
                autoBtn.Text = EP.isLocal() and "🖥️  ต่อ Local AI (ไม่ต้องใช้คีย์)" or "⚡  Auto Create API Key"
        end
        UIX.setAutoKeyBtn()
        autoBtn.MouseButton1Click:Connect(function()
                if EP.isLocal() then
                        if doConnect then doConnect() end
                else
                        if UIX.startAutoKey then UIX.startAutoKey() end
                end
        end)
end

end -- part wrap


-- ═══════════════════════════════════════════════════════════════
-- PAGE: CHAT (direct chat — ไม่จำกัดระยะ)
-- ═══════════════════════════════════════════════════════════════
do
        local pgChat = makePage("chat")
        local TS = game:GetService("TextService")

        local chatLog, lastReply, chatBusy = {}, "", false
        local CUID = "DIRECT_CHAT_TAB"

        -- ⚠ FIX "ต้องเลื่อนลงจนสุดหน้าถึงจะพิมพ์ได้": หน้าแชทเปลี่ยนเป็นเลย์เอาต์ตายตัว
        --   การ์ดเดียวเต็มหน้า — แถวพิมพ์/สถานะ/ปุ่ม action ปักไว้ล่างสุดของการ์ดเสมอ
        --   (ตามขนาดหน้าต่างอัตโนมัติ) ส่วนข้อความเลื่อนข้างในการ์ดเท่านั้น
        for _, ch in ipairs(pgChat:GetChildren()) do
                if ch:IsA("UIListLayout") or ch:IsA("UIPadding") then ch:Destroy() end
        end
        pgChat.ScrollingEnabled = false
        pgChat.AutomaticCanvasSize = Enum.AutomaticSize.None
        pgChat.CanvasSize = UDim2.new()

        local chatMsgCard = mkCard(pgChat, 316, 1)
        chatMsgCard.ClipsDescendants = true
        chatMsgCard.Position = UDim2.fromOffset(8, 6)
        chatMsgCard.Size = UDim2.new(1, -16, 1, -16)     -- เต็มหน้า (ความสูง 316 ถูก override)
        mkLabel(chatMsgCard, "CONVERSATION", 4)

        local chatScroll = Instance.new("ScrollingFrame", chatMsgCard)
        chatScroll.Size = UDim2.new(1, -6, 1, -110)      -- เหนือแถวพิมพ์ที่ปักล่างการ์ด
        chatScroll.Position = UDim2.fromOffset(3, 18)
        chatScroll.BackgroundTransparency = 1
        chatScroll.ScrollBarThickness = 3
        chatScroll.ScrollBarImageColor3 = C.BD
        chatScroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
        chatScroll.CanvasSize = UDim2.new()
        chatScroll.ZIndex = 15
        chatScroll.ClipsDescendants = true
        chatScroll.ElasticBehavior = Enum.ElasticBehavior.Never
        local cLL = Instance.new("UIListLayout", chatScroll)
        cLL.Padding = UDim.new(0, 5); cLL.SortOrder = Enum.SortOrder.LayoutOrder
        local cPad = Instance.new("UIPadding", chatScroll)
        cPad.PaddingTop = UDim.new(0, 2); cPad.PaddingBottom = UDim.new(0, 4)
        cPad.PaddingLeft = UDim.new(0, 2); cPad.PaddingRight = UDim.new(0, 2)

        local function bubbleH(text, isAI)
                local w = math.max(140, chatMsgCard.AbsoluteSize.X - 40)
                local ok, sz = pcall(function()
                        return TS:GetTextSize(text, 10, RF, Vector2.new(w - 28, 9999))
                end)
                local th = (ok and sz and sz.Y) or 18
                return math.max(46, th + (isAI and 40 or 26))
        end

        local bCount = 0
        local function addBubble(role, text)
                bCount = bCount + 1
                local isAI = role == "ai"
                local h = bubbleH(text, isAI)

                local bub = Instance.new("Frame", chatScroll)
                bub.Size = UDim2.new(1, -4, 0, h)
                bub.BackgroundColor3 = isAI and C.CD or C.AC
                bub.BorderSizePixel = 0
                bub.ZIndex = 16
                bub.LayoutOrder = bCount
                bub.ClipsDescendants = true
                themed(bub, "BackgroundColor3", isAI and "CD" or "AC")
                Instance.new("UICorner", bub).CornerRadius = UDim.new(0, 9)

                local who = L(bub, isAI and "🤖 Sebas" or "👤 You", UDim2.new(1, -8, 0, 13), UDim2.fromOffset(8, 4), 8, BF,
                        isAI and C.AC or Color3.fromRGB(255, 255, 255), Enum.TextXAlignment.Left, 17)
                if isAI then themed(who, "TextColor3", "AC") end

                local body = L(bub, text, UDim2.new(1, isAI and -64 or -14, 1, -20), UDim2.fromOffset(8, 18), 10, RF,
                        isAI and C.T1 or Color3.fromRGB(255, 255, 255), Enum.TextXAlignment.Left, 17)
                body.TextWrapped = true
                body.TextYAlignment = Enum.TextYAlignment.Top
                if isAI then themed(body, "TextColor3", "T1") end

                if isAI then
                        local cp = mkBtn(bub, "📋 Copy", UDim2.fromOffset(50, 20), UDim2.new(1, -56, 0, 4), "ghost", 7, 18)
                        local cap = text
                        cp.MouseButton1Click:Connect(function()
                                pcall(function()
                                        if setclipboard then
                                                setclipboard(cap)
                                                cp.Text = "✓"
                                                cp.BackgroundColor3 = C.OK
                                                cp.TextColor3 = C.WIN
                                                SND.play("success")
                                                task.delay(1.8, function() pcall(function()
                                                        cp.Text = "📋 Copy"
                                                end) end)
                                        end
                                end)
                        end)
                end

                -- bubble เด้งเข้าแบบสไลด์สั้น ๆ
                bub.Position = UDim2.fromOffset(0, 4)
                ANIM.play(bub, { Position = UDim2.fromOffset(0, 0) },
                        { t = 0.18, style = Enum.EasingStyle.Quad, dir = Enum.EasingDirection.Out, tag = "bub" })

                task.defer(function() pcall(function()
                        local cs = chatScroll.AbsoluteCanvasSize.Y
                        local ws = chatScroll.AbsoluteWindowSize.Y
                        if cs > ws then chatScroll.CanvasPosition = Vector2.new(0, cs - ws) end
                end) end)
        end

        addBubble("ai", "Hey! I'm Sebas. Talk to me here directly — no range limit.")

        -- input row — ปักไว้ล่างสุดของการ์ด (Y ชี้จากขอบล่าง = ตามขนาดหน้าต่างเสมอ)
        local chatBox = Instance.new("TextBox", chatMsgCard)
        chatBox.Size = UDim2.new(1, -78, 0, 30)
        chatBox.Position = UDim2.new(0, 8, 1, -86)
        chatBox.BackgroundColor3 = C.CD; chatBox.BorderSizePixel = 0
        chatBox.PlaceholderText = "Message Sebas..."
        chatBox.Text = ""
        chatBox.TextColor3 = C.T1; chatBox.PlaceholderColor3 = C.T2
        chatBox.Font = RF; chatBox.TextSize = 10
        chatBox.ZIndex = 15; chatBox.ClearTextOnFocus = false
        chatBox.TextXAlignment = Enum.TextXAlignment.Left
        themed(chatBox, "BackgroundColor3", "CD")
        themed(chatBox, "TextColor3", "T1")
        Instance.new("UICorner", chatBox).CornerRadius = UDim.new(0, 8)
        Sk(chatBox, "BD", 1, 0.4)
        Instance.new("UIPadding", chatBox).PaddingLeft = UDim.new(0, 8)

        local chatSend = mkBtn(chatMsgCard, "Send ➤", UDim2.fromOffset(62, 30), UDim2.new(1, -70, 1, -86), "accent", 10, 16)
        local chatStat = Lk(chatMsgCard, "", UDim2.new(1, -16, 0, 14), UDim2.new(0, 8, 1, -52), 8, RF, "T2", Enum.TextXAlignment.Left, 15)

        -- actions row (ล่างสุดของการ์ด)
        local copyLastBtn = mkBtn(chatMsgCard, "📋  Copy Last Reply", UDim2.new(0.57, -6, 0, 26), UDim2.new(0, 8, 1, -34), "ghost", 9, 16)
        local clearBtn = mkBtn(chatMsgCard, "🗑️  Clear", UDim2.new(0.43, -6, 0, 26), UDim2.new(0.57, -2, 1, -34), "danger", 9, 16)

        local function doSend(raw)
                if chatBusy then return end
                local text = (raw or ""):match("^%s*(.-)%s*$") or ""
                if text == "" then return end
                if not S.connected then
                        chatStat.Text = "⚠️ Not connected — enter API key first."
                        chatStat.TextColor3 = C.NO
                        SND.play("error")
                        return
                end
                chatBusy = true; chatBox.Text = ""
                if EXTCTX.searchOn and needsSearch(text) then
                        chatStat.Text = "🔍 Searching web + typing..."; chatStat.TextColor3 = C.WN
                else
                        chatStat.Text = "✏️ Sebas is typing..."; chatStat.TextColor3 = C.WN
                end
                table.insert(chatLog, { role = "user", text = text })
                addBubble("user", text)
                SND.play("click")
                task.spawn(function()
                        local rep, err = callAI(text, CUID, "Chat", false, false, false)
                        chatBusy = false
                        if rep then
                                lastReply = rep
                                table.insert(chatLog, { role = "ai", text = rep })
                                addBubble("ai", rep)
                                chatStat.Text = "✓"; chatStat.TextColor3 = C.OK
                                SND.play("notify")
                                task.delay(2, function() pcall(function() chatStat.Text = "" end) end)
                        else
                                local m = err == "BUSY" and "AI busy." or err == "WAIT" and "Cooldown."
                                        or err == "NOKEY" and "No key." or err == "RATE" and "Rate limited."
                                        or ("Err: " .. tostring(err))
                                chatStat.Text = "❌ " .. m; chatStat.TextColor3 = C.NO
                                SND.play("error")
                        end
                end)
        end

        chatSend.MouseButton1Click:Connect(function() doSend(chatBox.Text) end)
        chatBox.FocusLost:Connect(function(ep) if ep then doSend(chatBox.Text) end end)

        copyLastBtn.MouseButton1Click:Connect(function()
                if lastReply == "" then return end
                pcall(function()
                        if setclipboard then
                                setclipboard(lastReply)
                                copyLastBtn.Text = "✓ Copied!"
                                copyLastBtn.BackgroundColor3 = C.OK
                                copyLastBtn.TextColor3 = C.WIN
                                SND.play("success")
                                task.delay(2, function() pcall(function()
                                        copyLastBtn.Text = "📋  Copy Last Reply"
                                end) end)
                        end
                end)
        end)

        clearBtn.MouseButton1Click:Connect(function()
                for _, ch in ipairs(chatScroll:GetChildren()) do
                        if ch:IsA("Frame") then ch:Destroy() end
                end
                chatLog = {}; bCount = 0; lastReply = ""
                clearPlayerHistory(CUID)
                addBubble("ai", "Chat cleared. What's up?")
        end)

        UIX.chatMsgCard = chatMsgCard
        UIX.copyLastBtn = copyLastBtn
end

-- ═══════════════════════════════════════════════════════════════
-- PAGE: CONTROLS
-- ═══════════════════════════════════════════════════════════════
do
        local pgCtrl = makePage("controls")

        local ctrlCard1 = mkCard(pgCtrl, 126, 1)
        mkLabel(ctrlCard1, "TOGGLES", 4)
        mkToggle(ctrlCard1, 18, "💬  Chat Enabled (auto-reply)", "chatOn")
        mkToggle(ctrlCard1, 52, "👁️  Auto Observe", "talkOn")
        mkToggle(ctrlCard1, 86, "🏷️  Name Prefix", "prefixName")

        local ctrlCard2 = mkCard(pgCtrl, 192, 2)
        mkLabel(ctrlCard2, "AI EXTENSIONS", 4)
        mkToggleX(ctrlCard2, 18, "🔍  Web Search (DDG)",
                function() return EXTCTX.searchOn end,
                function(v) EXTCTX.searchOn = v end)
        mkToggleX(ctrlCard2, 52, "👁️  Player Awareness",
                function() return EXTCTX.awarenessOn end,
                function(v) EXTCTX.awarenessOn = v end)
        mkToggleX(ctrlCard2, 86, "🎭  Room Context (bg chat)",
                function() return EXTCTX.roomOn end,
                function(v) EXTCTX.roomOn = v end)
        mkToggleX(ctrlCard2, 120, "🧠  Cross-Session Memory",
                function() return EXTCTX.memoryExtOn end,
                function(v) EXTCTX.memoryExtOn = v end)
        -- GAME CONTEXT — inventory ตัวเอง + ตำแหน่งผู้เล่น (lazy: เก็บสดเฉพาะตอนถูกถาม/พูดถึง)
        mkToggleX(ctrlCard2, 154, "🎮  Game Context (items+positions)",
                function() return EXTCTX.gameCtxOn end,
                function(v) EXTCTX.gameCtxOn = v end)

        local ctrlCard3 = mkCard(pgCtrl, 96, 3)
        mkLabel(ctrlCard3, "TIMING", 4)
        mkInput(ctrlCard3, 18, "⏱️  Response Delay (s)", "responseDelay", 0, 60)
        mkInput(ctrlCard3, 52, "👁️  Observe Interval (s)", "observeInterval", 5, 300)

        UIX.ctrlCard1 = ctrlCard1
end

-- ═══════════════════════════════════════════════════════════════
-- PAGE: SETTINGS
-- ═══════════════════════════════════════════════════════════════
do
        local pgSet = makePage("settings")

        local setCard = mkCard(pgSet, 164, 1)
        mkLabel(setCard, "GENERAL", 4)
        mkInput(setCard, 18, "📡  Range (studs · 0 = unlimited)", "range", 0, 9999, makeRing)
        mkInput(setCard, 52, "⏱️  API Cooldown (sec)", "cooldown", 0, 60)
        mkInput(setCard, 86, "🤚  Hold Duration (sec)", "holdDuration", 0.1, 10)
        -- ✂️ ความยาวคำตอบสูงสุดที่ส่งลงแชท (กันคำตอบยาวโดนหั่นเป็นหลายท่อน)
        mkInput(setCard, 120, "✂️  Max Reply Length (0 = no limit)", "maxReply", 0, 4000)

        local uiCard = mkCard(pgSet, 140, 2)
        mkLabel(uiCard, "INTERFACE", 4)

        mkToggleX(uiCard, 18, "🔊  UI Sounds",
                function() return S.soundOn == true end,
                function(v) S.soundOn = v; saveSettings() end)
        mkToggleX(uiCard, 52, "🎞️  Cover Flow Animations",
                function() return S.carAnim ~= false end,
                function(v) S.carAnim = v; saveSettings() end)

        local kbLbl = Lk(uiCard, "⌨️  Toggle GUI: press  [RShift]", UDim2.new(1, -16, 0, 14), UDim2.fromOffset(10, 88), 9, RF, "T2", Enum.TextXAlignment.Left, 15)

        local tutResetBtn = mkBtn(uiCard, "🎓  Replay Tutorial", UDim2.new(1, -16, 0, 24), UDim2.fromOffset(8, 106), "ghost", 9, 16)
        tutResetBtn.MouseButton1Click:Connect(function()
                if UIX.openTut then UIX.openTut() end
        end)

        local aboutCard = mkCard(pgSet, 64, 3)
        mkLabel(aboutCard, "ABOUT", 4)
        Lk(aboutCard, "SEBAS AI " .. VERSION_TAG .. " · Local AI · Ollama · OpenRouter", UDim2.new(1, -16, 0, 13), UDim2.fromOffset(10, 18), 8, RF, "T1", Enum.TextXAlignment.Left, 15)
        Lk(aboutCard, "by IKKYU — premium, smooth, lightweight, mobile-first", UDim2.new(1, -16, 0, 13), UDim2.fromOffset(10, 33), 8, RF, "T2", Enum.TextXAlignment.Left, 15)
        Lk(aboutCard, "ลาก: เส้นล่าง/แถบบน · ย่อ: ปุ่ม — · ขยาย: แตะ pill · ปรับขนาด: มุมซ้ายล่าง", UDim2.new(1, -16, 0, 13), UDim2.fromOffset(10, 47), 7, RF, "T2", Enum.TextXAlignment.Left, 15)

        UIX.setCard = setCard
end


-- ═══════════════════════════════════════════════════════════════
-- PAGE: MOOD (personality sliders)
-- ═══════════════════════════════════════════════════════════════
do
        local pgMood = makePage("mood")
        local moodCard = mkCard(pgMood, 226, 1)
        mkLabel(moodCard, "PERSONALITY SLIDERS", 4)
        mkSlider(moodCard, 18, "😊 Friendly", "friendly")
        mkSlider(moodCard, 56, "😂 Funny", "funny")
        mkSlider(moodCard, 94, "🤫 Quiet", "quiet")
        mkSlider(moodCard, 132, "🧠 Smart", "smart")
        mkSlider(moodCard, 170, "😤 Aggressive", "aggro")
