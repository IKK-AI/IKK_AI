        activeKeys = 1,
        curKey = 1,
        lastKeyIdx = 0,
        keyDry = {}, keyOk = {}, keyErr = {},
        creditsText = "",
        -- Sound system (persisted)
        -- SND_PRESET v7 = โวลุ่มเริ่มต้น 200% ทุกหมวด (ชุด ID เดิมที่ผู้ใช้จัดมา)
        --   Mixer ปรับ 0-200% ต่อหมวดได้ตามเดิม
        soundOn = true, sndMaster = 1.0,
        sndVol = {},   -- [cat] = 0..2 override (100% = ระดับต้นฉบับ)
        sndId = {},    -- [cat] = custom sound id override
        sndPresetVer = 7,
