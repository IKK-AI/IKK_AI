-- ═══════════════════════════════════════════════════════════════
-- STATE
-- ═══════════════════════════════════════════════════════════════
local S = {
        chatOn = false, talkOn = false, prefixName = true,
        key = "", connected = false, thinking = false, thinkStart = 0,
        nextReq = 0, cooldown = 3, responseDelay = 2.0, tokens = 0,
        -- ✂️ Max Reply Length: ความยาวสูงสุดของคำตอบ AI ที่ส่งลงแชท (ตัวอักษร)
        --    ป้องกันคำตอบยาว ๆ โดนหั่นเป็นเม็ด ๆ หลายสิบท่อนในแชท Roblox (จำกัด ~200 ตัว/ข้อความ)
        --    600 = สูงสุด ~3-4 ท่อน · 200 = พอดี 1 ข้อความ · 0 = ไม่ตัด (ส่งเต็มยาวเท่าที่ได้)
        maxReply = 600,
        playerHistory = {}, playerNames = {}, maxPlayerHist = 2,
        userPersona = "", playerLang = {}, playerNick = {},
        range = 25, globalN = 0, spamT = tick(), playerCD = {},
        lastObserve = 0, observeInterval = 12, lastActions = {},
        traits = { friendly = 7, funny = 5, quiet = 3, smart = 7, aggro = 2 },
        blacklist = {}, currentModel = DEFAULT_MODEL,
        greetedPlayers = {}, toxicTargets = {},
        holdDuration = 1.0,
        whitelistOn = false, whitelist = {},
        totalTokensUsed = 0, remainingTokens = -1, tokenResetTime = 0,
        currentTheme = "midnight",
        baseURL = "",   -- Base URL (ว่าง = Local AI http://localhost:11434/api — สลับได้ในหน้า API)
