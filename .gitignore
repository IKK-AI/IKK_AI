-- ═══════════════════════════════════════════════════════════════
-- SEBAS USER DATABASE (Google Sheets) — ระบบ login + premium/normal
--   วิธีเปิดใช้งาน: วาง URL ของ Apps Script Web app ของคุณใน DB_URL
--   ด้านล่างนี้ (วิธีสร้าง URL อ่านในไฟล์ SebasAI_Database.gs ที่แนบมา)
--   หรือสร้างไฟล์ OllamaAI_DBUrl.txt ใน executor ใส่ URL ก็ได้
--   เว้นว่าง = ปิดระบบ login/premium → ใช้ได้ทุกฟีเจอร์เหมือนเดิม
-- ═══════════════════════════════════════════════════════════════
DB_URL = ""                                    -- ← วาง URL ตรงนี้
DBURL_FILE  = "OllamaAI_DBUrl.txt"             -- (ทางเลือก: ไฟล์แทนการแก้สคริปต์)
AUTH_FILE   = "OllamaAI_Account.json"

-- ─── MIGRATION ครั้งเดียว: ไฟล์ยุค OpenRouter → ยุค Ollama ───────
--   ข้อมูลเดิม (ธีม/เสียง/หน้าตา/ความจำ/บัญชี) ย้ายมาใช้ต่อ
--   ไฟล์ "คีย์" ไม่ย้าย — คีย์ OpenRouter ใช้กับ Ollama ไม่ได้ ต้องใส่ใหม่
pcall(function()
        if not isfile or not readfile or not writefile then return end
        local mv = {
                { "OpenRouterAI_Settings.json", SET_FILE },
                { "OpenRouterAI_Memory.json",   MEM_FILE },
                { "OpenRouterAI_Account.json",  AUTH_FILE },
                { "OpenRouterAI_DBUrl.txt",     DBURL_FILE },
                { "OpenRouterAI_TutDone.txt",   "OllamaAI_TutDone.txt" },
                { "OpenRouterAI_Extended.json", "OllamaAI_Extended.json" },
                { "OpenRouterAI_Session.json",  "OllamaAI_Session.json" },
                { "OpenRouterAI_World.json",    "OllamaAI_World.json" },
        }
        for _, pr in ipairs(mv) do
                if not isfile(pr[2]) and isfile(pr[1]) then
                        writefile(pr[2], readfile(pr[1]))
                end
        end
end)

pcall(function()
        if isfile and isfile(DBURL_FILE) then
                local c = readfile(DBURL_FILE)
                if type(c) == "string" then
                        c = c:gsub("^%s+", ""):gsub("%s+$", "")
                        if #c > 10 then DB_URL = c end
                end
        end
end)

-- ─── AUTH / PREMIUM TIER STATE ─────────────────────────────────
--   disabled = ไม่ได้ตั้ง DB_URL → ข้ามระบบ login ทุกฟีเจอร์เปิดหมด (โหมดเจ้าของ)
--   locked   = login overlay เปิดอยู่ (บล็อค gesture/บังคับให้ login ก่อน)
AUTH = {
        disabled = false, ok = false, locked = true,
        premium = false, tier = "normal",
        user = nil, offline = false, untilDate = nil, lastLogin = nil,
}
if DB_URL == "" then
        AUTH.disabled = true; AUTH.locked = false
        AUTH.ok = true; AUTH.premium = true
end

-- ฟีเจอร์ที่ต้องเป็น premium ถึงใช้ได้ (แก้รายการได้ตามต้องการ)
TIER_FEATS = {
        mixer    = true,   -- 🔊 Sound Mixer (ปรับเสียง UI เอง)
        research = true,   -- 🧠 AI Research Kit (ข้อมูลผู้เล่น/geo/ข่าว)
        multikey = true,   -- 🔑 Multi-Key (ใช้ได้มากกว่า 1 คีย์)
        persona  = true,   -- ✏️ Custom Persona (คำสั่งบุคลิกเพิ่มเติม)
}
function AUTH.on(f)
        if AUTH.disabled then return true end
        if f == nil or TIER_FEATS[f] == nil then return true end
        return AUTH.premium == true
end

