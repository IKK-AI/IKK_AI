end

-- ═══════════════════════════════════════════════════════════════
-- PAGE: PERSONA
-- ═══════════════════════════════════════════════════════════════
do
        local pgPer = makePage("persona")
        local perCard = mkCard(pgPer, 140, 1)
        mkLabel(perCard, "CUSTOM PERSONA", 4)
        Lk(perCard, "● Core identity ✓ built-in", UDim2.new(1, -16, 0, 13), UDim2.fromOffset(10, 18), 9, RF, "OK", Enum.TextXAlignment.Left, 15)

        local pBox = Instance.new("TextBox", perCard)
        pBox.Size = UDim2.new(1, -16, 0, 84)
        pBox.Position = UDim2.fromOffset(8, 34)
        pBox.BackgroundColor3 = C.CD; pBox.BorderSizePixel = 0
        pBox.Text = S.userPersona; pBox.TextColor3 = C.T1
        pBox.PlaceholderText = "Extra persona instructions..."
        pBox.PlaceholderColor3 = C.T2
        pBox.TextWrapped = true; pBox.TextYAlignment = Enum.TextYAlignment.Top
        pBox.Font = RF; pBox.TextSize = 10; pBox.ZIndex = 15
        pBox.ClearTextOnFocus = false
        themed(pBox, "BackgroundColor3", "CD")
        themed(pBox, "TextColor3", "T1")
        Instance.new("UICorner", pBox).CornerRadius = UDim.new(0, 8)
        Sk(pBox, "BD", 1, 0.4)
        local pSk = pBox:FindFirstChildOfClass("UIStroke")
        pBox.Focused:Connect(function()
                ANIM.play(pSk, { Color = C.AC, Transparency = 0 }, { t = 0.15, tag = "fc" })
        end)
        pBox.FocusLost:Connect(function()
                ANIM.play(pSk, { Color = C.BD, Transparency = 0.4 }, { t = 0.2, tag = "fc" })
                if not AUTH.on("persona") then   -- 🔒 premium gate
                        pBox.Text = S.userPersona or ""
                        notify("🔒 Premium", "Custom Persona เป็นฟีเจอร์ Premium — อัปเกรดที่หน้า Profile", "warn")
                        SND.play("error")
                        return
                end
                S.userPersona = pBox.Text; saveSettings()
        end)

        -- 🔒 premium lock banner บนสุดของหน้า (แสดงเมื่อ normal + DB เปิด — applyTierUI คุม Visible)
        local perLock = F(pgPer, UDim2.new(1, 0, 0, 46), UDim2.new(), C.CARD, 10, 20)
        perLock.LayoutOrder = 0
        Sk(perLock, nil, 1.2, 0.35).Color = Color3.fromRGB(245, 185, 66)
        Lk(perLock, "🔒  CUSTOM PERSONA · PREMIUM", UDim2.new(1, -16, 0, 14), UDim2.fromOffset(10, 7), 9, BF, "T1", Enum.TextXAlignment.Left, 21)
        Lk(perLock, "เขียนบุคลิกเพิ่มเองเป็นฟีเจอร์ Premium — อัปเกรดที่หน้า Profile", UDim2.new(1, -16, 0, 12), UDim2.fromOffset(10, 22), 8, RF, "T2", Enum.TextXAlignment.Left, 21)
        perLock.Name = "PerLock"
        perLock.Visible = not AUTH.on("persona")
        UIX.perLock = perLock
end

-- ═══════════════════════════════════════════════════════════════
-- PAGE: MEMORY
-- ═══════════════════════════════════════════════════════════════
do
        local pgMem = makePage("memory")

        local memCard = mkCard(pgMem, 150, 1)
        mkLabel(memCard, "MEMORY SYSTEM", 4)
        Lk(memCard, "● Isolated per player", UDim2.new(1, -16, 0, 13), UDim2.fromOffset(10, 18), 9, RF, "T1", Enum.TextXAlignment.Left, 15)
        Lk(memCard, "● Room snapshot on mention", UDim2.new(1, -16, 0, 13), UDim2.fromOffset(10, 33), 9, RF, "T1", Enum.TextXAlignment.Left, 15)
        Lk(memCard, "● Greeting → save → continue topic", UDim2.new(1, -16, 0, 13), UDim2.fromOffset(10, 48), 9, RF, "T1", Enum.TextXAlignment.Left, 15)
        Lk(memCard, "● Cross-session: ออกเกมแล้วกลับมาคุยต่อได้", UDim2.new(1, -16, 0, 13), UDim2.fromOffset(10, 63), 9, RF, "T1", Enum.TextXAlignment.Left, 15)

        local memStat = Lk(memCard, "Tokens used: " .. tostring(S.tokens), UDim2.new(1, -16, 0, 13), UDim2.fromOffset(10, 80), 9, RF, "WN", Enum.TextXAlignment.Left, 15)
        UIX.memStat = memStat

        local clrBtn = mkBtn(memCard, "🗑️  Clear All Memory", UDim2.new(1, -16, 0, 28), UDim2.fromOffset(8, 100), "danger", 10, 16)
        clrBtn.MouseButton1Click:Connect(function()
                S.playerHistory = {}; S.playerNames = {}; S.playerNick = {}; S.playerLang = {}
                S.greetedPlayers = {}; S.toxicTargets = {}
                EXTCTX.extended = {}
                EXTCTX.worldMeta.relationshipMap = {}
                saveMemory()
                savePersistent()
                notify("💾 Memory", "Cleared all player memory.", "ok")
                if refreshWhitelist then refreshWhitelist() end
        end)

        -- ─── KNOWN PLAYERS (cross-session profiles) ───
        local knownCard = mkCard(pgMem, 210, 2)
        mkLabel(knownCard, "KNOWN PLAYERS (CROSS-SESSION)", 4)

        local knScroll = Instance.new("ScrollingFrame", knownCard)
        knScroll.Size = UDim2.new(1, -12, 1, -30)
        knScroll.Position = UDim2.fromOffset(6, 22)
        knScroll.BackgroundTransparency = 1
        knScroll.ScrollBarThickness = 3
        knScroll.ScrollBarImageColor3 = C.BD
        knScroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
        knScroll.CanvasSize = UDim2.new()
        knScroll.ZIndex = 15; knScroll.ClipsDescendants = true
        local knLL = Instance.new("UIListLayout", knScroll)
        knLL.Padding = UDim.new(0, 4)

        local function refreshKnown()
                for _, ch in ipairs(knScroll:GetChildren()) do
                        if ch:IsA("Frame") or ch:IsA("TextLabel") then ch:Destroy() end
                end
                local count = 0
                for uid, p in pairs(EXTCTX.extended) do
                        count = count + 1
                        local rel = math.floor(EXTCTX.worldMeta.relationshipMap[uid] or 0)
                        local row = F(knScroll, UDim2.new(1, -4, 0, 30), nil, C.CD, 7, 16)
                        themed(row, "BackgroundColor3", "CD")
                        Lk(row, tostring(p.name or "?"), UDim2.new(1, -96, 0, 14), UDim2.fromOffset(8, 3), 9, BF, "T1", Enum.TextXAlignment.Left, 17)
                        Lk(row, (p.totalChats or 0) .. " chats · " .. EXTCTX.getRelLabel(rel), UDim2.new(1, -96, 0, 11), UDim2.fromOffset(8, 16), 7, RF, "T2", Enum.TextXAlignment.Left, 17)

                        -- แถบความสัมพันธ์
                        local relBarBg = Instance.new("Frame", row)
                        relBarBg.Size = UDim2.fromOffset(50, 4)
                        relBarBg.Position = UDim2.new(1, -88, 0, 13)
                        relBarBg.BackgroundColor3 = C.BD; relBarBg.BorderSizePixel = 0
                        relBarBg.ZIndex = 17
                        Instance.new("UICorner", relBarBg).CornerRadius = UDim.new(1, 0)
                        local relBar = Instance.new("Frame", relBarBg)
                        relBar.Size = UDim2.new(rel / 100, 0, 1, 0)
                        relBar.BackgroundColor3 = C.OK; relBar.BorderSizePixel = 0
                        relBar.ZIndex = 18
                        themed(relBar, "BackgroundColor3", "OK")
                        Instance.new("UICorner", relBar).CornerRadius = UDim.new(1, 0)

                        local rmBtn = mkBtn(row, "✕", UDim2.fromOffset(24, 20), UDim2.new(1, -30, 0.5, -10), "danger", 9, 17)
                        local cu = uid
                        rmBtn.MouseButton1Click:Connect(function()
                                EXTCTX.extended[cu] = nil
                                S.playerHistory[cu] = nil
                                savePersistent()
                                refreshKnown()
                                SND.play("close")
                        end)
                end
                if count == 0 then
                        local e = Instance.new("TextLabel", knScroll)
                        e.Size = UDim2.new(1, 0, 0, 26)
                        e.BackgroundTransparency = 1
                        e.Text = "No players recorded yet."
                        e.TextColor3 = C.T2
                        e.Font = RF; e.TextSize = 9; e.ZIndex = 16
                        e.TextXAlignment = Enum.TextXAlignment.Center
                end
        end
        refreshKnown()
        UIX.refreshKnown = refreshKnown
end

-- ═══════════════════════════════════════════════════════════════
-- PAGE: BLACKLIST
-- ═══════════════════════════════════════════════════════════════
do
        local pgBL = makePage("blacklist")

        local blInfoCard = mkCard(pgBL, 62, 1)
        mkLabel(blInfoCard, "BLACKLIST", 4)
        Lk(blInfoCard, "Block players — AI won't reply to them", UDim2.new(1, -16, 0, 13), UDim2.fromOffset(10, 18), 9, RF, "T1", Enum.TextXAlignment.Left, 15)
        Lk(blInfoCard, "Hold on player → radial menu → Toxic หรือกดปุ่มด้านล่างเพื่อเพิ่ม", UDim2.new(1, -16, 0, 12), UDim2.fromOffset(10, 33), 8, RF, "T2", Enum.TextXAlignment.Left, 15)

        local blActCard = mkCard(pgBL, 72, 2)
        mkLabel(blActCard, "ACTIONS", 4)
        local blAddBtn = mkBtn(blActCard, "⛔  Add to Blacklist (tap player)", UDim2.new(1, -16, 0, 26), UDim2.fromOffset(8, 18), "danger", 9, 16)
        local blManageBtn = mkBtn(blActCard, "📋  Manage Blacklist", UDim2.new(1, -16, 0, 26), UDim2.fromOffset(8, 46), "soft", 9, 16)

        UIX.blAddBtn = blAddBtn
        UIX.blManageBtn = blManageBtn
end

-- ═══════════════════════════════════════════════════════════════
-- PAGE: WHITELIST
-- ═══════════════════════════════════════════════════════════════
do
        local pgWL = makePage("whitelist")

        local wlInfoCard = mkCard(pgWL, 84, 1)
        mkLabel(wlInfoCard, "WHITELIST MODE", 4)
        mkToggle(wlInfoCard, 18, "✅  Whitelist Mode", "whitelistOn")
        Lk(wlInfoCard, "When ON → reply only to whitelisted players", UDim2.new(1, -16, 0, 13), UDim2.fromOffset(10, 54), 8, RF, "T2", Enum.TextXAlignment.Left, 15)

        local wlAddCard = mkCard(pgWL, 66, 2)
        mkLabel(wlAddCard, "ADD PLAYER", 4)
        local wlInput = Instance.new("TextBox", wlAddCard)
        wlInput.Size = UDim2.new(1, -82, 0, 26)
        wlInput.Position = UDim2.fromOffset(8, 20)
        wlInput.BackgroundColor3 = C.CD; wlInput.BorderSizePixel = 0
        wlInput.PlaceholderText = "Player name or UserId..."
        wlInput.Text = ""
        wlInput.TextColor3 = C.T1; wlInput.PlaceholderColor3 = C.T2
        wlInput.Font = RF; wlInput.TextSize = 10
        wlInput.ZIndex = 15; wlInput.ClearTextOnFocus = false
        themed(wlInput, "BackgroundColor3", "CD")
        themed(wlInput, "TextColor3", "T1")
        Instance.new("UICorner", wlInput).CornerRadius = UDim.new(0, 8)
        Sk(wlInput, "BD", 1, 0.4)

        local wlAddBtn = mkBtn(wlAddCard, "Add", UDim2.fromOffset(62, 26), UDim2.new(1, -70, 0, 20), "success", 10, 16)

        local wlListCard = mkCard(pgWL, 210, 3)
        mkLabel(wlListCard, "WHITELISTED PLAYERS", 4)
        local wlScroll = Instance.new("ScrollingFrame", wlListCard)
        wlScroll.Size = UDim2.new(1, -12, 1, -26)
        wlScroll.Position = UDim2.fromOffset(6, 22)
        wlScroll.BackgroundTransparency = 1
        wlScroll.ScrollBarThickness = 3
        wlScroll.ScrollBarImageColor3 = C.BD
        wlScroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
        wlScroll.CanvasSize = UDim2.new()
        wlScroll.ZIndex = 15; wlScroll.ClipsDescendants = true
        local wlLL = Instance.new("UIListLayout", wlScroll)
        wlLL.Padding = UDim.new(0, 4)

        function refreshWhitelist()
                for _, ch in ipairs(wlScroll:GetChildren()) do
                        if ch:IsA("Frame") or ch:IsA("TextLabel") then ch:Destroy() end
                end
                local filtered = {}
                for _, name in ipairs(S.whitelist) do
                        if searchText == "" or tostring(name):lower():find(searchText:lower(), 1, true) then
                                filtered[#filtered + 1] = name
                        end
                end
                if #filtered == 0 then
                        local e = Instance.new("TextLabel", wlScroll)
                        e.Size = UDim2.new(1, 0, 0, 30)
                        e.BackgroundTransparency = 1
                        e.Text = #S.whitelist == 0 and "No players whitelisted." or "No matches found."
                        e.TextColor3 = C.T2
                        e.Font = RF; e.TextSize = 9; e.ZIndex = 15
                        e.TextXAlignment = Enum.TextXAlignment.Center
                        return
                end
                for idx, name in ipairs(filtered) do
                        local row = F(wlScroll, UDim2.new(1, -4, 0, 32), nil, C.CD, 7, 16)
                        themed(row, "BackgroundColor3", "CD")
                        Lk(row, tostring(name), UDim2.new(1, -66, 0, 16), UDim2.fromOffset(8, 3), 10, BF, "T1", Enum.TextXAlignment.Left, 17)
                        Lk(row, "#" .. tostring(idx), UDim2.new(0, 40, 0, 11), UDim2.fromOffset(8, 18), 8, RF, "T2", Enum.TextXAlignment.Left, 17)
                        local rmBtn = mkBtn(row, "Remove", UDim2.fromOffset(58, 22), UDim2.new(1, -62, 0.5, -11), "danger", 8, 17)
                        local cName = name
                        rmBtn.MouseButton1Click:Connect(function()
                                for i, n in ipairs(S.whitelist) do
                                        if n == cName then table.remove(S.whitelist, i); break end
                                end
                                saveSettings()
                                refreshWhitelist()
                                notify("✅ Whitelist", "Removed " .. tostring(cName), "info")
                        end)
                end
        end
        refreshWhitelist()

        local function addToWhitelist(name)
                if not name or name == "" then return end
                name = name:match("^%s*(.-)%s*$") or ""
                if name == "" then return end
                for _, n in ipairs(S.whitelist) do
                        if n:lower() == name:lower() then return end
                end
                table.insert(S.whitelist, name)
                saveSettings()
                refreshWhitelist()
                notify("✅ Whitelist", "Added " .. name, "ok")
        end

        wlAddBtn.MouseButton1Click:Connect(function()
                addToWhitelist(wlInput.Text); wlInput.Text = ""
        end)
        wlInput.FocusLost:Connect(function(ep)
                if wlInput.Text ~= "" then addToWhitelist(wlInput.Text); wlInput.Text = "" end
        end)

        UIX.wlInfoCard = wlInfoCard
        UIX.wlListCard = wlListCard
end

-- ─── SEARCH BOX WIRING (หลัง refresh ฟังก์ชันถูก define แล้ว) ───
searchBox:GetPropertyChangedSignal("Text"):Connect(function()
        searchText = searchBox.Text
        if activeTab == "whitelist" then pcall(refreshWhitelist)
        elseif activeTab == "blacklist" then pcall(function() if refreshBL then refreshBL() end end) end
end)


-- ═══════════════════════════════════════════════════════════════
-- PAGE: THEME (การ์ดพรีวิว 8 ธีม แนวนอน ตามภาพอ้างอิง)
-- ═══════════════════════════════════════════════════════════════
do
        local pgTheme = makePage("theme")

        local themeCard = mkCard(pgTheme, 205, 1)
        mkLabel(themeCard, "SELECT THEME — เลือกธีมที่ชอบ (แตะการ์ดเพื่อเปลี่ยน)", 4)

        local thScroll = Instance.new("ScrollingFrame", themeCard)
        thScroll.Size = UDim2.new(1, -8, 1, -42)
        thScroll.Position = UDim2.fromOffset(4, 30)
        thScroll.BackgroundTransparency = 1
        thScroll.ScrollBarThickness = 3
        thScroll.ScrollBarImageColor3 = C.BD
        thScroll.AutomaticCanvasSize = Enum.AutomaticSize.X
        thScroll.CanvasSize = UDim2.new()
        thScroll.ZIndex = 15
        thScroll.ClipsDescendants = true
        thScroll.ScrollingDirection = Enum.ScrollingDirection.X
        local thLL = Instance.new("UIListLayout", thScroll)
        thLL.FillDirection = Enum.FillDirection.Horizontal
        thLL.Padding = UDim.new(0, 8)
        thLL.SortOrder = Enum.SortOrder.LayoutOrder
        local thPad = Instance.new("UIPadding", thScroll)
        thPad.PaddingLeft = UDim.new(0, 4); thPad.PaddingTop = UDim.new(0, 4)
        thPad.PaddingBottom = UDim.new(0, 4)

        local CW, CH = 112, 132
        local themeCards = {}

        -- วาดสถานะ active: ขอบหนา + ป้าย "✓ ใช้งาน" สีของธีมนั้นเอง (ไม่ตามธีมปัจจุบัน)
        local function paintActiveTheme()
                for tn, card in pairs(themeCards) do
                        local active = S.currentTheme == tn
                        card.stroke.Thickness = active and 2.4 or 1
                        card.stroke.Transparency = active and 0 or 0.45
                        card.dot.Visible = active
                        if card.badge then
                                card.badge.Visible = active
                                if active then
                                        card.badge.BackgroundColor3 = card.badgeAC
                                        card.badge.TextColor3 = card.badgeWIN
                                end
                        end
                end
        end

        for idx, tName in ipairs(THEME_ORDER) do
                local tD = THEMES[tName]
                local holder = Instance.new("Frame", thScroll)
                holder.Size = UDim2.fromOffset(CW, CH)
                holder.BackgroundTransparency = 1
                holder.ZIndex = 15
                holder.LayoutOrder = idx
                holder.ClipsDescendants = false

                -- ชื่อ "TPV_" = Theme PreView → walk() ตอนเปลี่ยนธีมจะข้าม subtree นี้
                --   (การ์ดพรีวิวแสดงสีของธีมตัวเองเสมอ ไม่เปลี่ยนตามธีมที่กำลังใช้)
                local card = Instance.new("TextButton", holder)
                card.Name = "TPV_" .. tName
                card.Size = UDim2.fromOffset(CW, 108)
                card.Position = UDim2.new()
                card.BackgroundColor3 = tD.POP
                card.BorderSizePixel = 0
                card.Text = ""; card.AutoButtonColor = false
                card.ZIndex = 16
                Instance.new("UICorner", card).CornerRadius = UDim.new(0, 10)
                local cst = Instance.new("UIStroke", card)
                cst.Color = tD.AC; cst.Thickness = 1; cst.Transparency = 0.45

                -- mini preview: top bar + sidebar + content + accent bits
                local pv = Instance.new("Frame", card)
                pv.Size = UDim2.new(1, -12, 1, -12)
                pv.Position = UDim2.fromOffset(6, 6)
                pv.BackgroundColor3 = tD.WIN
                pv.BorderSizePixel = 0
                pv.ZIndex = 17
                Instance.new("UICorner", pv).CornerRadius = UDim.new(0, 6)

                local pvTop = Instance.new("Frame", pv)
                pvTop.Size = UDim2.new(1, 0, 0, 10)
                pvTop.BackgroundColor3 = tD.SB; pvTop.BorderSizePixel = 0
                pvTop.ZIndex = 18
                Instance.new("UICorner", pvTop).CornerRadius = UDim.new(0, 6)
                local pvTopCover = Instance.new("Frame", pvTop)
                pvTopCover.Size = UDim2.new(1, 0, 0, 5)
                pvTopCover.Position = UDim2.new(0, 0, 1, -5)
                pvTopCover.BackgroundColor3 = tD.SB; pvTopCover.BorderSizePixel = 0
                pvTopCover.ZIndex = 18

                local pvLogo = Instance.new("Frame", pvTop)
                pvLogo.Size = UDim2.fromOffset(6, 6)
                pvLogo.Position = UDim2.fromOffset(3, 2)
                pvLogo.BackgroundColor3 = tD.AC; pvLogo.BorderSizePixel = 0
                pvLogo.ZIndex = 19
                Instance.new("UICorner", pvLogo).CornerRadius = UDim.new(0, 2)

                local pvSide = Instance.new("Frame", pv)
                pvSide.Size = UDim2.new(0, 22, 1, -12)
                pvSide.Position = UDim2.fromOffset(3, 13)
                pvSide.BackgroundColor3 = tD.SB; pvSide.BorderSizePixel = 0
                pvSide.ZIndex = 18
                Instance.new("UICorner", pvSide).CornerRadius = UDim.new(0, 4)

                -- จุด nav ใน sidebar (อันแรกเป็นสี accent)
                for d = 0, 3 do
                        local nd = Instance.new("Frame", pvSide)
                        nd.Size = UDim2.new(1, -6, 0, 5)
                        nd.Position = UDim2.fromOffset(3, 3 + d * 7)
                        nd.BackgroundColor3 = d == 0 and tD.AC or tD.CD
                        nd.BorderSizePixel = 0
                        nd.ZIndex = 19
                        Instance.new("UICorner", nd).CornerRadius = UDim.new(0, 2)
                end

                -- content: 2 cards + slider line
                local pvC1 = Instance.new("Frame", pv)
                pvC1.Size = UDim2.new(1, -32, 0, 16)
                pvC1.Position = UDim2.fromOffset(28, 14)
                pvC1.BackgroundColor3 = tD.CARD; pvC1.BorderSizePixel = 0
                pvC1.ZIndex = 18
                Instance.new("UICorner", pvC1).CornerRadius = UDim.new(0, 3)
                local pvC1a = Instance.new("Frame", pvC1)
                pvC1a.Size = UDim2.new(0.4, 0, 0, 3)
                pvC1a.Position = UDim2.fromOffset(4, 4)
                pvC1a.BackgroundColor3 = tD.AC; pvC1a.BorderSizePixel = 0
                pvC1a.ZIndex = 19
                Instance.new("UICorner", pvC1a).CornerRadius = UDim.new(1, 0)

                local pvC2 = Instance.new("Frame", pv)
                pvC2.Size = UDim2.new(1, -32, 0, 14)
                pvC2.Position = UDim2.fromOffset(28, 33)
                pvC2.BackgroundColor3 = tD.CARD; pvC2.BorderSizePixel = 0
                pvC2.ZIndex = 18
                Instance.new("UICorner", pvC2).CornerRadius = UDim.new(0, 3)

                local pvTrack = Instance.new("Frame", pv)
                pvTrack.Size = UDim2.new(1, -36, 0, 4)
                pvTrack.Position = UDim2.fromOffset(28, 56)
                pvTrack.BackgroundColor3 = tD.CD; pvTrack.BorderSizePixel = 0
                pvTrack.ZIndex = 18
                Instance.new("UICorner", pvTrack).CornerRadius = UDim.new(1, 0)
                local pvFill = Instance.new("Frame", pvTrack)
                pvFill.Size = UDim2.new(0.62, 0, 1, 0)
                pvFill.BackgroundColor3 = tD.AC; pvFill.BorderSizePixel = 0
                pvFill.ZIndex = 19
                Instance.new("UICorner", pvFill).CornerRadius = UDim.new(1, 0)

                -- แถบไล่เฉด 3 สี (accent/ok/warn) ของธีมนั้น — ฐานการ์ด
                local pvBar = Instance.new("Frame", card)
                pvBar.Size = UDim2.new(1, -12, 0, 4)
                pvBar.Position = UDim2.new(0, 6, 1, -8)
                pvBar.BackgroundColor3 = tD.AC; pvBar.BorderSizePixel = 0
                pvBar.ZIndex = 18
                Instance.new("UICorner", pvBar).CornerRadius = UDim.new(1, 0)
                local bar2 = Instance.new("Frame", pvBar)
                bar2.Size = UDim2.new(0.5, 0, 1, 0)
                bar2.Position = UDim2.new(0.5, 0, 0, 0)
                bar2.BackgroundColor3 = tD.OK; bar2.BorderSizePixel = 0
                bar2.ZIndex = 19
                Instance.new("UICorner", bar2).CornerRadius = UDim.new(1, 0)
                local bar3 = Instance.new("Frame", bar2)
                bar3.Size = UDim2.new(0.5, 0, 1, 0)
                bar3.Position = UDim2.new(0.5, 0, 0, 0)
                bar3.BackgroundColor3 = tD.WN; bar3.BorderSizePixel = 0
                bar3.ZIndex = 19
                Instance.new("UICorner", bar3).CornerRadius = UDim.new(1, 0)

                -- ป้าย "✓ ใช้งาน" มุมบนขวา (สีของธีมเจ้าของ — อยู่ใน TPV_ จึงไม่โดน remap)
                local badge = Instance.new("TextLabel", card)
                badge.Name = "TPVbadge"
                badge.Size = UDim2.fromOffset(52, 15)
                badge.Position = UDim2.new(1, -56, 0, 4)
                badge.BackgroundColor3 = tD.AC
                badge.Text = "✓ ใช้งาน"; badge.Font = BF; badge.TextSize = 8
                badge.TextColor3 = tD.WIN
                badge.ZIndex = 20
                badge.Visible = false
                Instance.new("UICorner", badge).CornerRadius = UDim.new(1, 0)

                -- label ใต้การ์ด (ตามธีมปัจจุบัน = อ่านง่ายเสมอ)
                local lbl = Instance.new("TextLabel", holder)
                lbl.Size = UDim2.new(1, 0, 0, 14)
                lbl.Position = UDim2.fromOffset(0, 110)
                lbl.BackgroundTransparency = 1
                lbl.Text = (THEME_ICONS[tName] or "") .. " " .. (THEME_NAMES[tName] or tName)
                lbl.Font = BF; lbl.TextSize = 9
                lbl.TextColor3 = C.T1
                lbl.ZIndex = 16
                themed(lbl, "TextColor3", "T1")

                -- จุด active (สีของธีมเจ้าของ — TPV_ กันโดน remap)
                local dot = Instance.new("Frame", holder)
                dot.Name = "TPVdot_" .. tName
                dot.Size = UDim2.fromOffset(7, 7)
                dot.Position = UDim2.new(0.5, -3, 0, 122)
                dot.BackgroundColor3 = tD.AC; dot.BorderSizePixel = 0
                dot.ZIndex = 16
                dot.Visible = false
                Instance.new("UICorner", dot).CornerRadius = UDim.new(1, 0)

                themeCards[tName] = { card = card, stroke = cst, dot = dot, badge = badge,
                        badgeAC = tD.AC, badgeWIN = tD.WIN }

                local function pickTheme()
                        if S.currentTheme == tName then return end
                        local cp = card.AbsolutePosition
                        applyTheme(tName, Vector2.new(cp.X + CW / 2, cp.Y + 50))
                        paintActiveTheme()
                        notify("🎨 Theme", (THEME_NAMES[tName] or tName) .. " applied", "ok")
                end
                card.MouseButton1Click:Connect(pickTheme)
                hookBtn(card, { sound = false })
        end
        paintActiveTheme()

        Lk(themeCard, "เปลี่ยนธีมได้ทันที — สีทั้งหมดใน GUI ปรับตามอัตโนมัติ · การ์ดแต่ละใบแสดงสีจริงของธีมนั้นเสมอ", UDim2.new(1, -16, 0, 12), UDim2.fromOffset(10, 190), 8, RF, "T2", Enum.TextXAlignment.Left, 15)

        UIX.themeCard = themeCard
end

-- ═══════════════════════════════════════════════════════════════
-- PAGE: SOUND (mixer กลาง — ปรับ ID/Volume ต่อประเภท)
-- ═══════════════════════════════════════════════════════════════
do
        local pgSound = makePage("sound")

        -- 🔒 premium lock banner บนสุดของหน้า (แสดงเมื่อ normal + DB เปิด — applyTierUI คุม Visible)
        local mixLock = F(pgSound, UDim2.new(1, 0, 0, 46), UDim2.new(), C.CARD, 10, 20)
        mixLock.LayoutOrder = 0
        Sk(mixLock, nil, 1.2, 0.35).Color = Color3.fromRGB(245, 185, 66)
        Lk(mixLock, "🔒  SOUND MIXER · PREMIUM", UDim2.new(1, -16, 0, 14), UDim2.fromOffset(10, 7), 9, BF, "T1", Enum.TextXAlignment.Left, 21)
        Lk(mixLock, "ปรับเสียง UI เองเป็นฟีเจอร์ Premium — อัปเกรดที่หน้า Profile", UDim2.new(1, -16, 0, 12), UDim2.fromOffset(10, 22), 8, RF, "T2", Enum.TextXAlignment.Left, 21)
        mixLock.Name = "MixLock"
        mixLock.Visible = not AUTH.on("mixer")
        UIX.mixLock = mixLock

        -- ─── MASTER ───
        local mCard = mkCard(pgSound, 106, 1)
        mkLabel(mCard, "MASTER", 4)
        mkToggleX(mCard, 18, "🔊  UI Sounds",
                function() return S.soundOn == true end,
                function(v) S.soundOn = v; saveSettings() end)

        -- master volume slider 0-100
        local mvRow = Instance.new("Frame", mCard)
        mvRow.Size = UDim2.new(1, -16, 0, 42)
        mvRow.Position = UDim2.fromOffset(8, 52)
        mvRow.BackgroundTransparency = 1; mvRow.ZIndex = 15
        Lk(mvRow, "🎚️  Master Volume", UDim2.new(0.6, 0, 0, 14), nil, 10, BF, "T1", Enum.TextXAlignment.Left, 16)
        local mvVal = Lk(mvRow, math.floor((S.sndMaster or 1.0) * 100) .. "%", UDim2.new(0.4, 0, 0, 14), UDim2.new(0.6, 0, 0, 0), 10, BF, "AC", Enum.TextXAlignment.Right, 16)

        local mvTrack = Instance.new("Frame", mvRow)
        mvTrack.Size = UDim2.new(1, 0, 0, 6)
        mvTrack.Position = UDim2.new(0, 0, 0, 24)
        mvTrack.BackgroundColor3 = C.CD; mvTrack.BorderSizePixel = 0
        mvTrack.ZIndex = 16
        themed(mvTrack, "BackgroundColor3", "CD")
        Instance.new("UICorner", mvTrack).CornerRadius = UDim.new(1, 0)
        local mvFill = Instance.new("Frame", mvTrack)
        mvFill.Size = UDim2.new(S.sndMaster or 1.0, 0, 1, 0)
        mvFill.BackgroundColor3 = C.AC; mvFill.BorderSizePixel = 0
        mvFill.ZIndex = 17
        themed(mvFill, "BackgroundColor3", "AC")
        Instance.new("UICorner", mvFill).CornerRadius = UDim.new(1, 0)
        local mvKnob = Instance.new("Frame", mvTrack)
        mvKnob.AnchorPoint = Vector2.new(0.5, 0.5)
        mvKnob.Size = UDim2.fromOffset(14, 14)
        mvKnob.Position = UDim2.new(S.sndMaster or 1.0, 0, 0.5, 0)
        mvKnob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
        mvKnob.BorderSizePixel = 0; mvKnob.ZIndex = 18
        Instance.new("UICorner", mvKnob).CornerRadius = UDim.new(1, 0)
        Sk(mvKnob, "AC", 2, 0.15)
        local mvHit = Instance.new("TextButton", mvRow)
        mvHit.Size = UDim2.new(1, 0, 0, 24)
        mvHit.Position = UDim2.new(0, 0, 0, 16)
        mvHit.BackgroundTransparency = 1
        mvHit.Text = ""; mvHit.AutoButtonColor = false
        mvHit.ZIndex = 19

        local mvDrag = false
        local function mvUpd(inp)
                local rx = math.clamp((inp.Position.X - mvTrack.AbsolutePosition.X) / math.max(mvTrack.AbsoluteSize.X, 1), 0, 1)
                S.sndMaster = math.floor(rx * 100 + 0.5) / 100
                mvVal.Text = math.floor(S.sndMaster * 100) .. "%"
                mvFill.Size = UDim2.new(rx, 0, 1, 0)
                mvKnob.Position = UDim2.new(rx, 0, 0.5, 0)
        end
        mvHit.InputBegan:Connect(function(i)
                if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
                        if not AUTH.on("mixer") then   -- 🔒 premium gate
                                notify("🔒 Premium", "Sound Mixer เป็นฟีเจอร์ Premium — อัปเกรดที่หน้า Profile", "warn")
                                SND.play("error")
                                return
                        end
                        mvDrag = true; mvUpd(i)
                end
        end)
        UIS.InputChanged:Connect(function(i)
                if mvDrag and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
                        mvUpd(i)
                end
        end)
        UIS.InputEnded:Connect(function(i)
                if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
                        if mvDrag then
                                mvDrag = false
                                saveSettings()
                                SND.play("slide")
                        end
                end
        end)

        -- ─── CATEGORY MIXER ───
        local rowsN = #SND.CATS
        local mixCard = mkCard(pgSound, 36 + rowsN * 32, 2)
        mkLabel(mixCard, "SOUND CATEGORIES — ปรับเสียงแยกตามการกระทำ (100% = ต้นฉบับ, สูงสุด 200%)", 4)

        for idx, cat in ipairs(SND.CATS) do
                local cfg = SND_CFG[cat]
                local y = 18 + (idx - 1) * 32

                local row = Instance.new("Frame", mixCard)
                row.Size = UDim2.new(1, -16, 0, 28)
                row.Position = UDim2.fromOffset(8, y)
                row.BackgroundColor3 = C.CD; row.BorderSizePixel = 0
                row.ZIndex = 15
                themed(row, "BackgroundColor3", "CD")
                Instance.new("UICorner", row).CornerRadius = UDim.new(0, 7)

                Lk(row, cfg.label, UDim2.fromOffset(76, 14), UDim2.fromOffset(8, 2), 9, BF, "T1", Enum.TextXAlignment.Left, 16)
                local volTxt = Lk(row, math.floor(SND.getRawVol(cat) * 100) .. "%", UDim2.fromOffset(24, 14), UDim2.fromOffset(80, 2), 8, BF, "AC", Enum.TextXAlignment.Right, 16)

                -- mini volume slider
                local track = Instance.new("Frame", row)
                track.Size = UDim2.fromOffset(56, 5)
                track.Position = UDim2.fromOffset(112, 11)
                track.BackgroundColor3 = C.AREA; track.BorderSizePixel = 0
                track.ZIndex = 16
                themed(track, "BackgroundColor3", "AREA")
                Instance.new("UICorner", track).CornerRadius = UDim.new(1, 0)
                local fill = Instance.new("Frame", track)
                local v0 = SND.getRawVol(cat) / 2   -- 0..2 → สัดส่วน 0..1 ของ track
                fill.Size = UDim2.new(v0, 0, 1, 0)
                fill.BackgroundColor3 = C.AC; fill.BorderSizePixel = 0
                fill.ZIndex = 17
                themed(fill, "BackgroundColor3", "AC")
                Instance.new("UICorner", fill).CornerRadius = UDim.new(1, 0)
                local knob = Instance.new("Frame", track)
                knob.AnchorPoint = Vector2.new(0.5, 0.5)
                knob.Size = UDim2.fromOffset(10, 10)
                knob.Position = UDim2.new(v0, 0, 0.5, 0)
                knob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
                knob.BorderSizePixel = 0; knob.ZIndex = 18
                Instance.new("UICorner", knob).CornerRadius = UDim.new(1, 0)

                local hit = Instance.new("TextButton", row)
                hit.Size = UDim2.fromOffset(64, 24)
                hit.Position = UDim2.fromOffset(108, 2)
                hit.BackgroundTransparency = 1
                hit.Text = ""; hit.AutoButtonColor = false
                hit.ZIndex = 19

                local dragging = false
                local function vUpd(inp)
                        local rx = math.clamp((inp.Position.X - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1), 0, 1)
                        local rv = rx * 2   -- track เต็ม = 200%
                        SND.setVolNoSave(cat, rv)
                        volTxt.Text = tostring(math.floor(rv * 100)) .. "%"
                        fill.Size = UDim2.new(rx, 0, 1, 0)
                        knob.Position = UDim2.new(rx, 0, 0.5, 0)
                end
                hit.InputBegan:Connect(function(i)
                        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
                                if not AUTH.on("mixer") then   -- 🔒 premium gate
                                        notify("🔒 Premium", "Sound Mixer เป็นฟีเจอร์ Premium — อัปเกรดที่หน้า Profile", "warn")
                                        SND.play("error")
                                        return
                                end
                                dragging = true; vUpd(i)
                        end
                end)
                UIS.InputChanged:Connect(function(i)
                        if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
                                vUpd(i)
                        end
                end)
                UIS.InputEnded:Connect(function(i)
                        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
                                if dragging then
                                        dragging = false
                                        saveSettings()
                                        SND.play("slide")
                                end
                        end
                end)

                -- ID textbox
                local idBox = Instance.new("TextBox", row)
                idBox.Size = UDim2.new(1, -236, 1, -6)
                idBox.Position = UDim2.new(1, -228, 0, 3)
                idBox.BackgroundColor3 = C.AREA; idBox.BorderSizePixel = 0
                idBox.Text = SND.getId(cat)
                idBox.TextColor3 = C.T2; idBox.PlaceholderColor3 = C.T2
                idBox.Font = Enum.Font.Code; idBox.TextSize = 8
                idBox.TextTruncate = Enum.TextTruncate.AtEnd
                idBox.ZIndex = 16; idBox.ClearTextOnFocus = false
                themed(idBox, "BackgroundColor3", "AREA")
                themed(idBox, "TextColor3", "T2")
                Instance.new("UICorner", idBox).CornerRadius = UDim.new(0, 5)
                idBox.Focused:Connect(function()
                        idBox.Text = SND.getId(cat)
                        idBox.TextXAlignment = Enum.TextXAlignment.Left
                end)
                idBox.FocusLost:Connect(function()
                        idBox.TextXAlignment = Enum.TextXAlignment.Right
                        local txt = idBox.Text
                        if txt ~= SND.getId(cat) then
                                SND.setId(cat, txt)
                        end
                end)

                -- test button
                local testBtn = mkBtn(row, "▶", UDim2.fromOffset(22, 22), UDim2.new(1, -26, 0, 3), "soft", 10, 17)
                testBtn.MouseButton1Click:Connect(function()
                        SND.play(cat)
                end)
        end

        Lk(mixCard, "แก้ Sound ID ได้ตรง ๆ (rbxasset:// หรือ rbxassetid://) — วางแล้วคลิกนอกช่อง", UDim2.new(1, -16, 0, 12), UDim2.fromOffset(10, 22 + rowsN * 32), 7, RF, "T2", Enum.TextXAlignment.Left, 15)

        UIX.soundCard = mCard
end

do -- p09 MODALS+CONNECT (locals หมดอายุตอนจบ part)

-- ═══════════════════════════════════════════════════════════════
-- MODEL REGISTRY — ดึงโมเดลสดจาก {Base URL}
--   • Local AI / Ollama Cloud (native):  /tags  (models[] + details{})
--   • OpenRouter (/v1):  /models (data[])
--     — ส่งราคามาด้วย (pricing.prompt/completion)
--       จะเรียง "ถูกสุดก่อน → แพงลงไปตามลำดับ" อัตโนมัติ
-- ═══════════════════════════════════════════════════════════════
OR = { models = {}, lastFetch = 0, sortedByPrice = false } -- global: ใช้ข้าม part

OR.fmtSize = function(n)
        n = tonumber(n) or 0
        if n <= 0 then return "" end
        if n >= 1e9 then return string.format("%.1fGB", n / 1e9) end
        if n >= 1e6 then return string.format("%.0fMB", n / 1e6) end
        return string.format("%.0fKB", n / 1e3)
end

OR.fmtCtx = function(n)
        n = tonumber(n) or 0
        if n <= 0 then return "?" end
        if n >= 1000000 then return string.format("%.1fM", n / 1000000) end
        if n >= 1000 then return math.floor(n / 1000 + 0.5) .. "K" end
        return tostring(n)
end

-- ราคารวม in+out ต่อ 1M tokens — nil = ค่ายนี้ไม่ส่งข้อมูลราคามา
OR.pricePerM = function(m)
        if type(m) ~= "table" or m.pin == nil or m.pin < 0 then return nil end
        return (m.pin + math.max(tonumber(m.pout) or 0, 0)) * 1e6
end

OR.fmtPrice = function(perM)
        if perM <= 0 then return "⭐ FREE" end
        local s
        if perM >= 100 then s = string.format("$%.0f", perM)
        elseif perM >= 1 then s = string.format("$%.2f", perM)
        elseif perM >= 0.01 then s = string.format("$%.3f", perM)
        else s = string.format("$%.4f", perM) end
        return s .. "/1M"
end

OR.normStr = function(s)
        if type(s) ~= "string" then return "" end
        return (s:lower():gsub("[^%w]", ""))
end

OR.fetchModels = function(silent)
        if not Http or not HttpService then return false end
        local ok, res = pcall(function()
                local hdrs = {}
                local firstKey = nil
                for i = 1, math.clamp(tonumber(S.activeKeys) or 1, 1, MAX_KEYS) do
                        if type(S.keys[i]) == "string" and #S.keys[i] >= 10 then firstKey = S.keys[i]; break end
                end
                if not firstKey and type(S.key) == "string" and #S.key >= 10 then firstKey = S.key end
                if firstKey then hdrs["Authorization"] = "Bearer " .. firstKey end
                return Http({ Url = EP.tags(), Method = "GET", Headers = hdrs })
        end)
        local r = normRes(res)
        if not ok or r == nil or r.status ~= 200 then
                if not silent then warn("[Sebas AI] โหลดโมเดลไม่สำเร็จ (จาก " .. EP.base() .. ")") end
                return false
        end
        local d
        local dok = pcall(function() d = HttpService:JSONDecode(r.body) end)
        if not dok or type(d) ~= "table" then return false end
        local list = {}
        if type(d.models) == "table" then
                -- Ollama /api/tags → models[] {name, model, size, modified_at, details{}}
                for _, m in ipairs(d.models) do
                        if type(m) == "table" then
                                local id = (type(m.model) == "string" and m.model ~= "") and m.model or tostring(m.name or "")
                                if id ~= "" then
                                        local det = type(m.details) == "table" and m.details or {}
                                        list[#list + 1] = {
                                                id = id,
                                                name = tostring(m.name or id):gsub(":latest$", ""),
                                                params = tostring(det.parameter_size or ""),
                                                quant = tostring(det.quantization_level or ""),
                                                family = tostring(det.family or ""),
                                                size = tonumber(m.size) or 0,
                                                modified = tostring(m.modified_at or ""),
                                                ctx = 0,
                                                pin = -1, pout = -1,   -- ราคา $/token (มีเฉพาะค่ายที่ส่งมา)
                                        }
                                end
                        end
                end
        elseif type(d.data) == "table" then
                -- OpenAI-compatible /models → data[] {id, name, context_length, pricing{}}
                for _, m in ipairs(d.data) do
                        if type(m) == "table" and type(m.id) == "string" then
                                local pin, pout = -1, -1
                                if type(m.pricing) == "table" then
                                        pin = tonumber(m.pricing.prompt) or -1
                                        pout = tonumber(m.pricing.completion) or -1
                                end
                                list[#list + 1] = {
                                        id = m.id,
                                        name = (type(m.name) == "string" and m.name ~= "") and m.name or m.id:gsub(":latest$", ""),
                                        params = "", quant = "", family = "",
                                        size = 0, modified = "", ctx = tonumber(m.context_length) or 0,
                                        pin = pin, pout = pout,
                                }
                        end
                end
        end
        -- เรียงลำดับ: ค่ายที่ส่งราคามา (OpenRouter) → ถูกสุดก่อน ไล่แพงลงไปตามลำดับ
        --   ค่ายที่ไม่ส่งราคา (Local AI/Ollama Cloud) → เรียงตามชื่อตามเดิม
        local hasPrice = false
        for _, m in ipairs(list) do
                if m.pin >= 0 then hasPrice = true; break end
        end
        if hasPrice then
                local function pOf(m)
                        if m.pin < 0 then return math.huge end   -- ไม่มีข้อมูลราคา → ท้ายสุด
                        return (m.pin + math.max(tonumber(m.pout) or 0, 0)) * 1e6
                end
                table.sort(list, function(a, b)
                        local pa, pb = pOf(a), pOf(b)
                        if pa ~= pb then return pa < pb end
                        return a.name:lower() < b.name:lower()
                end)
                OR.sortedByPrice = true
        else
                table.sort(list, function(a, b) return a.name:lower() < b.name:lower() end)
                OR.sortedByPrice = false
        end
        OR.models = list
        OR.lastFetch = tick()
        if not silent then print("[Sebas AI] โหลดโมเดลสำเร็จ: " .. #list .. " รายการ (จาก " .. EP.base() .. ")"
                .. (hasPrice and " · เรียงราคาถูกสุดก่อน" or "")) end
        return true, #list
end

OR.getModels = function()
        if #OR.models > 0 then return OR.models, true end
        local fb = {}
        for _, m in ipairs(AVAILABLE_MODELS) do
                fb[#fb + 1] = { id = m.id, name = m.name, params = "", quant = "", family = "",
                        size = 0, modified = "", ctx = 0, pin = -1, pout = -1 }
        end
        return fb, false
end

-- ═══════════════════════════════════════════════════════════════
-- ⊢ GENERIC MODAL SYSTEM — เปิด/ปิดสเกลสปริง + หมุนสลับฝั่ง + เสียง
-- ═══════════════════════════════════════════════════════════════
local modalBackdrop = Instance.new("TextButton", sg)
modalBackdrop.Size = UDim2.new(1, 0, 1, 0)
modalBackdrop.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
modalBackdrop.BackgroundTransparency = 1
modalBackdrop.BorderSizePixel = 0
modalBackdrop.Text = ""
modalBackdrop.AutoButtonColor = false
modalBackdrop.ZIndex = 50
modalBackdrop.Visible = false

local modalFlip = 1
local bdGen = 0   -- รุ่นของ backdrop (กัน backdrop ค้าง visible หลังปิด modal)

-- guard ให้ carousel gesture รู้ว่ามี modal เปิดอยู่ (ไม่ปัดหน้าใต้ modal)
UIX.modalOpen = function() return modalBackdrop.Visible end

local function showBackdrop(on)
        bdGen = bdGen + 1
        local gen = bdGen
        if on then
                modalBackdrop.Visible = true
                ANIM.play(modalBackdrop, { BackgroundTransparency = 0.45 },
                        { t = 0.22, tag = "bd" })
        else
                ANIM.play(modalBackdrop, { BackgroundTransparency = 1 },
                        { t = 0.18, tag = "bd", cb = function()
                                if modalBackdrop.Parent and bdGen == gen then modalBackdrop.Visible = false end
                        end })
                -- ⚠ FIX "บางครั้งปัดแท็บไม่ได้": เดิมซ่อน backdrop ด้วย tween cb อย่างเดียว
                --   ถ้า tween โดนยกเลิก (มี tween แท็ก bd ใหม่แทรก/executor หลุด cb)
                --   backdrop จะค้าง Visible=true ตลอดไป → modalOpen() ตลอด → ปัด carousel ตาย
                --   ถาวร — เพิ่ม timer สำรองปิดการันตี (gen ตรง = ไม่มีการเปิดใหม่แทรกกลาง)
                task.delay(0.26, function()
                        if modalBackdrop.Parent and modalBackdrop.Visible and bdGen == gen then
                                modalBackdrop.Visible = false
                        end
                end)
        end
end

local function openModal(m)
        if not m then return end
        -- ⚠ ตามคำขอ: popup/modal เปิดมากลางจอเสมอ — ยกเว้นเคยลากไว้ → กลับตำแหน่งที่ลากไว้ (UIX._fp)
        pcall(function()
                local vp = Camera.ViewportSize
                local w, h = m.Size.X.Offset, m.Size.Y.Offset
                local sp = UIX._fp and UIX._fp[m]
                local x, y
                if sp then
                        x, y = sp.x, sp.y
                else
                        x, y = (vp.X - w) / 2, (vp.Y - h) / 2
                end
                x = math.clamp(x, 0, math.max(0, vp.X - w))
                y = math.clamp(y, 0, math.max(0, vp.Y - h))
                m.Position = UDim2.fromOffset(math.floor(x), math.floor(y))
        end)
        modalFlip = -modalFlip
        showBackdrop(true)
        if UIX.setBlur then pcall(UIX.setBlur, true) end   -- เบลอพื้นหลังเหมือนหน้า login
        m.Visible = true
        local us = addScale(m, 0.88)
        m.Rotation = 1.2 * modalFlip      -- เอียงน้อย ๆ พอมีชีวิต ไม่ให้ดูสั่น
        m.BackgroundTransparency = 0.25
        ANIM.play(us, { Scale = 1 }, { t = 0.24, style = Enum.EasingStyle.Back, dir = Enum.EasingDirection.Out, tag = "mo" })
        ANIM.play(m, { Rotation = 0, BackgroundTransparency = 0 }, { t = 0.24, style = Enum.EasingStyle.Quint, dir = Enum.EasingDirection.Out, tag = "mr" })
        SND.play("open")
end

local function closeModal(m, cb)
        if not m or not m.Visible then return end
        local us = m:FindFirstChild("SebasScale")
        if us then
                ANIM.play(us, { Scale = 0.9 }, { t = 0.15, style = Enum.EasingStyle.Quint, dir = Enum.EasingDirection.In, tag = "mo" })
        end
        ANIM.play(m, { Rotation = -1 * modalFlip, BackgroundTransparency = 1 },
                { t = 0.15, style = Enum.EasingStyle.Quint, dir = Enum.EasingDirection.In, tag = "mr",
                        cb = function()
                                m.Visible = false
                                m.Rotation = 0
                                m.BackgroundTransparency = 0
                                if cb then cb() end
                        end })
        showBackdrop(false)
        if UIX.setBlur then pcall(UIX.setBlur, false) end   -- เลิกเบลอพื้นหลัง
        SND.play("close")
end

-- export ให้ p13 (upgrade modal) ใช้ระบบ modal เดียวกัน
UIX.openModal = openModal
UIX.closeModal = closeModal

-- ═══════════════════════════════════════════════════════════════
-- MODEL SELECTOR MODAL
-- ═══════════════════════════════════════════════════════════════
do
        local vp = Camera.ViewportSize
        local mW = math.clamp(vp.X - 24, 300, 460)
        local mH = math.clamp(vp.Y - 24, 330, 470)

        local modelModal = F(sg, UDim2.fromOffset(mW, mH), UDim2.new(.5, -mW / 2, .5, -mH / 2), C.POP, 14, 60)
        themed(modelModal, "BackgroundColor3", "POP")
        modelModal.Visible = false
        modelModal.ClipsDescendants = true
        modelModal.Name = "ModelModal"
        Sk(modelModal, "AC", 1.5, 0.25)

        local mHdr = F(modelModal, UDim2.new(1, 0, 0, 38), UDim2.new(), C.AREA, 10, 61)
        themed(mHdr, "BackgroundColor3", "AREA")
        local mHdrP = Instance.new("Frame", mHdr)
        mHdrP.Size = UDim2.new(1, 0, 0, 14)
        mHdrP.Position = UDim2.new(0, 0, 1, -14)
        mHdrP.BackgroundColor3 = C.AREA; mHdrP.BorderSizePixel = 0; mHdrP.ZIndex = 61
        themed(mHdrP, "BackgroundColor3", "AREA")

        local mHdrLbl = Lk(mHdr, "🤖  SELECT MODEL", UDim2.new(1, -80, 1, 0), UDim2.fromOffset(12, 0), 11, BF, "T1", Enum.TextXAlignment.Left, 62)
        local mRefBtn = mkBtn(mHdr, "↻", UDim2.fromOffset(26, 24), UDim2.new(1, -60, .5, -12), "soft", 12, 62)
        local mCloseBtn = mkBtn(mHdr, "✕", UDim2.fromOffset(24, 24), UDim2.new(1, -30, .5, -12), "danger", 11, 62)

        -- modal ลากได้จับที่หัวการ์ด + clamp ขอบจอ (เหมือน popup ทุกตัว)
        if UIX.floatDrag then pcall(UIX.floatDrag, modelModal, mHdr) end

        local mSearch = Instance.new("TextBox", modelModal)
        mSearch.Size = UDim2.new(1, -16, 0, 30)
        mSearch.Position = UDim2.fromOffset(8, 44)
        mSearch.BackgroundColor3 = C.CD; mSearch.BorderSizePixel = 0
        mSearch.PlaceholderText = "🔍  ค้นหาโมเดล... (เช่น gptoss, gemma, qwen)"
        mSearch.Text = ""; mSearch.TextColor3 = C.T1; mSearch.PlaceholderColor3 = C.T2
        mSearch.Font = RF; mSearch.TextSize = 10
        mSearch.ZIndex = 62; mSearch.ClearTextOnFocus = false
        themed(mSearch, "BackgroundColor3", "CD")
        themed(mSearch, "TextColor3", "T1")
        Instance.new("UICorner", mSearch).CornerRadius = UDim.new(0, 8)
        Sk(mSearch, "BD", 1, 0.45)

        local mStatus = Lk(modelModal, "● ยังไม่ได้โหลด", UDim2.new(1, -16, 0, 14), UDim2.fromOffset(12, 78), 8, RF, "T2", Enum.TextXAlignment.Left, 62)

        local mScroll = Instance.new("ScrollingFrame", modelModal)
        mScroll.Size = UDim2.new(1, -8, 1, -172)
        mScroll.Position = UDim2.fromOffset(4, 96)
        mScroll.BackgroundTransparency = 1
        mScroll.ScrollBarThickness = 3
        mScroll.ScrollBarImageColor3 = C.BD
        mScroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
        mScroll.CanvasSize = UDim2.new()
        mScroll.ZIndex = 61; mScroll.ClipsDescendants = true
        local mList = Instance.new("UIListLayout", mScroll)
        mList.Padding = UDim.new(0, 3)
        Instance.new("UIPadding", mScroll).PaddingTop = UDim.new(0, 3)

        -- ─── ✏️ พิมพ์ชื่อโมเดลเอง — แสดงเฉพาะโหมด Local AI ───
        --   (เซิร์ฟเวอร์ในเครื่อง: Ollama localhost / LM Studio / llama.cpp ฯลฯ)
        --   ใช้ตอนรายการดึงมาไม่ตรง หรืออยากฟอร์สชื่อโมเดลเอง
        local manRow = Instance.new("Frame", modelModal)
        manRow.Name = "MManualRow"
        manRow.Size = UDim2.new(1, -16, 0, 30)
        manRow.Position = UDim2.fromOffset(8, 78)
        manRow.BackgroundTransparency = 1
        manRow.Visible = false
        manRow.ZIndex = 62

        local manBox = Instance.new("TextBox", manRow)
        manBox.Name = "MManualBox"
        manBox.Size = UDim2.new(1, -64, 1, -2)
        manBox.Position = UDim2.fromOffset(0, 1)
        manBox.BackgroundColor3 = C.CD; manBox.BorderSizePixel = 0
        manBox.PlaceholderText = "✏️  พิมพ์ชื่อโมเดลเอง เช่น llama3.2, gpt-oss:20b"
        manBox.Text = ""; manBox.TextColor3 = C.T1; manBox.PlaceholderColor3 = C.T2
        manBox.Font = Enum.Font.Code; manBox.TextSize = 9
        manBox.TextTruncate = Enum.TextTruncate.AtEnd
        manBox.ZIndex = 63; manBox.ClearTextOnFocus = false
        themed(manBox, "BackgroundColor3", "CD")
        themed(manBox, "TextColor3", "T1")
        Instance.new("UICorner", manBox).CornerRadius = UDim.new(0, 8)
        Sk(manBox, "BD", 1, 0.45)

        local manBtn = mkBtn(manRow, "✓  ใช้", UDim2.fromOffset(56, 28), UDim2.new(1, -56, 0, 1), "accent", 9, 63)
        manBtn.Name = "MManualBtn"

        -- จัดเลย์เอาต์ตามโหมด: local → มีแถวพิมพ์เอง (เลื่อน status/ลิสต์ลง) · ปกติ → เหมือนเดิม
        local function layoutManual()
                local isL = EP.isLocal()
                manRow.Visible = isL
                if isL then
                        manBox.Text = S.currentModel
                        mStatus.Position = UDim2.fromOffset(12, 112)
                        mScroll.Position = UDim2.fromOffset(4, 130)
                        mScroll.Size = UDim2.new(1, -8, 1, -206)
                else
                        mStatus.Position = UDim2.fromOffset(12, 78)
                        mScroll.Position = UDim2.fromOffset(4, 96)
                        mScroll.Size = UDim2.new(1, -8, 1, -172)
                end
        end

        local mDetail = F(modelModal, UDim2.new(1, -16, 0, 66), UDim2.fromOffset(8, mH - 74), C.AREA, 8, 61)
        themed(mDetail, "BackgroundColor3", "AREA")
        mDetail.ClipsDescendants = true
        local mdName = Lk(mDetail, "—  เลือกโมเดลเพื่อดูรายละเอียด", UDim2.new(1, -12, 0, 14), UDim2.fromOffset(8, 4), 9, BF, "T1", Enum.TextXAlignment.Left, 62)
        mdName.TextTruncate = Enum.TextTruncate.AtEnd
        local mdPrice = Lk(mDetail, "", UDim2.new(1, -12, 0, 12), UDim2.fromOffset(8, 19), 8, RF, "AC", Enum.TextXAlignment.Left, 62)
        local mdDesc = Lk(mDetail, "", UDim2.new(1, -12, 0, 28), UDim2.fromOffset(8, 33), 7, RF, "T2", Enum.TextXAlignment.Left, 62)
        mdDesc.TextWrapped = true; mdDesc.TextTruncate = Enum.TextTruncate.AtEnd
        mdDesc.TextYAlignment = Enum.TextYAlignment.Top

        local function setDetail(m)
                if not m then return end
                local prov = EP.provider()
                mdName.Text = (prov and prov.icon or "🤖") .. " " .. m.name
                mdName.TextColor3 = C.T1
                local bits = {}
                if m.params ~= "" then bits[#bits + 1] = "param " .. m.params end
                if m.quant ~= "" then bits[#bits + 1] = m.quant end
                if m.size > 0 then bits[#bits + 1] = OR.fmtSize(m.size) end
                if m.family ~= "" then bits[#bits + 1] = "family " .. m.family end
                if m.ctx > 0 then bits[#bits + 1] = "ctx " .. OR.fmtCtx(m.ctx) end
                local pr = OR.pricePerM(m)
                if pr then
                        bits[#bits + 1] = pr <= 0 and "⭐ FREE" or ("💰 " .. OR.fmtPrice(pr) .. " (in+out)")
                end
                mdPrice.Text = #bits > 0 and table.concat(bits, " · ") or ("id: " .. m.id)
                mdPrice.TextColor3 = C.AC
                local prLine = ""
                if pr and pr > 0 then
                        prLine = " · in " .. OR.fmtPrice(m.pin * 1e6) .. " · out " .. OR.fmtPrice((tonumber(m.pout) or 0) * 1e6)
                end
                mdDesc.Text = "id: " .. m.id .. prLine
                        .. (m.modified ~= "" and ((prLine == "" and " · updated " or " · ") .. m.modified:sub(1, 10)) or "")
        end

        local function renderModels()
                for _, ch in ipairs(mScroll:GetChildren()) do
                        if ch:IsA("GuiObject") then ch:Destroy() end
                end
                local models, isLive = OR.getModels()
                local q = OR.normStr(mSearch.Text)
                local shown = {}
                for _, m in ipairs(models) do
                        if q == "" or OR.normStr(m.name):find(q, 1, true) or OR.normStr(m.id):find(q, 1, true) then
                                shown[#shown + 1] = m
                        end
                end

                local totalN = #shown
                mStatus.Text = (isLive and ("● สดจาก Base URL · " .. EP.base()) or "● fallback list (กด ↻ เพื่อดึงสด)")
                        .. "  ·  " .. totalN .. " โมเดล"
                mStatus.TextTruncate = Enum.TextTruncate.AtEnd
                mStatus.TextColor3 = isLive and C.OK or C.WN

                if totalN == 0 then
                        local e = Instance.new("TextLabel", mScroll)
                        e.Size = UDim2.new(1, 0, 0, 40); e.BackgroundTransparency = 1
                        e.Text = "ไม่พบโมเดลที่ชื่อใกล้เคียง"; e.TextColor3 = C.T2
                        e.Font = RF; e.TextSize = 10; e.ZIndex = 62
                        return
                end

                local function mkSection(text, count, col)
                        local h = F(mScroll, UDim2.new(1, -4, 0, 22), nil, C.AREA, 6, 62)
                        themed(h, "BackgroundColor3", "AREA")
                        L(h, text .. "  (" .. count .. ")", UDim2.new(1, -8, 1, 0), UDim2.fromOffset(8, 0), 9, BF, col, Enum.TextXAlignment.Left, 63)
                end

                local function mkRow(m)
                        local isActive = S.currentModel == m.id
                        local row = Instance.new("TextButton", mScroll)
                        row.Size = UDim2.new(1, -4, 0, 40)
                        row.BackgroundColor3 = isActive and C.AC or C.CD
                        row.BorderSizePixel = 0
                        row.Text = ""; row.AutoButtonColor = false
                        row.TextXAlignment = Enum.TextXAlignment.Left
                        row.ZIndex = 62
                        themed(row, "BackgroundColor3", isActive and "AC" or "CD")
                        Instance.new("UICorner", row).CornerRadius = UDim.new(0, 8)

                        L(row, m.name, UDim2.new(1, -112, 0, 15), UDim2.fromOffset(9, 3), 9, BF,
                                isActive and Color3.fromRGB(255, 255, 255) or C.T1, Enum.TextXAlignment.Left, 63)
                        local idl = L(row, m.id, UDim2.new(1, -112, 0, 11), UDim2.fromOffset(9, 19), 7, RF,
                                isActive and Color3.fromRGB(255, 255, 255) or C.T2, Enum.TextXAlignment.Left, 63)
                        idl.TextTruncate = Enum.TextTruncate.AtEnd
                        -- ขวา: ราคา (ค่ายที่ส่งราคามา — เรียงถูกสุดก่อน) หรือ ขนาดพารามิเตอร์/ไฟล์
                        local pr = OR.pricePerM(m)
                        local sizeTxt, subTxt
                        if pr then
                                sizeTxt = pr <= 0 and "⭐ FREE" or OR.fmtPrice(pr)
                                subTxt = m.ctx > 0 and ("ctx " .. OR.fmtCtx(m.ctx)) or ""
                        else
                                sizeTxt = m.params ~= "" and m.params or (m.size > 0 and OR.fmtSize(m.size) or "")
                                subTxt = m.size > 0 and OR.fmtSize(m.size) or (m.quant ~= "" and m.quant or (m.ctx > 0 and "ctx " .. OR.fmtCtx(m.ctx) or ""))
                        end
                        if sizeTxt ~= "" then
                                L(row, sizeTxt, UDim2.fromOffset(98, 12), UDim2.new(1, -104, 0, 4), 8, BF,
                                        isActive and Color3.fromRGB(255, 255, 255) or ((pr and pr <= 0) and C.OK or C.AC), Enum.TextXAlignment.Right, 63)
                        end
                        if subTxt ~= "" and subTxt ~= sizeTxt then
                                L(row, subTxt, UDim2.fromOffset(98, 11), UDim2.new(1, -104, 0, 19), 7, RF,
                                        isActive and Color3.fromRGB(255, 255, 255) or C.T2, Enum.TextXAlignment.Right, 63)
                        end
                        row.MouseButton1Click:Connect(function()
                                S.currentModel = m.id; MODEL = m.id
                                UIX.currentModelLbl.Text = "Current: " .. m.id
                                saveSettings(); setDetail(m)
                                SND.play("success")
                                notify("🤖 Model", "Selected: " .. m.name, "ok")
                                renderModels()
                        end)
                        hookBtn(row, { sound = false })
                end

                local cap, drawn = 150, 0
                local prov = EP.provider()
                local sortTxt = OR.sortedByPrice and "เรียงราคา: ถูกสุดก่อน" or "เรียงตามชื่อ"
                local secTxt = (prov and (prov.icon .. " " .. prov.name) or "🤖 Custom") .. " · " .. sortTxt
                if EP.isLocal() then secTxt = secTxt .. " · ✏️ พิมพ์ชื่อเองด้านบนได้" end
                mkSection(secTxt, totalN, C.AC)
                for _, m in ipairs(shown) do
                        if drawn >= cap then break end
                        mkRow(m); drawn = drawn + 1
                end
        end

        function UIX.openModelSelector()
                local prov = EP.provider()
                mHdrLbl.Text = "🤖  SELECT MODEL — " .. string.upper(prov and prov.name or "custom")
                layoutManual()   -- ✏️ แถวพิมพ์เอง (local) + จัดตำแหน่ง status/ลิสต์ให้พอดี
                renderModels()
                openModal(modelModal)
                if #OR.models == 0 or (tick() - OR.lastFetch) > 600 then
                        mStatus.Text = "⏳  กำลังดึงรายการโมเดลจาก Base URL..."
                        mStatus.TextColor3 = C.WN
                        task.spawn(function()
                                local ok = false
                                pcall(function() ok = OR.fetchModels(true) end)
                                if modelModal.Visible then renderModels() end
                                if not ok and #OR.models == 0 then
                                        mStatus.Text = "❌ โหลดไม่สำเร็จ — ใช้ fallback list (กด ↻ ลองใหม่)"
                                        mStatus.TextColor3 = C.NO
                                end
                        end)
                end
        end

        mCloseBtn.MouseButton1Click:Connect(function()
                closeModal(modelModal)
        end)
        -- ⚠ ตามคำขอ "กดตรงไหนไม่ได้เลยจนกว่าจะกดปิดหรือเลือกโมเดล":
        --   คลิก backdrop จึงไม่ปิด modal อีกต่อไป — ปิดได้จากปุ่ม ✕ หรือเลือกโมเดลเท่านั้น

        mRefBtn.MouseButton1Click:Connect(function()
                mStatus.Text = "⏳  กำลังรีเฟรช..."
                mStatus.TextColor3 = C.WN
                task.spawn(function()
                        pcall(OR.fetchModels)
                        renderModels()
                end)
        end)

        local searchT = 0
        mSearch:GetPropertyChangedSignal("Text"):Connect(function()
                local now = tick()
                searchT = now
                task.delay(0.15, function()
                        if searchT == now and modelModal.Visible then renderModels() end
                end)
        end)

        -- ✏️ ใช้โมเดลที่พิมพ์เอง (local) — ผ่าน UIX.applyManualModel ของ p05
        --   + อัปเดตแผงรายละเอียด + ปิด modal
        local function applyMan()
                if not (UIX.applyManualModel and UIX.applyManualModel(tostring(manBox.Text or ""))) then return end
                setDetail({ id = S.currentModel, name = S.currentModel, params = "", quant = "",
                        family = "", size = 0, modified = "", ctx = 0, pin = -1, pout = -1 })
                renderModels()
                closeModal(modelModal)
        end
        manBtn.MouseButton1Click:Connect(applyMan)
        manBox.FocusLost:Connect(function(enter)
                if enter then applyMan() end
        end)
end

-- ═══════════════════════════════════════════════════════════════
-- BLACKLIST ADD MODE (tap player) + MANAGE MODAL
-- ═══════════════════════════════════════════════════════════════
do
        -- dimmer แบบ Frame ธรรมดา (ไม่ Active) — แตะทะลุไปโลกได้สำหรับ raycast
        local addDimmer = Instance.new("Frame", sg)
        addDimmer.Size = UDim2.new(1, 0, 1, 0)
        addDimmer.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
        addDimmer.BackgroundTransparency = 1
        addDimmer.BorderSizePixel = 0
        addDimmer.ZIndex = 55
        addDimmer.Visible = false

        local function showAddDim(on)
                if on then
                        addDimmer.Visible = true
                        ANIM.play(addDimmer, { BackgroundTransparency = 0.55 }, { t = 0.22, tag = "ad" })
                else
                        ANIM.play(addDimmer, { BackgroundTransparency = 1 }, { t = 0.18, tag = "ad",
                                cb = function() if addDimmer.Parent then addDimmer.Visible = false end end })
                end
        end

        local addPopup = F(sg, UDim2.fromOffset(280, 44), UDim2.new(.5, -140, .5, -22), C.POP, 12, 70)
        themed(addPopup, "BackgroundColor3", "POP")
        addPopup.Visible = false
        Sk(addPopup, "WN", 1.5, 0.2)
        Lk(addPopup, "Tap player to blacklist", UDim2.new(1, -12, 1, 0), UDim2.fromOffset(6, 0), 10, BF, "T1", Enum.TextXAlignment.Center, 71)

        local addModeActive, addModeConn = false, nil
        UIX.isAddMode = function() return addModeActive == true end

        local function exitAddMode()
                addModeActive = false
                if addModeConn then addModeConn:Disconnect(); addModeConn = nil end
                showAddDim(false)
                ANIM.play(addPopup, { BackgroundTransparency = 1, Size = UDim2.fromOffset(260, 38) },
                        { t = 0.16, style = Enum.EasingStyle.Quart, dir = Enum.EasingDirection.In, tag = "ap",
                                cb = function() addPopup.Visible = false end })
                addPopup.BackgroundTransparency = 0
        end

        UIX.blAddBtn.MouseButton1Click:Connect(function()
                showAddDim(true)
                addPopup.Visible = true
                addPopup.Size = UDim2.fromOffset(258, 38)
                ANIM.play(addPopup, { Size = UDim2.fromOffset(280, 44) },
                        { t = 0.18, style = Enum.EasingStyle.Back, dir = Enum.EasingDirection.Out, tag = "ap" })
                SND.play("open")
                task.delay(2.5, function()
                        if addModeActive then
                                ANIM.play(addPopup, { BackgroundTransparency = 1 },
                                        { t = 0.3, tag = "ap", cb = function()
                                                if addModeActive then addPopup.Visible = false end
                                        end })
                        end
                end)
                addModeActive = true
                addModeConn = UIS.InputBegan:Connect(function(inp, gpe)
                        if gpe or not addModeActive then return end
                        if inp.UserInputType ~= Enum.UserInputType.MouseButton1 and inp.UserInputType ~= Enum.UserInputType.Touch then return end
                        local ray = Camera:ScreenPointToRay(inp.Position.X, inp.Position.Y)
                        local rp = RaycastParams.new()
                        rp.FilterType = Enum.RaycastFilterType.Exclude
                        rp.FilterDescendantsInstances = LP.Character and { LP.Character } or {}
                        local result = workspace:Raycast(ray.Origin, ray.Direction * 600, rp)
                        if result and result.Instance then
                                for _, p in ipairs(Players:GetPlayers()) do
                                        if p ~= LP and p.Character and result.Instance:IsDescendantOf(p.Character) then
                                                S.blacklist[tostring(p.UserId)] = p.DisplayName
                                                saveSettings()
                                                exitAddMode()
                                                SND.play("error")
                                                notify("⛔ Blacklisted", p.DisplayName .. " blocked.", "err")
                                                break
                                        end
                                end
                        end
                end)
        end)

        -- manage modal
        local mngModal = F(sg, UDim2.fromOffset(280, 310), UDim2.new(.5, -140, .5, -155), C.POP, 12, 65)
        themed(mngModal, "BackgroundColor3", "POP")
        mngModal.Visible = false
        mngModal.ClipsDescendants = true
        Sk(mngModal, "BD", 1.2, 0.3)

        local mngHdr = F(mngModal, UDim2.new(1, 0, 0, 36), UDim2.new(), C.AREA, 8, 66)
        -- modal ลากได้จับที่หัวการ์ด + clamp ขอบจอ
        if UIX.floatDrag then pcall(UIX.floatDrag, mngModal, mngHdr) end
        themed(mngHdr, "BackgroundColor3", "AREA")
        local mngHdrP = Instance.new("Frame", mngHdr)
        mngHdrP.Size = UDim2.new(1, 0, 0, 14)
        mngHdrP.Position = UDim2.new(0, 0, 1, -14)
        mngHdrP.BackgroundColor3 = C.AREA; mngHdrP.BorderSizePixel = 0; mngHdrP.ZIndex = 66
        themed(mngHdrP, "BackgroundColor3", "AREA")
        Lk(mngHdr, "📋  MANAGE BLACKLIST", UDim2.new(1, -36, 1, 0), UDim2.fromOffset(10, 0), 10, BF, "T1", Enum.TextXAlignment.Left, 67)
        local mngCloseBtn = mkBtn(mngHdr, "✕", UDim2.fromOffset(24, 22), UDim2.new(1, -28, .5, -11), "danger", 11, 67)

        local mngScroll = Instance.new("ScrollingFrame", mngModal)
        mngScroll.Size = UDim2.new(1, -8, 1, -42)
        mngScroll.Position = UDim2.fromOffset(4, 38)
        mngScroll.BackgroundTransparency = 1
        mngScroll.ScrollBarThickness = 3
        mngScroll.ScrollBarImageColor3 = C.BD
        mngScroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
        mngScroll.CanvasSize = UDim2.new()
        mngScroll.ZIndex = 66; mngScroll.ClipsDescendants = true
        local mngLL = Instance.new("UIListLayout", mngScroll)
        mngLL.Padding = UDim.new(0, 4)
        Instance.new("UIPadding", mngScroll).PaddingTop = UDim.new(0, 3)
        Instance.new("UIPadding", mngScroll).PaddingBottom = UDim.new(0, 3)

        function refreshBL()
                for _, ch in ipairs(mngScroll:GetChildren()) do
                        if ch:IsA("Frame") or ch:IsA("TextLabel") then ch:Destroy() end
                end
                local count = 0
                for uid, dname in pairs(S.blacklist) do
                        if searchText ~= "" and not tostring(dname):lower():find(searchText:lower(), 1, true) then
                                continue
                        end
                        count = count + 1
                        local row = F(mngScroll, UDim2.new(1, -4, 0, 36), nil, C.CD, 7, 67)
                        themed(row, "BackgroundColor3", "CD")
                        Lk(row, dname, UDim2.new(1, -68, 0, 16), UDim2.fromOffset(8, 4), 10, BF, "T1", Enum.TextXAlignment.Left, 68)
                        Lk(row, "UID: " .. uid, UDim2.new(1, -68, 0, 12), UDim2.fromOffset(8, 20), 8, RF, "T2", Enum.TextXAlignment.Left, 68)
                        local rmBtn = mkBtn(row, "Remove", UDim2.fromOffset(60, 24), UDim2.new(1, -64, .5, -12), "danger", 9, 68)
                        local cu = uid
                        rmBtn.MouseButton1Click:Connect(function()
                                S.blacklist[cu] = nil; saveSettings(); refreshBL()
                                SND.play("close")
                        end)
                end
                if count == 0 then
                        local e = Instance.new("TextLabel", mngScroll)
                        e.Size = UDim2.new(1, 0, 0, 40)
                        e.BackgroundTransparency = 1
                        e.Text = #S.blacklist == 0 and "No players blacklisted." or "No matches found."
                        e.TextColor3 = C.T2
                        e.Font = RF; e.TextSize = 9; e.ZIndex = 67
                        e.TextXAlignment = Enum.TextXAlignment.Center
                end
        end

        UIX.blManageBtn.MouseButton1Click:Connect(function()
                refreshBL()
                openModal(mngModal)
        end)
        mngCloseBtn.MouseButton1Click:Connect(function()
                closeModal(mngModal)
        end)
end
-- (profile modal ถูกแทนที่ด้วยหน้า Profile เต็มรูปแบบ — ดู p13_auth_login.lua)


-- ═══════════════════════════════════════════════════════════════
-- doConnect — 🖥️ Local AI: ตรวจเซิร์ฟเวอร์ตรง ๆ (ปิดระบบคีย์ทั้งหมด)
--            ☁️ คลาวด์: ทดสอบทุกคีย์ → ต่อได้ถ้า ≥1 ผ่าน
-- ═══════════════════════════════════════════════════════════════
do
        function doConnect(fromAuto)
                if UIX.keyRows then
                        for i = 1, MAX_KEYS do
                                local r = UIX.keyRows[i]
                                if r and type(r.box.Text) == "string" then
                                        S.keys[i] = r.box.Text:gsub("%s+", "")
                                end
                        end
                end
                saveKeys()

                S.thinking = false; S.nextReq = 0

                -- ══ 🖥️ LOCAL AI — ปิดระบบคีย์ทั้งหมด: ตรวจเซิร์ฟเวอร์ตรง ๆ ไม่ยุ่งกับคีย์ ══
                --   แม้ช่องคีย์จะมีข้อความค้างจากค่ายคลาวด์ก็ไม่ทดสอบ ไม่ส่ง Bearer
                --   localProbe ลอง localhost → 127.0.0.1 ให้เอง (กัน localhost ชี้ IPv6)
                if EP.isLocal() then
                        UIX.statusLbl.Text = "● กำลังต่อ Local AI..."
                        UIX.statusLbl.TextColor3 = C.WN
                        if UIX.setLocalStat then UIX.setLocalStat("⏳ กำลังเชื่อมต่อ " .. EP.base(), C.WN) end
                        task.spawn(function()
                                local ok, usedBase = localProbe()
                                if ok then
                                        -- localhost ต่อไม่ได้แต่ 127.0.0.1 ได้ → จำ base ที่ใช้ได้ไปใช้ต่อ (แชท/โมเดล)
                                        if type(usedBase) == "string" and usedBase ~= EP.base() then
                                                S.baseURL = usedBase
                                                saveSettings()
                                                if UIX.refreshProviderUI then UIX.refreshProviderUI() end
                                        end
                                        S.connected = true
                                        S.key = ""; S.curKey = 1
                                        S.keyOk[1] = true; S.keyErr[1] = nil; S.keyDry[1] = nil
                                        UIX.statusLbl.Text = "● Connected ✓ (Local AI · ไม่ใช้คีย์)"
                                        UIX.statusLbl.TextColor3 = C.OK
                                        pillDot.BackgroundColor3 = C.OK
                                        updateHUD()
                                        if not fromAuto then
                                                notify("🔗 Connected", "Local AI พร้อมใช้งาน — ไม่ต้องใช้คีย์", "ok")
                                        end
                                        makeRing()
                                        -- เวอร์ชั่น Ollama + จำนวนโมเดล → แผงสถานะ local (เฉพาะโหมด native)
                                        task.spawn(function()
                                                local verTxt, modelN = "", -1
                                                if not EP.oai() then
                                                        pcall(function()
                                                                local okv, resv = pcall(function()
                                                                        return Http({ Url = EP.ver(), Method = "GET", Headers = {} })
                                                                end)
                                                                local rv = normRes(resv)
                                                                if okv and rv and rv.status == 200 then
                                                                        local dv = HttpService:JSONDecode(rv.body)
                                                                        if dv and type(dv.version) == "string" then verTxt = "Ollama " .. dv.version end
                                                                end
                                                        end)
                                                end
                                                pcall(function()
                                                        local okm, resm = pcall(function()
                                                                return Http({ Url = EP.tags(), Method = "GET", Headers = {} })
                                                        end)
                                                        local rm = normRes(resm)
                                                        if okm and rm and rm.status == 200 then
                                                                local dm = HttpService:JSONDecode(rm.body)
                                                                if type(dm) == "table" then
                                                                        if type(dm.models) == "table" then modelN = #dm.models
                                                                        elseif type(dm.data) == "table" then modelN = #dm.data end
                                                                end
                                                        end
                                                end)
                                                local parts = {}
                                                if verTxt ~= "" then parts[#parts + 1] = verTxt end
                                                if modelN >= 0 then parts[#parts + 1] = modelN .. " โมเดลในเครื่อง" end
                                                local statTxt = "เชื่อมต่อแล้ว ✓" .. (#parts > 0 and ("  ·  " .. table.concat(parts, "  ·  ")) or "")
                                                S.localStatTxt = statTxt
                                                if UIX.setLocalStat then UIX.setLocalStat(statTxt, C.OK) end
                                                if UIX.creditLbl then
                                                        UIX.creditLbl.Text = "🖥️  Local AI:  " .. (#parts > 0 and table.concat(parts, "  ·  ") or "พร้อมใช้งาน")
                                                end
                                        end)
                                        task.spawn(function()
                                                task.wait(0.3)
                                                pcall(OR.fetchModels, true)
                                        end)
                                else
                                        S.connected = false; S.key = ""
                                        UIX.statusLbl.Text = "● Local AI ต่อไม่ได้ — เปิด Ollama ในเครื่องก่อน"
                                        UIX.statusLbl.TextColor3 = C.NO
                                        pillDot.BackgroundColor3 = C.NO
                                        updateHUD()
                                        S.localStatTxt = nil
                                        if UIX.setLocalStat then
                                                UIX.setLocalStat("❌ ต่อไม่ได้ — " .. EP.base() .. " ไม่ตอบ", C.NO)
                                        end
                                        if not fromAuto then
                                                notify("❌ Local AI", "ต่อ Ollama ในเครื่องไม่ได้ — เช็คตามนี้:\n① เปิดแอป Ollama (หรือรัน ollama serve) ในเครื่องนี้หรือยัง\n② ลากโมเดลมาไว้ 1 ตัว (ollama pull llama3.2)\n③ เล่น Roblox คนละเครื่องกับ Ollama → พิมพ์ IP เครื่อง Ollama ลงช่อง Base URL เช่น http://192.168.1.50:11434", "err")
                                                SND.play("error")
                                        end
                                end
                        end)
                        return
                end

                -- ══ ☁️ CLOUD — ทดสอบทุกคีย์ตามลำดับ 1→2→3 (ระบบเดิม) ══
                local actN = math.clamp(tonumber(S.activeKeys) or 1, 1, MAX_KEYS)
                if not AUTH.on("multikey") then actN = 1 end   -- 🔒 premium gate: ใช้จริงแค่คีย์เดียว
                local filled = 0
                for i = 1, actN do
                        if type(S.keys[i]) == "string" and #S.keys[i] >= 10 then filled = filled + 1 end
                end
                if filled == 0 then
                        S.connected = false; S.key = ""
                        UIX.statusLbl.Text = "● ยังไม่ใส่คีย์ (ช่อง 1-" .. actN .. ")"
                        UIX.statusLbl.TextColor3 = C.NO
                        pillDot.BackgroundColor3 = C.NO
                        updateHUD()
                        if not fromAuto then
                                local prov = EP.provider()
                                notify("🔑 API Keys", "ยังไม่ได้ใส่คีย์ — สร้างได้ที่ " .. (prov and prov.keyurl or "หน้าเว็บของผู้ให้บริการ"), "err")
                                SND.play("error")
                        end
                        return
                end

                UIX.statusLbl.Text = "● Testing " .. filled .. " key(s)..."
                UIX.statusLbl.TextColor3 = C.WN

                task.spawn(function()
                        local okCount, limCount, srvCount, firstOk = 0, 0, 0, nil
                        local credits = {}

                        for i = 1, actN do
                                local k = S.keys[i]
                                if type(k) == "string" and #k >= 10 then
                                        local ok, info, code = fastTest(k)
                                        if ok then
                                                okCount = okCount + 1
                                                S.keyOk[i] = true; S.keyErr[i] = nil; S.keyDry[i] = nil
                                                if not firstOk then firstOk = i end
                                                if info and info ~= "" then credits[#credits + 1] = "#" .. i .. ": " .. info end
                                        elseif code == "429" then
                                                -- ★ 429 = คีย์ถูกต้อง! (ลิมิตมีผลเฉพาะคีย์ที่ยืนยันแล้ว)
                                                --   ถือว่าต่อได้ — แค่พัก 30 วิ ไม่ใช่คีย์เสีย
                                                okCount = okCount + 1
                                                limCount = limCount + 1
                                                if not firstOk then firstOk = i end
                                                S.keyErr[i] = "429"
                                                S.keyDry[i] = tick() + 30
                                        elseif code == "401" or code == "403" or code == "402" then
                                                S.keyOk[i] = false
                                                S.keyErr[i] = code == "402" and "402$" or code
                                        elseif code == "500" or code == "502" or code == "503" or code == "504" then
                                                -- ★ 5xx = เซิร์ฟเวอร์คลาวด์สะดุดชั่วคราว — ไม่ใช่คีย์เสีย
                                                --   ถือว่าต่อได้ (ยังไม่ได้ตรวจคีย์ — ตอนคุยจริงจะเช็คเอง)
                                                okCount = okCount + 1
                                                srvCount = srvCount + 1
                                                if not firstOk then firstOk = i end
                                                S.keyErr[i] = "srv"
                                        else
                                                -- NET / 404 = ต่อไม่ถึงเซิร์ฟเวอร์ / URL ผิด — ไว้ตรวจตอนคุยจริง
                                                S.keyErr[i] = "srv"
                                        end
                                        if UIX.updateKeyDots then UIX.updateKeyDots() end
                                end
                        end

                        if okCount > 0 and firstOk then
                                S.connected = true
                                S.key = S.keys[firstOk] or ""
                                S.curKey = firstOk
                                UIX.statusLbl.Text = "● Connected ✓ (" .. okCount .. "/" .. math.max(filled, 1) .. " keys)"
                                        .. (limCount > 0 and " · ⏳" .. limCount .. " ติดลิมิตชั่วคราว" or "")
                                        .. (srvCount > 0 and " · ⚠" .. srvCount .. " ยังไม่ได้ตรวจ (เซิร์ฟเวอร์สะดุด)" or "")
                                UIX.statusLbl.TextColor3 = C.OK
                                pillDot.BackgroundColor3 = C.OK
                                -- ข้อมูลเซิร์ฟเวอร์: เวอร์ชั่น Ollama (เฉพาะโหมด native) + สรุปคีย์ตามผู้ให้บริการ
                                task.spawn(function()
                                        local verTxt = ""
                                        if not EP.oai() then
                                                pcall(function()
                                                        local okv, resv = pcall(function()
                                                                return Http({ Url = EP.ver(), Method = "GET", Headers = {} })
                                                        end)
                                                        local rv = normRes(resv)
                                                        if okv and rv and rv.status == 200 then
                                                                local dv = HttpService:JSONDecode(rv.body)
                                                                if dv and type(dv.version) == "string" then verTxt = "Ollama " .. dv.version end
                                                        end
                                                end)
                                        end
                                        if UIX.creditLbl then
                                                local prov = EP.provider()
                                                UIX.creditLbl.Text = (prov and (prov.icon .. "  " .. prov.name) or "🌐  API") .. ":  "
                                                        .. (verTxt ~= "" and (verTxt .. "  ·  ") or "")
                                                        .. (#credits > 0 and table.concat(credits, "  ·  ") or ("Keys OK: " .. okCount))
                                        end
                                end)
                                updateHUD()
                                if not fromAuto then
                                        notify("🔗 Connected", okCount .. "/" .. math.max(filled, 1) .. " ready"
                                                .. (limCount > 0 and " (⏳ " .. limCount .. " ติดลิมิต — ใช้ได้ปกติหลังพักสักครู่)" or ""), "ok")
                                end
                                makeRing()
                                task.spawn(function()
                                        task.wait(0.3)
                                        pcall(OR.fetchModels, true)
                                end)
                        else
                                S.connected = false; S.key = ""
                                UIX.statusLbl.Text = "● ทุกคีย์ใช้ไม่ได้ (เช็คคีย์/เน็ต/Base URL)"
                                UIX.statusLbl.TextColor3 = C.NO
                                pillDot.BackgroundColor3 = C.NO
                                updateHUD()
                                if not fromAuto then
                                        notify("❌ Connection", "ทุกคีย์ใช้ไม่ได้ — เช็คคีย์/เน็ต/Base URL", "err")
                                        SND.play("error")
                                end
                        end
                end)
        end
end

end -- part wrap

do -- p10 HOLD+POPUP (locals หมดอายุตอนจบ part)

-- ═══════════════════════════════════════════════════════════════
-- HOLD-TO-INTERACT SYSTEM (กดค้างบนตัวผู้เล่น)
-- ═══════════════════════════════════════════════════════════════
local HOLD_Z = 800
local IND_SIZE = 52

local holdIndicator = Instance.new("Frame", sg)
holdIndicator.Size = UDim2.fromOffset(IND_SIZE, IND_SIZE)
holdIndicator.BackgroundTransparency = 1
holdIndicator.BorderSizePixel = 0
holdIndicator.ZIndex = HOLD_Z
holdIndicator.Visible = false

local holdTrackOuter = Instance.new("Frame", holdIndicator)
holdTrackOuter.Size = UDim2.fromOffset(IND_SIZE, IND_SIZE)
holdTrackOuter.BackgroundTransparency = 1
holdTrackOuter.BorderSizePixel = 0
holdTrackOuter.ZIndex = HOLD_Z + 1
Instance.new("UICorner", holdTrackOuter).CornerRadius = UDim.new(1, 0)
local holdStroke = Instance.new("UIStroke", holdTrackOuter)
holdStroke.Color = C.AC; holdStroke.Thickness = 2.5; holdStroke.Transparency = 0.15
themed(holdStroke, "Color", "AC")

local holdFill = Instance.new("Frame", holdIndicator)
holdFill.AnchorPoint = Vector2.new(0.5, 0.5)
holdFill.Position = UDim2.fromOffset(IND_SIZE / 2, IND_SIZE / 2)
holdFill.Size = UDim2.fromOffset(0, 0)
holdFill.BackgroundColor3 = C.AC
holdFill.BackgroundTransparency = 0.45
holdFill.BorderSizePixel = 0
holdFill.ZIndex = HOLD_Z + 2
themed(holdFill, "BackgroundColor3", "AC")
Instance.new("UICorner", holdFill).CornerRadius = UDim.new(1, 0)

local holdPctLbl = Instance.new("TextLabel", holdIndicator)
holdPctLbl.Size = UDim2.fromOffset(IND_SIZE, 14)
holdPctLbl.Position = UDim2.fromOffset(0, IND_SIZE + 5)
holdPctLbl.BackgroundTransparency = 1
holdPctLbl.Text = ""
holdPctLbl.TextColor3 = C.AC
holdPctLbl.Font = BF
holdPctLbl.TextSize = 9
holdPctLbl.ZIndex = HOLD_Z + 3
holdPctLbl.TextXAlignment = Enum.TextXAlignment.Center
themed(holdPctLbl, "TextColor3", "AC")

local holdActive, holdStartTime, holdTarget = false, 0, nil
local holdInput, holdPos = nil, nil      -- ⚠ ตามนิ้วจาก InputObject ของนิ้วที่กดค้าง (live-update)
local holdMissSince = nil                -- เวลาที่ ray เริ่มไม่โดนเป้า (ยืดหยุ่น 0.25 วิ กัน flicker ชั่ววูบ)

local function cancelHold()
        holdActive = false; holdTarget = nil; holdInput = nil; holdPos = nil; holdMissSince = nil
        holdIndicator.Visible = false
        holdFill.Size = UDim2.fromOffset(0, 0); holdPctLbl.Text = ""
end

local function completeHold()
        local target = holdTarget
        holdActive = false; holdTarget = nil; holdInput = nil; holdPos = nil; holdMissSince = nil
        holdIndicator.Visible = false
        holdFill.Size = UDim2.fromOffset(0, 0); holdPctLbl.Text = ""
        if target and target.Character and target.Parent then
                local head = target.Character:FindFirstChild("Head")
                local screenPos
                -- ⚠ WorldToViewportPoint = พิกัดเต็มจอ (ตรงกับ sg.IgnoreGuiInset=true ของเรา)
                --   เดิมใช้ WorldToScreenPoint = หัก inset แล้ว popup ตกต่ำกว่าหัวผู้เล่น ~58px บนมือถือ
                if head then
                        local ok, sp = pcall(function() return Camera:WorldToViewportPoint(head.Position) end)
                        if ok and sp then screenPos = Vector2.new(sp.X, sp.Y) end
                else
                        local rootPart = target.Character:FindFirstChild("HumanoidRootPart")
                        if rootPart then
                                local ok, sp = pcall(function()
                                        return Camera:WorldToViewportPoint(rootPart.Position + Vector3.new(0, 3, 0))
                                end)
                                if ok and sp then screenPos = Vector2.new(sp.X, sp.Y) end
                        end
                end
                if screenPos then showRadialPopup(screenPos, target) end
        end
end

UIS.InputBegan:Connect(function(inp, gpe)
        if gpe or holdActive then return end
        if UIX.isAddMode and UIX.isAddMode() then return end
        if inp.UserInputType ~= Enum.UserInputType.MouseButton1 and inp.UserInputType ~= Enum.UserInputType.Touch then return end
        local ok, guisAtPos = pcall(function()
                return GuiService and GuiService:GetGuiObjectsAtPosition(inp.Position.X, inp.Position.Y) or nil
        end)
        if ok and guisAtPos and #guisAtPos > 0 then return end
        local ray = Camera:ScreenPointToRay(inp.Position.X, inp.Position.Y)
        local rp = RaycastParams.new()
        rp.FilterType = Enum.RaycastFilterType.Exclude
        rp.FilterDescendantsInstances = LP.Character and { LP.Character } or {}
        local result = workspace:Raycast(ray.Origin, ray.Direction * 1000, rp)
        if result and result.Instance then
                for _, p in ipairs(Players:GetPlayers()) do
                        if p ~= LP and p.Character and result.Instance:IsDescendantOf(p.Character) then
                                holdTarget = p; holdStartTime = tick(); holdActive = true
                                -- จำ InputObject ของนิ้วนี้ไว้ติดตามตำแหน่งจริง (ไม่พึ่ง GetMouseLocation)
                                holdInput = inp
                                holdPos = Vector2.new(inp.Position.X, inp.Position.Y)
                                holdMissSince = nil
                                holdIndicator.Position = UDim2.fromOffset(inp.Position.X - IND_SIZE / 2, inp.Position.Y - IND_SIZE / 2)
                                holdIndicator.Visible = true
                                holdFill.Size = UDim2.fromOffset(0, 0)
                                holdPctLbl.Text = "0%"
                                SND.play("hover")
                                break
                        end
                end
        end
end)

-- นิ้วที่กดค้างขยับ → อัปเดตตำแหน่งล่าสุด (InputObject เดียวกัน = นิ้วเดียวกัน)
UIS.InputChanged:Connect(function(i)
        if holdActive and holdInput and i == holdInput then
                holdPos = Vector2.new(i.Position.X, i.Position.Y)
        end
end)

UIS.InputEnded:Connect(function(inp)
        if not holdActive then return end
        if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
                cancelHold()
        end
end)

RunService.Heartbeat:Connect(function(dt)
        if not holdActive then return end
        -- ⚠ FIX "กดค้างแล้ววงเลื่อนขึ้นเรื่อย ๆ กดไม่ได้สักที": เดิมใช้ GetMouseLocation()
        --   ซึ่งบนมือถือบางเครื่อง/บาง executor ไม่ตามนิ้วจริง (ค้างที่ (0,0) หรือตามช้า ๆ)
        --   → วงบ่นไปเรื่อย ๆ และ ray หลุดจากตัวผู้เล่น → hold โดนยกเลิกก่อนเสร็จทุกครั้ง
        --   ตอนนี้ตามนิ้วของ InputObject ที่กดจริง (live-update) — เหลือ GetMouseLocation
        --   เป็น fallback สุดท้ายสำหรับเมาส์บน PC เท่านั้น
        local mp = holdPos
        if not mp and holdInput then
                local ip = holdInput.Position
                if ip then mp = Vector2.new(ip.X, ip.Y) end
        end
        if not mp then
                local ok, ml = pcall(function() return UIS:GetMouseLocation() end)
                if ok and ml then mp = Vector2.new(ml.X, ml.Y) end
        end
        if not mp then cancelHold() return end
        local ray = Camera:ScreenPointToRay(mp.X, mp.Y)
        local rp = RaycastParams.new()
        rp.FilterType = Enum.RaycastFilterType.Exclude
        rp.FilterDescendantsInstances = LP.Character and { LP.Character } or {}
        local result = workspace:Raycast(ray.Origin, ray.Direction * 1000, rp)
        local stillOnTarget = false
        if result and result.Instance and holdTarget and holdTarget.Character then
                stillOnTarget = result.Instance:IsDescendantOf(holdTarget.Character)
        end
        -- ยืดหยุ่น: ray หลุดเป้าชั่วคราว (ผู้เล่นขยับ/กล้องสั่น) ไม่ดีใจยกเลิกทันที —
        --   หลุดเกิน 0.25 วิ ค่อยถือว่าเลิกจริง (เดิมหลุดหนึ่งเฟรม = ตายทันที)
        if not stillOnTarget then
                if not holdMissSince then
                        holdMissSince = tick()
                elseif tick() - holdMissSince > 0.25 then
                        cancelHold()
                        return
                end
        else
                holdMissSince = nil
        end
        local elapsed = tick() - holdStartTime
        local progress = math.clamp(elapsed / math.max(S.holdDuration, 0.1), 0, 1)
        local fillMax = IND_SIZE - 8
        holdFill.Size = UDim2.fromOffset(progress * fillMax, progress * fillMax)
        holdFill.BackgroundTransparency = 0.5 - progress * 0.3
        holdIndicator.Position = UDim2.fromOffset(mp.X - IND_SIZE / 2, mp.Y - IND_SIZE / 2)
        holdPctLbl.Position = UDim2.fromOffset(mp.X - IND_SIZE / 2, mp.Y + IND_SIZE / 2 + 3)
        holdPctLbl.Text = math.floor(progress * 100) .. "%"
        if progress >= 1 then completeHold() end
end)

-- ═══════════════════════════════════════════════════════════════
-- RADIAL POPUP — 5 ปุ่ม (Greet / Bye / Toxic / Cancel / CHAT)
--   สไตล์ใหม่: stagger หมุนเด้งเข้า + เสียง + press feedback
-- ═══════════════════════════════════════════════════════════════
local IZ = 850
local iPopupVisible = false

local iCloseZone = Instance.new("TextButton", sg)
iCloseZone.Size = UDim2.new(1, 0, 1, 0)
iCloseZone.BackgroundTransparency = 1; iCloseZone.Text = ""
iCloseZone.ZIndex = IZ + 20; iCloseZone.Visible = false
iCloseZone.MouseButton1Click:Connect(function()
        if iPopupVisible then closeRadialPopup() end
end)

local POP_SIZE = 260
local CENTER = POP_SIZE / 2
local MAIN_R = 44
local SMALL_R = 27
local OFFSET = 90

local iPopup = Instance.new("Frame", sg)
iPopup.Size = UDim2.fromOffset(POP_SIZE, POP_SIZE)
iPopup.BackgroundTransparency = 1
iPopup.BorderSizePixel = 0
iPopup.ZIndex = IZ + 30
iPopup.Visible = false

local btnChat = Instance.new("TextButton", iPopup)
btnChat.Size = UDim2.fromOffset(MAIN_R * 2, MAIN_R * 2)
btnChat.Position = UDim2.fromOffset(CENTER - MAIN_R, CENTER - MAIN_R)
btnChat.BackgroundColor3 = C.AC; btnChat.BorderSizePixel = 0
btnChat.Text = "💬\nChat"; btnChat.TextColor3 = Color3.fromRGB(255, 255, 255)
btnChat.Font = BF; btnChat.TextSize = 10
btnChat.AutoButtonColor = false; btnChat.ZIndex = IZ + 36
themed(btnChat, "BackgroundColor3", "AC")
Instance.new("UICorner", btnChat).CornerRadius = UDim.new(1, 0)
local chatStk = Instance.new("UIStroke", btnChat)
chatStk.Color = Color3.fromRGB(255, 255, 255); chatStk.Thickness = 2; chatStk.Transparency = 0.55

local targetNameLbl = Instance.new("TextLabel", iPopup)
targetNameLbl.Size = UDim2.new(1, 0, 0, 14)
targetNameLbl.Position = UDim2.new(0, 0, 1, -16)
targetNameLbl.BackgroundTransparency = 1; targetNameLbl.Text = ""
targetNameLbl.TextColor3 = C.T1
targetNameLbl.TextSize = 10; targetNameLbl.Font = BF
targetNameLbl.ZIndex = IZ + 35
targetNameLbl.TextTruncate = Enum.TextTruncate.AtEnd
targetNameLbl.TextXAlignment = Enum.TextXAlignment.Center
themed(targetNameLbl, "TextColor3", "T1")

-- popup ลากได้: จับปุ่ม 💬 CHAT กลางวงแล้วลากทั้งวง — clamp ขอบจอเหมือน popup อื่น
-- (แตะเฉย ๆ ไม่ขยับ = กด CHAT ปกติ — แยกด้วยระยะเลื่อน >4px ของระบบ drag)
if UIX.floatDrag then pcall(UIX.floatDrag, iPopup, btnChat, { keep = 80 }) end

local function makeSmallBtn(text, bgColor, txtColor, stkColor, cx, cy)
        local btn = Instance.new("TextButton", iPopup)
        btn.Size = UDim2.fromOffset(SMALL_R * 2, SMALL_R * 2)
        btn.Position = UDim2.fromOffset(cx - SMALL_R, cy - SMALL_R)
        btn.BackgroundColor3 = bgColor; btn.BorderSizePixel = 0
        btn.Text = text; btn.TextColor3 = txtColor
        btn.Font = BF; btn.TextSize = 8; btn.AutoButtonColor = false
        btn.ZIndex = IZ + 35
        Instance.new("UICorner", btn).CornerRadius = UDim.new(1, 0)
        local stk = Instance.new("UIStroke", btn)
        stk.Color = stkColor; stk.Thickness = 1.5; stk.Transparency = 0.25
        btn.MouseEnter:Connect(function()
                ANIM.play(stk, { Transparency = 0 }, { t = 0.12, tag = "hs" })
                ANIM.play(btn, { BackgroundTransparency = 0.15 }, { t = 0.12, tag = "hb" })
        end)
        btn.MouseLeave:Connect(function()
                ANIM.play(stk, { Transparency = 0.25 }, { t = 0.12, tag = "hs" })
                ANIM.play(btn, { BackgroundTransparency = 0 }, { t = 0.12, tag = "hb" })
        end)
        return btn
end

local btnGreet       = makeSmallBtn("Greet",       Color3.fromRGB(50, 190, 110), Color3.fromRGB(255, 255, 255), Color3.fromRGB(40, 160, 90), CENTER, CENTER - OFFSET)
local btnBye         = makeSmallBtn("Goodbye",     Color3.fromRGB(88, 162, 255), Color3.fromRGB(255, 255, 255), Color3.fromRGB(70, 140, 235), CENTER, CENTER + OFFSET)
local btnToxic       = makeSmallBtn("Toxic\nMode", Color3.fromRGB(255, 72, 72),  Color3.fromRGB(255, 255, 255), Color3.fromRGB(220, 55, 55), CENTER + OFFSET, CENTER)
local btnCancelToxic = makeSmallBtn("Cancel\nToxic",Color3.fromRGB(90, 90, 110), Color3.fromRGB(210, 210, 220), Color3.fromRGB(70, 70, 90), CENTER - OFFSET, CENTER)

-- guard ให้ carousel gesture รู้ว่า radial popup เปิดอยู่
UIX.iPopupOpen = function() return iPopupVisible == true end

function closeRadialPopup()
        if not iPopupVisible then return end
        iPopupVisible = false
        -- ดูดหายแบบเร็ว
        ANIM.play(btnChat, { Size = UDim2.fromOffset(0, 0), Position = UDim2.fromOffset(CENTER, CENTER) },
                { t = 0.14, style = Enum.EasingStyle.Quart, dir = Enum.EasingDirection.In, tag = "rp" })
        for _, b in ipairs({ btnGreet, btnBye, btnToxic, btnCancelToxic }) do
                ANIM.play(b, { Size = UDim2.fromOffset(0, 0) }, { t = 0.14, style = Enum.EasingStyle.Quart, dir = Enum.EasingDirection.In, tag = "rp" })
        end
        task.delay(0.15, function()
                if not iPopupVisible then
                        iPopup.Visible = false; iCloseZone.Visible = false
                        targetNameLbl.Text = ""
                end
        end)
        SND.play("close")
end

function showRadialPopup(screenPos, targetPlayer)
        iPopupVisible = true
        targetNameLbl.Text = targetPlayer.DisplayName
        local vp = Camera.ViewportSize
        -- clamp ปลอดภัย: max >= min เสมอ (จอเตี้ยกว่า popup ก็ไม่ error แล้ว)
        local px = math.clamp(screenPos.X - CENTER, 4, math.max(4, vp.X - POP_SIZE - 4))
        local py = math.clamp(screenPos.Y - CENTER - 40, 4, math.max(4, vp.Y - POP_SIZE - 4))
        iPopup.Position = UDim2.fromOffset(px, py)
        iPopup.Visible = true; iCloseZone.Visible = true

        -- reset สำหรับแอนิเมชั่น (เด้งหมุนเข้าทีละตัว ตามตำแหน่งปลายทางของแต่ละปุ่ม)
        local function popBtn(btn, size, fx, fy, delay, rot)
                btn.Size = UDim2.fromOffset(0, 0)
                btn.Position = UDim2.fromOffset(fx, fy)
                btn.Rotation = rot
                task.delay(delay, function()
                        ANIM.play(btn, {
                                Size = UDim2.fromOffset(size, size),
                                Position = UDim2.fromOffset(fx - size / 2, fy - size / 2),
                                Rotation = 0,
                        }, { t = 0.3, style = Enum.EasingStyle.Back, dir = Enum.EasingDirection.Out, tag = "rp" })
                end)
        end

        popBtn(btnChat, MAIN_R * 2, CENTER, CENTER, 0, 30)
        popBtn(btnGreet, SMALL_R * 2, CENTER, CENTER - OFFSET, 0.06, -25)
        popBtn(btnBye, SMALL_R * 2, CENTER, CENTER + OFFSET, 0.1, 25)
        popBtn(btnToxic, SMALL_R * 2, CENTER + OFFSET, CENTER, 0.14, -30)
        popBtn(btnCancelToxic, SMALL_R * 2, CENTER - OFFSET, CENTER, 0.18, 30)

        SND.play("popup")
end

local function getPopupTarget()
        for _, p in ipairs(Players:GetPlayers()) do
                if p.DisplayName == targetNameLbl.Text then return p end
        end
        return nil
end

-- CHAT — ต่อบทสนทนากับผู้เล่นนี้
btnChat.MouseButton1Click:Connect(function()
        local target = getPopupTarget()
        closeRadialPopup()
        if not target or not S.connected then return end
        local uid = tostring(target.UserId)
        local nm = S.playerNick[uid] or target.DisplayName
        S.playerNames[uid] = target.DisplayName

        task.spawn(function()
                if S.responseDelay > 0 then task.wait(S.responseDelay) end
                if not S.connected then return end
                local hist = S.playerHistory[uid]
                local prompt
                if hist and #hist > 0 then
                        prompt = "[Continue the conversation naturally with " .. nm .. ". Reference your last exchange and say something NEW and related. If you already asked something and got an answer, do NOT re-ask it. Keep it casual and short, like talking to an old friend. 1-2 short sentences. Do NOT say ANY player's name.]"
                        local reply = callAI(prompt, uid, nm, false, nil, S.toxicTargets[uid] == true)
                        if reply then perform(reply, nm, uid) end
                else
                        local reply = callAI(makeGreetPrompt(nm), uid, nm, false, true, false)
                        if reply then
                                addPlayerMem(uid, "assistant", reply); saveMemory()
                                perform(reply, nm, uid, true)
                        end
                end
        end)
end)

-- Greet
btnGreet.MouseButton1Click:Connect(function()
        local target = getPopupTarget()
        closeRadialPopup()
        if not target or not S.connected then return end
        local uid = tostring(target.UserId)
        local nm = S.playerNick[uid] or target.DisplayName
        S.playerNames[uid] = target.DisplayName
        task.spawn(function()
                if S.responseDelay > 0 then task.wait(S.responseDelay) end
                if not S.connected then return end
                local reply = callAI(makeGreetPrompt(nm), uid, nm, false, true, false)
                if reply then
                        addPlayerMem(uid, "assistant", reply); saveMemory()
                        perform(reply, nm, uid, true)
                end
        end)
end)

-- Goodbye
btnBye.MouseButton1Click:Connect(function()
        local target = getPopupTarget()
        closeRadialPopup()
        if not target or not S.connected then return end
        local uid = tostring(target.UserId)
        local nm = S.playerNick[uid] or target.DisplayName
        S.playerNames[uid] = target.DisplayName
        task.spawn(function()
                if S.responseDelay > 0 then task.wait(S.responseDelay) end
                if not S.connected then return end
                local reply = callAI("[Say goodbye casually in 1 short sentence. Do NOT say their name.]", uid, nm, false, true, false)
                if reply then perform(reply, nm, uid, true) end
        end)
end)

-- Toxic ON
btnToxic.MouseButton1Click:Connect(function()
        local target = getPopupTarget()
        closeRadialPopup()
        if not target then return end
        local uid = tostring(target.UserId)
        local nm = S.playerNick[uid] or target.DisplayName
        S.toxicTargets[uid] = true
        notify("😈 Toxic Mode", "Toxic to: " .. nm, "err")
        if S.connected then
                task.spawn(function()
                        if S.responseDelay > 0 then task.wait(S.responseDelay) end
                        if not S.connected then return end
                        local reply = callAI("[You are now extremely toxic and angry at " .. nm .. ". Start being hostile immediately. 1-2 short toxic sentences. Use ALL CAPS for emphasis. Do NOT say their name.]", uid, nm, false, true, true)
                        if reply then perform(reply, nm, uid, true) end
                end)
        end
end)

-- Cancel Toxic
btnCancelToxic.MouseButton1Click:Connect(function()
        local target = getPopupTarget()
        closeRadialPopup()
        if not target then return end
        local uid = tostring(target.UserId)
        local nm = S.playerNick[uid] or target.DisplayName
        if S.toxicTargets[uid] then
                S.toxicTargets[uid] = nil
                clearPlayerHistory(uid)
                notify("✅ Toxic Mode OFF", "No longer toxic to: " .. nm, "ok")
                if S.connected then
                        task.spawn(function()
                                if S.responseDelay > 0 then task.wait(S.responseDelay) end
                                if not S.connected then return end
                                local reply = callAI("[You were just being toxic to " .. nm .. " but now you've calmed down and feel genuinely sorry. Apologize sincerely. Do NOT say their name. Be genuinely remorseful and friendly. 1-2 short sentences. Normal sentence case.]", uid, nm, false, true, false)
                                if reply then
                                        addPlayerMem(uid, "assistant", reply); saveMemory()
                                        perform(reply, nm, uid, true)
                                end
                        end)
                end
        else
                notify("ℹ️ Info", nm .. " not in toxic mode", "info")
        end
end)

end -- part wrap


-- ═══════════════════════════════════════════════════════════════
-- TUTORIAL — 13 ขั้น (reposition แบบ event-driven ไม่มี loop)
-- ═══════════════════════════════════════════════════════════════
do
        local tutActive = false
        local tutStep = 1
        local tutTotal = 0
        local tutPulse = false
        local TUT_FILE = "OllamaAI_TutDone.txt"
        local tutDone = false
        pcall(function() if isfile and isfile(TUT_FILE) then tutDone = true end end)

        local showTutStep, openTut, closeTut, hideAnim

        -- highlight box
        local tutHL = Instance.new("Frame", sg)
        tutHL.BackgroundColor3 = C.AC
        tutHL.BackgroundTransparency = 1
        tutHL.BorderSizePixel = 0
        tutHL.ZIndex = 975
        tutHL.Visible = false
        themed(tutHL, "BackgroundColor3", "AC")
        Instance.new("UICorner", tutHL).CornerRadius = UDim.new(0, 10)
        local tutHLSk = Instance.new("UIStroke", tutHL)
        tutHLSk.Color = C.AC; tutHLSk.Thickness = 2.5
        themed(tutHLSk, "Color", "AC")

        -- pulse loop — ทำงานเฉพาะตอน tutorial เปิดเท่านั้น
        local function startPulse()
                if tutPulse then return end
                tutPulse = true
                task.spawn(function()
                        while tutPulse and tutHL.Visible do
                                ANIM.play(tutHL, { BackgroundTransparency = 0.82 },
                                        { t = 0.55, style = Enum.EasingStyle.Sine, dir = Enum.EasingDirection.InOut, tag = "pls" })
                                task.wait(0.58)
                                ANIM.play(tutHL, { BackgroundTransparency = 1 },
                                        { t = 0.55, style = Enum.EasingStyle.Sine, dir = Enum.EasingDirection.InOut, tag = "pls" })
                                task.wait(0.58)
                        end
                        tutPulse = false
                end)
        end
        local function stopPulse()
                tutPulse = false; tutHL.Visible = false
        end

        -- tooltip card
        local TW, TH = 258, 132
        local tutCard = Instance.new("Frame", sg)
        tutCard.Size = UDim2.fromOffset(TW, TH)
        tutCard.BackgroundColor3 = C.POP
        tutCard.BorderSizePixel = 0
        tutCard.ZIndex = 982
        tutCard.Visible = false
        themed(tutCard, "BackgroundColor3", "POP")
        Instance.new("UICorner", tutCard).CornerRadius = UDim.new(0, 12)
        local tutCardSk = Instance.new("UIStroke", tutCard)
        tutCardSk.Color = C.AC; tutCardSk.Thickness = 2
        themed(tutCardSk, "Color", "AC")

        local tutCnt = Lk(tutCard, "1/1", UDim2.fromOffset(136, 14), UDim2.new(1, -140, 0, 6), 8, BF, "AC", Enum.TextXAlignment.Right, 983)
        local tutTit = Lk(tutCard, "", UDim2.new(1, -16, 0, 17), UDim2.fromOffset(10, 6), 11, BF, "T1", Enum.TextXAlignment.Left, 983)
        local tutDivLine = Instance.new("Frame", tutCard)
        tutDivLine.Size = UDim2.new(1, -16, 0, 1)
        tutDivLine.Position = UDim2.fromOffset(8, 26)
        tutDivLine.BackgroundColor3 = C.BD; tutDivLine.BorderSizePixel = 0; tutDivLine.ZIndex = 983
        themed(tutDivLine, "BackgroundColor3", "BD")
        local tutDsc = Instance.new("TextLabel", tutCard)
        tutDsc.Size = UDim2.new(1, -16, 0, 64)
        tutDsc.Position = UDim2.fromOffset(8, 30)
        tutDsc.BackgroundTransparency = 1; tutDsc.Text = ""
        tutDsc.Font = RF; tutDsc.TextSize = 9; tutDsc.TextColor3 = C.T2
        tutDsc.TextWrapped = true; tutDsc.ZIndex = 983
        tutDsc.TextXAlignment = Enum.TextXAlignment.Left
        tutDsc.TextYAlignment = Enum.TextYAlignment.Top
        themed(tutDsc, "TextColor3", "T2")

        local tutPrev = mkBtn(tutCard, "◀", UDim2.fromOffset(34, 24), UDim2.fromOffset(8, TH - 30), "soft", 12, 983)
        local tutNext = mkBtn(tutCard, "Next ▶", UDim2.fromOffset(82, 24), UDim2.new(0.5, -41, 1, -30), "accent", 10, 983)
        local tutClose = mkBtn(tutCard, "✕ Done", UDim2.fromOffset(68, 24), UDim2.new(1, -74, 1, -30), "danger", 9, 983)

        -- แตะ/คลิกที่ไหนก็ได้บนจอ = ไปขั้นถัดไป (ไม่ต้องกดแค่ปุ่ม Next)
        local tutCatch = Instance.new("TextButton", sg)
        tutCatch.Size = UDim2.new(1, 0, 1, 0)
        tutCatch.Position = UDim2.new()
        tutCatch.BackgroundTransparency = 1
        tutCatch.Text = ""; tutCatch.AutoButtonColor = false
        tutCatch.ZIndex = 979
        tutCatch.Visible = false
        tutCatch.InputBegan:Connect(function(i)
                if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
                        if not tutActive then return end
                        if tutStep >= tutTotal then
                                closeTut()
                        else
                                hideAnim(function() showTutStep(tutStep + 1) end)
                        end
                end
        end)

        -- arrow pointer
        local tutArr = Instance.new("Frame", sg)
        tutArr.Size = UDim2.fromOffset(14, 14)
        tutArr.BackgroundColor3 = C.POP; tutArr.BorderSizePixel = 0
        tutArr.ZIndex = 981; tutArr.Rotation = 45; tutArr.Visible = false
        themed(tutArr, "BackgroundColor3", "POP")
        local tutArrSk = Instance.new("UIStroke", tutArr)
        tutArrSk.Color = C.AC; tutArrSk.Thickness = 2
        themed(tutArrSk, "Color", "AC")

        local GAP, HA = 16, 7

        local function place(el, side)
                if not el or not el.Parent then return end
                local ap = el.AbsolutePosition
                local as = el.AbsoluteSize
                local vp = Camera.ViewportSize
                local ex, ey = ap.X + as.X / 2, ap.Y + as.Y / 2
                local tx, ty
                local mx, my = math.max(6, vp.X - TW - 6), math.max(6, vp.Y - TH - 6)
                if side == "bottom" then
                        tx = math.clamp(ex - TW / 2, 6, mx)
                        ty = math.clamp(ap.Y + as.Y + GAP, 6, my)
                elseif side == "top" then
                        tx = math.clamp(ex - TW / 2, 6, mx)
                        ty = math.clamp(ap.Y - TH - GAP, 6, my)
                elseif side == "right" then
                        tx = math.clamp(ap.X + as.X + GAP, 6, mx)
                        ty = math.clamp(ey - TH / 2, 6, my)
                else
                        tx = math.clamp(ap.X - TW - GAP, 6, mx)
                        ty = math.clamp(ey - TH / 2, 6, my)
                end
                tutCard.Position = UDim2.fromOffset(tx, ty)
                local ax, ay
                if side == "bottom" then
                        ax = math.clamp(ex - HA, tx + 6, tx + TW - 14); ay = ty - HA
                elseif side == "top" then
                        ax = math.clamp(ex - HA, tx + 6, tx + TW - 14); ay = ty + TH - HA
                elseif side == "right" then
                        ax = tx - HA; ay = math.clamp(ey - HA, ty + 6, ty + TH - 14)
                else
                        ax = tx + TW - HA; ay = math.clamp(ey - HA, ty + 6, ty + TH - 14)
                end
                tutArr.Position = UDim2.fromOffset(ax, ay)
                tutHL.Position = UDim2.fromOffset(ap.X - 6, ap.Y - 6)
                tutHL.Size = UDim2.fromOffset(as.X + 12, as.Y + 12)
        end

        local function showAnim()
                tutCard.Visible = true; tutArr.Visible = true; tutHL.Visible = true; tutCatch.Visible = true
                tutCard.BackgroundTransparency = 0
                ANIM.popIn(tutCard, { from = 0.9, t = 0.24 })
                startPulse()
        end

        hideAnim = function(cb)
                tutPulse = false
                ANIM.popOut(tutCard, { to = 0.92, t = 0.15 })
                task.delay(0.16, function()
                        pcall(function()
                                tutCard.Visible = false; tutArr.Visible = false; tutHL.Visible = false; tutCatch.Visible = false
                        end)
                        if cb then cb() end
                end)
        end

        -- ═══ 13 ขั้น ═══
        local steps = {
                { tab = "api", title = "🔑  API Keys (Local AI)",
                        desc = "เลือกที่แถบ PROVIDER: 🖥️ Local AI (Ollama ในเครื่อง ไม่ต้องใช้คีย์ แนะนำ) / 🦙 Ollama Cloud / 🔀 OpenRouter — โหมด Local AI จะปิดระบบคีย์ให้เอง (ไม่มีช่องคีย์) สลับเป็นค่ายคลาวด์เมื่อไหร่ช่องคีย์ 10 ช่องจะกลับมา",
                        getEl = function() return UIX.keyBox end, side = "bottom" },
                { tab = "api", title = "🎚️  Active Keys Slider",
                        desc = "เลื่อนเลือกจำนวนคีย์ที่เปิดใช้ 1-10 คีย์ — โชว์เฉพาะค่ายคลาวด์ (Local AI ไม่ใช้คีย์จึงซ่อนไว้)",
                        getEl = function() return UIX.keyRows and UIX.keyRows[1] and UIX.keyRows[1].row end, side = "top" },
                { tab = "api", title = "⚡  Connect Button",
                        desc = "กด Connect — โหมด Local AI ต่อเข้า Ollama ในเครื่องได้เลยโดยไม่ต้องใช้คีย์ · ค่ายคลาวด์จะทดสอบคีย์ทีละช่อง จุดสถานะเขียว = พร้อมใช้งาน",
                        getEl = function() return UIX.connBtn end, side = "bottom" },
                { tab = "api", title = "📊  Key & Token Counter",
                        desc = "กดที่ pill นี้เพื่อกลับมาหน้า API — โหมด Local AI ขึ้น 🖥️ Local ค่ายคลาวด์ขึ้น 🔑 N/M พร้อมโทเคนสะสม อัปเดตสด ๆ ตลอด",
                        getEl = function() return statusPill end, side = "bottom" },
                { tab = "chat", title = "🎞️  Cover Flow Carousel",
                        desc = "ปัดนิ้วซ้าย-ขวาบนแถบการ์ด หรือแตะการ์ดใดก็ได้ เพื่อเปลี่ยนหน้าแบบ 3D · ปัดได้ทั้งบนแถบการ์ดและแถบหัวเรื่อง",
                        getEl = function() return UIX.carStrip end, side = "bottom" },
                { tab = "chat", title = "👤  โปรไฟล์ตัวเอง",
                        desc = "กดรูปอวตารวงกลมขวาบน หรือการ์ด Profile ใบแรก — สถิติบัญชี เพื่อน ชุดที่สวม สถานะ Premium",
                        getEl = function() return avaChip end, side = "bottom" },
                { tab = "chat", title = "💬  Chat Tab",
                        desc = "คุยกับ Sebas ตรง ๆ ผ่านแชทในหน้านี้ — ไม่จำกัดระยะ ไม่ต้องใช้แชทเกม",
                        getEl = function() return UIX.chatMsgCard end, side = "bottom" },
                { tab = "controls", title = "🎛️  Controls",
                        desc = "เปิด/ปิด Chat Enabled เพื่อให้ AI ตอบแชทคนใกล้ตัวอัตโนมัติ",
                        getEl = function() return UIX.ctrlCard1 end, side = "bottom" },
                { tab = "settings", title = "⚙️  Range & Timing",
                        desc = "Range = ระยะตอบแชท (0 = ไม่จำกัด) · Cooldown กันสแปม",
                        getEl = function() return UIX.setCard end, side = "bottom" },
                { tab = "mood", title = "🎭  Personality Sliders",
                        desc = "ลากปรับนิสัย Sebas — เฟรนด์ลี่ ตลก เงียบ เก่ง หรือดุ",
                        getEl = function() return UIX.moodCard end, side = "bottom" },
                { tab = "whitelist", title = "✅  Allow List",
                        desc = "เปิดโหมด Whitelist เพื่อให้ตอบเฉพาะคนที่เพิ่มไว้",
                        getEl = function() return UIX.wlInfoCard end, side = "bottom" },
                { tab = "theme", title = "🎨  Themes",
                        desc = "8 ธีมพร้อมพรีวิว — กดการ์ดเพื่อเปลี่ยน มี wipe animation",
                        getEl = function() return UIX.themeCard end, side = "bottom" },
                { tab = "sound", title = "🔊  Sound Mixer",
                        desc = "ปรับเสียง UI แยกตามการกระทำ — กด ▶ เพื่อทดสอบแต่ละเสียง",
                        getEl = function() return UIX.soundCard end, side = "bottom" },
                { tab = nil, title = "🤚  Hold to Interact",
                        desc = "กดค้างบนตัวผู้เล่น ~1 วิ จะเด้งเมนูวงกลม: Greet, Bye, Toxic, Chat",
                        getEl = function() return tutBtn end, side = "bottom" },
                { tab = nil, title = "🔵  Minimize + ลาก + ปรับขนาด",
                        desc = "กด — ย่อเป็น pill · ลาก GUI จับเส้นล่างหรือแถบบน · ปรับขนาดจับมุมซ้ายล่าง · RShift = ย่อ/ขยาย",
                        getEl = function() return minBtn end, side = "bottom" },
        }
        tutTotal = #steps

        showTutStep = function(idx)
                idx = math.clamp(idx, 1, tutTotal); tutStep = idx
                local s = steps[idx]
                if not s then return end
                tutCnt.Text = "แตะที่ไหนก็ได้ · " .. idx .. " / " .. tutTotal
                tutTit.Text = s.title or ""; tutDsc.Text = s.desc or ""
                tutPrev.TextColor3 = idx == 1 and C.T2 or C.T1
                if idx == 1 then
                        ANIM.play(tutPrev, { BackgroundColor3 = C.AREA }, { t = 0.12, tag = "pv" })
                else
                        ANIM.play(tutPrev, { BackgroundColor3 = C.CD }, { t = 0.12, tag = "pv" })
                end
                tutNext.Text = idx == tutTotal and "Finish ✓" or "Next ▶"
                if s.tab then pcall(function() switchTab(s.tab) end) end
                task.defer(function() pcall(function()
                        local el = s.getEl and s.getEl()
                        if el and el.Parent then
                                place(el, s.side or "bottom")
                        else
                                -- ไม่เจอ element → วางการ์ดกลางล่างจอ (ไม่หลุดขอบ)
                                local vp = Camera.ViewportSize
                                local cx = math.max(6, math.floor((vp.X - TW) / 2))
                                local cy = math.max(6, vp.Y - TH - 12)
                                tutCard.Position = UDim2.fromOffset(cx, cy)
                                tutArr.Position = UDim2.fromOffset(cx + math.floor(TW / 2) - 7, cy - 7)
                        end
                        showAnim()
                end) end)
                -- จัดวงอีกครั้งหลัง animation หน้าเพจจบ → ตรงจุดเสมอ
                task.delay(0.34, function()
                        if not tutActive or tutStep ~= idx then return end
                        pcall(function()
                                local el2 = s.getEl and s.getEl()
                                if el2 and el2.Parent then place(el2, s.side or "bottom") end
                        end)
                end)
        end

        -- event-driven reposition (เรียกจาก drag/resize/tab switch)
        function tutReposition()
                if not tutActive then return end
                local s = steps[tutStep]
                if not s then return end
                pcall(function()
                        local el = s.getEl and s.getEl()
                        if el and el.Parent then place(el, s.side or "bottom") end
                end)
        end

        -- ⊢ FOLLOW LOOP — วง tutorial ตามเป้าหมายทุกเฟรม (เฉพาะตอน tutorial เปิด)
        --   ⚠ FIX "วงไม่ตรงจุดที่ชี้": เดิมวางวงครั้งเดียวตอนเปิดขั้น (+reposition ตอน drag)
        --   แต่ AbsolutePosition ตอนนั้นอาจยังเป็นค่าเก่า (หน้าเพจเพิ่งสลับ/แชทโหลดข้อความ/
        --   การ์ดคีย์สร้างใหม่/เลื่อน scroll) → วงค้างที่จุดเก่า — ตอนนี้ตรวจทุกเฟรม ถ้าเป้าหมาย
        --   ขยับจริงจัดวงใหม่ทันที (เขียนเฉพาะตอนขยับ = ไม่ชน animation ของการ์ดเอง)
        local tutFollowConn = nil
        local tutLastKey = nil
        local function tutFollowStart()
                if tutFollowConn or not RunService then return end
                tutLastKey = nil
                tutFollowConn = RunService.RenderStepped:Connect(function()
                        if not tutActive or not tutHL.Visible then return end
                        local s = steps[tutStep]
                        if not s then return end
                        local el = s.getEl and s.getEl()
                        if not el or not el.Parent then return end
                        local ap, as = el.AbsolutePosition, el.AbsoluteSize
                        if not ap or not as then return end
                        local key = math.floor(ap.X + 0.5) .. "," .. math.floor(ap.Y + 0.5)
                                .. "," .. math.floor(as.X + 0.5) .. "," .. math.floor(as.Y + 0.5)
                        if key ~= tutLastKey then
                                tutLastKey = key
                                pcall(place, el, s.side or "bottom")
                        end
                end)
        end
        local function tutFollowStop()
                if tutFollowConn then tutFollowConn:Disconnect(); tutFollowConn = nil end
                tutLastKey = nil
        end

        openTut = function()
                if tutActive then return end
                tutActive = true; tutStep = 1
                tutBtn.BackgroundColor3 = C.AC
                tutBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
                tutBtnSk.Color = C.OK
                SND.play("open")
                tutFollowStart()
                showTutStep(1)
        end

        closeTut = function()
                if not tutActive then return end
                local wasLast = tutStep >= tutTotal
                hideAnim(function()
                        tutActive = false; stopPulse(); tutFollowStop()
                        tutBtn.BackgroundColor3 = C.CD
                        tutBtn.TextColor3 = C.T2
                        tutBtnSk.Color = C.AC
                        if wasLast then
                                task.delay(0.4, function()
                                        notify("✅ Tutorial Complete", "กด ? ตรงแถบบนเพื่อดูซ้ำได้ตลอด", "ok")
                                end)
                        end
                end)
                pcall(function() if writefile then writefile(TUT_FILE, "done") end end)
                tutDone = true
        end

        UIX.openTut = openTut
        UIX.closeTut = closeTut
        UIX.tutGuard = function() return tutActive == true end   -- guard ให้ carousel gesture รู้ว่า tutorial เปิดอยู่

        tutBtn.MouseButton1Click:Connect(function()
                if tutActive then closeTut() else openTut() end
        end)

        tutPrev.MouseButton1Click:Connect(function()
                if not tutActive or tutStep <= 1 then return end
                hideAnim(function() showTutStep(tutStep - 1) end)
        end)
        tutNext.MouseButton1Click:Connect(function()
                if not tutActive then return end
                if tutStep >= tutTotal then closeTut()
                else hideAnim(function() showTutStep(tutStep + 1) end) end
        end)
        tutClose.MouseButton1Click:Connect(function()
                if tutActive then closeTut() end
        end)

        -- ย่อ GUI ระหว่าง tutorial → ซ่อน tooltip ด้วย (event ไม่ใช่ loop)
        Main:GetPropertyChangedSignal("Visible"):Connect(function()
                if not tutActive then return end
                if not Main.Visible then
                        pcall(function()
                                tutCard.Visible = false; tutArr.Visible = false
                                tutHL.Visible = false; tutPulse = false; tutCatch.Visible = false
                        end)
                else
                        task.delay(0.4, function()
                                if not tutActive then return end
                                pcall(function()
                                        local s = steps[tutStep]
                                        if s then
                                                local el = s.getEl and s.getEl()
                                                if el and el.Parent then place(el, s.side or "bottom") end
                                        end
                                        showAnim()
                                end)
                        end)
                end
        end)

        -- first run → เปิด tutorial อัตโนมัติ (รอ login เสร็จก่อน — ไม่ทับกับการ์ด login)
        if not tutDone then
                task.delay(1.6, function()
                        task.spawn(function()
                                local waited = 0
                                while AUTH and AUTH.locked and waited < 30 do
                                        task.wait(0.5); waited = waited + 0.5
                                end
                                if not tutActive and not (AUTH and AUTH.locked) then pcall(openTut) end
                        end)
                end)
        end
end

do -- p13 AUTH+LOGIN+PROFILE (locals หมดอายุตอนจบ part)

-- ═══════════════════════════════════════════════════════════════
-- ⊢ SEBAS USER DATABASE — login + premium/normal tier system
--   • ครั้งแรก: การ์ด login บังคับ — ชื่อดึงจาก Roblox อัตโนมัติ
--     ผู้ใช้ตั้งรหัสผ่านเอง → สมัครเข้า Google Sheets DB ทันที
--   • ครั้งถัดไป: เข้าสู่ระบบเงียบ ๆ (session file) + ดึง tier ใหม่
--   • Premium: ปลดล็อค Sound Mixer / Research Kit / Multi-Key / Persona
--   • DB_URL ว่าง = ปิดระบบนี้ทั้งหมด (โหมดเจ้าของ ทุกฟีเจอร์ใช้ได้)
-- ═══════════════════════════════════════════════════════════════

local GOLD  = Color3.fromRGB(245, 185, 66)
local GOLDD = Color3.fromRGB(46, 30, 0)     -- ตัวอักษรบนพื้นทอง
local LG_USER = tostring(LP.Name)

-- ─── metadata ที่ส่งไปกับ login/register → แอดมินดูสถานะผู้ใช้ได้
--   uid = Roblox UserId · ver = เวอร์ชั่นสคริปต์ · place = เกมที่เล่นล่าสุด
local function authMeta()
        local okP, pl = pcall(function() return game.PlaceId end)
        return {
                uid = tostring(LP.UserId),
                ver = VERSION_TAG,
                place = (okP and pl) and tostring(pl) or "",
        }
end

-- ─── HTTP: POST JSON → fallback GET (Apps Script Web app) ──────
local function authCall(params)
        if DB_URL == "" or not Http or not HttpService then return nil end
        -- login/register แนบ metadata ให้ DB อัปเดตสถานะผู้ใช้ (heartbeat)
        if params.action == "login" or params.action == "register" then
                local m = authMeta()
                params.uid = m.uid; params.ver = m.ver; params.place = m.place
        end
        local ok, res = pcall(function()
                return Http({
                        Url = DB_URL,
                        Method = "POST",
                        Headers = { ["Content-Type"] = "application/json" },
                        Body = HttpService:JSONEncode(params),
                })
        end)
        if ok and res then
                local rn = normRes(res)
                if rn and rn.status == 200 then
                        local d
                        pcall(function() d = HttpService:JSONDecode(rn.body) end)
                        if type(d) == "table" then return d end
                end
        end
        -- fallback: GET + query string (บาง executor POST ไป Apps Script ไม่ผ่าน)
        local q = {}
        for k, v in pairs(params) do
                q[#q + 1] = tostring(k) .. "=" .. (PX.urlEnc and PX.urlEnc(tostring(v)) or tostring(v))
        end
        local ok2, res2 = pcall(function()
                return Http({ Url = DB_URL .. "?" .. table.concat(q, "&"), Method = "GET" })
        end)
        if ok2 and res2 then
                local rn2 = normRes(res2)
                if rn2 and rn2.status == 200 then
                        local d2
                        pcall(function() d2 = HttpService:JSONDecode(rn2.body) end)
                        if type(d2) == "table" then return d2 end
                end
        end
        return nil
end

local function setAuthFromResp(resp)
        AUTH.ok = true
        AUTH.offline = false
        AUTH.premium = (resp.premium == true or resp.tier == "premium")
        AUTH.tier = AUTH.premium and "premium" or "normal"
        AUTH.user = resp.username or AUTH.user or LG_USER
        AUTH.untilDate = resp["until"]
        AUTH.lastLogin = resp.lastLogin
end

