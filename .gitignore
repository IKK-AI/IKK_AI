---------------------------------------------------------------------
-- Drag & resize
---------------------------------------------------------------------
do
local function makeDrag(handle, begin, update, allowed)
    local active, origin, state
    handle.InputBegan:Connect(function(i)
        if (i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch)
            and (not allowed or allowed()) then
            active = true
            origin = i.Position
            state = begin()
            i.Changed:Connect(function()
                if i.UserInputState == Enum.UserInputState.End then active = false end
            end)
        end
    end)
    conns[#conns + 1] = UIS.InputChanged:Connect(function(i)
        if active and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
            update(state, i.Position - origin)
        end
    end)
end

makeDrag(box,
    function() return box.Position end,
    function(p, d) box.Position = UDim2.fromOffset(p.X.Offset + d.X, p.Y.Offset + d.Y) end,
    function() return not playing and boxOn end)

makeDrag(grip,
    function() return box.AbsoluteSize end,
    function(s, d) box.Size = UDim2.fromOffset(math.max(40, s.X + d.X), math.max(30, s.Y + d.Y)) end,
    function() return not playing and boxOn end)

makeDrag(header,
    function() return panel.Position end,
    function(p, d) panel.Position = UDim2.fromOffset(p.X.Offset + d.X, p.Y.Offset + d.Y) end)
end -- do (drag)

---------------------------------------------------------------------
-- Key detection inside the box
---------------------------------------------------------------------
local function isShown(o)
    local p = o
    while p and p ~= playerGui do
        if p:IsA("GuiObject") then
            if not p.Visible then return false end
        elseif p:IsA("ScreenGui") then
            if not p.Enabled then return false end
        end
        p = p.Parent
    end
    return true
end

local function scan()
    local bp, bs = box.AbsolutePosition, box.AbsoluteSize
    local found = {}

    for _, o in ipairs(playerGui:GetDescendants()) do
        if o:IsA("GuiObject") and not o:IsDescendantOf(gui) then
            local isBtn = o:IsA("GuiButton")
            local isLbl = o:IsA("TextLabel") and singleChar(o.Text) ~= nil
                and not o:FindFirstAncestorWhichIsA("GuiButton")
            if (isBtn or isLbl) and o.AbsoluteSize.X > 0 and o.AbsoluteSize.Y > 0 then
                local c = rawCenter(o)
                local ref = isLbl and o or findLetter(o)
                local p = ref and textPoint(ref) or c
                local function inBox(v)
                    return v.X >= bp.X and v.X <= bp.X + bs.X and v.Y >= bp.Y and v.Y <= bp.Y + bs.Y
                end
                if (inBox(c) or inBox(p)) and isShown(o) then
                    -- x/y = exact letter position: the marker shows it and the tap lands there
                    found[#found + 1] = { obj = o, ref = ref, x = p.X, y = p.Y, h = o.AbsoluteSize.Y }
                end
            end
        end
    end

    table.sort(found, function(a, b)
        if math.abs(a.x - b.x) < 1 then return a.y < b.y end
        return a.x < b.x
    end)
    for i, k in ipairs(found) do k.i = i end
    detected = found
    boxLabel.Text = "SCAN · " .. #found .. " keys"
end

task.spawn(function()
    while gui.Parent do
        if scanActive and not playing then
            pcall(scan)
            updateMarkers()
            if os.clock() > lockUntil then
                if #detected > 0 then
                    setStatus("Detected " .. #detected .. " keys · ready", "good")
                else
                    setStatus("No keys found. Move/resize the box over the piano.", "bad")
                end
            end
        end
        task.wait(0.25)
    end
end)

---------------------------------------------------------------------
-- Song library (multiple sources merged) + pins
-- song = { key, label, l (lowercase), tag, url | page | localPath }
---------------------------------------------------------------------
local songs = {}
local seenKey = {}
local pins = {}            -- key -> true
local selected = nil
local loadingCount = 0
local onlyPins = false
local rows, stars = {}, {}
local playSong, stopAll, renderList -- forward declarations

local function urlEncode(s)
    return (s:gsub("[^%w%-%._~/]", function(ch) return string.format("%%%02X", ch:byte()) end))
end

local function cleanName(s)
    s = s:gsub("%.[Mm][Ii][Dd][Ii]?$", ""):gsub("[_]+", " "):gsub("%s+", " ")
    return (s:gsub("^%s+", ""):gsub("%s+$", ""))
end

local renderQueued = false
local function queueRender()
    if renderQueued then return end
    renderQueued = true
    task.delay(0.35, function()
        renderQueued = false
        if gui.Parent then renderList() end
    end)
end

local function trim(s)
    return (s:gsub("^%s+", ""):gsub("%s+$", ""))
end

-- searchable form: lowercase, punctuation -> space (bytes >= 128 kept, so Thai/Unicode works)
local function norm(s)
    s = s:lower():gsub("[^%w\128-\255]+", " ")
    return trim(s)
end

local function urlDecode(s)
    return (s:gsub("%%(%x%x)", function(h) return string.char(tonumber(h, 16)) end))
end

-- turn a JSON value (string / list of strings / list of {name=}) into plain text
local function asText(v)
    if type(v) == "string" then return trim(v) end
    if type(v) == "table" then
        local t = {}
        for _, x in ipairs(v) do
            if type(x) == "string" and x ~= "" then
                t[#t + 1] = x
            elseif type(x) == "table" and type(x.name) == "string" then
                t[#t + 1] = x.name
            end
        end
        return trim(table.concat(t, ", "))
    end
    return ""
end

local function realText(v)
    local s = asText(v)
    local l = s:lower()
    if l == "nil" or l == "null" or l == "undefined" or l == "none" then return "" end
    return s
end

local nameInfo = {} -- normalized name -> { tag, count }

local function addSong(name, fields)
    local key = fields.url or fields.page or fields.localPath or fields.mem
    if not key or seenKey[key] then return false end
    name = trim(name or "")
    if name == "" then name = "Untitled" end

    -- same title: from another source = same song (skip); from the same source = another version (numbered)
    local nl = norm(name)
    local info = nameInfo[nl]
    if info then
        if info.tag ~= fields.tag or HIDE_DUPLICATES then return false end
        local alt = (fields.folder and fields.folder ~= "") and (name .. " (" .. fields.folder .. ")") or nil
        if alt and not nameInfo[norm(alt)] then
            -- same file name in another folder: tell them apart by the folder name
            name = alt
            nameInfo[norm(alt)] = { tag = fields.tag, count = 1 }
        else
            info.count += 1
            name = name .. " (" .. info.count .. ")"
        end
    else
        nameInfo[nl] = { tag = fields.tag, count = 1 }
    end

    seenKey[key] = true
    fields.key = key
    fields.label = name
    local base = urlDecode((key:gsub("\\", "/")):match("([^/]+)$") or "")
    fields.sk = norm(name)
    fields.l = fields.sk .. " " .. norm(base)       -- title + file name
    fields.l2 = (fields.l:gsub(" ", ""))             -- also match "spiritedaway"
    songs[#songs + 1] = fields
    return true
end

local function sortSongs()
    table.sort(songs, function(a, b) return a.sk < b.sk end)
end

-- saved data (pins + settings)
saveData = function()
    if not writefile then return end
    local out = {}
    for _, s in ipairs(songs) do
        if pins[s.key] then
            out[#out + 1] = { label = s.label, tag = s.tag, url = s.url, page = s.page, localPath = s.localPath }
        end
    end
    pcall(function()
        writefile(DATA_FILE, HttpService:JSONEncode({ pins = out, speed = speed, mode = modeIdx, auto = autoIdx, lyrics = lyricsOn }))
    end)
end

local function loadData()
    if not (readfile and isfile) then return end
    local ok, raw = pcall(function()
        if isfile(DATA_FILE) then return readfile(DATA_FILE) end
    end)
    if not ok or not raw then return end
    local okJ, d = pcall(HttpService.JSONDecode, HttpService, raw)
    if not okJ or type(d) ~= "table" then return end
    if type(d.speed) == "number" then setSpeed(d.speed) end
    if type(d.mode) == "number" and modeNames[d.mode] then modeIdx = d.mode refreshModes() end
    if type(d.auto) == "number" and autoNames[d.auto] then autoIdx = d.auto refreshAuto() end
    if type(d.lyrics) == "boolean" then lyricsOn = d.lyrics refreshLyrBtn() end
    if type(d.pins) == "table" then
        for _, p in ipairs(d.pins) do
            if type(p) == "table" and p.label then
                local fields = { tag = p.tag or "Pin", url = p.url, page = p.page, localPath = p.localPath }
                addSong(tostring(p.label), fields)
                local key = p.url or p.page or p.localPath
                if key then pins[key] = true end
            end
        end
    end
end

local function httpGet(url)
    if not httpRequest then return nil end
    local ok, res = pcall(httpRequest, { Url = url, Method = "GET" })
    if ok and res and res.StatusCode == 200 then return res.Body end
    return nil
end

local function loadNanoMidi()
    local body = httpGet("https://api.nanomidi.net/api/midiData")
    if not body then return 0 end
    local ok, data = pcall(HttpService.JSONDecode, HttpService, body)
    if not ok or type(data) ~= "table" then return 0 end
    local n = 0
    for _, s in ipairs(data) do
        if type(s) == "table" and type(s.midiFilename) == "string" and s.midiFilename ~= "" then
            local file = s.midiFilename
            local url = "https://api.nanomidi.net/api/midis/" .. urlEncode(file)
            local name = realText(s.name or s.title or s.songName)
            if name == "" then name = cleanName(file) end -- no title in the API: use the file name
            local artist = realText(s.artists or s.artist)
            local label = (artist ~= "") and (name .. " - " .. artist) or name
            if addSong(label, { url = url, tag = "Nano" }) then n += 1 end
        end
    end
    return n
end

local function loadGithub(src)
    local branch = src.branch or "HEAD"
    local body = httpGet(("https://api.github.com/repos/%s/git/trees/%s?recursive=1"):format(src.repo, branch))
    if not body then return 0 end
    local ok, data = pcall(HttpService.JSONDecode, HttpService, body)
    if not ok or type(data) ~= "table" or type(data.tree) ~= "table" then return 0 end
    local n = 0
    for _, item in ipairs(data.tree) do
        if item.type == "blob" and item.path:lower():match("%.midi?$") then
            local name = cleanName(item.path:match("([^/]+)$") or item.path)
            local url = ("https://raw.githubusercontent.com/%s/%s/%s"):format(src.repo, branch, urlEncode(item.path))
            local folder = item.path:match("([^/]+)/[^/]+$") or ""
            if addSong(name, { url = url, tag = src.tag or src.repo, folder = folder }) then n += 1 end
        end
    end
    return n
end

local function loadLocal()
    if not (listfiles and readfile and isfolder) then return 0 end
    pcall(function() if makefolder and not isfolder(LOCAL_FOLDER) then makefolder(LOCAL_FOLDER) end end)
    if not isfolder(LOCAL_FOLDER) then return 0 end
    local n = 0
    local function walk(dir, depth)
        local ok, files = pcall(listfiles, dir)
        if not ok then return end
        for _, f in ipairs(files) do
            if f:lower():match("%.midi?$") then
                local name = cleanName((f:gsub("\\", "/")):match("([^/]+)$") or f)
                if addSong(name, { localPath = f, tag = "Local" }) then n += 1 end
            elseif depth < 3 then
                local isF = false
                pcall(function() isF = isfolder(f) end)
                if isF then walk(f, depth + 1) end
            end
        end
    end
    walk(LOCAL_FOLDER, 0)
    return n
end

local function searchBitMidi(q)
    local n = 0
    for page = 1, 5 do
        local html = httpGet("https://bitmidi.com/search?q=" .. HttpService:UrlEncode(q) .. "&page=" .. page)
        if not html then break end
        local before = n
        for slug in html:gmatch('href="/([^"/%s]+%-mid)"') do
            -- readable title from the url slug: decode %XX, dashes -> spaces, Title Case
            local name = urlDecode((slug:gsub("%-mid$", "")))
            name = name:gsub("%-", " ")
            name = name:gsub("(%a)([%w']*)", function(a, b) return a:upper() .. b end)
            if addSong(name, { page = "https://bitmidi.com/" .. slug, tag = "BitMidi" }) then n += 1 end
        end
        if n == before then break end
    end
    return n
end

local function fetchBody(s)
    if s.body then return s.body end
    if s.localPath then
        local ok, d = pcall(readfile, s.localPath)
        return ok and d or nil
    end
    if s.page then
        local html = httpGet(s.page)
        if not html then return nil end
        local path = html:match('href="(/uploads/[^"]-%.mid)"') or html:match('"(/uploads/[^"]-%.mid)"')
        if not path then return nil end
        return httpGet("https://bitmidi.com" .. path)
    end
    return httpGet(s.url)
end

---------------------------------------------------------------------
-- Filtering, queue, list rendering
---------------------------------------------------------------------
-- all songs matching the search / pin tab, pinned first
local function getFiltered()
    local tokens = {}
    for w in norm(search.Text):gmatch("%S+") do tokens[#tokens + 1] = w end
    local pinned, other = {}, {}
    for _, s in ipairs(songs) do
        local isPin = pins[s.key] == true
        if isPin or not onlyPins then
            local ok = true
            for _, t in ipairs(tokens) do
                if not (s.l:find(t, 1, true) or s.l2:find(t, 1, true)) then ok = false break end
            end
            if ok then
                if isPin then pinned[#pinned + 1] = s else other[#other + 1] = s end
            end
        end
    end
    for _, s in ipairs(other) do pinned[#pinned + 1] = s end
    return pinned
end

local queue, qIdx = {}, 0
local function setQueueFrom(s)
    queue = getFiltered()
    qIdx = table.find(queue, s) or 0
    if qIdx == 0 then queue = { s } qIdx = 1 end
end
local function stepQueue(dir)
    if #queue == 0 then return nil end
    if autoIdx == 4 and dir > 0 and #queue > 1 then
        local old = qIdx
        repeat qIdx = math.random(#queue) until qIdx ~= old
    else
        qIdx = (qIdx - 1 + dir) % #queue + 1
    end
    return queue[qIdx]
end

local function updatePinBtn()
    local on = selected and pins[selected.key]
    pinBtn.Text = on and "★" or "☆"
    pinBtn.TextColor3 = on and C.warn or C.muted
end

local function togglePin(s)
    if pins[s.key] then pins[s.key] = nil else pins[s.key] = true end
    saveData()
    local st = stars[s]
    if st and st.Parent then
        local on = pins[s.key]
        st.Text = on and "★" or "☆"
        st.TextColor3 = on and C.warn or C.muted
    end
    updatePinBtn()
    if onlyPins then queueRender() end
end

local function highlightRows()
    for s, row in pairs(rows) do
        if row.Parent then
            tween(row, 0.12, { BackgroundColor3 = (s == selected) and C.accent2 or C.card2 })
        end
    end
end

local function makeRow(s, n)
    local row = new("Frame", {
        Size = UDim2.new(1, -4, 0, 30),
        BackgroundColor3 = (s == selected) and C.accent2 or C.card2,
        LayoutOrder = n,
    }, list)
    corner(row, 7)
    local nameBtn = new("TextButton", {
        Size = UDim2.new(1, -32, 1, 0), BackgroundTransparency = 1, RichText = true,
        Text = esc(s.label) .. '  <font color="rgb(148,153,176)" size="10">' .. esc(s.tag or "") .. "</font>",
        Font = FONT, TextSize = 12, TextColor3 = C.text, TextXAlignment = Enum.TextXAlignment.Left,
        TextTruncate = Enum.TextTruncate.AtEnd, AutoButtonColor = false,
    }, row)
    pad(nameBtn, 10, 0)
    local on = pins[s.key]
    local star = new("TextButton", {
        AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -2, 0.5, 0), Size = UDim2.fromOffset(28, 28),
        BackgroundTransparency = 1, Text = on and "★" or "☆", Font = FONT_B, TextSize = 16,
        TextColor3 = on and C.warn or C.muted, AutoButtonColor = false,
    }, row)
    rows[s] = row
    stars[s] = star
    nameBtn.MouseButton1Click:Connect(function() playSong(s) end)
    star.MouseButton1Click:Connect(function() togglePin(s) end)
end

renderList = function()
    for _, c in ipairs(list:GetChildren()) do
        if c:IsA("GuiObject") then c:Destroy() end
    end
    rows, stars = {}, {}
    local res = getFiltered()
    search.PlaceholderText = "🔍 " .. #songs .. " songs · Enter = online"
    local shown = math.min(#res, MAX_SHOWN)
    for n = 1, shown do makeRow(res[n], n) end
    if #res > shown then
        label(list, {
            Size = UDim2.new(1, 0, 0, 24), Text = "+" .. (#res - shown) .. " more · search to narrow down",
            TextSize = 11, TextColor3 = C.muted, LayoutOrder = shown + 1,
        })
    elseif #res == 0 then
        local msg = (loadingCount > 0 and #songs == 0 and "Loading song list…")
            or (onlyPins and "No pinned songs yet · tap ☆ on a song")
            or (#songs == 0 and "No songs loaded")
            or "No results · press Enter to search online"
        label(list, { Size = UDim2.new(1, 0, 0, 44), Text = msg, TextSize = 12, TextColor3 = C.muted, TextWrapped = true })
    end
end

---------------------------------------------------------------------
-- Player engine: real-time speed, seek, pause, auto-advance
---------------------------------------------------------------------
local token = 0          -- bumps whenever a new song starts / playback stops
-- lyrics (LRCLIB, time-synced) ------------------------------------
local lyr = nil          -- { {t = seconds, text = "..."}, ... } for the current song
local lyrIdx = 0

local loadLyrics
do
local function parseLrc(txt)
    local out = {}
    for line in txt:gmatch("[^\r\n]+") do
        local text = trim((line:gsub("%[[^%]]*%]", "")))
        for m, sc in line:gmatch("%[(%d+):(%d+%.?%d*)%]") do
            out[#out + 1] = { t = tonumber(m) * 60 + tonumber(sc), text = text }
        end
    end
    table.sort(out, function(a, b) return a.t < b.t end)
    return out
end

function loadLyrics(s, my)
    lyr, lyrIdx = nil, 0
    if not lyricsOn then return end
    if s.lyr == nil then
        s.lyr = false -- cached per song (false = none found)
        local q = trim((s.label:gsub("%b()", " "):gsub(" %- ", " ")))
        if q ~= "" then
            local body = httpGet("https://lrclib.net/api/search?q=" .. HttpService:UrlEncode(q))
            if body then
                local ok, data = pcall(HttpService.JSONDecode, HttpService, body)
                if ok and type(data) == "table" then
                    for _, r in ipairs(data) do
                        if type(r) == "table" and type(r.syncedLyrics) == "string" and r.syncedLyrics ~= "" then
                            local lines = parseLrc(r.syncedLyrics)
                            if #lines > 0 then
                                s.lyr = lines
                                break
                            end
                        end
                    end
                end
            end
        end
    end
    if my == token and s.lyr then lyr = s.lyr end
end
end -- do (lyrics)

local cur = nil          -- { notes, total } for the loaded song
local pos, idx = 0, 1    -- playhead (song seconds) and next note index
local scrub = nil        -- seconds while the progress bar is being dragged
local failStreak = 0
local lastSec, lastTotal = -1, -1

local function updatePlayBtn()
    playBtn.Text = (playing and cur and not paused) and "❚❚" or "▶"
end

local function updateProgress(force)
    local total = cur and cur.total or 0
    local p = scrub or pos
    local r = total > 0 and math.clamp(p / total, 0, 1) or 0
    barFill.Size = UDim2.new(r, 0, 1, 0)
    knob.Position = UDim2.new(r, 0, 0.5, 0)
    local sec = math.floor(p)
    if force or sec ~= lastSec or total ~= lastTotal then
        lastSec, lastTotal = sec, total
        timeL.Text = fmt(p)
        timeR.Text = fmt(total)
    end
    -- lyric line that matches the playhead
    if lyr and lyricsOn then
        local i = lyrIdx
        while i < #lyr and lyr[i + 1].t <= p do i += 1 end
        while i > 0 and lyr[i].t > p do i -= 1 end
        if i ~= lyrIdx then
            lyrIdx = i
            lyricLabel.Text = (i > 0) and lyr[i].text or ""
        end
    end
end

local function firstIdx(notes, t)
    local lo, hi = 1, #notes + 1
    while lo < hi do
        local mid = (lo + hi) // 2
        if notes[mid].time < t then lo = mid + 1 else hi = mid end
    end
    return lo
end

local function seekTo(t)
    if not cur then return end
    pos = math.clamp(t, 0, cur.total)
    idx = firstIdx(cur.notes, pos)
    updateProgress(true)
end

stopAll = function()
    token += 1
    playing, paused, cur = false, false, nil
    pos, idx, scrub = 0, 1, nil
    lyr, lyrIdx = nil, 0
    lyricLabel.Text = ""
    refreshPlayingUI()
    updatePlayBtn()
    updateProgress(true)
end

-- runs one song until it ends / fails / is replaced. returns "done" | "fail" | "stop" | "superseded"
local function runSong(s, my)
    pcall(scan)
    updateMarkers()
    if #detected == 0 then
        setStatus("No keys detected. Move the box over the piano.", "bad", 3)
        return "stop"
    end
    local keys = detected
    local N = #keys

    setStatus("Loading…", "play")
    local body = fetchBody(s)
    if my ~= token then return "superseded" end
    if not body then
        setStatus("Download failed · skipping", "bad", 3)
        return "fail"
    end
    local okP, notes = pcall(parseMidi, body)
    if not okP or #notes == 0 then
        setStatus("MIDI unreadable · skipping", "bad", 3)
        return "fail"
    end

    local diatonic
    if modeIdx == 1 then diatonic = not hasBlackKeys(keys) else diatonic = (modeIdx == 3) end
    local mapper = buildMapper(notes, N, diatonic)
    local maxChord = (N <= 15) and 2 or 4

    cur = { notes = notes, total = math.max(notes[#notes].time, 0.001) }
    pos, idx, paused = 0, 1, false
    task.spawn(loadLyrics, s, my)
    updatePlayBtn()
    updateProgress(true)
    setStatus((diatonic and "Diatonic" or "Chromatic") .. " · " .. N .. " keys", "play")

    while true do
        local dt = task.wait()
        if my ~= token then return "superseded" end
        if not paused then pos += math.min(dt, 0.25) * speed end -- speed is read every frame = real time
        if pos > cur.total + 0.4 then return "done" end

        while idx <= #notes and notes[idx].time <= pos do
            local t = notes[idx].time
            local group, j = {}, idx
            while j <= #notes and notes[j].time - t < 0.01 do
                group[#group + 1] = notes[j].n
                j += 1
            end
            idx = j
            table.sort(group, function(a, b) return a > b end)
            local chord, seen = {}, {}
            for _, nn in ipairs(group) do
                local k = mapper(nn)
                if not seen[k] and keys[k + 1] then
                    seen[k] = true
                    chord[#chord + 1] = keys[k + 1]
                    if #chord >= maxChord then break end
                end
            end
            if #chord > 0 then task.spawn(pressMany, chord) end
        end
        updateProgress()
    end
end

playSong = function(s, keepQueue)
    if not keepQueue then setQueueFrom(s) end
    token += 1
    local my = token
    selected = s
    songLabel.Text = s.label
    updatePinBtn()
    highlightRows()
    cur, pos, idx, paused, scrub = nil, 0, 1, false, nil
    lyr, lyrIdx = nil, 0
    lyricLabel.Text = ""
    playing = true
    refreshPlayingUI()
    updatePlayBtn()
    updateProgress(true)

    task.spawn(function()
        local ok, res = pcall(runSong, s, my)
        if not ok then res = "fail" end
        if my ~= token then return end -- replaced by another song or stopped
        cur = nil

        if res == "done" then failStreak = 0 else failStreak += 1 end
        if res == "stop" then return stopAll() end
        if autoIdx == 1 then
            stopAll()
            setStatus(res == "done" and "Done ✓" or "Stopped", res == "done" and "good" or "warn", 3)
            return
        end
        if res == "fail" and (autoIdx == 3 or failStreak >= 5) then
            stopAll()
            return
        end
        local nxt = (autoIdx == 3) and s or stepQueue(1)
        if nxt then playSong(nxt, true) else stopAll() end
    end)
end

