    lyrBtn.TextColor3 = lyricsOn and C.accent or C.muted
end
refreshLyrBtn()

-- "แกะเพลง" overlay: paste a link / song name -> MIDI
local tcFrame = new("Frame", {
    Position = list.Position, Size = UDim2.new(1, -20, 1, -(LIST_Y + 10)), BackgroundColor3 = C.card, Visible = false, ZIndex = 3,
