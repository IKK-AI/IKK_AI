    { repo = "jukedeck/nottingham-dataset", branch = "master", tag = "Nottingham" },
}

local HIDE_DUPLICATES = false -- true = hide songs that have the exact same title as one already listed

local OPENNAN_API = "https://api.opennan.com/v1/piano/transcriptions" -- link / song name -> MIDI
local TRANSCRIBE_TIMEOUT = 1500 -- seconds to wait for one transcription

local MAX_SHOWN = 100 -- rows rendered at once (use search / pins to narrow)

