local chip = new("Frame", {
    AutomaticSize = Enum.AutomaticSize.X,
    Size = UDim2.fromOffset(0, 22),
    Position = UDim2.new(0, 0, 0, -26),
    BackgroundColor3 = C.dark,
    BackgroundTransparency = 0.1,
    ZIndex = 6,
}, box)
corner(chip, 11)
stroke(chip, C.accent, 1, 0.4)
pad(chip, 10, 0)
local boxLabel = new("TextLabel", {
    AutomaticSize = Enum.AutomaticSize.X,
    Size = UDim2.fromOffset(0, 22),
    BackgroundTransparency = 1,
    Text = "SCAN · 0 keys",
    Font = FONT_B,
    TextSize = 12,
    TextColor3 = C.accent,
    ZIndex = 7,
}, chip)

local grip = new("TextButton", {
    Size = UDim2.fromOffset(30, 30),
    AnchorPoint = Vector2.new(1, 1),
    Position = UDim2.new(1, 4, 1, 4),
    BackgroundColor3 = C.accent,
    Text = "◢",
    Font = FONT_B,
    TextSize = 15,
    TextColor3 = C.dark,
    AutoButtonColor = false,
    ZIndex = 8,
}, box)
corner(grip, 15)
stroke(grip, C.dark, 2, 0.3)

local markers = {}
local function getMarker(i)
    local m = markers[i]
    if not m then
        m = new("Frame", {
            Size = UDim2.fromOffset(10, 10),
            AnchorPoint = Vector2.new(0.5, 0.5),
            BackgroundColor3 = C.accent,
            BorderSizePixel = 0,
            Visible = false,
            ZIndex = 9,
        }, gui)
        corner(m, 5)
        stroke(m, C.dark, 1.5, 0.2)
        markers[i] = m
    end
    return m
end
local function updateMarkers()
    local show = scanActive and boxOn
    for i, k in ipairs(detected) do
        local m = getMarker(i)
        m.Position = UDim2.fromOffset(k.x, k.y)
        m.Visible = show
    end
    for i = #detected + 1, #markers do
        markers[i].Visible = false
    end
end
flash = function(i)
    local m = markers[i]
    if not m then return end
    m.Size = UDim2.fromOffset(18, 18)
    m.BackgroundColor3 = WHITE
    tween(m, 0.22, { Size = UDim2.fromOffset(10, 10), BackgroundColor3 = C.accent })
end

local function styleBox()
    local show = boxOn
    box.Active = show and not playing
    chip.Visible = show
    grip.Visible = show
    local bgT = (not show) and 1 or (playing and 0.95 or 0.85)
    tween(box, 0.2, { BackgroundTransparency = bgT })
    tween(boxStroke, 0.2, {
        Color = playing and C.good or C.accent,
        Transparency = show and 0 or 1,
    })
end

