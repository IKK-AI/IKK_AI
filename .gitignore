-- ═══════════════════════════════════════════════════════════════
-- ⊢ UPGRADE MODAL — ประโยชน์ของ premium (เปิดจากปุ่มอัปเกรด)
-- ═══════════════════════════════════════════════════════════════
local upModal
do
        local vp = Camera.ViewportSize
        local uW = math.clamp(vp.X - 24, 260, 320)
        local uH = math.clamp(vp.Y - 24, 300, 388)
        upModal = F(sg, UDim2.fromOffset(uW, uH), UDim2.new(0.5, -uW / 2, 0.5, -uH / 2), C.POP, 14, 60)
        themed(upModal, "BackgroundColor3", "POP")
        upModal.Visible = false
        upModal.ClipsDescendants = true
        upModal.Name = "UpgradeModal"
        Sk(upModal, nil, 1.5, 0.25).Color = GOLD

        local uHdr = F(upModal, UDim2.new(1, 0, 0, 40), UDim2.new(), GOLD, 10, 61)
        local uHdrP = Instance.new("Frame", uHdr)
        uHdrP.Size = UDim2.new(1, 0, 0, 14)
        uHdrP.Position = UDim2.new(0, 0, 1, -14)
        uHdrP.BackgroundColor3 = GOLD; uHdrP.BorderSizePixel = 0; uHdrP.ZIndex = 61
        L(uHdr, "★  UPGRADE TO PREMIUM", UDim2.new(1, -60, 1, 0), UDim2.fromOffset(12, 0), 12, BF, GOLDD, Enum.TextXAlignment.Left, 62)
        local uClose = mkBtn(uHdr, "✕", UDim2.fromOffset(24, 24), UDim2.new(1, -30, 0.5, -12), "danger", 11, 62)
        -- ลากได้จับที่หัวการ์ด + clamp ขอบจอ
        if UIX.floatDrag then pcall(UIX.floatDrag, upModal, uHdr) end

        local yy = 50
        local function upRow(icon, txt)
                Lk(upModal, icon .. "  " .. txt, UDim2.new(1, -24, 0, 26), UDim2.fromOffset(12, yy), 9, RF, "T1", Enum.TextXAlignment.Left, 62)
                yy = yy + 30
        end
        upRow("🔊", "Sound Mixer — ปรับเสียง UI ทุกหมวดเอง")
        upRow("🧠", "AI Research Kit — ข้อมูลผู้เล่น/ข่าว/เวลาสด")
        upRow("🔑", "Multi-Key — สำรองอัตโนมัติ ติดลิมิตแล้วข้ามไปคีย์ถัดไป (10 ดอก)")
        upRow("✏️", "Custom Persona — สั่งบุคลิกเพิ่มเติมเอง")
        yy = yy + 4
        local uDiv = Instance.new("Frame", upModal)
        uDiv.Size = UDim2.new(1, -24, 0, 1)
        uDiv.Position = UDim2.fromOffset(12, yy)
        uDiv.BackgroundColor3 = C.BD; uDiv.BorderSizePixel = 0; uDiv.ZIndex = 62
        themed(uDiv, "BackgroundColor3", "BD")
        yy = yy + 8
        local uNote = Lk(upModal, "วิธีอัปเกรด: ติดต่อเจ้าของ Sebas AI\nเจ้าของจะเปิด Premium ให้บัญชีของคุณผ่านหน้าแอดมิน\n(เปิดใช้ทันที ไม่ต้องโหลดสคริปต์ใหม่)",
                UDim2.new(1, -24, 0, 44), UDim2.fromOffset(12, yy), 8, RF, "T2", Enum.TextXAlignment.Left, 62)
        uNote.TextWrapped = true
        uNote.TextYAlignment = Enum.TextYAlignment.Top

        local uOk = mkBtn(upModal, "เข้าใจแล้ว", UDim2.new(1, -24, 0, 30), UDim2.new(0.5, -((uW - 24) / 2), 1, -40), "soft", 10, 62)
        uOk.MouseButton1Click:Connect(function()
                if UIX.closeModal then pcall(UIX.closeModal, upModal) end
        end)
        uClose.MouseButton1Click:Connect(function()
                if UIX.closeModal then pcall(UIX.closeModal, upModal) end
        end)
end

upBtn.MouseButton1Click:Connect(function()
        SND.play("click")
        if UIX.openModal then pcall(UIX.openModal, upModal) end
end)

-- ═══════════════════════════════════════════════════════════════
-- ⊢ LOGIN OVERLAY — บังคับครั้งแรก (ชื่ออัตโนมัติ + ตั้งรหัสเอง)
--   ⚠ รีดีไซน์ตามคำขอ: เบลอพื้นหลังจริง (BlurEffect) + backdrop เข้ม ·
--   การ์ดปักกลางจอเสมอ ลากไม่ได้ · กดอะไรนอกการ์ดไม่ได้เลยจนกว่าจะ
--   login สำเร็จ · เคย login แล้ว → เหลือช่องรหัสผ่านเดียว (ไม่มีช่องยืนยัน)
--   ขนาด/ฟอนต์ = แบบเดิมเป๊ะ (ยุค v7 ดั้งเดิม)
-- ═══════════════════════════════════════════════════════════════
local lgBackdrop = Instance.new("TextButton", sg)
lgBackdrop.Name = "LoginBackdrop"
lgBackdrop.Size = UDim2.new(1, 0, 1, 0)
lgBackdrop.BackgroundColor3 = Color3.fromRGB(4, 6, 12)
lgBackdrop.BackgroundTransparency = 1
lgBackdrop.BorderSizePixel = 0
lgBackdrop.Text = ""; lgBackdrop.AutoButtonColor = false
lgBackdrop.ZIndex = 990
lgBackdrop.Visible = false

local lgCard
local lgMode, lgBusy = nil, false
local passBox, confirmBox, lgStatus, submitBtn, retryBtn, helpBtn, cfRow, cfLbl

do
        local vp = Camera.ViewportSize
        local lW = math.clamp(vp.X - 20, 240, 282)
        local lH = math.clamp(vp.Y - 16, 300, 348)
        lgCard = F(sg, UDim2.fromOffset(lW, lH), UDim2.new(0.5, 0, 0.5, 0), C.POP, 16, 991)
        lgCard.AnchorPoint = Vector2.new(0.5, 0.5)
        lgCard.Position = UDim2.new(0.5, 0, 0.5, 0)   -- ปักกลางจอเสมอ (จอเปลี่ยนก็จัดกลางใหม่)
        themed(lgCard, "BackgroundColor3", "POP")
        lgCard.Name = "LoginCard"
        lgCard.Visible = false
        lgCard.ClipsDescendants = true
        Sk(lgCard, "AC", 1.5, 0.2)

        -- หัวการ์ด: gradient + ชื่อ (การ์ดปักกลางจอ — ไม่มี handle ลากแล้ว)
        local lgHdr = F(lgCard, UDim2.new(1, 0, 0, 46), UDim2.new(), C.AC, 10, 992)
        themed(lgHdr, "BackgroundColor3", "AC")
        local lgHdrP = Instance.new("Frame", lgHdr)
        lgHdrP.Size = UDim2.new(1, 0, 0, 14)
        lgHdrP.Position = UDim2.new(0, 0, 1, -14)
        lgHdrP.BackgroundColor3 = C.AC; lgHdrP.BorderSizePixel = 0; lgHdrP.ZIndex = 992
        themed(lgHdrP, "BackgroundColor3", "AC")
        local lgGrad = Instance.new("UIGradient", lgHdr)
        lgGrad.Rotation = 105
        lgGrad.Transparency = NumberSequence.new({
                NumberSequenceKeypoint.new(0, 0.1),
                NumberSequenceKeypoint.new(1, 0.4),
        })
        L(lgHdr, "SEBAS AI", UDim2.fromOffset(130, 18), UDim2.fromOffset(14, 7), 14, BF,
                Color3.fromRGB(255, 255, 255), Enum.TextXAlignment.Left, 993)
        L(lgHdr, "SIGN IN · " .. VERSION_TAG, UDim2.fromOffset(150, 10), UDim2.fromOffset(14, 26), 7, RF,
                Color3.fromRGB(255, 255, 255), Enum.TextXAlignment.Left, 993)

        -- อวตาร + ชื่อ (ล็อคจาก Roblox)
        local lgAva = Instance.new("Frame", lgCard)
        lgAva.Size = UDim2.fromOffset(46, 46)
        lgAva.Position = UDim2.new(0.5, -23, 0, 58)
        lgAva.BackgroundColor3 = C.AC; lgAva.BorderSizePixel = 0
        lgAva.ZIndex = 992
        themed(lgAva, "BackgroundColor3", "AC")
        Instance.new("UICorner", lgAva).CornerRadius = UDim.new(1, 0)
        Sk(lgAva, nil, 2, 0.2).Color = Color3.fromRGB(255, 255, 255)
        L(lgAva, LP.DisplayName:sub(1, 1):upper(), UDim2.new(1, 0, 1, 0), UDim2.new(), 19, BF,
                Color3.fromRGB(255, 255, 255), Enum.TextXAlignment.Center, 993)
        -- ภาพอวตาร Roblox จริง (headshot) แทนตัวอักษร
        if UIX.avatar then pcall(UIX.avatar, lgAva, 994) end

        local lgName = Lk(lgCard, LP.DisplayName, UDim2.new(1, -20, 0, 15), UDim2.fromOffset(10, 108), 12, BF, "T1", Enum.TextXAlignment.Center, 992)
        lgName.TextTruncate = Enum.TextTruncate.AtEnd
        Lk(lgCard, "@" .. LG_USER .. "   🔒 ชื่อดึงจาก Roblox อัตโนมัติ",
                UDim2.new(1, -20, 0, 10), UDim2.fromOffset(10, 124), 7, RF, "T2", Enum.TextXAlignment.Center, 992)

        local function lgField(y, ph, isPass)
                local bx = Instance.new("TextBox", lgCard)
                bx.Size = UDim2.new(1, -28, 0, 30)
                bx.Position = UDim2.fromOffset(14, y)
                bx.BackgroundColor3 = C.CD; bx.BorderSizePixel = 0
                bx.Text = ""; bx.PlaceholderText = ph
                bx.PlaceholderColor3 = C.T2
                bx.TextColor3 = C.T1
                bx.Font = BF; bx.TextSize = 11
                bx.ZIndex = 992; bx.ClearTextOnFocus = false
                bx.TextXAlignment = Enum.TextXAlignment.Left
                themed(bx, "BackgroundColor3", "CD")
                themed(bx, "TextColor3", "T1")
                Instance.new("UICorner", bx).CornerRadius = UDim.new(0, 8)
                local s = Sk(bx, "BD", 1, 0.4)
                bx.Focused:Connect(function()
                        ANIM.play(s, { Color = C.AC, Transparency = 0 }, { t = 0.14, tag = "lgf" })
                end)
                bx.FocusLost:Connect(function()
                        ANIM.play(s, { Color = C.BD, Transparency = 0.4 }, { t = 0.18, tag = "lgf" })
                end)
                return bx
        end

        Lk(lgCard, "PASSWORD", UDim2.fromOffset(120, 8), UDim2.fromOffset(16, 140), 7, BF, "T2", Enum.TextXAlignment.Left, 992)
        passBox = lgField(150, "ตั้งรหัสผ่านของคุณ (4+ ตัว)")
        passBox.Name = "LoginPass"

        cfRow = Instance.new("Frame", lgCard)
        cfRow.Size = UDim2.new(1, 0, 0, 48)
        cfRow.Position = UDim2.fromOffset(0, 184)
        cfRow.BackgroundTransparency = 1; cfRow.ZIndex = 992
        cfLbl = Lk(cfRow, "CONFIRM PASSWORD", UDim2.fromOffset(120, 8), UDim2.fromOffset(16, 0), 7, BF, "T2", Enum.TextXAlignment.Left, 992)
        confirmBox = lgField(10, "พิมพ์รหัสซ้ำอีกครั้ง")
        confirmBox.Name = "LoginConfirm"
        confirmBox.Parent = cfRow

        submitBtn = mkBtn(lgCard, "สร้างบัญชี", UDim2.new(1, -28, 0, 32), UDim2.fromOffset(14, 238), "accent", 11, 992)
        submitBtn.Name = "LoginSubmit"

        lgStatus = Lk(lgCard, "", UDim2.new(1, -28, 0, 24), UDim2.fromOffset(14, 274), 8, RF, "T2", Enum.TextXAlignment.Center, 992)
        lgStatus.TextWrapped = true

        retryBtn = mkBtn(lgCard, "↻ ลองใหม่", UDim2.fromOffset(90, 24), UDim2.new(0.5, -96, 1, -32), "soft", 9, 992)
        helpBtn = mkBtn(lgCard, "❓ เชื่อม Sheet", UDim2.fromOffset(100, 24), UDim2.new(0.5, 6, 1, -32), "soft", 9, 992)
        retryBtn.Visible = false
        -- ⚠ เคร่งครัด: ไม่มีปุ่มข้าม/ใช้แบบออฟไลน์ — ไม่ login = ใช้สคริปต์ไม่ได้ (ตามที่แอดมินสั่ง)

        -- การ์ดปักกลางจอเสมอ (จอหมุน/เปลี่ยนขนาด → ถูกจัดกลับกลางจออีกครั้ง)
        if UIX.addFloat then
                UIX.addFloat(lgCard, function()
                        lgCard.Position = UDim2.new(0.5, 0, 0.5, 0)
                end)
        end
end

local function lgSetStatus(txt, kind)
        lgStatus.Text = txt or ""
        lgStatus.TextColor3 = (kind == "err") and C.NO or (kind == "warn") and C.WN or (kind == "ok") and C.OK or C.T2
end

local function lgSetMode(mode)
        lgMode = mode
        cfRow.Visible = (mode == "register")
        submitBtn.Text = (mode == "register") and "สร้างบัญชี" or "เข้าสู่ระบบ"
        -- เลย์เอาต์ปรับตามโหมด: login (ไม่มีช่องยืนยัน) ชิดขึ้น — ดูกระชับ ไม่มีช่องว่างยาว ๆ
        submitBtn.Position = UDim2.fromOffset(14, mode == "register" and 238 or 192)
        lgStatus.Position = UDim2.fromOffset(14, mode == "register" and 274 or 228)
end

local function showLogin()
        if lgBackdrop.Visible then return end
        AUTH.locked = true
        lgBackdrop.Visible = true
        lgBackdrop.BackgroundTransparency = 0.30
        lgCard.Visible = true
        lgCard.AnchorPoint = Vector2.new(0.5, 0.5)
        lgCard.Position = UDim2.new(0.5, 0, 0.5, 0)
        if UIX.setBlur then pcall(UIX.setBlur, true) end   -- เบลอพื้นหลังจริง + ห้ามสัมผัส GUI หลัง
        ANIM.play(lgBackdrop, { BackgroundTransparency = 0.30 }, { t = 0.25, tag = "lgb" })
        local us = addScale(lgCard, 0.9)
        ANIM.play(us, { Scale = 1 }, { t = 0.3, style = Enum.EasingStyle.Back, dir = Enum.EasingDirection.Out, tag = "lgc" })
        SND.play("open")
        passBox.Text = ""; confirmBox.Text = ""
        retryBtn.Visible = false
        -- ⚠ เคย login แล้ว → เหลือช่องรหัสผ่านเดียว (โหมด login ทันที)
        --   ไม่มี session → เริ่มด้วยโหมดรหัสผ่าน แล้วเซิร์ฟเวอร์จะสลับเป็น register เองถ้าเป็นบัญชีใหม่
        local sess = loadSession()
        if AUTH.disabled then
                -- ไม่มีเซิร์ฟเวอร์ (DB_URL ว่าง) → บัญชีท้องถิ่น โหมดเจ้าของ
                lgSetMode(sess and "login" or "register")
                lgSetStatus("โหมดเจ้าของ — ไม่ได้เชื่อม Google Sheets" ..
                        (sess and " · ใส่รหัสผ่านที่ตั้งไว้" or " · ตั้งรหัสผ่านเพื่อเริ่มใช้งาน"), "warn")
                return
        end
        lgSetMode("login")
        if sess then
                lgSetStatus("ยินดีต้อนรับกลับ @" .. (sess.u or LG_USER) .. " — ใส่รหัสผ่านเพื่อเข้าสู่ระบบ", "ok")
        else
                lgSetStatus("กำลังตรวจสอบบัญชี...", nil)
        end
        task.spawn(function()
                local resp = authCall({ action = "check", username = LG_USER })
                if not lgBackdrop.Visible then return end
                if resp and resp.ok then
                        lgSetMode(resp.exists and "login" or "register")
                        lgSetStatus(resp.exists and "มีบัญชีอยู่แล้ว — ใส่รหัสผ่านเพื่อเข้าสู่ระบบ"
                                or "ยังไม่มีบัญชี — ตั้งรหัสผ่านเพื่อสร้างเลย", "ok")
                else
                        lgSetStatus("เชื่อมต่อช้า — กดปุ่มได้เลย (จะลองใหม่ให้อัตโนมัติ)", "warn")
                end
        end)
end

local function hideLogin()
        AUTH.locked = false
        if UIX.setBlur then pcall(UIX.setBlur, false) end   -- เลิกเบลอพื้นหลัง
        ANIM.play(lgBackdrop, { BackgroundTransparency = 1 }, { t = 0.2, tag = "lgb",
                cb = function() lgBackdrop.Visible = false end })
        local us = lgCard:FindFirstChild("SebasScale")
        if us then
                ANIM.play(us, { Scale = 0.88 }, { t = 0.18, style = Enum.EasingStyle.Quart, dir = Enum.EasingDirection.In, tag = "lgc",
                        cb = function()
                                lgCard.Visible = false
                                us.Scale = 1
                        end })
        else
                lgCard.Visible = false
        end
        SND.play("close")
end

local function authSuccess(resp, hash, remember)
        setAuthFromResp(resp)
        if remember then saveSession(LG_USER, hash, AUTH.tier) end
        hideLogin()
        pcall(applyTierLater)
        SND.play("success")
        notify("🎉 ยินดีต้อนรับ " .. (AUTH.premium and "★ " or "") .. LG_USER,
                AUTH.premium and "PREMIUM ACTIVE — ทุกฟีเจอร์ปลดล็อค" or "เข้าสู่ระบบสำเร็จ (Normal)", "ok")
end

local function lgSubmit()
        if lgBusy then return end
        local p = passBox.Text or ""
        if #p < 4 then
                lgSetStatus("รหัสผ่านต้องยาวอย่างน้อย 4 ตัว", "err")
                SND.play("error")
                return
        end
        if lgMode == "register" and p ~= (confirmBox.Text or "") then
                lgSetStatus("รหัสผ่านทั้งสองช่องไม่ตรงกัน", "err")
                SND.play("error")
                return
        end
        lgBusy = true
        lgSetStatus("กำลังตรวจสอบ...", nil)
        task.spawn(function()
                local h = pwHash(p)
                if AUTH.disabled then
                        -- บัญชีท้องถิ่น (ไม่มีเซิร์ฟเวอร์): เก็บในเครื่อง — tier = premium โหมดเจ้าของ
                        local sess = loadSession()
                        if sess and sess.h ~= h then
                                lgBusy = false
                                SND.play("error")
                                lgSetStatus("รหัสผ่านไม่ตรงกับที่ตั้งไว้ในเครื่องนี้", "err")
                                return
                        end
                        saveSession(LG_USER, h, "premium")
                        AUTH.ok = true; AUTH.offline = false
                        AUTH.premium = true; AUTH.tier = "premium"
                        AUTH.user = LG_USER
                        lgBusy = false
                        hideLogin()
                        pcall(applyTierLater)
                        SND.play("success")
                        notify("ยินดีต้อนรับ " .. LG_USER,
                                "โหมดเจ้าของ — ทุกฟีเจอร์ปลดล็อค (ไม่เชื่อมเซิร์ฟเวอร์)", "ok")
                        return
                end
                local resp
                if lgMode == "login" then
                        resp = authCall({ action = "login", username = LG_USER, pass = h })
                else
                        resp = authCall({ action = "register", username = LG_USER, pass = h })
                        -- แข่งกันสมัครพร้อมกัน/มีบัญชีแล้ว → สลับไป login เอง
                        if resp and resp.ok == false and resp.error == "exists" then
                                lgSetMode("login")
                                lgSetStatus("ชื่อ @" .. LG_USER .. " เคยสมัครแล้ว (ชื่อผู้ใช้ห้ามซ้ำ) — ใส่รหัสผ่านเดิม", "warn")
                                resp = authCall({ action = "login", username = LG_USER, pass = h })
                        end
                end
                lgBusy = false
                if not lgBackdrop.Visible then return end
                if resp and resp.ok then
                        authSuccess(resp, h, true)
                elseif resp then
                        SND.play("error")
                        if resp.error == "badpass" then
                                lgSetStatus("รหัสผ่านไม่ถูกต้อง — ลองอีกครั้ง", "err")
                        elseif resp.error == "banned" then
                                lgSetStatus("บัญชีนี้ถูกระงับ — ติดต่อเจ้าของ", "err")
                        elseif resp.error == "nouser" then
                                lgSetMode("register")
                                lgSetStatus("ยังไม่มีบัญชี — ตั้งรหัสผ่านเพื่อสร้างเลย", "warn")
                        else
                                lgSetStatus("ผิดพลาด: " .. tostring(resp.error), "err")
                        end
                else
                        SND.play("error")
                        lgSetStatus("เชื่อมต่อเซิร์ฟเวอร์ไม่ได้ — ตรวจเน็ต หรือกด ❓ ดูวิธีแก้", "err")
                        retryBtn.Visible = true
                end
        end)
end

submitBtn.MouseButton1Click:Connect(lgSubmit)
retryBtn.MouseButton1Click:Connect(function()
        SND.play("click")
        retryBtn.Visible = false
        lgSetStatus("กำลังเชื่อมต่อเซิร์ฟเวอร์...", nil)
        task.spawn(function()
                local resp = authCall({ action = "check", username = LG_USER })
                if resp and resp.ok then
                        lgSetMode(resp.exists and "login" or "register")
                        lgSetStatus("เชื่อมต่อได้แล้ว — ใส่รหัสผ่านได้เลย", "ok")
                else
                        lgSetStatus("ยังเชื่อมไม่ได้ — เช็คว่า Deploy ตั้ง Who has access = Anyone (กด ❓ ดูวิธี)", "err")
                        retryBtn.Visible = true
                end
        end)
end)

-- ─── คู่มือเชื่อมต่อ Google Sheets (ปุ่ม ❓ บนการ์ด login) ──────
--   อธิบายขั้นตอน deploy Apps Script ให้ข้อมูลผู้เล่นลง Sheet จริง
local guideCard = nil
local function showSetupGuide()
        SND.play("open")
        if guideCard and guideCard.Parent then
                guideCard.Visible = true
                pcall(ANIM.popIn, guideCard, { from = 0.92, t = 0.22 })
                return
        end
        local vp = Camera.ViewportSize
        local gw2 = math.clamp(vp.X - 20, 250, 334)
        local gh2 = math.clamp(vp.Y - 16, 300, 380)
        guideCard = F(sg, UDim2.fromOffset(gw2, gh2), UDim2.new(0.5, -gw2 / 2, 0.5, -gh2 / 2), C.POP, 14, 995)
        guideCard.Name = "SetupGuide"
        themed(guideCard, "BackgroundColor3", "POP")
        Sk(guideCard, "AC", 1.5, 0.2)
        local gh = F(guideCard, UDim2.new(1, 0, 0, 40), UDim2.new(), C.AC, 10, 996)
        gh.Name = "GuideHeader"
        themed(gh, "BackgroundColor3", "AC")
        L(gh, "🔗 เชื่อมต่อ Google Sheets", UDim2.new(1, -56, 1, 0), UDim2.fromOffset(12, 0), 11, BF,
                Color3.fromRGB(255, 255, 255), Enum.TextXAlignment.Left, 997)
        local gx = mkBtn(guideCard, "✕", UDim2.fromOffset(24, 24), UDim2.new(1, -30, 0, 8), "soft", 10, 997)
        gx.MouseButton1Click:Connect(function()
                SND.play("close")
                guideCard.Visible = false
        end)
        local body = Instance.new("ScrollingFrame", guideCard)
        body.Size = UDim2.new(1, -20, 1, -52)
        body.Position = UDim2.fromOffset(10, 46)
        body.BackgroundTransparency = 1
        body.BorderSizePixel = 0
        body.ScrollBarThickness = 3
        body.CanvasSize = UDim2.new(0, 0, 0, 460)
        body.ZIndex = 996
        local txt = L(body,
                "วิธีเปิดระบบผู้ใช้ (ส่งข้อมูลลง Google Sheets จริง):\n\n" ..
                "1) เปิด Google Sheet ของคุณ → ส่วนเสริม (Extensions) → Apps Script\n\n" ..
                "2) ลบโค้ดเดิมออก → วางโค้ดจากไฟล์ SebasAI_Database.gs ทั้งหมด → กดบันทึก\n\n" ..
                "3) Deploy → New deployment → กดเฟือง ⚙ เลือก Web app\n" ..
                "    · Execute as: Me\n" ..
                "    · Who has access: Anyone  ← สำคัญมาก! ตั้งอย่างอื่นจะเชื่อมไม่ได้\n\n" ..
                "4) คัดลอก Web app URL (ลงท้ายด้วย /exec)\n\n" ..
                "5) เปิดไฟล์สคริปต์นี้ → หาบรรทัด DB_URL = \"\" → วาง URL ของคุณใน \"..\"\n" ..
                "    (หรือสร้างไฟล์ OllamaAI_DBUrl.txt ใส่ URL ก็ได้)\n\n" ..
                "6) รันสคริปต์ใหม่ → กด ↻ ลองใหม่ — ขึ้นว่าเชื่อมต่อได้ = ใช้งานได้\n\n" ..
                "หลังจากนี้:\n" ..
                "· ผู้เล่นที่สมัครครั้งแรก = แพลนธรรมดา (Normal) ทุกคน\n" ..
                "· ชื่อผู้ใช้ดึงจาก Roblox อัตโนมัติ ห้ามซ้ำกัน\n" ..
                "· อัปคนเป็น Premium ผ่านเว็บ SebasAI_Admin.html\n" ..
                "   (ใส่ Web app URL เดียวกัน + ADMIN_KEY ในไฟล์ .gs)\n" ..
                "· แอดมินดูสถานะผู้ใช้สด ๆ ได้แก่ ออนไลน์/เกม/เวอร์ชั่น",
                UDim2.new(1, -8, 0, 450), UDim2.new(), 9, RF, C.T1, Enum.TextXAlignment.Left, 996)
        txt.TextWrapped = true
        txt.TextYAlignment = Enum.TextYAlignment.Top
        if UIX.floatDrag then pcall(UIX.floatDrag, guideCard, gh) end
        pcall(ANIM.popIn, guideCard, { from = 0.92, t = 0.22 })
end
helpBtn.MouseButton1Click:Connect(showSetupGuide)

-- ─── เติมข้อมูลหน้าโปรไฟล์ (cache → background refresh) ─────────
local fillInFlight = false
local function fillCore(info)
        pcall(function()
                prName.Text = (info and info.display) or LP.DisplayName
                prVer.Visible = info and info.verified == true
                local ageYears = info and info.ageYears
                        or math.floor(((tonumber(LP.AccountAge) or 0) / 365) * 10 + 0.5) / 10
                stAge2.Text = ageYears > 0 and (tostring(ageYears) .. " year" .. (ageYears >= 2 and "s" or "")) or "—"
                if info and info.created then
                        stJoined2.Text = info.created:sub(1, 10)
                else
                        stJoined2.Text = os.date("%Y-%m-%d", os.time() - (tonumber(LP.AccountAge) or 0) * 86400)
                end
                stFriends2.Text = info and info.friends and tostring(info.friends) or "—"
                stFollow2.Text = info and info.followers and tostring(info.followers) or "—"
                stRig2.Text = info and info.rig or "—"
                stWear2.Text = info and info.wearing or "—"
                stBio2.Text = info and info.desc or ""
        end)
end

local function fillOR()
        pcall(function()
                local actN = math.clamp(tonumber(S.activeKeys) or 1, 1, MAX_KEYS)
                local okN = 0
                for i = 1, actN do
                        if S.keyOk[i] then okN = okN + 1 end
                end
                if S.connected and EP.isLocal() then
                        orDot2.BackgroundColor3 = C.OK
                        orLine3.Text = "Connected ✓  (Local AI · ไม่ใช้คีย์)"
                        orLine3.TextColor3 = C.OK
                elseif S.connected and okN > 0 then
                        orDot2.BackgroundColor3 = C.OK
                        orLine3.Text = "Connected ✓  (" .. okN .. "/" .. actN .. " keys live)"
                        orLine3.TextColor3 = C.OK
                elseif S.connected then
                        orDot2.BackgroundColor3 = C.WN
                        orLine3.Text = "Connected (re-checking keys...)"
                        orLine3.TextColor3 = C.WN
                else
                        orDot2.BackgroundColor3 = C.NO
                        orLine3.Text = "Disconnected"
                        orLine3.TextColor3 = C.NO
                end
                local tok = tonumber(S.totalTokensUsed) or 0
                orLine4.Text = EP.isLocal()
                        and ("⚡ Tokens: " .. string.format("%.1fK", tok / 1000) .. "  ·  🖥️ Local AI (ไม่ใช้คีย์)")
                        or ("⚡ Tokens: " .. string.format("%.1fK", tok / 1000) .. "  ·  🔑 Keys: " .. actN)
                orModel2.Text = "🤖 " .. tostring(S.currentModel)
        end)
end

-- tier UI: pill/วงแหวน/ปุ่มอัปเกรด/แถวฟีเจอร์/การ์ดบัญชี
local function fillTierUI()
        pcall(function()
                local prem = AUTH.premium == true
                prRing.Color = prem and GOLD or Color3.fromRGB(255, 255, 255)
                prRing.Thickness = prem and 3 or 2.5
                if AUTH.disabled then
                        prTier.Text = "PRO"
                        prTier.BackgroundColor3 = GOLD
                        prTier.TextColor3 = GOLDD
                elseif prem then
                        prTier.Text = "★ PREMIUM"
                        prTier.BackgroundColor3 = GOLD
                        prTier.TextColor3 = GOLDD
                else
                        prTier.Text = "FREE"
                        prTier.BackgroundColor3 = C.CD
                        prTier.TextColor3 = C.T2
                end
                prUntil.Text = (prem and AUTH.untilDate and #AUTH.untilDate >= 8)
                        and ("Premium ถึง " .. AUTH.untilDate:sub(1, 10)) or ""

                if AUTH.disabled then
                        tierTitle.Text = "OWNER MODE · ทุกฟีเจอร์ปลดล็อค"
                        tierSub.Text = "ยังไม่เชื่อมฐานข้อมูล (DB_URL ว่าง) — ระบบ login/premium ปิดอยู่"
                        upBtn.Visible = false
                elseif prem then
                        tierTitle.Text = "PREMIUM ACTIVE ★"
                        tierSub.Text = (AUTH.untilDate and #AUTH.untilDate >= 8)
                                and ("ใช้ได้ถึง " .. AUTH.untilDate:sub(1, 10) .. " · ขอบคุณที่สนับสนุน ♥")
                                or "ใช้ได้ตลอดไป · ขอบคุณที่สนับสนุน ♥"
                        upBtn.Visible = false
                else
                        tierTitle.Text = "FREE PLAN"
                        tierSub.Text = "อัปเกรดเป็น Premium เพื่อปลดล็อคฟีเจอร์ทั้ง 4 ด้านล่าง"
                        upBtn.Visible = true
                end

                for _, row in pairs(benRows) do
                        local on = row.feat == nil or AUTH.on(row.feat)
                        row.st.Text = on and "✓ ใช้ได้" or "🔒 PREMIUM"
                        row.st.TextColor3 = on and C.OK or GOLD
                end

                if AUTH.disabled then
                        accLine1.Text = "บัญชีท้องถิ่น — @" .. tostring(AUTH.user or LG_USER)
                        accLine2.Text = "โหมดเจ้าของ: ยังไม่เชื่อมฐานข้อมูล (DB_URL ว่าง)"
                        logoutBtn.Visible = (AUTH.ok == true and AUTH.user ~= nil)
                        accNote.Text = "ตั้งค่า: วาง Apps Script URL ที่ DB_URL ในสคริปต์ (หรือไฟล์ OllamaAI_DBUrl.txt) → ระบบ login + premium จริงจะเปิดใช้ทันที"
                else
                        accLine1.Text = "@" .. tostring(AUTH.user or LG_USER) .. "  ·  " .. (prem and "★ Premium" or "Normal")
                        accLine2.Text = AUTH.offline and "ออฟไลน์ — ใช้สถานะล่าสุดชั่วคราว"
                                or ("เข้าล่าสุด: " .. tostring(AUTH.lastLogin or "—"))
                        logoutBtn.Visible = true
                        accNote.Text = "เปลี่ยนรหัสผ่าน: ขอเจ้าของรีเซ็ตให้จากหน้าแอดมิน"
                end
        end)
end

UIX.fillProfilePage = function()
        fillTierUI()
        fillOR()
        local info = PX.getPlayerInfo and PX.getPlayerInfo(tostring(LP.UserId)) or nil
        fillCore(info)
        if fillInFlight then return end
        fillInFlight = true
        task.spawn(function()
                for attempt = 1, 3 do
                        task.wait(attempt == 1 and 0.6 or 1.6)
                        if not pg.Parent then return end
                        local i2 = PX.getPlayerInfo and PX.getPlayerInfo(tostring(LP.UserId)) or nil
                        if i2 and i2.username then
                                fillCore(i2)
                                fillInFlight = false
                                return
                        end
                end
                fillInFlight = false
        end)
end

logoutBtn.MouseButton1Click:Connect(function()
        SND.play("click")
        clearSession()
        AUTH.ok = false; AUTH.premium = false; AUTH.tier = "normal"
        AUTH.user = nil; AUTH.offline = false; AUTH.untilDate = nil; AUTH.lastLogin = nil
        pcall(applyTierLater)
        showLogin()
        notify("ออกจากระบบแล้ว", "เข้าสู่ระบบอีกครั้งเพื่อใช้งาน", "info")
end)

-- ═══════════════════════════════════════════════════════════════
-- ⊢ APPLY TIER — อัปเดต UI ทั้งระบบตามสถานะ premium จริง
--   (ดาว avatar / ขอบทอง / ป้าย 🔒 การ์ด carousel / ล็อคหน้า
--    sound+persona / หน้าโปรไฟล์)
-- ═══════════════════════════════════════════════════════════════
applyTierLater = function()
        local prem = AUTH.premium == true
        local gated = (not AUTH.disabled) and (not prem)
        pcall(function()
                if UIX.avaStar then UIX.avaStar.Visible = prem or AUTH.disabled end
                if UIX.avaSk then UIX.avaSk.Color = (prem or AUTH.disabled) and GOLD or Color3.fromRGB(255, 255, 255) end
                if UIX.carLocks then
                        for _, lk in pairs(UIX.carLocks) do lk.Visible = gated end
                end
                if UIX.mixLock then UIX.mixLock.Visible = gated end
                if UIX.perLock then UIX.perLock.Visible = gated end
        end)
        fillTierUI()
        if UIX.updateKeyDots then pcall(UIX.updateKeyDots) end
end

-- ─── silent login (session file) + recheck ทุก 5 นาที ──────────
local function silentLogin(sess, isRecheck)
        task.spawn(function()
                local resp = authCall({ action = "login", username = sess.u, pass = sess.h })
                if resp and resp.ok then
                        local wasPrem = AUTH.premium
                        setAuthFromResp(resp)
                        saveSession(sess.u, sess.h, AUTH.tier)   -- cache tier ใหม่
                        applyTierLater()
                        if isRecheck and wasPrem ~= AUTH.premium then
                                notify(AUTH.premium and "★ PREMIUM ACTIVATED" or "สถานะเปลี่ยนเป็น Normal",
                                        AUTH.premium and "ทุกฟีเจอร์ปลดล็อคแล้ว — เช็คหน้า Profile" or "พบ premium หมดอายุ", AUTH.premium and "ok" or "warn")
                                SND.play(AUTH.premium and "success" or "notify")
                        end
                elseif resp and (resp.error == "badpass" or resp.error == "nouser" or resp.error == "banned") then
                        if resp.error == "banned" then
                                AUTH.premium = false; AUTH.tier = "normal"
                                applyTierLater()
                        end
                        if isRecheck then
                                notify("เซสชันหมดอายุ", "กรุณาเข้าสู่ระบบใหม่", "warn")
                                SND.play("notify")
                        end
                        showLogin()
                else
                        -- เน็ต/เซิร์ฟเวอร์ล่ม → ออฟไลน์ชั่วคราว ใช้ tier ที่ cache ไว้
                        AUTH.ok = true
                        AUTH.offline = true
                        AUTH.premium = (sess.tier == "premium")
                        AUTH.tier = sess.tier or "normal"
                        AUTH.user = sess.u
                        applyTierLater()
                        if not isRecheck then
                                notify("ออฟไลน์ชั่วคราว", "เชื่อม DB ไม่ได้ — ใช้สถานะล่าสุด (" .. AUTH.tier .. ")", "warn")
                        end
                end
        end)
end

AUTH.recheck = function()
        if AUTH.disabled then return end
        local sess = loadSession()
        if sess then silentLogin(sess, true) end
end

-- ═══ BOOT ══════════════════════════════════════════════════════
if AUTH.disabled then
        local sess = loadSession()
        if sess and type(sess.h) == "string" and #sess.h >= 6 then
                -- บัญชีท้องถิ่นที่ตั้งไว้แล้ว → เข้าแบบเงียบ ๆ (โหมดเจ้าของ)
                AUTH.ok = true; AUTH.premium = true; AUTH.tier = "premium"
                AUTH.user = sess.u or LG_USER
                applyTierLater()
        else
                task.delay(0.35, showLogin) -- ครั้งแรก: บังคับตั้งรหัส (บัญชีท้องถิ่น)
        end
else
        local sess = loadSession()
        if sess then
                silentLogin(sess, false)   -- เข้าเงียบ ๆ ด้วย session เดิม
        else
                task.delay(0.35, showLogin) -- ครั้งแรก: บังคับ login
        end
end

print("[Sebas AI] Auth system " .. (AUTH.disabled and "OFF (owner mode)" or "ON (" .. DB_URL:sub(1, 42) .. "...)"))

end -- part wrap


-- ═══════════════════════════════════════════════════════════════
-- AUTO API KEY ADDON — สร้าง/ตรวจคีย์อัตโนมัติผ่านคลิปบอร์ด
-- ═══════════════════════════════════════════════════════════════
do
        local function cleanKey(raw)
                if type(raw) ~= "string" then return "" end
                local k = raw
                k = k:gsub("\xEF\xBB\xBF", "")
                k = k:gsub("\xFF\xFE", "")
                k = k:gsub("\xFE\xFF", "")
                k = k:gsub("%c", "")
                k = k:gsub("%s+", " ")
                return k:match("^%s*(.-)%s*$") or ""
        end

        -- Ollama API key ไม่มี prefix ตายตัว (เป็น token ยาว) → รับ token ทั่วไป 20-200 ตัวอักษร
        local function forceFixKey(raw)
                if type(raw) ~= "string" or #raw < 5 then return nil end
                local k = cleanKey(raw)
                if #k >= 20 and #k <= 200 and k:match("^[%w_.%-]+$") then return k end
                k = raw:match("[Bb]earer%s+([%w_.%-]+)")
                if k and #k >= 20 and #k <= 200 then return k end
                k = raw:match("([%w_%-]{30,})")   -- ดึง token ยาวที่ฝังอยู่ในข้อความ
                if k and #k <= 200 then return k end
                return nil
        end

        local function detailedTest(key)
                if not Http then return false, "NOHTTP" end
                if type(key) ~= "string" or #key < 10 then return false, "SHORT" end
                local ok, res = pcall(function()
                        return Http({
                                Url = EP.tags(), Method = "GET",
                                Headers = { ["Authorization"] = "Bearer " .. key },
                        })
                end)
                if not ok then return false, "NET" end
                local r = normRes(res)
                if not r then return false, "NORES" end
                if r.status == 200 then return true, "OK" end
                if r.status == 401 then return false, "KEY401" end
                if r.status == 403 then return false, "ERR403" end
                if r.status == 429 then return false, "RATE429" end
                if r.status == 402 then return false, "ERR402" end
                return false, "ERR" .. tostring(r.status)
        end

        local akState = { active = false, retries = 0, maxRetries = 8 }
        local akNotif, akLbl, akStroke, akProg, akProgFill

        local function akShow(text, color, showProg)
                pcall(function()
                        if not akNotif then
                                akNotif = Instance.new("Frame")
                                akNotif.Name = "SebasAutoKeyNotif"
                                akNotif.Size = UDim2.fromOffset(310, 70)
                                akNotif.Position = UDim2.new(0.5, -155, 0.01, 0)
                                akNotif.BackgroundColor3 = C.POP
                                akNotif.BackgroundTransparency = 0.03
                                akNotif.BorderSizePixel = 0
                                akNotif.ZIndex = 950
                                themed(akNotif, "BackgroundColor3", "POP")
                                Instance.new("UICorner", akNotif).CornerRadius = UDim.new(0, 14)

                                akStroke = Instance.new("UIStroke")
                                akStroke.Color = color or C.AC
                                akStroke.Thickness = 1.5
                                akStroke.Parent = akNotif

                                akProg = Instance.new("Frame")
                                akProg.Size = UDim2.new(0.9, 0, 0, 3)
                                akProg.Position = UDim2.new(0.05, 0, 1, -8)
                                akProg.BackgroundColor3 = C.CD
                                akProg.BorderSizePixel = 0
                                akProg.ZIndex = 952
                                akProg.Visible = false
                                themed(akProg, "BackgroundColor3", "CD")
                                Instance.new("UICorner", akProg).CornerRadius = UDim.new(0, 2)

                                akProgFill = Instance.new("Frame")
                                akProgFill.Size = UDim2.new(0, 0, 1, 0)
                                akProgFill.BackgroundColor3 = color or C.AC
                                akProgFill.BorderSizePixel = 0
                                akProgFill.ZIndex = 953
                                Instance.new("UICorner", akProgFill).CornerRadius = UDim.new(0, 2)
                                akProgFill.Parent = akProg
                                akProg.Parent = akNotif

                                akLbl = Instance.new("TextLabel")
                                akLbl.Size = UDim2.new(0.82, 0, 0.8, 0)
                                akLbl.Position = UDim2.fromOffset(30, 7)
                                akLbl.BackgroundTransparency = 1
                                akLbl.TextColor3 = Color3.new(1, 1, 1)
                                akLbl.TextSize = 12
                                akLbl.Font = BF
                                akLbl.TextWrapped = true
                                akLbl.TextXAlignment = Enum.TextXAlignment.Center
                                akLbl.TextYAlignment = Enum.TextYAlignment.Center
                                akLbl.ZIndex = 951
                                akLbl.Parent = akNotif

                                local cb = Instance.new("TextButton")
                                cb.Size = UDim2.fromOffset(24, 24)
                                cb.Position = UDim2.new(1, -28, 0, 4)
                                cb.BackgroundColor3 = C.CD
                                cb.Text = "✕"
                                cb.TextColor3 = C.T2
                                cb.TextSize = 11
                                cb.Font = BF
                                cb.BorderSizePixel = 0
                                cb.ZIndex = 952
                                Instance.new("UICorner", cb).CornerRadius = UDim.new(1, 0)
                                cb.Parent = akNotif
                                cb.MouseButton1Click:Connect(function()
                                        akState.active = false
                                        if akNotif then akNotif.Visible = false end
                                end)

                                local cc = Instance.new("TextButton")
                                cc.Name = "ClickCatch"
                                cc.Size = UDim2.new(1, 0, 1, 0)
                                cc.BackgroundTransparency = 1
                                cc.Text = ""
                                cc.ZIndex = 954
                                cc.Parent = akNotif
                                cc.MouseButton1Click:Connect(function()
                                        cc.Visible = false
                                        local fn = UIX.startAutoKey
                                        if fn then fn() end
                                end)

                                akNotif.Parent = sg
                        end
                        akNotif.Visible = true
                        akNotif.Size = UDim2.fromOffset(280, 62)
                        ANIM.play(akNotif, { Size = UDim2.fromOffset(310, 70) },
                                { t = 0.25, style = Enum.EasingStyle.Back, dir = Enum.EasingDirection.Out, tag = "ak" })
                        akLbl.Text = text
                        if color and akStroke then akStroke.Color = color end
                        if showProg and akProg then
                                akProg.Visible = true
                                if akProgFill then akProgFill.BackgroundColor3 = color or C.AC end
                        elseif akProg then
                                akProg.Visible = false
                        end
                        SND.play("notify")
                end)
        end

        local function akHide()
                pcall(function() if akNotif then akNotif.Visible = false end end)
        end

        local function akSetProgress(pct)
                pcall(function()
                        if akProgFill then
                                ANIM.play(akProgFill, { Size = UDim2.new(math.clamp(pct, 0, 1), 0, 1, 0) },
                                        { t = 0.4, tag = "akp" })
                        end
                end)
        end

        local function autoOpenKeyURL()
                -- เปิดหน้าสร้างคีย์ของค่ายที่ใช้อยู่ (ตาม Base URL ปัจจุบัน)
                local prov = EP.provider()
                local ku = prov and prov.keyurl
                local url = ku and ("https://" .. ku) or "https://ollama.com/settings/keys"
                local opened = false
                pcall(function()
                        if GuiService and GuiService.OpenBrowser then
                                GuiService:OpenBrowser(url)
                                opened = true
                        end
                end)
                pcall(function()
                        if not opened and StarterGui and StarterGui.OpenBrowser then
                                StarterGui:OpenBrowser(url)
                                opened = true
                        end
                end)
                pcall(function() setclipboard(url) end)
                return opened, url
        end

        local function autoKeyConnect(key)
                if type(key) ~= "string" or #key < 10 then return false, "SHORT" end
                local k = forceFixKey(key)
                if not k then k = cleanKey(key) end
                if not k or #k < 10 then return false, "SHORT" end
                local ok, reason = detailedTest(k)
                if ok then
                        local slot = nil
                        for i = 1, MAX_KEYS do
                                if type(S.keys[i]) == "string" and S.keys[i] == k then slot = i; break end
                        end
                        if not slot then
                                for i = 1, MAX_KEYS do
                                        if type(S.keys[i]) ~= "string" or #S.keys[i] < 10 then slot = i; break end
                                end
                        end
                        if not slot then slot = 1 end
                        if slot > (tonumber(S.activeKeys) or 1) then
                                S.activeKeys = math.min(slot, MAX_KEYS)
                        end
                        S.keys[slot] = k
                        S.key = k
                        S.curKey = slot
                        S.keyOk[slot] = true
                        S.keyErr[slot] = nil
                        S.connected = true
                        pcall(saveKeys)
                        pcall(function()
                                if UIX.keyRows and UIX.keyRows[slot] then
                                        UIX.keyRows[slot].box.Text = k
                                end
                                if UIX.updateKeyDots then UIX.updateKeyDots() end
                        end)
                        pcall(function()
                                if UIX.statusLbl then
                                        UIX.statusLbl.Text = "● Connected ✓ (Auto → Key #" .. slot .. ")"
                                        UIX.statusLbl.TextColor3 = C.OK
                                end
                        end)
                        pcall(function() pillDot.BackgroundColor3 = C.OK end)
                        pcall(updateHUD)
                        pcall(makeRing)
                        task.spawn(function()
                                task.wait(0.3)
                                pcall(function() OR.fetchModels(true) end)
                        end)
                        return true, "OK"
                end
                return false, reason
        end

        local hasGetClipboard = false
        pcall(function()
                if type(getclipboard) == "function" then hasGetClipboard = true end
        end)

        local function startAutoKeySetup()
                if akState.active then
                        akState.active = false
                        task.wait(0.5)
                end
                if S.connected and S.key and #S.key >= 10 then
                        akShow("✅🔑 เชื่อมต่อแล้ว!", C.OK)
                        task.delay(3, akHide)
                        return
                end
                -- 🖥️ Local AI (Ollama ในเครื่อง/วงแลน) — ไม่ต้องสร้างคีย์ ต่อเข้าเครื่องได้เลย
                if EP.isLocal() then
                        akShow("🖥️ Local AI ไม่ต้องใช้ API key\nกด Connect All ได้เลย", C.OK)
                        SND.play("success")
                        task.delay(4, akHide)
                        pcall(function() doConnect(true) end)
                        return
                end
                if not Http then
                        akShow("❌ Executor ไม่รองรับ HTTP", C.NO)
                        return
                end
                if not hasGetClipboard then
                        akShow("⚠️ อ่านคลิปบอร์ดไม่ได้\nกดปุ่มสีฟ้าแล้ววาง Key เองในหน้า API", C.WN)
                        autoOpenKeyURL()
                        return
                end

                akState.active = true
                akState.retries = 0

                local prov = EP.provider()
                local provName = prov and prov.name or "API"
                akShow("Opening " .. provName .. " keys page...", C.AC, true)
                akSetProgress(0.1)

                local opened, keyURL = autoOpenKeyURL()
                task.wait(2)
                akSetProgress(0.2)

                if opened then
                        akShow("Sign in " .. provName .. " -> Create Key\nThen COPY the API key", C.AC, true)
                else
                        akShow("Link copied to clipboard!\nOpen: " .. keyURL:gsub("^https?://", ""), C.WN, true)
                end
                task.wait(3)
                akSetProgress(0.3)

                akShow("Watching clipboard...\nCopy your " .. provName .. " API key", C.AC, true)

                local lastClip = ""
                local checks = 0
                local maxChecks = 180
                local dots = { "", ".", "..", "..." }

                while akState.active and checks < maxChecks do
                        task.wait(2.5)
                        checks = checks + 1
                        if not akState.active then break end

                        local prog = 0.3 + (checks / maxChecks) * 0.6
                        akSetProgress(prog)

                        if checks % 4 == 0 then
                                akShow("Waiting for key" .. dots[(checks % 4) + 1] ..
                                        "\nCopy API Key from " .. keyURL:gsub("^https?://", ""), C.AC, true)
                        end

                        pcall(function()
                                local clip = getclipboard()
                                if clip and type(clip) == "string" and #clip > 0 and clip ~= lastClip then
                                        lastClip = clip
                                        -- API key = token ทั่วไปของแต่ละค่าย (ไม่มี prefix ตายตัว)
                                        local looksLikeKey = #clip >= 20 and #clip <= 200 and clip:match("^[%w_.%-]+$")
                                        if looksLikeKey then
                                                akSetProgress(0.85)
                                                akShow("Key found! Testing connection...", C.WN, true)
                                                task.wait(0.5)

                                                local ok, reason = autoKeyConnect(clip)

                                                if ok then
                                                        akState.active = false
                                                        akSetProgress(1)
                                                        akShow("Connected! AI is ready.\nKey saved automatically.", C.OK)
                                                        SND.play("success")
                                                        task.delay(4, akHide)
                                                        return
                                                else
                                                        akState.retries = akState.retries + 1
                                                        local errMsgs = {
                                                                KEY401 = "Invalid key, copy again",
                                                                ERR403 = "Blocked (403) create new key",
                                                                ERR402 = "No credits (402) add credits",
                                                                RATE429 = "Rate limited, waiting...",
                                                                NET = "Network error, retrying...",
                                                                NOHTTP = "No HTTP",
                                                                SHORT = "Key too short",
                                                                NO_ORKEY = "Key pattern not found",
                                                        }
                                                        local emsg = errMsgs[reason] or ("Error: " .. tostring(reason))

                                                        if akState.retries >= akState.maxRetries then
                                                                akSetProgress(1)
                                                                akShow(emsg .. "\nMax retries reached.\nPaste key manually in API tab.", C.NO)
                                                                akState.active = false
                                                                task.delay(6, akHide)
                                                                return
                                                        end

                                                        akShow(emsg ..
                                                                "\nRetry " .. akState.retries .. "/" .. akState.maxRetries ..
                                                                "\nStill watching clipboard...", Color3.fromRGB(255, 150, 50), true)

                                                        if reason == "RATE429" then
                                                                task.wait(15)
                                                        else
                                                                task.wait(5)
                                                        end

                                                        if akState.active then
                                                                lastClip = ""
                                                                akShow("Copy key again" .. dots[(checks % 4) + 1] ..
                                                                        "\nSystem ready to receive key", C.AC, true)
                                                        end
                                                end
                                        end
                                end
                        end)
                end

                if akState.active then
                        akState.active = false
                        akSetProgress(1)
                        akShow("Timed out.\nPaste key manually in API tab\nor click Auto button again.", C.WN)
                        task.delay(6, akHide)
                end
        end

        UIX.startAutoKey = function() 
                task.spawn(function()
                        local ok, err = pcall(startAutoKeySetup)
                        if not ok then warn("[AutoKey] " .. tostring(err)) end
                end)
        end

        -- เพิ่ม clipboard auto-fill ให้ Connect button
        if UIX.connBtn and hasGetClipboard then
                UIX.connBtn.MouseButton1Click:Connect(function()
                        pcall(function()
                                local anyKey = false
                                for i = 1, MAX_KEYS do
                                        if type(S.keys[i]) == "string" and #S.keys[i] >= 10 then anyKey = true; break end
                                end
                                if not anyKey then
                                        local clip = getclipboard()
                                        if clip and type(clip) == "string" and #clip >= 20 then
                                                local k = forceFixKey(clip)
                                                if k and #k >= 10 then
                                                        if UIX.keyRows and UIX.keyRows[1] then UIX.keyRows[1].box.Text = k end
                                                        S.keys[1] = k
                                                end
                                        end
                                end
                        end)
                end)
        end

        -- auto-start ตอน first run
        task.spawn(function()
                task.wait(3.5)
                if S.connected then return end
                local hadSavedKey = false
                for i = 1, MAX_KEYS do
                        if type(S.keys[i]) == "string" and #S.keys[i] >= 10 then hadSavedKey = true; break end
                end
                -- 🖥️ Local AI เป็นค่าเริ่มต้น — ไม่ต้องมีคีย์ ต่อเข้า Ollama ในเครื่องเลย
                if EP.isLocal() then
                        pcall(function() doConnect(true) end)
                        return
                end
                if hadSavedKey then
                        pcall(function() doConnect(true) end)
                        task.wait(4)
                        if not S.connected then
                                akShow("Old keys failed.\nTap Auto to create new key.", C.WN)
                        end
                else
                        task.wait(2.5)
                        if not S.connected then
                                UIX.startAutoKey()
                        end
                end
        end)

        _G.SebasAutoKeySetup = UIX.startAutoKey
        _G.SebasAutoKeyConnect = autoKeyConnect

        print("[Sebas AI] AutoKey addon loaded")
end

-- ═══════════════════════════════════════════════════════════════
-- INIT — เปิด GUI แบบมีจังหวะ
-- ═══════════════════════════════════════════════════════════════
pcall(switchTab, "profile") -- หน้าแรก = Profile (โชว์ตัวตน + สถานะ premium) — fix: pcall กัน crash ทำลาย init ทั้งท่อน

do
        -- entrance: ขยายเข้าแบบนุ่ม + เงาค่อย ๆ โผล่
        local us = addScale(Main, 0.72)
        Main.BackgroundTransparency = 0.25
        Main.Visible = true
        winShadow.Visible = true
        winShadow.BackgroundTransparency = 1
        ANIM.play(us, { Scale = 1 }, { t = 0.38, style = Enum.EasingStyle.Quint, dir = Enum.EasingDirection.Out, tag = "init" })
        ANIM.play(Main, { BackgroundTransparency = 0 }, { t = 0.26, tag = "init" })
        ANIM.play(winShadow, { BackgroundTransparency = 0.62 }, { t = 0.42, tag = "init" })
        task.delay(0.12, function() SND.play("max") end)
end

if HRP then makeRing() end
if UIX.currentModelLbl then UIX.currentModelLbl.Text = "Current: " .. S.currentModel end
updateHUD()

-- มีคีย์เก่าบันทึกไว้ / หรือโหมด Local AI → Connect อัตโนมัติ
do
        local savedCount = 0
        for i = 1, math.clamp(S.activeKeys or 1, 1, MAX_KEYS) do
                if type(S.keys[i]) == "string" and #S.keys[i] >= 10 then savedCount = savedCount + 1 end
        end
        if savedCount > 0 or EP.isLocal() then
                task.delay(0.6, function() doConnect(true) end)
        end
end

-- ═══════════════════════════════════════════════════════════════
-- ⊢ MAINTENANCE LOOP เดียว (แทน loop กระจัดกระจาย 6 ตัวของ v7)
--   2s  : observe (self-throttle ด้วย observeInterval)
--   10s : ล้างสถานะ dry (429) ที่หมดเวลา
--   40s : ตัดประวัติให้สั้น (ประหยัดโทเคน)
--   60s : ตรวจคีย์ bad ซ้ำ + save persistent
--   300s: รีเฟรชเครดิต
-- ═══════════════════════════════════════════════════════════════
task.spawn(function()
        local t = 0
        while true do
                task.wait(2)
                t = t + 2
                pcall(doObserve)

                if t % 10 == 0 then
                        pcall(function()
                                local now = tick()
                                local changed = false
                                for i = 1, MAX_KEYS do
                                        local dt2 = S.keyDry[i]
                                        if dt2 and now >= dt2 then
                                                S.keyDry[i] = nil
                                                if S.keyErr[i] == "429" then S.keyErr[i] = nil end
                                                changed = true
                                        end
                                end
                                -- ล้าง mark ข้อความที่สคริปต์ส่งเอง (คัด self-chat) ที่หมดอายุ
                                if S._sentMark then
                                        for k2, v2 in pairs(S._sentMark) do
                                                if now - v2 > 10 then S._sentMark[k2] = nil end
                                        end
                                end
                                if changed and UIX.updateKeyDots then UIX.updateKeyDots() end
                        end)
                end

                if t % 40 == 0 then
                        pcall(function()
                                for uid, hist in pairs(S.playerHistory) do
                                        while #hist > 4 do table.remove(hist, 1) end
                                end
                                saveMemory()
                        end)
                end

                if t % 60 == 0 then
                        pcall(function()
                                -- 🖥️ Local AI auto-heal: ยังไม่ต่อ (เช่นตอนบูต Ollama ยังไม่ทันเปิด)
                                --   → ลองต่อให้ใหม่เงียบ ๆ ทุก 60 วิ พอเปิด Ollama เมื่อไหร่ก็กลับมาใช้ได้เอง
                                if EP.isLocal() and not S.connected then
                                        task.spawn(function()
                                                local okH, usedBase = localProbe()
                                                if okH then
                                                        if type(usedBase) == "string" and usedBase ~= EP.base() then
                                                                S.baseURL = usedBase
                                                                pcall(saveSettings)
                                                                if UIX.refreshProviderUI then UIX.refreshProviderUI() end
                                                        end
                                                        S.connected = true; S._lbOK = true; S._lbOKT = tick()
                                                        S.key = ""; S.curKey = 1
                                                        S.keyOk[1] = true; S.keyErr[1] = nil; S.keyDry[1] = nil
                                                        if UIX.statusLbl then
                                                                UIX.statusLbl.Text = "● Connected ✓ (Local AI · ไม่ใช้คีย์)"
                                                                UIX.statusLbl.TextColor3 = C.OK
                                                        end
                                                        if pillDot then pillDot.BackgroundColor3 = C.OK end
                                                        if UIX.setLocalStat then
                                                                UIX.setLocalStat("🔄 เชื่อมต่อใหม่อัตโนมัติแล้ว — Ollama กลับมาตอบ", C.OK)
                                                        end
                                                        pcall(updateHUD)
                                                end
                                        end)
                                        return
                                end
                                -- real-time key status: ตรวจคีย์ทุกดอกที่เปิดใช้ใหม่ทุก 60s
                                -- (อัปเดตจุด/pill/status label ทันทีตามผลจริง)
                                if UIX.refreshKeyStatus then
                                        UIX.refreshKeyStatus(true)
                                elseif S.connected then
                                        local actN = math.clamp(tonumber(S.activeKeys) or 1, 1, MAX_KEYS)
                                        for i = 1, actN do
                                                local k = S.keys[i]
                                                if type(k) == "string" and #k >= 10 and S.keyErr[i] and S.keyErr[i] ~= "429" then
                                                        local ok = fastTest(k)
                                                        if ok then
                                                                S.keyOk[i] = true; S.keyErr[i] = nil
                                                        end
                                                end
                                        end
                                        if UIX.updateKeyDots then UIX.updateKeyDots() end
                                end
                        end)
                        pcall(savePersistent)
                        pcall(saveSettings)
                end

                if t % 300 == 0 then
                        pcall(function()
                                -- recheck tier จาก DB ทุก 5 นาที (แอดมินอัปเกรด/ดาวน์เกรด → มีผลทันที
                                --  ไม่ต้องรีเกม ไม่ต้องโหลดสคริปต์ใหม่)
                                if AUTH and AUTH.recheck then pcall(AUTH.recheck) end
                        end)
                        pcall(function()
                                if not S.connected then return end
                                -- ☁️ เพิ่งคุยสำเร็จ → ข้าม (ประหยัดโควตา กันยิง /tags จนติด 429)
                                if S.lastOKT and (tick() - S.lastOKT) < 300 then return end
                                local actN = math.clamp(tonumber(S.activeKeys) or 1, 1, MAX_KEYS)
                                local credits = {}
                                for i = 1, actN do
                                        local k = S.keys[i]
                                        if type(k) == "string" and #k >= 10 and S.keyOk[i] then
                                                local ok, info = fastTest(k)
                                                if ok and info and info ~= "" then
                                                        credits[#credits + 1] = "#" .. i .. ": " .. info
                                                end
                                        end
                                end
                                if #credits > 0 and UIX.creditLbl then
                                        UIX.creditLbl.Text = "💳  " .. table.concat(credits, "  ·  ")
                                end
                        end)
                end
        end
end)

-- แจ้งเตือนเมื่อทุกคีย์โดน rate limit (เช็คตอน dry-clear ทุก 10s แล้ว)
-- (รวมไว้ใน loop เดียว — ใช้ counter แยกกัน error สะสม)
do
        local warnedAt = 0
        task.spawn(function()
                while true do
                        task.wait(25)
                        pcall(function()
                                if not S.connected then return end
                                local actN = math.clamp(tonumber(S.activeKeys) or 1, 1, MAX_KEYS)
                                local filled, dryN = 0, 0
                                for i = 1, actN do
                                        local k = S.keys[i]
                                        if type(k) == "string" and #k >= 10 then
                                                filled = filled + 1
                                                if S.keyDry[i] and tick() < S.keyDry[i] then dryN = dryN + 1 end
                                        end
                                end
                                if filled > 1 and dryN == filled and (tick() - warnedAt) > 120 then
                                        warnedAt = tick()
                                        notify("🔑 Multi-Key", "คีย์ทั้งหมด (" .. filled .. ") โดน rate limit ชั่วคราว — รอสักครู่", "warn")
                                end
                        end)
                end
        end)
end

-- บันทึกตอนปิดเกม
pcall(function()
        game:BindToClose(function()
                pcall(savePersistent)
                pcall(saveMemory)
                pcall(saveSettings)
        end)
end)

print("[Sebas AI] ✅ v7.0 LUXE Redesign loaded — " .. VERSION_TAG)
print("  · Themes: 8 (midnight default) · Sounds: 15 categories (central SND)")
print("  · Drag: bottom bar / top bar · Resize: bottom-left corner")
print("  · Minimize: — button or RShift · Carousel: swipe / tap card")
print("  · Auth: " .. (AUTH.disabled and "OFF (owner mode — ทุกฟีเจอร์)" or ("ON · tier=" .. tostring(AUTH.tier) .. (AUTH.offline and " (offline)" or ""))))
print("  · Active keys: " .. tostring(S.activeKeys) .. "/" .. MAX_KEYS .. " · Model: " .. tostring(S.currentModel))
