                        d.BackgroundColor3 = C.T2; d.BorderSizePixel = 0
                        d.ZIndex = 13
                        d.BackgroundTransparency = 0.35
                        themed(d, "BackgroundColor3", "T2")
                        Instance.new("UICorner", d).CornerRadius = UDim.new(1, 0)
                        gripDots[#gripDots + 1] = d
                end
        end
end

Lk(BotBar, "⠿ drag", UDim2.fromOffset(70, BOT_H), UDim2.new(0.5, 45, 0, 14), 8, RF, "T2", Enum.TextXAlignment.Left, 13)
Lk(BotBar, VERSION_TAG .. " · IKKYU", UDim2.fromOffset(80, BOT_H), UDim2.new(1, -88, 0, 14), 8, RF, "T2", Enum.TextXAlignment.Right, 13)

-- drag hit area (ทั้งเส้นล่าง)
local dragHit = Instance.new("TextButton", BotBar)
dragHit.Size = UDim2.new(1, 0, 0, BOT_H)
dragHit.Position = UDim2.new(0, 0, 0, 14)
