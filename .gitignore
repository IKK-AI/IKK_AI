-- ═════════════════════════════════════════════════════════════
-- ⊢ COVER FLOW CAROUSEL — แท็บแบบการ์ด 3D (swipe + tap)
--   การ์ดกลางหันเข้าผู้ใช้เต็มขนาด การ์ดข้าง ๆ เอียง/เล็กลง/จางลง
--   ปัดนิ้วซ้าย-ขวา / แตะการ์ด = เปลี่ยนหน้า
--   เอนจิน: carCur (ตำแหน่งต่อเนื่อง) ไหลเข้าหา carPos (เป้าหมาย)
--   แบบ exp-lerp ทุกเฟรม — event-driven ประหยัด resource
-- ═════════════════════════════════════════════════════════════
local CAR_N       = #NAV_ITEMS
local CARD_W, CARD_H = 60, 68
local STRIDE      = 66      -- px ต่อ 1 หน้า (ระยะปัดที่เปลี่ยนหน้า)
local CAR_SMOOTH  = 14      -- ความหน่วงการไหล (สูง = คมขึ้น)

local carCur, carPos = 1, 1
local carCards, carDots = {}, {}
local carLoopConn = nil
local carGest = nil

carStrip = Instance.new("Frame", Content)
carStrip.Name = "Carousel"
carStrip.Size = UDim2.new(1, 0, 0, CAR_H)
carStrip.Position = UDim2.fromOffset(0, HDR_H)
carStrip.BackgroundTransparency = 1
carStrip.ZIndex = 13
carStrip.ClipsDescendants = true
UIX.carStrip = carStrip

-- เส้นแบ่งใต้ carousel
do
        local carDiv = Instance.new("Frame", Content)
        carDiv.Size = UDim2.new(1, -24, 0, 1)
        carDiv.Position = UDim2.fromOffset(12, HDR_H + CAR_H - 2)
        carDiv.BackgroundColor3 = C.BD; carDiv.BorderSizePixel = 0
        carDiv.ZIndex = 13
        themed(carDiv, "BackgroundColor3", "BD")
end

local function lerpC3(a, b, t)
        return Color3.new(a.R + (b.R - a.R) * t, a.G + (b.G - a.G) * t, a.B + (b.B - a.B) * t)
end

-- สร้างการ์ด 12 ใบ (TextButton = รับแตะได้ และ UIS gesture ทะลุได้)
--   การ์ดหน้า premium ที่ยังไม่ปลดล็อค → มีป้าย 🔒 มุมขวาบน (จัดโดย applyTierUI)
UIX.carLocks = {}
for i, td in ipairs(NAV_ITEMS) do
        local card = Instance.new("TextButton", carStrip)
        card.Name = "Car_" .. td.name
        card.AnchorPoint = Vector2.new(0.5, 0.5)
        card.Size = UDim2.fromOffset(CARD_W, CARD_H)
        card.Position = UDim2.new(0.5, (i - 1) * 6, 0.5, -6)
        card.BackgroundColor3 = C.CARD
        card.BorderSizePixel = 0
        card.Text = ""; card.AutoButtonColor = false
        card.ZIndex = 30
        card.ClipsDescendants = true
        Instance.new("UICorner", card).CornerRadius = UDim.new(0, 12)
        local cSk = Sk(card, "BD", 1.5, 0.3)

        local ico = L(card, td.icon, UDim2.new(1, 0, 0, 28), UDim2.fromOffset(0, 7), 20, RF,
                C.T1, Enum.TextXAlignment.Center, 31)
        local lbl = L(card, td.label, UDim2.new(1, -6, 0, 14), UDim2.fromOffset(3, 38), 9, BF,
                C.T1, Enum.TextXAlignment.Center, 31)
        lbl.TextTruncate = Enum.TextTruncate.AtEnd

        if td.premium then
                local lk = Instance.new("TextLabel", card)
                lk.Size = UDim2.fromOffset(15, 15)
                lk.Position = UDim2.new(1, -14, 0, -1)
                lk.BackgroundColor3 = Color3.fromRGB(245, 185, 66)
                lk.Text = "🔒"; lk.Font = BF; lk.TextSize = 7
                lk.TextColor3 = Color3.fromRGB(46, 30, 0)
                lk.ZIndex = 32; lk.Rotation = 8
                lk.Visible = false
                Instance.new("UICorner", lk).CornerRadius = UDim.new(1, 0)
                lk.Name = "CarLock_" .. td.name
                UIX.carLocks[td.name] = lk
        end

        carCards[i] = { btn = card, ico = ico, lbl = lbl, sk = cSk }
end

-- จุดบอกตำแหน่ง (dots) ใต้การ์ด — active เป็น pill ยาวสี accent
do
        local dw = CAR_N * 11 - 5
        for i = 1, CAR_N do
                local d = Instance.new("Frame", carStrip)
                d.Size = UDim2.fromOffset(6, 6)
                d.Position = UDim2.new(0.5, -dw / 2 + (i - 1) * 11, 1, -13)
                d.BackgroundColor3 = C.BD; d.BorderSizePixel = 0
                d.ZIndex = 26
                themed(d, "BackgroundColor3", "BD")
                Instance.new("UICorner", d).CornerRadius = UDim.new(1, 0)
                carDots[i] = d
        end
end

-- ⊢ ลูกศร ‹ › ถูกลบออกตามคำขอ (ปัด/แตะการ์ด/จุด ใช้งานได้ทั้งหมด —
--   ปุ่มซ้ำซ้อนกับ gesture แล้วยังเป็นจุดตาย input บางเครื่อง)

-- จัดวางการ์ดทั้งหมดจากตำแหน่ง carCur (เรียกทุกเฟรมตอน animate)
--   d = ระยะจากการ์ดกลาง: x เลื่อนออก, ขนาดหุบ, หมุนเอียง (cover flow), จางลง
local function carLayout()
        local cw = carStrip.AbsoluteSize.X
        if cw < 60 then cw = math.max(gW - 20, 300) end   -- ก่อน render ครั้งแรก
        local halfW = math.max(56, cw / 2 - 30)
        for i = 1, CAR_N do
                local cc = carCards[i]
                local d = i - carCur
                local ad = math.abs(d)
                if ad > 3.4 then
                        cc.btn.Visible = false
                else
                        cc.btn.Visible = true
                        local scl = math.max(0.55, 1 - 0.14 * ad)
                        local xo = (d >= 0 and 1 or -1) * math.min(halfW, 50 * ad ^ 0.9)
                        local yo = -6 + math.min(7, ad * 2.4)
                        cc.btn.Size = UDim2.fromOffset(CARD_W * scl, CARD_H * scl)
                        cc.btn.Position = UDim2.new(0.5, xo, 0.5, yo)
                        cc.btn.Rotation = math.clamp(-d * 13, -26, 26)
                        cc.btn.ZIndex = math.max(20, 30 - math.floor(ad * 3 + 0.5))
                        cc.btn.BackgroundTransparency = math.min(0.4, ad * 0.13)
                        cc.btn.BackgroundColor3 = lerpC3(C.AC, C.CARD, math.min(1, ad * 1.7))
                        cc.sk.Transparency = 0.25 + math.min(0.55, ad * 0.18)
                        cc.sk.Color = lerpC3(C.AC, C.BD, math.min(1, ad))
                        cc.sk.Thickness = 1.5
                        local tt = math.min(0.42, ad * 0.14)
                        cc.ico.TextTransparency = tt
                        cc.lbl.TextTransparency = tt
                        local tc = lerpC3(Color3.new(1, 1, 1), C.T2, math.min(1, ad * 1.9))
                        cc.ico.TextColor3 = tc
                        cc.lbl.TextColor3 = tc
                end
        end
end

-- dots สะท้อนหน้าเป้าหมาย (active = pill ยาว 16px)
local function updateCarDots(idx)
        local dw = CAR_N * 11 - 5
        for i = 1, CAR_N do
                local on = (i == idx)
                carDots[i].Size = on and UDim2.fromOffset(16, 6) or UDim2.fromOffset(6, 6)
                carDots[i].Position = UDim2.new(0.5, -dw / 2 + (i - 1) * 11 - (on and 5 or 0), 1, -13)
                carDots[i].BackgroundColor3 = on and C.AC or C.BD
        end
end

local function carEnsureLoop()
        if carLoopConn or not RunService then return end
        carLoopConn = RunService.RenderStepped:Connect(function(dt)
                if S.carAnim == false then carCur = carPos end   -- ปิดแอนิเมต → สแนปทันที
                local a = 1 - math.exp(-math.max(dt or 0.016, 0.005) * CAR_SMOOTH)
                carCur = carCur + (carPos - carCur) * a
                local settled = (carGest == nil) and math.abs(carPos - carCur) < 0.004
                if settled then carCur = carPos end
                pcall(carLayout)
                if settled then
                        carLoopConn:Disconnect()
                        carLoopConn = nil
                end
                -- watchdog: gesture ค้างเกิน 2.5 วิ (InputEnded หาย) → ปลดให้เอง = ปัดไม่ตายซ้ำ ๆ
                if carGest and tick() - (carGest.t0 or 0) > 2.5 then carGest = nil end
        end)
end

-- ไปหน้าที่ idx (ต่อเนื่องแบบ cover flow) — เรียกจาก switchTab และ gesture
function carGoTo(idx)
        idx = tonumber(idx) or 1
        idx = math.clamp(math.floor(idx + 0.5), 1, CAR_N)
        carPos = idx
        updateCarDots(idx)
        carEnsureLoop()
end

local function carKick()   -- จัดวางรอบเดียว (ใช้ตอน resize / เปลี่ยนธีม)
        pcall(carLayout)
end
UIX.carKick = carKick

-- เปลี่ยนธีม → การ์ดต้องคำนวณสีใหม่จาก palette ใหม่
table.insert(THEME_CB, function()
        carKick()
        updateCarDots(math.floor(carPos + 0.5))
end)

local carBusyUntil = 0     -- ล็อค input ช่วงเปลี่ยนหน้า (ประกาศก่อนทุกฟังก์ชันที่ใช้)

local function carStep(dir)
        local cur = math.floor(carPos + 0.5)
        local tgt = math.clamp(cur + dir, 1, CAR_N)
        if tgt == cur then return end
        carBusyUntil = tick() + 0.16
        carGoTo(tgt)
        switchTab(NAV_ITEMS[tgt].name)
end

-- ⊢ GESTURE — ปัด/แตะ ผ่าน UserInputService + GuiObject (ทะลุการ์ด/ปุ่มได้หมด)
--   กันชน: ไม่ทำงานตอน tutorial เปิด / modal / hold-popup เปิด
--   ⚠ FIX สาเหตุ "ปัดไม่ได้เลยในเครื่องจริง": ใน Roblox จริงการแตะ/คลิก
--   บนปุ่ม (การ์ด TextButton) จะได้ gameProcessed=true — เดิมโค้ดเช็ค gpe
--   แล้ว return ทำให้ gesture ตายหมดบนเครื่องจริง (แต่ sim ไม่ส่งค่า gpe
--   เลยจึงผ่านตลอด) — ตัด gpe ออก ใช้ hit-test เองแม่นกว่า
--   ⚠⚠ FIX ใหญ่รอบนี้ "เลื่อนแถบไม่ได้": ปัด+แตะการ์ดตายทั้งคู่ (ยุคลูกศร)
--   แตะการ์ด (MouseButton1Click ของ engine) ยังใช้ได้ = ทุกอย่างที่พึ่ง
--   พิกัด/identity ของเราเองเป็นตัวตาย จึงเพิ่มเส้นทาง engine-native 3 ชั้น:
--   (1) เริ่ม gesture จาก GuiObject.InputBegan บนแถบ + การ์ดทุกใบ (engine
--       hit-test เอง — สถาปัตยกรรมเดียวกับ makeDraggable ของหน้าต่างหลัก
--       ที่ใช้ได้จริงบนเครื่องผู้ใช้) และจบจาก GuiObject.InputEnded ด้วย
--   (2) แตะการ์ด = MouseButton1Click โดยตรง (กลไกเดียวกับปุ่มทั่วไป)
--   (3) UIS.TouchSwipe — engine จำแนก gesture เอง (สำรองแน่นสุด)
--   อีกทั้ง soften identity ของ InputObject (บางแพลตฟอร์มส่ง instance ใหม่
--   ทุก event → เดิม carGest ค้างนาน = ปัดตายเป็นพัก ๆ) → เช็คความ
--   ต่อเนื่องของตำแหน่งแทน แล้ว re-bind ให้เอง
local carZoneUntil = 0       -- ช่วงที่นิ้วเพิ่งเริ่มบนแถบ/หัวเรื่อง (อนุญาต TouchSwipe)
local carSuppressClick = 0   -- กัน MouseButton1Click ยิงซ้ำหลังจบ gesture ด้วย path อื่น

local function carBlocked()
        if AUTH and AUTH.locked then return true end
        if UIX.tutGuard and UIX.tutGuard() then return true end
        if UIX.modalOpen and UIX.modalOpen() then return true end
        if UIX.iPopupOpen and UIX.iPopupOpen() then return true end
        return false
end

local function inRect(px, py, f)
        local ap, as = f.AbsolutePosition, f.AbsoluteSize
        return px >= ap.X and px <= ap.X + as.X and py >= ap.Y and py <= ap.Y + as.Y
end

-- เริ่ม gesture จาก InputObject ใด ๆ (ใช้ร่วมทั้ง path UIS และ path GuiObject)
local function carStart(i)
        if carGest or carBlocked() then return end
        if tick() < carBusyUntil then return end   -- กำลังเปลี่ยนหน้าอยู่ → กลืน input ซ้อน
        if i.UserInputType == Enum.UserInputType.Touch or i.UserInputType == Enum.UserInputType.MouseButton1 then
                if not Main.Visible then return end
                local px, py = i.Position.X, i.Position.Y
                carZoneUntil = tick() + 1.2
                carGest = { sx = px, sy = py, t0 = tick(), startPos = carPos,
                        moved = false, lastX = px, lastY = py, lastT = tick(), vel = 0,
                        obj = i, touch = (i.UserInputType == Enum.UserInputType.Touch) }
        end
end

UIS.InputBegan:Connect(function(i, gpe)
        -- ปลดล็อค gesture ที่ค้าง (InputEnded หายจาก event แปลก ๆ ของบางเครื่อง)
        --   ⚠ FIX "ค้างอยู่หน้านั้นไปเลย": เดิมรอ 12 วิ = รู้สึกตายถาวร — 2.5 วิพอ (นิ้วคนจริงปัดจบใน <1 วิ)
        if carGest and tick() - (carGest.t0 or 0) > 2.5 then carGest = nil end
        -- gpe (gameProcessed) ถูกละเว้นโดยเจตนา: แตะบนการ์ด/ปุ่ม = true ในเครื่องจริง
        if carGest or carBlocked() then return end
        if i.UserInputType == Enum.UserInputType.Touch or i.UserInputType == Enum.UserInputType.MouseButton1 then
                if not Main.Visible then return end
                local px, py = i.Position.X, i.Position.Y
                local zone = nil
                -- โซนแถบ carousel — ขยายขึ้นบน 64px กันพิกัด offset (gui inset บางเครื่อง
                --   ส่ง i.Position ต่ำกว่า AbsoluteSize space) ส่วนที่ทับ = โซน hdr เดิม
                local ap, as = carStrip.AbsolutePosition, carStrip.AbsoluteSize
                if py >= ap.Y - 64 and py <= ap.Y + as.Y
                        and px >= ap.X and px <= ap.X + as.X then
                        zone = "car"
                else
                        -- แถบหัวเรื่อง (title row) = โซนปัดได้เช่นกัน (ยกเว้นช่อง search + avatar)
                        local cap = Content.AbsolutePosition
                        local cas = Content.AbsoluteSize
                        if py >= cap.Y - 8 and py <= cap.Y + HDR_H - 6
                                and px >= cap.X and px <= cap.X + cas.X
                                and not (searchFrame.Visible and inRect(px, py, searchFrame))
                                and not inRect(px, py, avaChip) then
                                zone = "hdr"
                        end
                end
                if zone then carStart(i) end
        end
end)

-- เส้นทาง engine-native (1): แตะเริ่มบนแถบ/การ์ด — bubble ขึ้นถึง carStrip
--   และต่อที่ปุ่มการ์ดทุกใบตรง ๆ เพื่อกันจุดตาย (บางแพลตฟอร์มไม่ bubble)
carStrip.InputBegan:Connect(carStart)

-- เส้นทาง engine-native (2): แตะการ์ดเปลี่ยนหน้า — MouseButton1Click
--   ของปุ่มโดยตรง (กลไกเดียวกับปุ่มทั่วไปที่ใช้ได้เสมอ)
for i = 1, CAR_N do
        local cc = carCards[i]
        cc.btn.InputBegan:Connect(carStart)
        cc.btn.InputEnded:Connect(function(i2) carFinish(i2) end)
        cc.btn.MouseButton1Click:Connect(function()
                if tick() < carSuppressClick then return end
                if tick() < carBusyUntil then return end   -- กำลัง settle จากการปัด/แตะก่อนหน้า
                carBusyUntil = tick() + 0.16
                carGoTo(i)
                switchTab(NAV_ITEMS[i].name)
        end)
end
carStrip.InputEnded:Connect(function(i2) carFinish(i2) end)

-- เส้นทาง engine-native (3): UIS.TouchSwipe — engine จำแนก gesture เอง
--   ยอมรับเฉพาะ ~1.2 วิหลังนิ้วเพิ่งเริ่มบนแถบ/หัวเรื่อง (กันปัดหน้าอื่นสลับแท็บ)
pcall(function()
        UIS.TouchSwipe:Connect(function(dir, nT)
                if carBlocked() then return end
                if carGest then
                        if carGest.moved then return end   -- finger-follow กำลังทำงาน → ไม่ต้องช่วย
                        carGest = nil                        -- tracking ไม่ขยับ → ให้ engine จัดการแทน
                end
                if tick() > carZoneUntil then return end
                if nT and nT > 1 then return end
                if dir == Enum.SwipeDirection.Left then
                        carStep(1)
                elseif dir == Enum.SwipeDirection.Right then
                        carStep(-1)
                end
        end)
end)

UIS.InputChanged:Connect(function(i)
        if not carGest then return end
        if i.UserInputType == Enum.UserInputType.Touch or i.UserInputType == Enum.UserInputType.MouseMovement then
                -- นิ้วอื่นที่ไม่ใช่นิ้วที่เริ่มปัด → เช็คความต่อเนื่องของตำแหน่งแทน identity
                --   (บางแพลตฟอร์ม/executor ส่ง InputObject ใหม่ทุก event → เดิมเทียบ
                --    identity ไม่ติดเลย = ไม่ขยับ + carGest ค้าง = "ปัดไม่ได้")
                if carGest.touch and i.UserInputType == Enum.UserInputType.Touch
                        and carGest.obj ~= nil and i ~= carGest.obj then
                        if carGest.lastX and math.abs(i.Position.X - carGest.lastX) > 90 then return end
                        --   ⚠ FIX ใหม่: เช็คทั้งแกน X และ Y — เดิมเช็คแค่ X ทำให้นิ้วสองที่ X ใกล้กัน
                        --   (แต่คนละจุดแนวตั้ง) หลอก re-bind แล้วการ์ดกระโดดไปมา (ติดๆขัดๆ)
                        if carGest.lastY and math.abs(i.Position.Y - carGest.lastY) > 90 then return end
                        carGest.obj = i   -- ตำแหน่งต่อเนื่อง = นิ้วเดียวกัน → re-bind
                end
                local px = i.Position.X
                local now = tick()
                local dt = now - carGest.lastT
                if dt > 0.008 then
                        carGest.vel = (px - carGest.lastX) / dt
                        carGest.lastX = px; carGest.lastY = i.Position.Y; carGest.lastT = now
                end
                local dx = px - carGest.sx
                if not carGest.moved then
                        if math.abs(dx) > 7 then
                                carGest.moved = true
                                carGest.sx = px          -- re-anchor: การ์ดไม่กระโดด 7px ตอนเริ่มปัด (ลื่นตั้งแต่เฟรมแรก)
                                carGest.startPos = carCur
                                dx = 0                   -- เริ่มนับจาก 0 ที่จุดที่จับจริง
                                SND.play("drag")       -- เสียง "จับ" สั้น ๆ ตอนเริ่มปัด
                        else return end
                end
                carCur = carGest.startPos - dx / STRIDE
                carPos = carCur
                carEnsureLoop()      -- ให้ loop เดินสายต่อ (diff = 0 → ไม่ขยับเอง)
                pcall(carLayout)
        end
end)

-- จบ gesture (แชร์ระหว่าง UIS.InputEnded และ GuiObject.InputEnded ของแถบ/การ์ด)
function carFinish(i)
        if not carGest then return end
        if i.UserInputType == Enum.UserInputType.Touch or i.UserInputType == Enum.UserInputType.MouseButton1 then
                -- identity แบบ forgive: instance รีไซเคิลแต่ตำแหน่งต่อเนื่อง = นิ้วเดียวกัน
                if carGest.touch and i.UserInputType == Enum.UserInputType.Touch
                        and carGest.obj ~= nil and i ~= carGest.obj then
                        if carGest.lastX and math.abs(i.Position.X - carGest.lastX) <= 90
                                and carGest.lastY and math.abs(i.Position.Y - carGest.lastY) <= 90 then
                                carGest.obj = i
                        else
                                return   -- นิ้วอื่นปล่อยจริง ๆ → ไม่ใช่การจบ gesture นี้
                        end
                end
                local g = carGest
                carGest = nil
                local px, py = i.Position.X, i.Position.Y
                if not g.moved then
                        -- แตะ: หาการ์ดใต้นิ้ว → ไปหน้านั้น (การ์ดไกล ๆ ก็แตะได้)
                        for idx = 1, CAR_N do
                                local cc = carCards[idx]
                                if cc.btn.Visible and inRect(px, py, cc.btn) then
                                        carSuppressClick = tick() + 0.35   -- กัน click ยิงซ้ำ
                                        carBusyUntil = tick() + 0.16
                                        carGoTo(idx)
                                        switchTab(NAV_ITEMS[idx].name)
                                        return
                                end
                        end
                        return   -- แตะโดนที่ว่างของแถบ → ปล่อยให้ MouseButton1Click จัดการเอง
                end
                carSuppressClick = tick() + 0.35   -- ปัดจบ → กัน click ตามหลังปล่อยบนการ์ด
                -- ปล่อยหลังปัด: momentum + snap ไปหน้าใกล้สุด (ปัดแรง = ก้าวไกลกว่า)
                local vel = math.clamp(g.vel or 0, -700, 700)
                local proj = carCur - vel * 0.09 / STRIDE
                local tgt = math.floor(proj + 0.5)
                local totalDx = (g.lastX or g.sx) - g.sx
                if math.abs(totalDx) > STRIDE * 0.4 then
                        local dir = totalDx < 0 and 1 or -1   -- ปัดซ้าย = หน้าถัดไป
                        local forced = math.floor(g.startPos + 0.5) + dir
                        if dir > 0 then tgt = math.max(tgt, forced) else tgt = math.min(tgt, forced) end
                end
                tgt = math.clamp(tgt, 1, CAR_N)
                carBusyUntil = tick() + 0.16        -- ปัดจบ → ล็อค input สั้น ๆ ระหว่าง settle กันแตะซ้อน
                carGoTo(tgt)
                switchTab(NAV_ITEMS[tgt].name)
        end
end
UIS.InputEnded:Connect(carFinish)

-- วางครั้งแรก
carLayout()
updateCarDots(1)

-- ─── BOTTOM DRAG BAR (จับเส้นข้างล่างเพื่อลาก) ─────────────────
local BotBar = Instance.new("Frame", Main)
BotBar.Size = UDim2.new(1, 0, 0, BOT_H + 14)
BotBar.Position = UDim2.new(0, 0, 1, -(BOT_H + 14))
BotBar.BackgroundColor3 = C.SB; BotBar.BorderSizePixel = 0
BotBar.ZIndex = 12
themed(BotBar, "BackgroundColor3", "SB")
Instance.new("UICorner", BotBar).CornerRadius = UDim.new(0, 16)

local bbCover = Instance.new("Frame", BotBar)
bbCover.Size = UDim2.new(1, 0, 0, 15)
bbCover.Position = UDim2.new()
bbCover.BackgroundColor3 = C.SB; bbCover.BorderSizePixel = 0
bbCover.ZIndex = 12
themed(bbCover, "BackgroundColor3", "SB")

do
        local bbDiv = Instance.new("Frame", BotBar)
        bbDiv.Size = UDim2.new(1, 0, 0, 1)
        bbDiv.Position = UDim2.new(0, 0, 0, 14)
        bbDiv.BackgroundColor3 = C.BD; bbDiv.BorderSizePixel = 0
        bbDiv.ZIndex = 13
        themed(bbDiv, "BackgroundColor3", "BD")
end

-- grip dots ตรงกลาง (visual affordance ของ drag handle)
local gripDots = {}
do
        local gripHolder = Instance.new("Frame", BotBar)
