}, tcFrame)
corner(urlBox, 8)
pad(urlBox, 8, 0)
stroke(urlBox, C.accent, 1, 0.4)
local pasteBtn = button(tcFrame, {
    AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, 20), Size = UDim2.fromOffset(56, 36),
    Text = "วาง", TextSize = 12, ZIndex = 4,
}, C.card2, C.line)
corner(pasteBtn, 8)
local nameBox = new("TextBox", {
    Position = UDim2.fromOffset(0, 62), Size = UDim2.new(1, 0, 0, 32), BackgroundColor3 = C.card2,
    PlaceholderText = "ชื่อเพลง - ศิลปิน (ไม่บังคับ ใช้ตั้งชื่อ + หาเนื้อ)", Text = "", ClearTextOnFocus = false,
    Font = FONT, TextSize = 12, TextColor3 = C.text, PlaceholderColor3 = C.muted,
    TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, ZIndex = 4,
}, tcFrame)
corner(nameBox, 8)
pad(nameBox, 8, 0)
local goBtn = button(tcFrame, {
    Position = UDim2.fromOffset(0, 100), Size = UDim2.new(1, 0, 0, 38), Text = "🎼  แกะเป็น MIDI", TextSize = 14,
    TextColor3 = C.dark, ZIndex = 4,
}, C.accent, Color3.fromRGB(150, 245, 228))
corner(goBtn, 10)
local tcStatus = label(tcFrame, {
    Position = UDim2.fromOffset(0, 146), Size = UDim2.new(1, 0, 1, -146),
    Text = "ฟรี 3 เพลงต่อวัน · ใช้เวลาประมาณ 1-2 เท่าของความยาวเพลง\nแกะเสร็จแล้วเพลงจะถูกบันทึกในโฟลเดอร์ AutoPiano และเล่นให้ทันที\nถ้าเป็นชื่อเพลงหรือลิงก์ที่ไม่ใช่เปียโน ระบบจะหา piano cover มาแกะให้",
    TextSize = 11, TextColor3 = C.muted, TextWrapped = true, TextXAlignment = Enum.TextXAlignment.Left,
    TextYAlignment = Enum.TextYAlignment.Top, ZIndex = 4,
})


local function showOverlay(which)
    settings.Visible = (which == "settings")
    tcFrame.Visible = (which == "tc")
    gearBtn.TextColor3 = settings.Visible and C.accent or C.muted
    tcBtn.TextColor3 = tcFrame.Visible and C.accent or C.muted
end
gearBtn.MouseButton1Click:Connect(function() showOverlay((not settings.Visible) and "settings" or nil) end)
tcBtn.MouseButton1Click:Connect(function() showOverlay((not tcFrame.Visible) and "tc" or nil) end)

lyrBtn.MouseButton1Click:Connect(function()
    lyricsOn = not lyricsOn
    refreshLyrBtn()
    if not lyricsOn then
        lyr = nil
        lyricLabel.Text = ""
    elseif cur and selected then
        task.spawn(loadLyrics, selected, token)
    end
    saveData()
end)

local function tcSay(text, kind)
    tcStatus.Text = text
    setStatus(text, kind or "play", 20)
end

local function postForm(field, value)
    local b = "----AutoPiano" .. (HttpService:GenerateGUID(false):gsub("%-", ""))
    local body = "--" .. b .. "\r\nContent-Disposition: form-data; name=\"" .. field .. "\"\r\n\r\n"
        .. value .. "\r\n--" .. b .. "--\r\n"
    local ok, res = pcall(httpRequest, {
        Url = OPENNAN_API, Method = "POST",
        Headers = { ["Content-Type"] = "multipart/form-data; boundary=" .. b },
        Body = body,
    })
    return ok and res or nil
end

local function jsonOf(res)
    if not res or type(res.Body) ~= "string" then return nil end
    local ok, d = pcall(HttpService.JSONDecode, HttpService, res.Body)
    return (ok and type(d) == "table") and d or nil
end

local function getJson(url)
    local body = httpGet(url)
    if not body then return nil end
    local ok, d = pcall(HttpService.JSONDecode, HttpService, body)
    return (ok and type(d) == "table") and d or nil
end

local function errText(res, d)
    local m
    if d then
        if type(d.error) == "table" then m = d.error.message else m = d.error or d.message end
    end
    return tostring(m or (res and ("HTTP " .. tostring(res.StatusCode))) or "unknown")
end

local function pickId(d)
    if not d then return nil end
    return d.id or d.task_id or (type(d.data) == "table" and (d.data.id or d.data.task_id)) or nil
end

local function pickStatus(d)
    if not d then return nil end
    return d.status or (type(d.data) == "table" and d.data.status) or nil
end

local function safeFileName(str)
    str = trim((str:gsub("[^%w\128-\255 _%-]", ""):gsub("%s+", " ")))
    local len = utf8.len(str)
    if len and len > 40 then str = str:sub(1, utf8.offset(str, 41) - 1) end
    return trim(str)
end

local function findLocalSong(fname)
    for _, sg in ipairs(songs) do
        if sg.localPath and ((sg.localPath:gsub("\\", "/")):match("([^/]+)$")) == fname .. ".mid" then
            return sg
        end
    end
    return nil
end

local tcBusy = false

local function transcribe(input, custom)
    input = trim(input or "")
    if tcBusy then return tcSay("กำลังแกะอีกเพลงอยู่ รอให้เสร็จก่อนนะ", "warn") end
    if input == "" then return tcSay("ใส่ลิงก์ YouTube หรือชื่อเพลงก่อน", "warn") end
    if not httpRequest then return tcSay("executor ไม่รองรับ request()", "bad") end
    tcBusy = true

    task.spawn(function()
        local ok, err = pcall(function()
            local isLink = input:match("^https?://") ~= nil
            local vid = input:match("[?&]v=([%w_%-]+)") or input:match("youtu%.be/([%w_%-]+)") or input:match("/shorts/([%w_%-]+)")
            local name = trim(custom or "")
            local label = (name ~= "") and name or (vid and ("YouTube " .. vid)) or input
            local fname = safeFileName(label)
            if fname == "" then fname = "Song " .. os.time() end

            -- made before? play the saved file, no daily quota used
            if isfile and isfile(LOCAL_FOLDER .. "/" .. fname .. ".mid") then
                loadLocal()
                sortSongs()
                renderList()
                local have = findLocalSong(fname)
                if have then
                    showOverlay(nil)
                    tcSay("มีไฟล์นี้แล้ว เล่นเลย (ไม่เสียโควตา)", "good")
                    playSong(have)
                    return
                end
            end

            tcSay("กำลังส่งไปแกะ…")
            local res, d
            local fields = isLink and { "url" } or { "url", "query" }
            for _, f in ipairs(fields) do
                res = postForm(f, input)
                d = jsonOf(res)
                if res and res.StatusCode < 400 and pickId(d) then break end
            end
            if not (res and res.StatusCode < 400 and pickId(d)) then
                if res and res.StatusCode == 429 then
                    return tcSay("ใช้ครบโควตาวันนี้ หรือส่งถี่เกินไป ลองใหม่ทีหลัง", "bad")
                end
                return tcSay("ส่งไม่สำเร็จ: " .. errText(res, d), "bad")
            end

            local base = OPENNAN_API .. "/" .. tostring(pickId(d))
            local t0 = os.clock()
            while true do
                local st = pickStatus(d)
                if st == "succeeded" then break end
                if st == "failed" then
                    return tcSay("แกะไม่สำเร็จ: " .. errText(nil, d) .. " (ไม่เสียโควตา)", "bad")
                end
                if os.clock() - t0 > TRANSCRIBE_TIMEOUT then
                    return tcSay("รอนานเกินไป ลองใหม่อีกครั้ง", "bad")
                end
                tcSay("กำลังแกะ… " .. fmt(os.clock() - t0) .. " · " .. tostring(st or "queued"))
                task.wait(3)
                d = getJson(base) or d
            end

            tcSay("กำลังโหลด MIDI…")
            local midi = httpGet(base .. "/midi")
            if not midi and type(d.outputs) == "table" and type(d.outputs[1]) == "table" and d.outputs[1].url then
                midi = httpGet(d.outputs[1].url)
            end
            if not midi or midi:sub(1, 4) ~= "MThd" then
                return tcSay("โหลดไฟล์ MIDI ไม่ได้", "bad")
            end

            local song
            if writefile then
                pcall(function()
                    if makefolder and isfolder and not isfolder(LOCAL_FOLDER) then makefolder(LOCAL_FOLDER) end
                    writefile(LOCAL_FOLDER .. "/" .. fname .. ".mid", midi)
                end)
                loadLocal()
                song = findLocalSong(fname)
            end
            if not song then
                -- executor can't save files: keep it in memory for this session
                local memKey = "opennan:" .. tostring(pickId(d))
                addSong(label, { body = midi, mem = memKey, tag = "Opennan" })
                for _, sg in ipairs(songs) do
                    if sg.mem == memKey then song = sg break end
                end
            end
            sortSongs()
            renderList()
            showOverlay(nil)
            tcSay("แกะเสร็จแล้ว ✓", "good")
            if song then playSong(song) end
        end)
        tcBusy = false
        if not ok then tcSay("error: " .. tostring(err), "bad") end
    end)
end

goBtn.MouseButton1Click:Connect(function() transcribe(urlBox.Text, nameBox.Text) end)
urlBox.FocusLost:Connect(function(enter)
    if enter then transcribe(urlBox.Text, nameBox.Text) end
end)
pasteBtn.MouseButton1Click:Connect(function()
    local ok, txt = pcall(function() return getclipboard and getclipboard() end)
    if ok and type(txt) == "string" and txt ~= "" then
        urlBox.Text = trim(txt)
    else
        tcStatus.Text = "executor นี้ไม่มีปุ่มวางอัตโนมัติ — แตะที่ช่องแล้ววางจากคีย์บอร์ดแทน"
    end
end)

end -- do (overlays + transcribe)

end

-- progress bar: drag to seek
do
local scrubbing = false
local function ratioFrom(inp)
    local w = math.max(barHit.AbsoluteSize.X, 1)
    return math.clamp((inp.Position.X - barHit.AbsolutePosition.X) / w, 0, 1)
end
barHit.InputBegan:Connect(function(i)
    if (i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch) and cur then
        scrubbing = true
        scrub = ratioFrom(i) * cur.total
        updateProgress(true)
        i.Changed:Connect(function()
            if i.UserInputState == Enum.UserInputState.End then
                scrubbing = false
                if scrub then seekTo(scrub) end
                scrub = nil
                updateProgress(true)
            end
        end)
    end
end)
conns[#conns + 1] = UIS.InputChanged:Connect(function(i)
    if scrubbing and cur and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
        scrub = ratioFrom(i) * cur.total
        updateProgress()
    end
end)
end -- do (scrub)

playBtn.MouseButton1Click:Connect(function()
    if not playing then
        local s = selected or getFiltered()[1]
        if s then playSong(s) else setStatus("No songs yet", "warn", 3) end
    elseif cur then
        paused = not paused
        updatePlayBtn()
        setStatus(paused and "Paused" or "Playing", paused and "warn" or "play", paused and 60 or 2)
    end
end)
backBtn.MouseButton1Click:Connect(function() if cur then seekTo(pos - 10) end end)
fwdBtn.MouseButton1Click:Connect(function() if cur then seekTo(pos + 10) end end)
prevBtn.MouseButton1Click:Connect(function()
    if cur and pos > 3 then return seekTo(0) end
    if #queue == 0 and selected then setQueueFrom(selected) end
    local s = stepQueue(-1)
    if s then playSong(s, true) end
end)
nextBtn.MouseButton1Click:Connect(function()
    if #queue == 0 then
        local s = selected or getFiltered()[1]
        if s then playSong(s) end
        return
    end
    local s = stepQueue(1)
    if s then playSong(s, true) end
end)
stopBtn.MouseButton1Click:Connect(stopAll)
miniStop.MouseButton1Click:Connect(stopAll)
pinBtn.MouseButton1Click:Connect(function() if selected then togglePin(selected) end end)

minus.MouseButton1Click:Connect(function() setSpeed(speed - 0.1) saveData() end)
plus.MouseButton1Click:Connect(function() setSpeed(speed + 0.1) saveData() end)
speedBtn.MouseButton1Click:Connect(function() setSpeed(1) saveData() end)
autoBtn.MouseButton1Click:Connect(function()
    autoIdx = autoIdx % #autoNames + 1
    refreshAuto()
    saveData()
end)

pinsTab.MouseButton1Click:Connect(function()
    onlyPins = not onlyPins
    pinsTab.TextColor3 = onlyPins and C.warn or C.muted
    tween(pinsTab, 0.12, { BackgroundColor3 = onlyPins and C.card2 or C.card })
    renderList()
end)

search:GetPropertyChangedSignal("Text"):Connect(queueRender)
search.FocusLost:Connect(function(enter)
    local q = search.Text:match("^%s*(.-)%s*$")
    if not enter or q == "" then return end
    task.spawn(function()
        setStatus("Searching BitMidi…", "play", 30)
        loadingCount += 1
        local added = select(2, pcall(searchBitMidi, q))
        loadingCount -= 1
        if type(added) ~= "number" then added = 0 end
        sortSongs()
        renderList()
        setStatus("BitMidi: +" .. added .. " songs", added > 0 and "good" or "warn", 5)
    end)
end)

---------------------------------------------------------------------
-- Start: load saved data, then all sources in parallel
---------------------------------------------------------------------
setSpeed(1)
refreshAuto()
loadData()
sortSongs()
renderList()

if not httpRequest then
    setStatus("Executor has no request() — only local files work", "bad", 8)
end

do
local function loadSource(fn, ...)
    local args = { ... }
    loadingCount += 1
    task.spawn(function()
        local ok, n = pcall(fn, table.unpack(args))
        loadingCount -= 1
        if ok and type(n) == "number" and n > 0 then sortSongs() end
        queueRender()
    end)
end

loadSource(loadLocal)
if USE_NANOMIDI then loadSource(loadNanoMidi) end
if USE_GITHUB then
    for _, src in ipairs(GITHUB_REPOS) do loadSource(loadGithub, src) end
end
end -- do (start)
end, function(e)
    if debug and debug.traceback then return debug.traceback(tostring(e), 2) end
    return tostring(e)
end)

if not __ok then
    warn("[AutoPiano] " .. tostring(__err))
    pcall(function()
        local g = Instance.new("ScreenGui")
        g.Name = "AutoPianoError"
        g.ResetOnSpawn = false
        g.DisplayOrder = 1000
        g.Parent = (gethui and gethui()) or game:GetService("CoreGui")
        local l = Instance.new("TextLabel")
        l.Size = UDim2.new(1, -20, 0, 150)
        l.Position = UDim2.fromOffset(10, 10)
        l.BackgroundColor3 = Color3.fromRGB(70, 12, 12)
        l.TextColor3 = Color3.fromRGB(255, 255, 255)
        l.TextWrapped = true
        l.TextSize = 12
        l.TextXAlignment = Enum.TextXAlignment.Left
        l.TextYAlignment = Enum.TextYAlignment.Top
        l.Text = "Auto Piano error (send this to Claude):\n" .. tostring(__err)
        l.Parent = g
        task.delay(90, function() g:Destroy() end)
    end)
end
