local refreshLyrBtn = function() end

---------------------------------------------------------------------
-- Pressing keys: pure TOUCH input
---------------------------------------------------------------------
local function singleChar(s)
    if type(s) == "string" and #s == 1 and s:match("^[%w!@#%$%%%^&%*%(%)]$") then
        return s
    end
    return nil
end

local function rawCenter(o)
    local sg = o:FindFirstAncestorOfClass("ScreenGui")
    local c = o.AbsolutePosition + o.AbsoluteSize / 2
    if sg and not sg.IgnoreGuiInset then
        c = c + GuiService:GetGuiInset()
    end
    return c
end

-- exact on-screen position of the glyph inside a text object (honours text alignment)
local function isLetterObj(o)
    return (o:IsA("TextLabel") or o:IsA("TextButton")) and singleChar(o.Text) ~= nil
end

local function textPoint(t)
    local ap, as, tb = t.AbsolutePosition, t.AbsoluteSize, t.TextBounds
    local x, y = as.X / 2, as.Y / 2
    if tb.X > 0 and tb.Y > 0 then
        if t.TextXAlignment == Enum.TextXAlignment.Left then
            x = tb.X / 2
        elseif t.TextXAlignment == Enum.TextXAlignment.Right then
            x = as.X - tb.X / 2
        end
        if t.TextYAlignment == Enum.TextYAlignment.Top then
            y = tb.Y / 2
        elseif t.TextYAlignment == Enum.TextYAlignment.Bottom then
            y = as.Y - tb.Y / 2
        end
    end
    local c = Vector2.new(ap.X + math.clamp(x, 0, as.X), ap.Y + math.clamp(y, 0, as.Y))
    local sg = t:FindFirstAncestorOfClass("ScreenGui")
    if sg and not sg.IgnoreGuiInset then
        c = c + GuiService:GetGuiInset()
    end
    return c
end

-- the single-character label that belongs to a key (the key itself or a visible child)
local function findLetter(o)
    if isLetterObj(o) then return o end
    for _, d in ipairs(o:GetDescendants()) do
        if d:IsA("GuiObject") and d.Visible and isLetterObj(d) then return d end
    end
    return nil
end

local function keyPoint(k)
    if k.ref and k.ref.Parent then return textPoint(k.ref) end
    return rawCenter(k.obj)
end

local flash = function() end

local pressMany
do
local touchOk = pcall(function() return VIM.SendTouchEvent end)
local touchId = 0

local function tapKey(k)
    if not k.obj.Parent then return end
    local c = keyPoint(k) -- exactly on the letter, recomputed at tap time
    if touchOk then
        touchId = touchId % 200 + 1
        local id = touchId
        local ok = pcall(function() VIM:SendTouchEvent(id, 0, c.X, c.Y) end)
        if ok then
            task.wait(0.035)
            pcall(function() VIM:SendTouchEvent(id, 2, c.X, c.Y) end)
            return
        end
        touchOk = false
    end
    VIM:SendMouseMoveEvent(c.X, c.Y, game)
    VIM:SendMouseButtonEvent(c.X, c.Y, 0, true, game, 0)
    task.wait(0.03)
    VIM:SendMouseButtonEvent(c.X, c.Y, 0, false, game, 0)
end

function pressMany(keys)
    for _, k in ipairs(keys) do
        task.spawn(tapKey, k)
        flash(k.i)
    end
end
end -- do (touch)

---------------------------------------------------------------------
-- Note mapping
---------------------------------------------------------------------
local hasBlackKeys, buildMapper
do
local majorDegree = { [0] = 0, [1] = 0, [2] = 1, [3] = 1, [4] = 2, [5] = 3, [6] = 3, [7] = 4, [8] = 4, [9] = 5, [10] = 5, [11] = 6 }
local inMajor = { [0] = true, [2] = true, [4] = true, [5] = true, [7] = true, [9] = true, [11] = true }

local function detectTonic(notes)
    local hist = {}
    for i = 0, 11 do hist[i] = 0 end
    for _, n in ipairs(notes) do
        local pc = n.n % 12
        hist[pc] = hist[pc] + 1
    end
    local best, bestScore, bestTie = 0, -1, -1
    for t = 0, 11 do
        local score = 0
        for pc = 0, 11 do
            if inMajor[(pc - t) % 12] then score = score + hist[pc] end
        end
        local tie = hist[t] + hist[(t + 7) % 12]
        if score > bestScore or (score == bestScore and tie > bestTie) then
            best, bestScore, bestTie = t, score, tie
        end
    end
    return best
end

function hasBlackKeys(keys)
    local minH, maxH, minY, maxY = math.huge, 0, math.huge, -math.huge
    for _, k in ipairs(keys) do
        minH = math.min(minH, k.h)
        maxH = math.max(maxH, k.h)
        minY = math.min(minY, k.y)
        maxY = math.max(maxY, k.y)
    end
    return (maxH / math.max(minH, 1) >= 1.25) or (maxY - minY > 0.15 * maxH)
end

function buildMapper(notes, N, diatonic)
    local tonic = diatonic and detectTonic(notes) or 0
    local unit = diatonic and 7 or 12

    local function toVal(note)
        if diatonic then
            local d = note - tonic
            return math.floor(d / 12) * 7 + majorDegree[d % 12]
        end
        return note
    end

    local counts, vals = {}, {}
    local minV, maxV = math.huge, -math.huge
    for _, n in ipairs(notes) do
        local v = toVal(n.n)
        counts[v] = (counts[v] or 0) + 1
        vals[#vals + 1] = v
        if v < minV then minV = v end
        if v > maxV then maxV = v end
    end
    table.sort(vals)
    local med = vals[math.ceil(#vals / 2)] or 0

    local bestBase, bestOut, bestDist = 0, math.huge, math.huge
    for base = (math.floor(minV / unit) - 1) * unit, maxV, unit do
        local out = 0
        for v, c in pairs(counts) do
            if v < base or v > base + N - 1 then out = out + c end
        end
        local dist = math.abs(base + N / 2 - med)
        if out < bestOut or (out == bestOut and dist < bestDist) then
            bestBase, bestOut, bestDist = base, out, dist
        end
    end

    return function(note)
        local idx = toVal(note) - bestBase
        if N >= unit then
            while idx < 0 do idx = idx + unit end
            while idx >= N do idx = idx - unit end
        else
            idx = idx % N
        end
        return idx
    end
end
end -- do (note mapping)

---------------------------------------------------------------------
-- Theme & GUI helpers
---------------------------------------------------------------------
local WHITE = Color3.fromRGB(255, 255, 255)
local C = {
    bg = Color3.fromRGB(16, 17, 24),
    card = Color3.fromRGB(27, 29, 40),
    card2 = Color3.fromRGB(40, 43, 58),
    line = Color3.fromRGB(62, 66, 88),
    text = Color3.fromRGB(236, 238, 246),
    muted = Color3.fromRGB(148, 153, 176),
    accent = Color3.fromRGB(94, 234, 212),
    accent2 = Color3.fromRGB(129, 140, 248),
    good = Color3.fromRGB(74, 222, 128),
    warn = Color3.fromRGB(250, 204, 21),
    bad = Color3.fromRGB(248, 113, 113),
    dark = Color3.fromRGB(12, 14, 20),
}
local FONT, FONT_M, FONT_B = Enum.Font.Gotham, Enum.Font.GothamMedium, Enum.Font.GothamBold

local function new(class, props, parent)
    local i = Instance.new(class)
    for k, v in pairs(props) do i[k] = v end
    i.Parent = parent
    return i
end
local function corner(o, r) return new("UICorner", { CornerRadius = UDim.new(0, r or 8) }, o) end
local function stroke(o, color, th, tr)
    return new("UIStroke", {
        Color = color, Thickness = th or 1, Transparency = tr or 0,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
    }, o)
end
local function gradient(o, c1, c2, rot)
    return new("UIGradient", { Color = ColorSequence.new(c1, c2), Rotation = rot or 0 }, o)
end
local function pad(o, l, t, r, b)
    new("UIPadding", {
        PaddingLeft = UDim.new(0, l), PaddingTop = UDim.new(0, t or l),
        PaddingRight = UDim.new(0, r or l), PaddingBottom = UDim.new(0, b or t or l),
    }, o)
end
local function tween(o, t, props)
    TweenService:Create(o, TweenInfo.new(t, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), props):Play()
end
local function label(parent, props)
    props.BackgroundTransparency = 1
    props.Font = props.Font or FONT
    props.TextColor3 = props.TextColor3 or C.text
    props.TextSize = props.TextSize or 13
    return new("TextLabel", props, parent)
end
local function button(parent, props, base, over)
    props.AutoButtonColor = false
    props.BackgroundColor3 = base
    props.Font = props.Font or FONT_B
    props.TextColor3 = props.TextColor3 or C.text
    props.TextSize = props.TextSize or 13
    local b = new("TextButton", props, parent)
    b.MouseEnter:Connect(function() tween(b, 0.12, { BackgroundColor3 = over }) end)
    b.MouseLeave:Connect(function() tween(b, 0.12, { BackgroundColor3 = base }) end)
    return b
end
local function esc(s)
    return (s:gsub("&", "&amp;"):gsub("<", "&lt;"):gsub(">", "&gt;"))
end
local function fmt(sec)
    sec = math.max(0, math.floor(sec))
    return string.format("%d:%02d", sec // 60, sec % 60)
end

