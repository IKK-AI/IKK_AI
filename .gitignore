-- FORWARD DECLARATIONS (กันปัญหาลำดับ define ระหว่าง section)
-- ═══════════════════════════════════════════════════════════════
local sg                 -- p03 (ScreenGui)
local Main               -- p03 (main window)
local updateHUD          -- p04 (event-driven status pill)
local tutReposition      -- p11 (tutorial)
local doConnect          -- p09
local refreshWhitelist   -- p07
local refreshBL          -- p09
local searchText = ""    -- search box current text
local switchTab          -- p04
local hookBtn           -- p04 (ประกาศก่อนเพื่อ wrap ใน do-block ได้)

-- UIX — cross-section references (กันปัญหา ordering + ลดจำนวน local)
local UIX = {}

-- ⊢ อวตาร Roblox จริง (ภาพ headshot ของ LocalPlayer) ใส่ลง frame วงกลม
--   ทำงานเบื้องหลัง + fallback เป็นตัวอักษรแรกของชื่อ (ถ้าโหลดภาพไม่ได้)
--   z = ZIndex ของ ImageLabel (เลือกให้อยู่เหนือตัวอักษร แต่ต่ำกว่าดาว premium)
function UIX.avatar(frame, z)
        if not frame or not Players or not LP then return end
        pcall(function()
                task.spawn(function()
                        local ok, content = pcall(function()
                                return Players:GetUserThumbnailAsync(LP.UserId,
                                        Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size420x420)
                        end)
                        if ok and type(content) == "string" and #content > 5 and frame.Parent then
                                local img = frame:FindFirstChild("AvImg")
                                if not img then
                                        img = Instance.new("ImageLabel")
                                        img.Name = "AvImg"
                                        img.Size = UDim2.new(1, 0, 1, 0)
                                        img.Position = UDim2.new()
                                        img.BackgroundTransparency = 1
                                        img.ScaleType = Enum.ScaleType.Crop
                                        img.Parent = frame
                                end
                                img.ZIndex = z or 16
                                img.Image = content
                                for _, ch in ipairs(frame:GetChildren()) do
                                        if ch.ClassName == "TextLabel" and ch.Name ~= "AvaStar" then
                                                ch.Visible = false
                                        end
                                end
                        end
                end)
        end)
end


