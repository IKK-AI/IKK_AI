local THEME_ORDER = { "midnight", "dark", "light", "ocean", "violet", "rose", "cyber", "sunset" }
local THEME_ICONS = {
        midnight = "🌙", dark = "🌚", light = "☀️", ocean = "🌊",
        violet = "🔮", rose = "🌹", cyber = "💚", sunset = "🌅",
}
local THEME_NAMES = {
        midnight = "Midnight", dark = "Dark", light = "Light", ocean = "Ocean",
        violet = "Violet", rose = "Rose", cyber = "Cyber", sunset = "Sunset",
}

local C = {}

-- PX — pipeline internals (รวมฟังก์ชันภายในไว้ใน namespace เพื่อประหยัด register)
local PX = {}

function PX.applyThemeColors(themeName)
        local t = THEMES[themeName] or THEMES.midnight
        for k, v in pairs(t) do C[k] = v end
        S.currentTheme = themeName
end
PX.applyThemeColors(S.currentTheme)

-- ⊢ THEME REGISTRY — ลงทะเบียน instance ที่ต้องเปลี่ยนสีตอนเปลี่ยนธีม
local THEME_REG = {}
local THEME_CB = {}

local function themed(obj, prop, key)
        if not obj then return obj end
        THEME_REG[#THEME_REG + 1] = { obj = obj, prop = prop, key = key }
        return obj
end

-- เปลี่ยนธีมทั้งหมดทันที (สี match แบบ map — เร็ว ไม่ tween ทั้งต้นไม้)
-- + registry fast path + callback สำหรับของพิเศษ
local function applyThemeNoSave(themeName)
        local function _ck(c)
                return math.floor(c.R * 255 + .5) .. "," .. math.floor(c.G * 255 + .5) .. "," .. math.floor(c.B * 255 + .5)
        end
        local newT = THEMES[themeName] or THEMES.midnight
        local oldCmap = {}
        for k, oc in pairs(C) do oldCmap[_ck(oc)] = newT[k] end
        PX.applyThemeColors(themeName)

        for _, e in ipairs(THEME_REG) do
                local col = C[e.key]
                if col then pcall(function() e.obj[e.prop] = col end) end
        end

        if sg then
                local function walk(inst)
                        -- ข้าม subtree ที่ขึ้นต้นชื่อ "TPV_" (Theme PreView) — การ์ดพรีวิวธีม
                        --   ต้องแสดง "สีของธีมตัวเอง" เสมอ ห้ามถูก remap ตามธีมที่กำลังใช้
                        --   (แก้: เปลี่ยนธีมแล้วสีการ์ดธีมอื่นเพี้ยนตาม)
                        if type(inst.Name) == "string" and inst.Name:sub(1, 4) == "TPV_" then return end
                        pcall(function()
                                if inst:IsA("GuiObject") then
                                        local m = oldCmap[_ck(inst.BackgroundColor3)]
                                        if m then inst.BackgroundColor3 = m end
                                end
                                if inst:IsA("TextLabel") or inst:IsA("TextButton") or inst:IsA("TextBox") then
                                        local m = oldCmap[_ck(inst.TextColor3)]
                                        if m then inst.TextColor3 = m end
                                end
                                if inst:IsA("UIStroke") then
                                        local m = oldCmap[_ck(inst.Color)]
                                        if m then inst.Color = m end
                                end
                                if inst:IsA("ImageLabel") or inst:IsA("ImageButton") then
                                        local m = oldCmap[_ck(inst.ImageColor3)]
                                        if m then inst.ImageColor3 = m end
                                end
                        end)
                        for _, ch in ipairs(inst:GetChildren()) do walk(ch) end
                end
                walk(sg)
        end

        for _, cb in ipairs(THEME_CB) do pcall(cb) end
end

-- วงกลม wipe สวย ๆ ตอนเปลี่ยนธีม (แอนิเมชั่นแยกจากการ set สี)
function PX.themeWipe(originPos)
        if not sg or not Main or not Main.Visible then return end
        local mp, ms = Main.AbsolutePosition, Main.AbsoluteSize
        local cx = originPos and (originPos.X - mp.X) or ms.X / 2
        local cy = originPos and (originPos.Y - mp.Y) or ms.Y / 2
        local rad = math.max(ms.X, ms.Y) * 0.9

        local wipe = Instance.new("Frame", Main)
        wipe.AnchorPoint = Vector2.new(0.5, 0.5)
        wipe.Position = UDim2.fromOffset(cx, cy)
        wipe.Size = UDim2.fromOffset(0, 0)
        wipe.BackgroundColor3 = C.AC
        wipe.BackgroundTransparency = 0.55
        wipe.BorderSizePixel = 0
        wipe.ZIndex = 60
        Instance.new("UICorner", wipe).CornerRadius = UDim.new(1, 0)

        ANIM.play(wipe, { Size = UDim2.fromOffset(rad * 2, rad * 2), BackgroundTransparency = 1 },
                { t = 0.45, style = Enum.EasingStyle.Quart, dir = Enum.EasingDirection.Out, tag = "wipe" })
        task.delay(0.5, function()
                if wipe and wipe.Parent then wipe:Destroy() end
        end)
end

local function applyTheme(themeName, fxOrigin)
        applyThemeNoSave(themeName)
        saveSettings()
        PX.themeWipe(fxOrigin)
        SND.play("theme")
end

-- ═══════════════════════════════════════════════════════════════
-- CHARACTER MANAGEMENT
-- ═══════════════════════════════════════════════════════════════
local Char, HRP

local function refreshChar()
        Char = LP.Character
        if not Char then return end
        HRP = Char:FindFirstChild("HumanoidRootPart")
end
refreshChar()

LP.CharacterAdded:Connect(function(c)
        Char = c
        pcall(function() HRP = c:WaitForChild("HumanoidRootPart", 8) end)
end)

-- ═══════════════════════════════════════════════════════════════
-- ⊢ AI CONTEXT PIPELINE (รวม extension 5 ชั้นของ v7 เป็นชุดเดียว)
--   web search · player awareness · room snapshot · continuity
-- ═══════════════════════════════════════════════════════════════
local EXTCTX = {
        searchOn = true, awarenessOn = true, roomOn = true, memoryExtOn = true,
        gameCtxOn = true,            -- AI เห็น inventory ตัวเอง + ตำแหน่งผู้เล่น (lazy — เฉพาะตอนถูกถาม/พูดถึง)
        roomBuf = {},              -- background chat buffer {t, uid, m}
        appearCache = {},          -- [uid] = {t, txt}
        FILE_EXTENDED = "OllamaAI_Extended.json",
        FILE_SESSION  = "OllamaAI_Session.json",
        FILE_WORLD    = "OllamaAI_World.json",
        extended = {},
        sessionMeta = { startTime = os.time(), gameId = tostring(game.PlaceId), chatCount = 0, activePlayers = {} },
        worldMeta = { relationshipMap = {}, knownNames = {}, sessionCount = 0 },
}

function PX.urlEnc(s)
        return (s:gsub("([^%w%-_%.~])", function(c)
                return string.format("%%%02X", string.byte(c))
        end))
end

-- Web search (DuckDuckGo Instant Answer — ฟรี ไม่ต้องมี key)
function PX.webSearch(query)
        if not Http or not HttpService then return nil end
        local url = "https://api.duckduckgo.com/?q=" .. PX.urlEnc(query:sub(1, 100))
                .. "&format=json&no_redirect=1&no_html=1&t=SebasAI"
        local ok2, res = pcall(function()
                return Http({ Url = url, Method = "GET", Headers = { ["Accept"] = "application/json" } })
        end)
        local rn = normRes(res)
        if not ok2 or rn == nil or rn.status ~= 200 then return nil end
        local data
        pcall(function() data = HttpService:JSONDecode(rn.body) end)
        if not data then return nil end
        if data.AbstractText and #data.AbstractText > 20 then return data.AbstractText:sub(1, 180) end
        if data.Answer and #data.Answer > 5 then return data.Answer:sub(1, 140) end
        if data.RelatedTopics and data.RelatedTopics[1] then
                local t = data.RelatedTopics[1].Text
                if t and #t > 10 then return t:sub(1, 160) end
        end
        return nil
end

PX.KW = {
        "what is","who is","who are","how to","how do",
        "when did","when was","where is","why is","why does",
        "explain","define","meaning","tell me about",
        "current","latest","newest","recent","today","news",
        "search","look up","find out","google",
        "คืออะไร","ใครคือ","ยังไง","อธิบาย","หมายความว่า",
        "ล่าสุด","ข่าว","วันนี้","ค้นหา","บอกเกี่ยวกับ",
}

local function needsSearch(msg)
        if not msg then return false end
        local low = msg:lower()
        for _, kw in ipairs(PX.KW) do
                if low:find(kw, 1, true) then return true end
        end
        return false
end

-- คีย์เวิร์ดเรื่องข่าว → ใช้ Google News RSS (DDG Instant Answer ไม่คืนข่าวจริง)
PX.NEWS_KW = {
        "news", "headline", "happening", "what's going on in the world",
        "ข่าว", "พาดหัว", "เกิดอะไรขึ้น", "มีอะไรขึ้น",
}

function PX.needsNews(msg)
        if not msg then return false end
        local low = msg:lower()
        for _, kw in ipairs(PX.NEWS_KW) do
                if low:find(kw, 1, true) then return true end
        end
        return false
end

-- ดึงข่าวสดจาก Google News RSS — คืนพาดหัว 4-5 ข้อ (ตามภาษาผู้พูด + cache 5 นาที)
function PX.newsSearch(query, langCode)
        if not Http then return nil end
        -- สกัดหัวข้อ: ตัดคำถาม/คำเรื่องข่าวออก ถ้าเหลือสั้นเกิน → ใช้ top stories
        local q = ""
        if type(query) == "string" then
                q = (query:match("^(.-)%[") or query)
                        :gsub("[?!]", ""):gsub("%s+", " ")
                q = (q:match("^%s*(.-)%s*$") or "")
                local stripped = q:lower()
                        :gsub("news", ""):gsub("headlines?", ""):gsub("today", "")
                        :gsub("ข่าว", ""):gsub("วันนี้", ""):gsub("ล่าสุด", "")
                        :gsub("มีอะไรขึ้น", ""):gsub("มีอะไรบ้าง", ""):gsub("เกิดอะไรขึ้น", "")
                        :gsub("บ้าง", ""):gsub("%s", "")
                if #stripped < 3 then q = "" end
        end
        local key = q .. "|" .. tostring(langCode or "?")
        local nc = PX.RS.newsCache
        if nc.key == key and nc.t and nc.txt and tick() - nc.t < PX.RS.NEWS_TTL then
                return nc.txt
        end
        local hl, gl = "th", "TH"
        if langCode == "en" then hl, gl = "en", "US" end
        local url = "https://news.google.com/rss"
                .. (q ~= "" and ("/search?q=" .. PX.urlEnc(q:sub(1, 60))) or "")
                .. "?hl=" .. hl .. "&gl=" .. gl .. "&ceid=" .. gl .. ":" .. hl
        local ok, res = pcall(function()
                return Http({ Url = url, Method = "GET",
                        Headers = { ["Accept"] = "application/rss+xml, text/xml, */*" } })
        end)
        local rn = normRes(res)
        if not ok or rn == nil or rn.status ~= 200 then return nil end
        local body = tostring(rn.body or "")
        if #body < 30 then return nil end
        local titles = {}
        for t in body:gmatch("<title>(.-)</title>") do
                local clean = t:gsub("^<!%[CDATA%[(.-)%]%]>$", "%1")
                        :gsub("&amp;", "&"):gsub("&lt;", "<"):gsub("&gt;", ">")
                        :gsub("&quot;", '"'):gsub("&#39;", "'"):gsub("&apos;", "'")
                if #clean > 10 then titles[#titles + 1] = clean:sub(1, 90) end
                if #titles >= 6 then break end
        end
        if #titles > 1 then table.remove(titles, 1) end   -- <title> แรก = ชื่อ feed เอง
        if #titles == 0 then return nil end
        local txt = "top headlines: " .. table.concat(titles, " / ")
        PX.RS.newsCache = { key = key, t = tick(), txt = txt }
        return txt
end

-- สี → ชื่อ (สำหรับบรรยาย avatar)
function PX.colorName(c3)
        if not c3 then return "?" end
        local r, g, b = c3.R, c3.G, c3.B
        local mx = math.max(r, g, b)
        local mn = math.min(r, g, b)
        local sat = mx < 0.001 and 0 or (mx - mn) / mx
        if sat < 0.18 then
                if mx > 0.78 then return "white"
                elseif mx < 0.22 then return "black"
                else return "grey" end
        end
        local h
        local d = mx - mn
        if mx == r then h = ((g - b) / d) % 6
        elseif mx == g then h = (b - r) / d + 2
        else h = (r - g) / d + 4 end
        h = h * 60
        if h < 0 then h = h + 360 end
        local pre = mx > 0.70 and "light " or (mx < 0.35 and "dark " or "")
        if h < 25 then return pre.."red"
        elseif h < 50 then return pre.."orange"
        elseif h < 75 then return pre.."yellow"
        elseif h < 155 then return pre.."green"
        elseif h < 205 then return pre.."cyan"
        elseif h < 265 then return pre.."blue"
        elseif h < 320 then return pre.."purple"
        elseif h < 345 then return pre.."pink"
        else return pre.."red" end
end

-- อ่านรูปลักษณ์ avatar ในเกม (ละเอียด: ทุก accessory + สี + ร่าง R6/R15, cache 30 วิ)
function PX.getAppearanceCached(uid, plr)
        if not plr then return nil end
        local now = tick()
        local ce = EXTCTX.appearCache[uid]
        if ce and now - ce.t < 30 then return ce.txt end
        local char = plr.Character
        if not char then return ce and ce.txt or nil end
        local parts = {}
        pcall(function()
                local hum = char:FindFirstChildOfClass("Humanoid")
                if hum and hum.RigType == Enum.HumanoidRigType.R15 then
                        parts[#parts + 1] = "R15 body"
                end
        end)
        pcall(function()
                for _, c in ipairs(char:GetChildren()) do
                        if #parts >= 8 then break end
                        if c:IsA("Accessory") then
                                local n = c.Name:gsub("Roblox", ""):gsub("_", " ")
                                n = (n:match("^%s*(.-)%s*$") or ""):sub(1, 16)
                                if #n > 2 then parts[#parts + 1] = n end
                        end
                end
        end)
        pcall(function()
                local bc = char:FindFirstChildOfClass("BodyColors")
                if bc then
                        parts[#parts + 1] = PX.colorName(bc.HeadColor3) .. " skin"
                        parts[#parts + 1] = PX.colorName(bc.TorsoColor3) .. " torso"
                        parts[#parts + 1] = PX.colorName(bc.LeftLegColor3) .. " legs"
                end
        end)
        if char:FindFirstChildOfClass("Shirt") then parts[#parts + 1] = "custom shirt" end
        if char:FindFirstChildOfClass("Pants") then parts[#parts + 1] = "custom pants" end
        local txt = #parts > 0 and table.concat(parts, ", ") or nil
        EXTCTX.appearCache[uid] = { t = now, txt = txt }
        return txt
end

-- รายชื่อคนรอบตัว (จำกัด 4 คน สั้น ๆ)
function PX.buildNearbyContext()
        if not HRP or not HRP.Parent then return nil end
        local range = S.range == 0 and 60 or S.range
        local lines = {}
        for _, p in ipairs(Players:GetPlayers()) do
                if p ~= LP and #lines < 4 and p.Character then
                        local ph = p.Character:FindFirstChild("HumanoidRootPart")
                        if ph then
                                local dist = (HRP.Position - ph.Position).Magnitude
                                if dist <= range then
                                        lines[#lines + 1] = math.floor(dist) .. "m away"
                                end
                        end
                end
        end
        if #lines == 0 then return nil end
        return #lines .. " players nearby (" .. table.concat(lines, ", ") .. ")"
end

-- Room snapshot — แชทพื้นหลังแบบไม่มีชื่อจริง (กัน AI พูดชื่อคนอื่น)
PX.ROOM_TTL = 120
function PX.pushRoomMsg(uid, msg)
        if not msg or type(msg) ~= "string" then return end
        local buf = EXTCTX.roomBuf
        buf[#buf + 1] = { t = tick(), uid = uid, m = msg:sub(1, 90) }
        local now = tick()
        local i2 = 1
        while i2 <= #buf do
                if now - buf[i2].t > PX.ROOM_TTL then table.remove(buf, i2) else i2 = i2 + 1 end
        end
        while #buf > 12 do table.remove(buf, 1) end
end

function PX.buildRoomSnap(excludeUid)
        local buf = EXTCTX.roomBuf
        local recent = {}
        local start = math.max(1, #buf - 4)
        for i = start, #buf do
                local e = buf[i]
                if e.uid ~= excludeUid then
                        recent[#recent + 1] = "someone:\"" .. e.m .. "\""
                end
        end
        if #recent == 0 then return nil end
        return "bg-chat:[" .. table.concat(recent, " | ") .. "]"
end

-- ═══════════════════════════════════════════════════════════════
-- ⊢ SELF-CHAT AWARENESS — รู้ว่า "เจ้าของแอค" (คน) พิมพ์อะไรไปเอง
--   เจ้าของบางครั้งเล่นแอคนี้เองและพิมพ์แชทเอง → AI ต้องเห็นข้อความเหล่านั้น
--   เพื่อไม่ทักทาย/พูดซ้ำกับที่เจ้าของพิมพ์ไปแล้ว (แยกจากข้อความ
--   ที่ AI ส่งเองด้วย mark ที่ติดไว้ตอน sendRaw)
-- ═══════════════════════════════════════════════════════════════
PX.SELF_TTL = 600          -- จำข้อความเจ้าของ 10 นาที
S.selfChat = {}            -- { {t, m}, ... } เรียงเก่า → ใหม่
S._sentMark = {}           -- [text] = เวลาที่สคริปต์เพิ่งส่งข้อความนี้เอง

function PX.pushSelfMsg(msg)
        if type(msg) ~= "string" then return end
        local txt = msg:match("^%s*(.-)%s*$") or ""
        if txt == "" then return end
        local now = tick()
        -- ข้อความที่สคริปต์ (AI) เพิ่งส่งไปเอง → ไม่ใช่คนพิมพ์
        local mk = S._sentMark[txt]
        if mk and (now - mk) < 5 then
                S._sentMark[txt] = nil
                return
        end
        -- กันจับซ้ำ (Chatted + MessageReceived ยิงพร้อมกันบางเกม)
        local last = S.selfChat[#S.selfChat]
        if last and last.m == txt and (now - last.t) < 2 then return end
        S.selfChat[#S.selfChat + 1] = { t = now, m = txt:sub(1, 120) }
        while #S.selfChat > 8 do table.remove(S.selfChat, 1) end
        while #S.selfChat > 0 and (now - S.selfChat[1].t) > PX.SELF_TTL do
                table.remove(S.selfChat, 1)
        end
        print("[Sebas AI] 👤 owner typed: " .. txt:sub(1, 60))
end

function PX.buildSelfChat()
        local buf = S.selfChat
        local now = tick()
        while #buf > 0 and (now - buf[1].t) > PX.SELF_TTL do
                table.remove(buf, 1)
        end
        if #buf == 0 then return nil end
        local lines = {}
        local start = math.max(1, #buf - 5)
        for i = start, #buf do
                local e = buf[i]
                local mins = math.floor((now - e.t) / 60)
                local age = mins >= 1 and (mins .. " min ago") or "just now"
                lines[#lines + 1] = '- "' .. e.m .. '" (' .. age .. ')'
        end
        return "ACCOUNT OWNER NOTE: the human owner sometimes plays this account and types in the game chat THEMSELVES — "
                .. "those messages are NOT yours.\n"
                .. "What the OWNER recently typed in chat (oldest first):\n"
                .. table.concat(lines, "\n") .. "\n"
                .. "RULES: Do NOT repeat, re-greet, or duplicate what the owner already said "
                .. "(e.g. if the owner already greeted or answered someone, do NOT do it again). "
                .. "Continue naturally from what the owner said instead."
end

-- ═══════════════════════════════════════════════════════════════
-- ⊢ RESEARCH KIT — ข้อมูลผู้เล่น / บัญชีตัวเอง / IP-Geo / เวลา / ข่าว
--   ดึงข้อมูลจริงจาก Roblox public API + IP geolocation + Google News RSS
--   cache ต่อผู้เล่น 10 นาที + ยิง background ไม่บล็อกแชท
-- ═══════════════════════════════════════════════════════════════
PX.RS = {
        SELF_USER = "chat_g0d",   -- username ของ AI ตัวเอง (ถูกถามเรื่องบัญชี → ดูข้อมูลชื่อนี้)
        cache = {},               -- [uid] = {t, info, fetching}
        selfInfo = nil,           -- ข้อมูลบัญชี chat_g0d (ดึงตอนสตาร์ท)
        geo = nil,                -- IP geolocation ของเครื่องที่รัน AI
        newsCache = { key = nil, t = 0, txt = nil },
        TTL = 600,                -- cache ผู้เล่น 10 นาที
        NEWS_TTL = 300,           -- cache ข่าว 5 นาที
}

-- GET แบบรับ JSON (pcall ครอบทุกอย่าง — พังก็คืน nil ไม่ทำให้แชทตาย)
function PX.httpGetJson(url)
        if not Http or not HttpService then return nil end
        local ok, res = pcall(function()
                return Http({ Url = url, Method = "GET", Headers = { ["Accept"] = "application/json" } })
        end)
        local rn = normRes(res)
        if not ok or rn == nil or rn.status ~= 200 then return nil end
        local d
        pcall(function() d = HttpService:JSONDecode(rn.body) end)
        return type(d) == "table" and d or nil
end

-- ดึงข้อมูลผู้เล่นครบชุด: บัญชี/อายุ/เพื่อน/followers/ชุดที่สวม (จาก Roblox public API)
function PX.fetchPlayerInfo(uid)
        uid = tostring(uid or "")
        if not uid:match("^%d+$") then return nil end
        local info = { userId = uid }

        -- ข้อมูล in-game ทันที (ไม่ต้องรอเน็ต)
        pcall(function()
                local plr = Players:GetPlayerByUserId(tonumber(uid))
                if plr then
                        info.username = plr.Name
                        info.display = plr.DisplayName
                        info.ageDays = tonumber(plr.AccountAge) or nil
                end
        end)

        -- โปรไฟล์: วันสร้างบัญชี / bio / verified
        local d = PX.httpGetJson("https://users.roblox.com/v1/users/" .. uid)
        if type(d) == "table" then
                info.username = d.name or info.username
                info.display = d.displayName or info.display
                info.created = d.created
                if type(d.description) == "string" and #d.description > 0 then
                        info.desc = d.description:sub(1, 90)
                end
                info.verified = d.hasVerifiedBadge == true
        end

        -- เพื่อน / followers
        local f = PX.httpGetJson("https://friends.roblox.com/v1/users/" .. uid .. "/friends/count")
        if type(f) == "table" and tonumber(f.count) then info.friends = tonumber(f.count) end
        local fl = PX.httpGetJson("https://friends.roblox.com/v1/users/" .. uid .. "/followers/count")
        if type(fl) == "table" and tonumber(fl.count) then info.followers = tonumber(fl.count) end

        -- ชุดที่สวมอยู่ (avatar API ได้ชื่อไอเท็มจริง)
        local av = PX.httpGetJson("https://avatar.roblox.com/v1/users/" .. uid .. "/avatar")
        if type(av) == "table" and type(av.assets) == "table" then
                local names = {}
                for _, a in ipairs(av.assets) do
                        if type(a) == "table" and type(a.name) == "string" and #a.name > 1 and #names < 6 then
                                names[#names + 1] = a.name:sub(1, 22)
                        end
                end
                if av.playerAvatarType then info.rig = av.playerAvatarType end
                if #names > 0 then info.wearing = table.concat(names, ", ") end
        end

        -- อายุบัญชีแบบปีทศนิยม (แม่นกว่า AccountAge ถ้าได้วันสร้าง)
        if info.created then
                local y, m, dd = info.created:match("^(%d+)-(%d+)-(%d+)")
                y, m, dd = tonumber(y), tonumber(m), tonumber(dd)
                if y and m and dd then
                        local yrs = (os.time() - os.time({ year = y, month = m, day = dd, hour = 12 })) / 31557600
                        if yrs >= 0 then info.ageYears = math.floor(yrs * 10) / 10 end
                end
        end
        return info
end

-- ยิงดึงข้อมูลเบื้องหลัง (ไม่บล็อก) — เรียกตอนผู้เล่นเริ่มพูด
function PX.warmPlayer(uid)
        uid = tostring(uid or "")
        if not uid:match("^%d+$") then return end
        local now = tick()
        local c = PX.RS.cache[uid]
        if c then
                if now - c.t < PX.RS.TTL then return end                 -- ยังสดอยู่
                if c.fetching and now - c.fetching < 10 then return end  -- กำลังดึงอยู่
        end
        PX.RS.cache[uid] = { t = c and c.t or 0, info = c and c.info or nil, fetching = now }
        task.spawn(function()
                local ok, info = pcall(PX.fetchPlayerInfo, uid)
                local cc = PX.RS.cache[uid]
                if cc then
                        cc.fetching = 0
                        if ok and type(info) == "table" and info.username then
                                cc.t = tick(); cc.info = info
                        end
                end
        end)
end

-- อ่านจาก cache (ถ้าหมดอายุ → ยิง warm แล้วคืนของเก่าไปก่อน)
function PX.getPlayerInfo(uid)
        uid = tostring(uid or "")
        local c = PX.RS.cache[uid]
        if c and c.t > 0 and tick() - c.t < PX.RS.TTL then return c.info end
        PX.warmPlayer(uid)
        return c and c.info or nil
end

-- ดึงแบบ synchronous (ใช้เมื่อมีคนถามถึงคนนั้นโดยตรง — ยอมรอ ~1s ครั้งเดียวต่อ 10 นาที)
function PX.getPlayerInfoSync(uid)
        uid = tostring(uid or "")
        local c = PX.RS.cache[uid]
        if c and c.t > 0 and tick() - c.t < PX.RS.TTL then return c.info end
        local ok, info = pcall(PX.fetchPlayerInfo, uid)
        if ok and type(info) == "table" and info.username then
                PX.RS.cache[uid] = { t = tick(), info = info, fetching = 0 }
                return info
        end
        return c and c.info or nil
end

-- ดึงข้อมูลบัญชีตัวเอง (chat_g0d) — ค้นหา userId จาก username แล้วดึงข้อมูลเต็ม
function PX.fetchSelfInfo()
        local d = PX.httpGetJson("https://users.roblox.com/v1/users/search?keyword="
                .. PX.urlEnc(PX.RS.SELF_USER) .. "&limit=10")
        if type(d) ~= "table" or type(d.data) ~= "table" then return end
        for _, u in ipairs(d.data) do
                if type(u) == "table" and type(u.name) == "string"
                        and u.name:lower() == PX.RS.SELF_USER:lower() then
                        local info = PX.fetchPlayerInfo(tostring(u.id))
                        if type(info) == "table" then
                                info.userId = tostring(u.id)
                                info.username = u.name
                                PX.RS.selfInfo = info
                        end
                        return
                end
        end
end

-- IP geolocation ของเครื่องที่รัน AI — ประเทศ/เมือง/timezone/ISP (ลอง https ก่อน แล้ว fallback http)
function PX.fetchGeo()
        local g = PX.httpGetJson("https://ipwho.is/")
        if type(g) == "table" and g.success == true and g.country then
                PX.RS.geo = {
                        country = g.country, city = g.city, region = g.region, ip = g.ip,
                        tz = g.timezone and g.timezone.id or nil,
                        isp = g.connection and g.connection.isp or nil,
                }
                return
        end
        local g2 = PX.httpGetJson("http://ip-api.com/json/")
        if type(g2) == "table" and g2.status == "success" and g2.country then
                PX.RS.geo = {
                        country = g2.country, city = g2.city, region = g2.regionName,
                        ip = g2.query, tz = g2.timezone, isp = g2.isp,
                }
        end
end

-- จัดรูปแบบข้อมูลผู้เล่นเป็นบรรทัดสั้น ๆ สำหรับ AI
function PX.fmtInfo(i)
        if type(i) ~= "table" then return "no data" end
        local p = {}
        if i.username or i.display then
                local nm = "@" .. tostring(i.username or "?")
                if i.display and i.display ~= i.username then nm = nm .. " (shows as " .. tostring(i.display) .. ")" end
                p[#p + 1] = nm
        end
        if i.ageYears then
                p[#p + 1] = "account ~" .. i.ageYears .. "y old"
        elseif i.ageDays then
                p[#p + 1] = "account ~" .. (math.floor(i.ageDays / 365 * 10) / 10) .. "y old"
        end
        if i.created then p[#p + 1] = "joined " .. i.created:sub(1, 10) end
        if i.friends then p[#p + 1] = i.friends .. " friends" end
        if i.followers then p[#p + 1] = i.followers .. " followers" end
        if i.verified then p[#p + 1] = "verified badge" end
        if i.wearing then p[#p + 1] = "wears: " .. i.wearing end
        if i.rig then p[#p + 1] = i.rig end
        if i.desc then p[#p + 1] = 'bio: "' .. i.desc .. '"' end
        if #p == 0 then return "no public data" end
        return table.concat(p, ", ")
end

-- ประกอบบริบทสด (เวลา + ตำแหน่ง + บัญชีตัวเอง + โปรไฟล์คนพูด + คนที่ถูกถามถึง)
function PX.buildEnvContext(uidK, name, userMsg)
        local L = {}
        local RS_ON = AUTH.on("research")   -- premium gate: ข้อมูลสดให้ AI (โปรไฟล์ผู้เล่น/geo/บัญชีตัวเอง)

        -- เวลา ณ ตอนนี้: local + UTC + offset → AI คำนวณเวลาประเทศไหนก็ได้จาก UTC
        --   (สร้าง UTC string จาก table เอง — os.date("!%Y...") ใส่ '!' หลุดมาใน string บาง runtime)
        pcall(function()
                if type(os.date) ~= "function" then return end
                local utcT = os.date("!*t")
                if type(utcT) ~= "table" then utcT = os.date("*t") end
                local utcStr = string.format("%04d-%02d-%02d %02d:%02d",
                        utcT.year or 2020, utcT.month or 1, utcT.day or 1, utcT.hour or 0, utcT.min or 0)
                local off = os.time(os.date("*t")) - os.time(utcT)
                local sign = off >= 0 and "+" or "-"
                off = math.abs(off)
                L[#L + 1] = string.format("Time now: %s local (UTC%s%02d:%02d); UTC: %s. "
                        .. "Answer any country's time by UTC + its offset.",
                        os.date("%Y-%m-%d %H:%M"), sign, math.floor(off / 3600),
                        math.floor((off % 3600) / 60), utcStr)
        end)

        -- ตำแหน่งจาก IP (ของเครื่องที่รัน AI) — premium (Research Kit)
        if RS_ON then
                local geo = PX.RS.geo
                if geo then
                        local loc = geo.city and (geo.city .. ", ") or ""
                        local tzp = geo.tz and (" (timezone " .. geo.tz .. ")") or ""
                        L[#L + 1] = "You are connected from: " .. loc .. tostring(geo.country) .. tzp
                        if uidK == "DIRECT_CHAT_TAB" then
                                L[#L + 1] = "You are chatting directly with the user on this machine (same location)."
                        end
                end

                -- บัญชีของตัวเอง (chat_g0d)
                local si = PX.RS.selfInfo
                if si then
                        L[#L + 1] = "Your account (" .. PX.RS.SELF_USER .. "): " .. PX.fmtInfo(si)
                end
        end

        -- โปรไฟล์คนที่กำลังพูด — premium (Research Kit)
        if RS_ON and uidK and uidK ~= "DIRECT_CHAT_TAB" then
                local info = PX.getPlayerInfo(uidK)
                if info then
                        L[#L + 1] = "Current speaker " .. tostring(name or "?") .. " — " .. PX.fmtInfo(info)
                end
        end

        -- มีคนถามถึงผู้เล่นคนอื่นในข้อความ (พบชื่อ/ชื่อที่แสดง) → ดึงข้อมูลคนนั้นด้วย
        if RS_ON and type(userMsg) == "string" and #userMsg > 2 then
                local low = userMsg:lower()
                pcall(function()
                        for _, p in ipairs(Players:GetPlayers()) do
                                if p ~= LP and tostring(p.UserId) ~= tostring(uidK) then
                                        local un = tostring(p.Name or "")
                                        local dn = tostring(p.DisplayName or "")
                                        local hitName = (#un > 2 and low:find(un:lower(), 1, true))
                                                or (#dn > 2 and low:find(dn:lower(), 1, true))
                                        if hitName then
                                                local info2 = PX.getPlayerInfoSync(tostring(p.UserId))
                                                if info2 then
                                                        L[#L + 1] = "About " .. un .. " (mentioned in message): " .. PX.fmtInfo(info2)
                                                end
                                                break
                                        end
                                end
                        end
                end)
        end

        -- ขนาดเซิร์ฟเวอร์
        pcall(function()
                L[#L + 1] = "Server: " .. #Players:GetPlayers() .. " players online."
        end)

        if #L == 0 then return nil end
        local txt = table.concat(L, "\n")
        if #txt > 700 then txt = txt:sub(1, 700) end
        return txt
end

-- ═════════════════════════════════════════════════════════════
-- ⊢ GAME CONTEXT (lazy) — inventory ของตัวเองในเกม + ตำแหน่งผู้เล่นทุกคน
--   ตาม requirement ผู้ใช้: "ให้ AI เห็น inventory ของตัวเองและตำแหน่ง
--   ของผู้เล่นแต่ละคน แต่จะไม่อัปเดตถ้าไม่มีคนถามหรือพูดถึง"
--   = ไม่มี polling / ไม่มี cache / ไม่ยิงอะไรเบื้องหลังเลย
--   สแกนข้อความ → โดน trigger (คำถามเรื่องของ/ตำแหน่ง หรือพูดถึงชื่อผู้เล่น)
--   เมื่อไรค่อยเก็บสแนปช็อตสดตอนนั้น แนบเฉพาะ request นั้น
-- ═════════════════════════════════════════════════════════════
-- ตำแหน่งตัวละคร (เก็บได้ทุกกรณี: GetPivot / PrimaryPart / HRP / Head)
function PX.charPos(pl)
        local c = pl and pl.Character
        if not c then return nil end
        local ok, pv = pcall(function() return c:GetPivot() end)
        if ok and pv and pv.Position then return pv.Position end
        local ok2, pp = pcall(function() return c.PrimaryPart and c.PrimaryPart.Position end)
        if ok2 and pp then return pp end
        local ok3, hrp = pcall(function() return c:FindFirstChild("HumanoidRootPart") end)
        if ok3 and hrp and hrp.Position then return hrp.Position end
        local ok4, hd = pcall(function() return c:FindFirstChild("Head") end)
        if ok4 and hd and hd.Position then return hd.Position end
        return nil
end

PX.GAME_KW_INV = {
        "inventory", "item", "tool", "backpack", "holding", "equip", "held",
        "ไอเทม", "ของติดตัว", "กระเป๋า", "ถือ", "สวม", "อุปกรณ์", "มีอะไร", "มีไร",
}
PX.GAME_KW_POS = {
        "position", "where", "location", "coordinate", "coord", "how far", "distance",
        "ตำแหน่ง", "อยู่ไหน", "อยู่ตรงไหน", "ที่ไหน", "อยู่ที่", "พิกัด", "ระยะ", "ใกล้", "ไกล",
        "ใครอยู่", "ไปไหน", "อยู่แถวไหน", "ทิศทาง",
}

-- ตรวจ trigger จากข้อความ → nil ถ้าไม่เกี่ยวเลย (lazy gate)
function PX.gameCtxTrigger(msg)
        if type(msg) ~= "string" or #msg < 2 then return nil end
        local low = msg:lower()
        local inv, pos = false, false
        for _, kw in ipairs(PX.GAME_KW_INV) do
                if low:find(kw, 1, true) then inv = true break end
        end
        for _, kw in ipairs(PX.GAME_KW_POS) do
                if low:find(kw, 1, true) then pos = true break end
        end
        -- พูดถึงชื่อผู้เล่น = ถือว่าสนใจตำแหน่ง/สถานะของคนนั้น (ตาม requirement)
        local mentioned = nil
        pcall(function()
                for _, p in ipairs(Players:GetPlayers()) do
                        local un = tostring(p.Name or "")
                        local dn = tostring(p.DisplayName or "")
                        if #un > 2 and low:find(un:lower(), 1, true) then mentioned = p break end
                        if dn ~= un and #dn > 2 and low:find(dn:lower(), 1, true) then mentioned = p break end
                end
        end)
        if mentioned then pos = true end
        if not inv and not pos then return nil end
        return { inv = inv, pos = pos, mentioned = mentioned }
end

-- สร้างข้อความบริบทเกม (เรียกเฉพาะตอน trigger แล้วเท่านั้น)
function PX.buildGameContext(msg)
        local trig = PX.gameCtxTrigger(msg)
        if not trig then return nil end
        local L = {}
        local myPos = PX.charPos(LP)

        if trig.pos then
                if myPos then
                        L[#L + 1] = string.format("My position: (%d, %d, %d)",
                                math.round(myPos.X), math.round(myPos.Y), math.round(myPos.Z))
                else
                        L[#L + 1] = "My position: unknown (no character right now)"
                end
                local rows, n = {}, 0
                pcall(function()
                        for _, p in ipairs(Players:GetPlayers()) do
                                if p ~= LP then
                                        local pp = PX.charPos(p)
                                        if pp then
                                                n = n + 1
                                                local dist = ""
                                                if myPos then
                                                        local okD, d = pcall(function()
                                                                local dx, dy, dz = pp.X - myPos.X, pp.Y - myPos.Y, pp.Z - myPos.Z
                                                                return math.round(math.sqrt(dx * dx + dy * dy + dz * dz))
                                                        end)
                                                        if okD and d then dist = " " .. d .. " studs away" end
                                                end
                                                local mark = (trig.mentioned == p) and " [mentioned]" or ""
                                                rows[#rows + 1] = string.format("- %s (@%s)%s: (%d, %d, %d)%s",
                                                        tostring(p.DisplayName or p.Name), tostring(p.Name), mark,
                                                        math.round(pp.X), math.round(pp.Y), math.round(pp.Z), dist)
                                        end
                                end
                        end
                end)
                if #rows == 0 then
                        L[#L + 1] = "Other players: none with a character right now"
                else
                        L[#L + 1] = "Players' positions (" .. n .. "):\n" .. table.concat(rows, "\n")
                end
        end

        if trig.inv then
                local names, equipped = {}, nil
                pcall(function()
                        local seen = {}
                        local bp = LP:FindFirstChild("Backpack")
                        if bp then
                                for _, t in ipairs(bp:GetChildren()) do
                                        if t:IsA("Tool") then seen[t.Name] = (seen[t.Name] or 0) + 1 end
                                end
                        end
                        local c = LP.Character
                        if c then
                                for _, t in ipairs(c:GetChildren()) do
                                        if t:IsA("Tool") then equipped = t.Name end
                                end
                        end
                        for nm, ct in pairs(seen) do
                                names[#names + 1] = ct > 1 and (nm .. " x" .. ct) or nm
                        end
                        table.sort(names)
                end)
                if #names == 0 and not equipped then
                        L[#L + 1] = "My inventory: empty (no tools)"
                else
                        L[#L + 1] = "My inventory: " .. (#names > 0 and table.concat(names, ", ") or "empty")
                                .. (equipped and (" | currently holding: " .. equipped) or "")
                end
        end

        if #L == 0 then return nil end
        local txt = table.concat(L, "\n")
        if #txt > 900 then txt = txt:sub(1, 900) end
        return txt
end

-- สตาร์ท: ดึง geo + ข้อมูลบัญชีตัวเองเบื้องหลัง (ไม่บล็อกการเปิด GUI) — premium เท่านั้น
if AUTH.on("research") then
        task.spawn(function()
                pcall(PX.fetchGeo)
                pcall(PX.fetchSelfInfo)
        end)
end

-- ⊢ Cross-session persistent profiles
PX.REL = {
        [0] = "stranger", [20] = "acquaintance", [40] = "familiar",
        [60] = "friend", [80] = "close friend", [95] = "best friend",
}

function PX.getRelLabel(score)
        local best, label = 0, "stranger"
        for threshold, lbl in pairs(PX.REL) do
                if score >= threshold and threshold >= best then
                        best = threshold; label = lbl
                end
        end
        return label
end
EXTCTX.getRelLabel = PX.getRelLabel

function PX.getOrCreateProfile(uid, name)
        if not uid then return nil end
        if not EXTCTX.extended[uid] then
                EXTCTX.extended[uid] = {
                        name = name or "?", firstSeen = os.time(), lastSeen = os.time(),
                        totalChats = 0, topics = {}, mood = "neutral",
                        relationship = 0, notes = "", lastMessage = "",
                }
        end
        if name and name ~= "" then EXTCTX.extended[uid].name = name end
        return EXTCTX.extended[uid]
end

function PX.updateProfile(uid, name, message, reply)
        local p = PX.getOrCreateProfile(uid, name)
        if not p then return end
        p.lastSeen = os.time()
        p.totalChats = (p.totalChats or 0) + 1
        p.lastMessage = (message or ""):sub(1, 80)
        local current = EXTCTX.worldMeta.relationshipMap[uid] or 0
        EXTCTX.worldMeta.relationshipMap[uid] = math.min(100, current + 0.5)
        p.relationship = EXTCTX.worldMeta.relationshipMap[uid]
        if name and name ~= "" then
                if not EXTCTX.worldMeta.knownNames[uid] then EXTCTX.worldMeta.knownNames[uid] = {} end
                local found = false
                for _, n in ipairs(EXTCTX.worldMeta.knownNames[uid]) do
                        if n == name then found = true; break end
                end
                if not found then table.insert(EXTCTX.worldMeta.knownNames[uid], name) end
        end
        EXTCTX.sessionMeta.activePlayers[uid] = name or "?"
        EXTCTX.sessionMeta.chatCount = EXTCTX.sessionMeta.chatCount + 1
end

function PX.buildContinuityContext(uid, name)
        local p = EXTCTX.extended[uid]
        if not p or (p.totalChats or 0) == 0 then return nil end
        local rel = EXTCTX.worldMeta.relationshipMap[uid] or 0
        return "you've talked with " .. (name or p.name) .. " " .. p.totalChats
                .. "x before, relationship: " .. PX.getRelLabel(rel)
end

local function savePersistent()
        if not writefile or not HttpService then return end
        pcall(function()
                writefile(EXTCTX.FILE_EXTENDED, HttpService:JSONEncode(EXTCTX.extended))
                writefile(EXTCTX.FILE_WORLD, HttpService:JSONEncode(EXTCTX.worldMeta))
                writefile(EXTCTX.FILE_SESSION, HttpService:JSONEncode({
                        time = os.time(), gameId = EXTCTX.sessionMeta.gameId,
                        chatCount = EXTCTX.sessionMeta.chatCount,
                        activePlayers = EXTCTX.sessionMeta.activePlayers,
                }))
        end)
        pcall(saveMemory)
end

do
        pcall(function()
                if not isfile or not readfile or not HttpService then return end
                if isfile(EXTCTX.FILE_EXTENDED) then
                        local d = HttpService:JSONDecode(readfile(EXTCTX.FILE_EXTENDED))
                        if type(d) == "table" then EXTCTX.extended = d end
                end
                if isfile(EXTCTX.FILE_WORLD) then
                        local d = HttpService:JSONDecode(readfile(EXTCTX.FILE_WORLD))
                        if type(d) == "table" then
                                if type(d.relationshipMap) == "table" then EXTCTX.worldMeta.relationshipMap = d.relationshipMap end
                                if type(d.knownNames) == "table" then EXTCTX.worldMeta.knownNames = d.knownNames end
                                EXTCTX.worldMeta.sessionCount = tonumber(d.sessionCount) or 0
                        end
                end
                EXTCTX.worldMeta.sessionCount = EXTCTX.worldMeta.sessionCount + 1
        end)
end

-- ═══════════════════════════════════════════════════════════════
-- API HELPERS — Ollama: ตรวจคีย์ผ่าน GET {base}/tags (ไม่มีค่าใช้จ่าย)
--   ★ คืน (ok, info, code) — code แยกสาเหตุจริง:
--     "OK" = ผ่าน · "429" = ลิมิตชั่วคราว (คีย์ถูกต้อง! ลิมิตมีผลเฉพาะคีย์ที่ยืนยันแล้ว)
--     "401"/"403" = คีย์เสีย · "402" = เครดิตหมด · "NET" = เน็ตหลุด/เซิร์ฟเวอร์ไม่ตอบ
--     "404"/"5xx"/อื่น ๆ = ปัญหาฝั่งเซิร์ฟเวอร์ — ไม่ใช่คีย์เสีย
--   (เดิมโทษคีย์ทุกกรณี → key ปกติแต่ขึ้น "ทุกคีย์ใช้ไม่ได้" ตลอด)
-- ═══════════════════════════════════════════════════════════════
local function fastTest(key)
        if not Http or not HttpService then return false, "", "NOHTTP" end
        if type(key) ~= "string" or #key < 10 then
                -- Ollama ในเครื่อง (localhost) ไม่ต้องใช้คีย์ → ตรวจด้วย /tags ตรง ๆ
                if EP.isLocal() then
                        local ok0, res0 = pcall(function()
                                return Http({ Url = EP.tags(), Method = "GET", Headers = {} })
                        end)
                        local r0 = normRes(res0)
                        return (ok0 and r0 ~= nil and r0.status == 200), "local",
                                (ok0 and r0 ~= nil and r0.status == 200) and "OK" or "NET"
                end
                return false, "", "NOKEY"
        end
        local ok, res = pcall(function()
                return Http({
                        Url = EP.tags(), Method = "GET",
                        Headers = { ["Authorization"] = "Bearer " .. key },
                })
        end)
        if not ok or not res then return false, "", "NET" end
        local r = normRes(res)
        if not r then return false, "", "NET" end
        if r.status == 200 then
                local info = ""
                pcall(function()
                        local d = HttpService:JSONDecode(r.body)
                        if d and type(d.models) == "table" then
                                info = #d.models .. " models"
                        elseif d and type(d.data) == "table" then
                                info = #d.data .. " models"
                        end
                end)
                return true, info, "OK"
        end
        return false, "", tostring(r.status)
end

-- ═══════════════════════════════════════════════════════════════
-- LOCAL PROBE — ตรวจเซิร์ฟเวอร์ Ollama ในเครื่อง (โหมด Local AI · ไม่มีคีย์)
--   ลองหลายทาง: /tags (หรือ /models ถ้า /v1) → ไม่ตอบค่อยลอง /version
--   ★ ถ้าโฮสต์เป็น localhost แล้วต่อไม่ได้ → ลอง 127.0.0.1 แทน
--     (บางระบบแก้ localhost เป็น IPv6 ::1 แต่ Ollama รับฟังแค่ IPv4 127.0.0.1
--      เป็นสาเหตุอันดับ 1 ที่ "กด Connect แล้ว error" ในโหมด local)
--   คืน: ok, usedBase  (usedBase = base ที่ต่อได้จริง — ต่างจากเดิม = โดน fallback)
-- ═══════════════════════════════════════════════════════════════
local function localProbe()
        if not Http or not HttpService then return false, nil end
        local function tryUrl(u)
                local okR, resR = pcall(function()
                        return Http({ Url = u, Method = "GET", Headers = {} })
                end)
                local rR = normRes(resR)
                return okR and rR ~= nil and rR.status == 200
        end
        local b = EP.base()
        if tryUrl(EP.tags()) then return true, b end          -- native → /tags · /v1 → /models
        if tryUrl(EP.ver()) then return true, b end           -- เซิร์ฟเวอร์บางตัวไม่มี /tags
        -- localhost ไม่ตอบ → ลอง IPv4 127.0.0.1 (กัน localhost ชี้ไป ::1)
        if b:lower():find("localhost", 1, true) then
                local b2 = b:gsub("[Ll]ocalhost", "127.0.0.1")
                if tryUrl(b2 .. (EP.oai() and "/models" or "/tags")) then return true, b2 end
                if tryUrl(b2 .. "/version") then return true, b2 end
        end
        return false, nil
end

function PX.unstick()
        if S.thinking and (tick() - S.thinkStart) > 10 then
                S.thinking = false
        end
end

-- ═══════════════════════════════════════════════════════════════
-- API ERROR TOAST — ไม่ได้รับคำตอบจาก API → แจ้งเตือน error ขึ้นจอ
--   (กันสแปม: แจ้งห่างกันอย่างน้อย 8 วิ)
-- ═══════════════════════════════════════════════════════════════
local API_ERR_TXT = {
        NET     = "ไม่ได้รับคำตอบ — เชื่อมต่อ API ไม่ได้ (เน็ต/Base URL)",
        DEC     = "ไม่ได้รับคำตอบ — API ตอบกลับมาแต่อ่านคำตอบไม่ได้",
        RATE    = "ติดลิมิตทุกคีย์ (429) — พักสักครู่แล้วลองใหม่",
        MODEL   = "ไม่ได้รับคำตอบ — โมเดลนี้ใช้ไม่ได้ (เลือกโมเดลใหม่)",
        KEY     = "ไม่ได้รับคำตอบ — คีย์ไม่ถูกต้อง (401/403)",
        ERR402  = "ไม่ได้รับคำตอบ — เครดิตหมด (402)",
        NOKEY   = "ไม่ได้รับคำตอบ — ยังไม่ได้ใส่ API key",
        NOHTTP  = "ไม่ได้รับคำตอบ — executor ไม่รองรับ HTTP",
        ALLKEYS = "ไม่ได้รับคำตอบจาก API — ทุกคีย์ล้มเหลว",
        LOCALNET = "ไม่ได้รับคำตอบ — Ollama ในเครื่องไม่ตอบ\nเปิด Ollama ไว้ไหม? โมเดลใหญ่โหลดครั้งแรกช้า (ลองใหม่อีกครั้ง)",
}
function apiErrToast(err)
        local code = tostring(err or "?")
        local t = API_ERR_TXT[code]
                or ("ไม่ได้รับคำตอบจาก API (HTTP " .. code:gsub("^ERR", "") .. ")")
        if S._errToastT and (tick() - S._errToastT) < 8 then return end
        S._errToastT = tick()
        pcall(function() notify("❌ API Error", t, "err") end)
        print("[Sebas AI] ❌ " .. t)
end

-- ═══════════════════════════════════════════════════════════════
-- CHAT SEND
-- ═══════════════════════════════════════════════════════════════
local function sendRaw(text)
        if type(text) ~= "string" or text == "" then return false end
        local ok = false
        if TextChat and TextChat.ChatVersion == Enum.ChatVersion.TextChatService then
                pcall(function()
                        local chs = TextChat:FindFirstChild("TextChannels")
                        if chs then
                                local ch = chs:FindFirstChild("RBXGeneral") or chs:FindFirstChild("General")
                                if ch and ch.SendAsync then ch:SendAsync(text); ok = true end
                        end
                end)
        end
        if not ok and RepStorage then
                pcall(function()
                        local ev = RepStorage:FindFirstChild("DefaultChatSystemChatEvents")
                        if ev then
                                local say = ev:FindFirstChild("SayMessageRequest")
                                if say and say.FireServer then say:FireServer(text, "All"); ok = true end
                        end
                end)
        end
        -- ติด mark ไว้แยก "ข้อความที่ AI ส่งเอง" ออกจาก "ข้อความที่เจ้าของพิมพ์เอง"
        --   (self-chat awareness จะได้ไม่จับข้อความนี้เป็นของคน)
        if ok and S._sentMark then S._sentMark[text] = tick() end
        return ok
end

local function sendChat(text)
        if not text or type(text) ~= "string" then return end
        text = text:match("^%s*(.-)%s*$") or ""
        if text:gsub("%s+", "") == "" then return end
        if #text <= CHAT_LIMIT then sendRaw(text); return end
        -- หั่นยาว: หาจุดจบประโยค (. ! ? ตามด้วยวรรค) ก่อน — ไม่มีค่อยใช้ช่องว่าง
        --   (ท่อนละ ≤194 ตัว + ท้าย " i/N" รวมแล้วไม่เกินลิมิต 200 ของแชท Roblox)
        local chunks, rem = {}, text
        while #rem > 0 do
                if #rem <= CHAT_LIMIT then chunks[#chunks + 1] = rem; break end
                local sentCut, spCut = nil, nil
                for j = CHAT_LIMIT, math.max(CHAT_LIMIT - 60, 1), -1 do
                        local ch = rem:sub(j, j)
                        local nx = rem:sub(j + 1, j + 1)
                        if (ch == "." or ch == "!" or ch == "?") and (nx == " " or nx == "\n" or nx == "") then
                                sentCut = j; break
                        end
                        if spCut == nil and ch == " " then spCut = j - 1 end
                end
                local cut = sentCut or spCut or CHAT_LIMIT
                chunks[#chunks + 1] = rem:sub(1, cut)
                rem = (rem:sub(cut + 1):match("^%s*(.-)%s*$") or "")
        end
        task.spawn(function()
                for i, c in ipairs(chunks) do
                        sendRaw(c .. " " .. i .. "/" .. #chunks)
                        if i < #chunks then task.wait(0.5) end
                end
        end)
end

-- ✂️ ตัดคำตอบให้สั้นลงตามขีดจำกัด (S.maxReply) — ตัดที่จุดจบประโยค ไม่ใช่ตัดกลางคำ
--    ใช้กับคำตอบที่จะส่งลงแชทเท่านั้น (หน้า GUI / ความจำยังเก็บฉบับเต็ม)
--    limit <= 0 = ไม่ตัด · ตัดแล้วต่อท้าย " …" ให้รู้ว่ายังมีต่อ
--    (จุดตัดใช้แต่ ASCII . ! ? \n และช่องว่าง — ไม่มีทางหั่นกลางอักษรไทย/emoji UTF-8)
function PX.capReply(text, limit)
        if type(text) ~= "string" then return text end
        limit = tonumber(limit)
        if limit == nil then limit = tonumber(S.maxReply) or 600 end
        if limit <= 0 or #text <= limit then return text end
        local cut = text:sub(1, limit)
        -- 1) จุดจบประโยคล่าสุด (ASCII เท่านั้น — ปลอดภัยกับ UTF-8 ทุกภาษา)
        local best = 0
        for j = #cut, 1, -1 do
                local ch = cut:sub(j, j)
                if ch == "\n" or ch == "." or ch == "!" or ch == "?" then best = j; break end
        end
        -- 2) เจอแต่อยู่หลังไป (ตัดแล้วสั้นกว่าครึ่งเดิม) → เลือกช่องว่างล่าสุดแทน
        if best < math.floor(limit * 0.5) then
                best = 0
                for j = #cut, 1, -1 do
                        if cut:sub(j, j) == " " then best = j - 1; break end
                end
        end
        -- 3) ยาวติดกันไม่มีวรรคเลย → ตัดตรงตำแหน่งลิมิต
        if best < math.floor(limit * 0.5) then best = limit end
        local out = cut:sub(1, best):gsub("[%s\n]+$", "")
        if out == "" then out = cut end
        return out .. " …"
end

-- ═══════════════════════════════════════════════════════════════
-- PERSONA
-- ═══════════════════════════════════════════════════════════════
function PX.moodLine()
        local t, p = S.traits, {}
        if t.friendly >= 8 then p[#p + 1] = "super friendly" elseif t.friendly <= 2 then p[#p + 1] = "cold" end
        if t.funny >= 8 then p[#p + 1] = "hilarious" elseif t.funny <= 2 then p[#p + 1] = "serious" end
        if t.quiet >= 8 then p[#p + 1] = "very quiet" elseif t.quiet <= 2 then p[#p + 1] = "talkative" end
        if t.smart >= 8 then p[#p + 1] = "genius" elseif t.smart <= 2 then p[#p + 1] = "silly" end
        if t.aggro >= 8 then p[#p + 1] = "aggressive" elseif t.aggro <= 2 then p[#p + 1] = "kind" end
        return #p > 0 and "Mood: " .. table.concat(p, ", ") .. "." or ""
end

function PX.buildPersona()
        local p = { CORE_PERSONA, OPERATING_RULES }
        local m = PX.moodLine()
        if m ~= "" then p[#p + 1] = m end
        -- กฎความยาวคำตอบตามค่า Max Reply Length ที่ตั้งไว้ (หน้า Settings)
        --   สอนโมเดลให้พูดสั้น สอดคล้องกับตัวตัดจริง (PX.capReply) — ค่า 0 = ไม่บังคับ
        local capN = tonumber(S.maxReply) or 600
        if capN > 0 then
                p[#p + 1] = "Response length rule: keep EVERY reply under " .. capN
                        .. " characters (" .. (capN <= 250 and "1-2 short sentences" or "2-4 short sentences")
                        .. "). Never write essays, lists, or long explanations unless explicitly asked for detail."
        end
        if S.userPersona and S.userPersona ~= "" then p[#p + 1] = "Extra: " .. S.userPersona end
        return table.concat(p, "\n")
end

-- ═══════════════════════════════════════════════════════════════
-- ⊢ callAI — Local AI/Ollama/OpenRouter · multi-key sequential + context pipeline
-- ═══════════════════════════════════════════════════════════════
local function callAI(userMsg, uid, name, isObs, skipSave, isToxic)
        PX.unstick()
        if S.thinking then return nil, "BUSY" end
        if tick() < S.nextReq then return nil, "WAIT" end
        if not Http or not HttpService then apiErrToast("NOHTTP") return nil, "NOHTTP" end

        -- 1) รวบรวมคีย์ที่เปิดใช้ — เรียงลำดับ 1→2→3 ตายตัว (เริ่มจากคีย์ปัจจุบัน)
        --    ระบบ: ใช้คีย์แรกจนกว่าจะติดลิมิต (429) แล้วย้ายไปคีย์ถัดไปถาวร
        --          คีย์ถัดไปติดลิมิตก็ย้ายต่อ ๆ ไป แบบนี้ไปเรื่อย ๆ (ครบรอบวนกลับคีย์แรก)
        local actN = math.clamp(tonumber(S.activeKeys) or 1, 1, MAX_KEYS)
        local pool = {}
        local startIdx = math.clamp(tonumber(S.curKey) or 1, 1, actN)
        for off = 0, actN - 1 do
                local i = ((startIdx - 1 + off) % actN) + 1
                local k = S.keys and S.keys[i]
                if type(k) == "string" and #k >= 10 then
                        pool[#pool + 1] = { idx = i, key = k }
                end
        end
        -- 🖥️ Local AI = ปิดระบบคีย์ทั้งหมด: ยิงตรง ๆ ไม่มี Bearer เสมอ
        --   (แม้ช่องคีย์จะมีข้อความค้างจากค่ายคลาวด์ก็ตาม — ไม่ใช้ ไม่ทดสอบ)
        if EP.isLocal() then
                pool = { { idx = 1, key = "" } }
        elseif #pool == 0 then
                apiErrToast("NOKEY")
                return nil, "NOKEY"
        end

        local uidK = uid and tostring(uid) or nil

        -- 2) Context pipeline (ไม่รวม observation — ยกเว้น nearby)
        local finalMsg = userMsg
        if not isObs and type(userMsg) == "string" then
                local ctx = {}
                if EXTCTX.roomOn then
                        local snap = PX.buildRoomSnap(uidK)
                        if snap then ctx[#ctx + 1] = snap end
                end
                if EXTCTX.awarenessOn then
                        if uidK and uidK ~= "DIRECT_CHAT_TAB" then
                                local plr = Players:GetPlayerByUserId(tonumber(uidK) or 0)
                                if plr then
                                        local app = PX.getAppearanceCached(uidK, plr)
                                        if app then ctx[#ctx + 1] = "speaker looks: " .. app end
                                end
                        end
                        local near = PX.buildNearbyContext()
                        if near then ctx[#ctx + 1] = near end
                end
                if EXTCTX.memoryExtOn and uidK and uidK ~= "DIRECT_CHAT_TAB" then
                        local cont = PX.buildContinuityContext(uidK, name)
                        if cont then ctx[#ctx + 1] = cont end
                end
                -- ข่าว → Google News RSS / คำถามทั่วไป → DDG Instant Answer
                if EXTCTX.searchOn then
                        local msgClean = (userMsg:match("^(.-)%[") or userMsg):match("^%s*(.-)%s*$") or userMsg
                        if AUTH.on("research") and PX.needsNews(userMsg) then
                                local langHint = uidK and S.playerLang[uidK]
                                local news = PX.newsSearch(msgClean, langHint)
                                if news then ctx[#ctx + 1] = "news: " .. news end
                        elseif needsSearch(userMsg) then
                                local r = PX.webSearch(msgClean:sub(1, 90))
                                if r then ctx[#ctx + 1] = "web info: " .. r end
                        end
                end
                if #ctx > 0 then
                        local combined = table.concat(ctx, " | ")
                        if #combined > 380 then combined = combined:sub(1, 380) end
                        finalMsg = userMsg .. " [bg: " .. combined
                                .. " — background ONLY, do NOT mention names or reference these]"
                end
        elseif isObs and EXTCTX.awarenessOn and type(userMsg) == "string" then
                local near = PX.buildNearbyContext()
                if near then finalMsg = userMsg .. " [" .. near .. "]" end
        end

        -- 3) ประกอบชุดข้อความ
        local msgs = {}
        if isObs then
                msgs[#msgs + 1] = { role = "system", content = CORE_PERSONA .. "\nObserve what is happening and react casually in exactly 1 short sentence." }
                -- OWNER CHAT — ให้ AI รู้ว่าเจ้าของ (คน) พิมพ์อะไรไปเอง (กันทักซ้ำ)
                local selfTxtObs = PX.buildSelfChat()
                if selfTxtObs then
                        msgs[#msgs + 1] = { role = "system", content = selfTxtObs }
                end
        else
                if isToxic then
                        msgs[#msgs + 1] = { role = "system", content = TOXIC_PERSONA }
                else
                        msgs[#msgs + 1] = { role = "system", content = PX.buildPersona() }
                end
                -- LIVE CONTEXT — ข้อมูลจริง (เวลา/IP-geo/บัญชีตัวเอง/โปรไฟล์คนพูด) แยกเป็น system ข้อความ
                --   ต่างจาก [bg:...] ตรงที่ AI นำไปใช้ตอบได้เลยเมื่อถูกถาม
                local envOk, envTxt = pcall(PX.buildEnvContext, uidK, name, userMsg)
                if envOk and type(envTxt) == "string" and #envTxt > 10 then
                        msgs[#msgs + 1] = { role = "system",
                                content = "LIVE CONTEXT (real data, use when asked/relevant, never invent):\n" .. envTxt }
                end
                -- GAME CONTEXT — inventory ตัวเอง + ตำแหน่งผู้เล่น (LAZY: เก็บสดเฉพาะเมื่อข้อความ
                --   นี้ถามถึง/พูดถึงเท่านั้น — ไม่มี polling ไม่มี cache ตาม requirement ผู้ใช้)
                if EXTCTX.gameCtxOn and type(userMsg) == "string" then
                        local gOk, gTxt = pcall(PX.buildGameContext, userMsg)
                        if gOk and type(gTxt) == "string" and #gTxt > 8 then
                                msgs[#msgs + 1] = { role = "system",
                                        content = "GAME CONTEXT (live in-game data, snapshot at the moment of this question — use it to answer, never invent):\n" .. gTxt }
                        end
                end
                -- OWNER CHAT — ข้อความที่เจ้าของแอค (คน) พิมพ์ไปเองในแชทเกม
                --   ให้ AI เห็นว่าเจ้าของคุยอะไรไปแล้ว → ไม่ทักทาย/พูดซ้ำ
                local selfTxt = PX.buildSelfChat()
                if selfTxt then
                        msgs[#msgs + 1] = { role = "system", content = selfTxt }
                end
                if uidK and S.playerHistory[uidK] then
                        for _, h in ipairs(S.playerHistory[uidK]) do
                                msgs[#msgs + 1] = h
                        end
                end
        end
        msgs[#msgs + 1] = { role = "user", content = finalMsg }

        -- Ollama: stream=false + options.num_predict (แทน max_tokens ของ OpenAI-format)
        --   ถ้า Base URL เป็นแบบ /v1 (OpenAI-compatible) → ใช้ max_tokens แทน
        --   ★ โมเดลคิดก่อนตอบ (gpt-oss/deepseek-r1/qwen3): ช่วง "คิด" กินโควตาโทเคนด้วย!
        --     เดิมให้ 60/250 → คิดไม่ทันก็หมดงบ → content ว่าง = "ไม่ได้รับคำตอบ"
        --     → เพิ่มเป็น 300/800 (เป็นแค่เพดาน — โมเดลปกติจบเองก่อนถึงเพดานเสมอ)
        local reqBody = {
                model = S.currentModel, messages = msgs,
                stream = false,
        }
        if EP.oai() then
                reqBody.max_tokens = isObs and 300 or 800
                reqBody.temperature = 0.85
        else
                reqBody.options = { temperature = 0.85, num_predict = isObs and 300 or 800 }
        end
        local bodyJson = HttpService:JSONEncode(reqBody)

        S.thinking = true
        S.thinkStart = tick()

        -- 🖥️ Local AI — หา base ที่ต่อได้จริงก่อนยิงแชท (localhost ตาย → 127.0.0.1 ให้เอง)
        --   กันเคส: ตอนบูต Ollama ยังไม่เปิด → auto-connect พัง → base ค้างเป็น localhost(::1)
        --   ทุกข้อความหลังจากนั้นพังหมดทั้งที่เปิด Ollama ทีหลังแล้ว
        --   ต่อได้ = จำ 2 นาที · ต่อไม่ได้ = เว้น 60 วิ (กันค้าง — localhost ที่ตายจะถูกปฏิเสธทันที
        --   แต่ IP วงแลนที่ดับจะรอ timeout ของ executor)
        if EP.isLocal() then
                local nowL = tick()
                local okCached = S._lbOK and (nowL - (S._lbOKT or 0) < 120)
                local failFresh = (not S._lbOK) and (nowL - (S._lbFT or 0) < 60)
                if not okCached and not failFresh then
                        local okP, usedBase = localProbe()
                        if okP then
                                S._lbOK, S._lbOKT, S._lbFT = true, nowL, nil
                                if type(usedBase) == "string" and usedBase ~= EP.base() then
                                        S.baseURL = usedBase
                                        pcall(saveSettings)
                                        if UIX and UIX.refreshProviderUI then pcall(UIX.refreshProviderUI) end
                                end
                        else
                                S._lbOK, S._lbFT = false, nowL
                        end
                end
        end

        local reply, data, usedIdx, lastErr = nil, nil, 0, "NET"

        -- 4) ลองทีละคีย์ — pass 1 ข้ามคีย์พัก (429) / pass 2 ลองทั้งหมด
        for pass = 1, 2 do
                for pi = 1, #pool do
                        local ent = pool[pi]
                        local kIdx, kKey = ent.idx, ent.key
                        local dryT = S.keyDry[kIdx]
                        if pass == 1 and dryT and tick() < dryT then
                                -- คีย์กำลังพัก → ข้าม
                        else
                                local ok, res = pcall(function()
                                        local hdrs = { ["Content-Type"] = "application/json" }
                                        if #kKey >= 10 then
                                                hdrs["Authorization"] = "Bearer " .. kKey
                                        end
                                        return Http({
                                                Url = EP.chat(), Method = "POST",
                                                Headers = hdrs,
                                                Body = bodyJson,
                                        })
                                end)

                                if ok and res then
                                        local r = normRes(res)
                                        local st = r and r.status or 0
                                        if st == 200 then
                                                local d2
                                                local decodeOk = pcall(function() d2 = HttpService:JSONDecode(r.body) end)
                                                -- Ollama: คำตอบอยู่ที่ message.content
                                                --   (แบบ /v1 OpenAI-compat: choices[1].message.content)
                                                --   ★ โมเดลคิดก่อนตอบ: ถ้าคิดยาวจนโควตาโทเคนหมดกลางทาง
                                                --     content จะว่างเปล่า แต่ข้อความอยู่ใน message.thinking
                                                --     → ใช้ thinking เป็นคำตอบสำรอง แทนการถือว่า
                                                --       "อ่านคำตอบไม่ได้" (เดิมเจอเคสนี้บ่อยมาก)
                                                local r2 = nil
                                                if decodeOk and type(d2) == "table" then
                                                        if type(d2.message) == "table" then
                                                                r2 = d2.message.content
                                                                if type(r2) ~= "string" or #r2 == 0 then
                                                                        r2 = d2.message.thinking
                                                                end
                                                        elseif d2.choices and d2.choices[1] then
                                                                local cm = d2.choices[1].message
                                                                if type(cm) == "table" then
                                                                        r2 = cm.content
                                                                        if type(r2) ~= "string" or #r2 == 0 then
                                                                                r2 = cm.reasoning   -- OpenRouter reasoning models
                                                                        end
                                                                end
                                                        end
                                                end
                                                if type(r2) == "string" and #r2 > 0 then
                                                        reply, data, usedIdx = r2, d2, kIdx
                                                        S.key = kKey; S.curKey = kIdx; S.lastKeyIdx = kIdx
                                                        S.keyOk[kIdx] = true
                                                        S.keyErr[kIdx] = nil; S.keyDry[kIdx] = nil
                                                end
                                                if not reply then lastErr = "DEC"; S.keyErr[kIdx] = "DEC" end
                                        elseif st == 429 then
                                                -- พักคีย์ตาม Retry-After ที่เซิร์ฟเวอร์แนบมา (ไม่มี = 30 วิ)
                                                local ra = tonumber(r.headers and (r.headers["Retry-After"] or r.headers["retry-after"])) or 30
                                                if ra <= 0 or ra > 120 then ra = 30 end
                                                S.keyDry[kIdx] = tick() + ra
                                                S.keyErr[kIdx] = "429"
                                                lastErr = "RATE"
                                                -- คีย์ที่กำลังใช้อยู่ติดลิมิต → ย้ายไปคีย์ถัดไป
                                                --   ถาวร (1→2→3→...→วนกลับ 1) ตามที่เจ้าของสั่ง
                                                if kIdx == startIdx then
                                                        S.curKey = (startIdx % actN) + 1
                                                end
                                        elseif st == 401 or st == 403 then
                                                S.keyErr[kIdx] = tostring(st)
                                                S.keyOk[kIdx] = false
                                                lastErr = "KEY"
                                        elseif st == 402 then
                                                S.keyErr[kIdx] = "402$"
                                                S.keyOk[kIdx] = false
                                                lastErr = "ERR402"
                                        elseif st == 404 or st == 400 then
                                                S.keyErr[kIdx] = tostring(st)
                                                lastErr = "MODEL"
                                        else
                                                S.keyErr[kIdx] = tostring(st)
                                                lastErr = "ERR" .. tostring(st)
                                        end
                                else
                                        S.keyErr[kIdx] = "NET"
                                        lastErr = "NET"
                                end
                        end
                        if reply then break end
                end
                if reply then break end
        end

        S.thinking = false

        if not reply then
                -- ไม่ได้รับคำตอบจาก API → แจ้งเตือน error ขึ้นจอ (ทุกกรณี)
                if lastErr == "RATE" then
                        S.nextReq = tick() + 15
                        apiErrToast("RATE")
                        return nil, "RATE"
                end
                if lastErr == "MODEL" then apiErrToast("MODEL") return nil, "MODEL" end
                if lastErr == "KEY" then apiErrToast("KEY") return nil, "KEY" end
                -- 🖥️ Local: ไม่ตอบ = เซิร์ฟเวอร์ในเครื่องไม่ตอบ — ข้อความเฉพาะ (ไม่ใช่เรื่องเน็ตคลาวด์)
                --   บอกด้วยว่าโมเดลใหญ่โหลดครั้งแรกช้ามาก (เจอ timeout ของ executor ได้)
                if lastErr == "NET" and EP.isLocal() then
                        apiErrToast("LOCALNET")
                        return nil, "NET"
                end
                apiErrToast(lastErr)
                return nil, "ALLKEYS"
        end

        if usedIdx > 0 and not EP.isLocal() then
                print("[Sebas AI] ✅ using API Key #" .. usedIdx)
        elseif usedIdx > 0 then
                print("[Sebas AI] ✅ Local AI ตอบกลับ (ไม่ใช้คีย์)")
        end

        S.nextReq = tick() + math.max(S.cooldown or 1, 1)
        -- จำเวลาที่คุยสำเร็จล่าสุด — ใช้โดยระบบตรวจคีย์เบื้องหลัง (ทุก 60 วิ)
        --   ถ้าเพิ่งคุยได้เมื่อกี้ = คีย์+เซิร์ฟเวอร์ใช้ได้แน่ ๆ → ข้ามการตรวจ
        --   (ตรวจไปก็เปลืองโควตา rate-limit ของคลาวด์ — เคยเป็นสาเหตุที่ทำให้
        --    คีย์ปกติโดนยิง /tags จนเนียน ๆ แล้วแชทตามไปติด 429 จริงจัง)
        S.lastOKT = tick()

        if data then
                -- usage: Ollama = prompt_eval_count + eval_count / แบบ /v1 = usage.total_tokens
                local tot = 0
                if type(data.usage) == "table" then
                        tot = tonumber(data.usage.total_tokens) or 0
                end
                if tot == 0 then
                        tot = (tonumber(data.prompt_eval_count) or 0) + (tonumber(data.eval_count) or 0)
                end
                if tot > 0 then
                        S.tokens = S.tokens + tot
                        S.totalTokensUsed = S.totalTokensUsed + tot
                end
        end

        if uidK and not isObs and not skipSave then
                addPlayerMem(uidK, "user", userMsg)
                addPlayerMem(uidK, "assistant", reply)
                saveMemory()
        end

        -- อัปเดต cross-session profile (แบบไม่บล็อก)
        if uidK and uidK ~= "DIRECT_CHAT_TAB" and not isObs then
                task.defer(function()
                        pcall(function()
                                PX.updateProfile(uidK, name, userMsg, reply)
                                task.defer(savePersistent)
                        end)
                end)
        end

        if updateHUD then pcall(updateHUD) end
        -- real-time: จุดสถานะคีย์ในหน้า API อัปเดตทันทีหลังคำขอ (429/401/สำเร็จ)
        if UIX and UIX.updateKeyDots then pcall(UIX.updateKeyDots) end
        return reply, nil
end

-- ═══════════════════════════════════════════════════════════════
-- MESSAGE PERFORM + WHITELIST
-- ═══════════════════════════════════════════════════════════════
local function perform(reply, name, uid, skipPrefix)
        if type(reply) ~= "string" then return end
        -- ✂️ ตัดความยาวก่อนเพิ่ม prefix — กันคำตอบยาวถูกหั่นเป็นหลายท่อนในแชท
        --   (ความจำ/ประวัติบันทึกฉบับเต็มไว้แล้วก่อนถึงตรงนี้)
        reply = PX.capReply(reply)
        local msg = reply:gsub("^%s+", ""):gsub("%s+$", "")
        if not msg:match("%S") then return end
        if not skipPrefix and S.prefixName then
                local cn = name or ""
                if uid and S.playerNick[tostring(uid)] then
                        cn = S.playerNick[tostring(uid)]
                end
                if cn ~= "" then msg = "[" .. cn .. "] " .. msg end
        end
        sendChat(msg)
end

local function isWhitelisted(plr)
        if not S.whitelistOn then return true end
        local uid = tostring(plr.UserId)
        local dn = plr.DisplayName:lower()
        local un = plr.Name:lower()
        for _, entry in ipairs(S.whitelist) do
                local e = tostring(entry):lower()
                if e == uid or e == dn or e == un then return true end
        end
        return false
end

-- ═══════════════════════════════════════════════════════════════
-- CHAT HANDLER
-- ═══════════════════════════════════════════════════════════════
local function handleChat(plr, msg)
        if not S.chatOn or not S.connected then return end
        if not plr or plr == LP then return end
        if not msg or type(msg) ~= "string" then return end

        local uid = tostring(plr.UserId)
        if S.blacklist[uid] then return end
        if not isWhitelisted(plr) then return end

        PX.pushRoomMsg(uid, msg)

        if S.range > 0 then
                if not HRP or not HRP.Parent then return end
                local pc = plr.Character
                if not pc then return end
                local ph = pc:FindFirstChild("HumanoidRootPart")
                if not ph then return end
                if (HRP.Position - ph.Position).Magnitude > S.range then return end
        end

        local now = tick()
        if now - S.spamT > 5 then S.globalN = 0; S.spamT = now end
        S.globalN = S.globalN + 1
        if S.globalN > 15 then S.nextReq = now + 5; return end
        if S.playerCD[plr] and (now - S.playerCD[plr]) < 2 then return end
        S.playerCD[plr] = now

        S.playerNames[uid] = plr.DisplayName
        if AUTH.on("research") then
                PX.warmPlayer(uid)   -- ดึงข้อมูลโปรไฟล์เบื้องหลัง (premium) ให้พร้อมตอน AI ตอบ
        end
        if msg:match("[^\x00-\x7F]") then
                S.playerLang[uid] = "non-en"
        elseif not S.playerLang[uid] then
                S.playerLang[uid] = "en"
        end

        local nm = msg:match("[Cc]all me (.+)") or msg:match("เรียกฉันว่า%s*(.+)")
        if nm then
                local nick = (nm:match("^%s*(.-)%s*$") or ""):sub(1, 20)
                if nick ~= "" then
                        S.playerNick[uid] = nick
                        S.playerNames[uid] = nick
                        saveMemory()
                end
        end

        local sn = S.playerNick[uid] or plr.DisplayName
        local isToxic = S.toxicTargets[uid] == true

        task.spawn(function()
                if S.responseDelay > 0 then task.wait(S.responseDelay) end
                if not S.chatOn then return end
                local lang = S.playerLang[uid] == "non-en" and " [Same language]" or " [English]"
                local nick = S.playerNick[uid] and (" [Call them: " .. S.playerNick[uid] .. "]") or ""

                local flowHint = ""
                local hist = S.playerHistory[uid]
                if hist and #hist >= 2 then
                        local lastAI = hist[#hist]
                        if lastAI and lastAI.role == "assistant" then
                                flowHint = " [The player is replying to YOUR last message. Understand what they're responding to. Don't ask the same thing again.]"
                        end
                end

                local reply = callAI(msg .. lang .. nick .. flowHint, uid, sn, false, nil, isToxic)
                if reply then perform(reply, sn, uid) end
        end)
end

-- เชื่อม chat ทั้ง 2 ระบบ + เก็บ room buffer ของทุกข้อความ (รวมคนอื่น)
if TextChat and TextChat.ChatVersion == Enum.ChatVersion.TextChatService then
        pcall(function()
                TextChat.MessageReceived:Connect(function(m)
                        if m and m.TextSource then
                                local plr = Players:GetPlayerByUserId(m.TextSource.UserId)
                                if plr and plr ~= LP then
                                        PX.pushRoomMsg(tostring(plr.UserId), m.Text)
                                        handleChat(plr, m.Text)
                                elseif plr == LP then
                                        -- ข้อความที่พิมพ์เอง (เจ้าของหรือ AI — คัดด้วย _sentMark)
                                        PX.pushSelfMsg(m.Text)
                                end
                        end
                end)
        end)
else
        local function connectPlayerChat(p)
                if not p then return end
                pcall(function()
                        p.Chatted:Connect(function(m)
                                if p ~= LP then
                                        PX.pushRoomMsg(tostring(p.UserId), m)
                                        handleChat(p, m)
                                end
                        end)
                end)
        end
        for _, p in ipairs(Players:GetPlayers()) do connectPlayerChat(p) end
        Players.PlayerAdded:Connect(connectPlayerChat)
end

-- SELF-CHAT — จับข้อความที่แอคตัวเองพิมพ์ (เกมส่วนใหญ่ Chatted ยิงให้ทั้ง 2 ระบบ
--   มี dedupe 2 วิใน pushSelfMsg อยู่แล้ว จับซ้ำไม่เป็นไร — ขอไม่พลาดของคนจริง)
pcall(function()
        LP.Chatted:Connect(function(m)
                PX.pushSelfMsg(m)
        end)
end)

-- ═══════════════════════════════════════════════════════════════
-- OBSERVATION / AUTO-GREET
-- ═══════════════════════════════════════════════════════════════
function PX.getAction(plr)
        if not plr then return "?" end
        local c = plr.Character
        if not c then return "?" end
        local h = c:FindFirstChildOfClass("Humanoid")
        if not h then return "?" end
        local st = h:GetState()
        if st == Enum.HumanoidStateType.Running then return "running"
        elseif st == Enum.HumanoidStateType.Jumping then return "jumping"
        elseif st == Enum.HumanoidStateType.Freefall then return "falling"
        elseif st == Enum.HumanoidStateType.StrafingNoPhysics then return "dancing"
        elseif h.MoveDirection and h.MoveDirection.Magnitude > 0.1 then return "walking"
        else return "standing" end
end

function PX.getNearby()
        local list = {}
        if not HRP or not HRP.Parent then return list end
        for _, p in ipairs(Players:GetPlayers()) do
                if p ~= LP and p.Character then
                        local ph = p.Character:FindFirstChild("HumanoidRootPart")
                        if ph then
                                local d = (HRP.Position - ph.Position).Magnitude
                                if d <= S.range then
                                        list[#list + 1] = { plr = p, dist = d, act = PX.getAction(p) }
                                end
                        end
                end
        end
        table.sort(list, function(a, b) return a.dist < b.dist end)
        return list
end

local function makeGreetPrompt(name)
        for uid, nm in pairs(S.playerNames) do
                if nm == name then
                        local p = EXTCTX.extended[uid]
                        if p and (p.totalChats or 0) >= 2 then
                                return "[You and " .. name .. " have talked " .. p.totalChats
                                        .. " times before. Pick up naturally where you left off. Do NOT say their name. 1-2 short sentences.]"
                        end
                end
        end
        return "[Greet " .. name .. " casually in 1-2 short sentences. Be friendly and warm. Do NOT say their name — just greet them naturally like you would a friend walking up to you.]"
end

local function doObserve()
        PX.unstick()
        if not S.talkOn or not S.connected or S.thinking then return end
        if tick() - S.lastObserve < S.observeInterval then return end

        local nearby = PX.getNearby()
        if #nearby == 0 then return end

        if S.chatOn then
                local continueTarget = nil
                for _, d in ipairs(nearby) do
                        local uid = tostring(d.plr.UserId)
                        if S.blacklist[uid] then continue end
                        if not isWhitelisted(d.plr) then continue end
                        local hist = S.playerHistory[uid]
                        if hist and #hist > 0 then
                                continueTarget = { uid = uid, plr = d.plr, dist = d.dist }
                                break
                        end
                end
                if not continueTarget then return end

                S.lastObserve = tick()
                local uid = continueTarget.uid
                local nm = S.playerNick[uid] or continueTarget.plr.DisplayName
                S.playerNames[uid] = continueTarget.plr.DisplayName

                task.spawn(function()
                        local w = math.min(S.responseDelay, 1.5)
                        if w > 0 then task.wait(w) end
                        if not S.talkOn or not S.chatOn or not S.connected then return end
                        local prompt = "[Continue the conversation with " .. nm .. " naturally. "
                                .. "Look at the history: if you asked something and they answered, do NOT re-ask or rephrase it. "
                                .. "Accept their answer and say something NEW. If they said 'good' or 'fine', just move on. "
                                .. "Do NOT change the subject. Keep it casual and short, like talking to a close friend. "
                                .. "1 short sentence only. Do NOT say ANY player's name.]"
                        local reply = callAI(prompt, uid, nm, false, true, S.toxicTargets[uid] == true)
                        if reply then
                                addPlayerMem(uid, "assistant", reply)
                                saveMemory()
                                perform(reply, nm, uid, true)
                        end
                end)
                return
        end

        local changed = false
        local lines = {}
        for _, d in ipairs(nearby) do
                local uid = tostring(d.plr.UserId)
                if S.blacklist[uid] then continue end
                if not isWhitelisted(d.plr) then continue end
                local nm = S.playerNick[uid] or d.plr.DisplayName
                local prev = S.lastActions[d.plr.Name]
                if not prev or prev ~= d.act then changed = true end
                S.lastActions[d.plr.Name] = d.act
                lines[#lines + 1] = nm .. ": " .. d.act .. " (" .. math.floor(d.dist) .. "m)"
        end
        if #lines == 0 then return end
        if not changed and math.random(100) > 25 then return end
        S.lastObserve = tick()

        local contUid = nil
        for _, d in ipairs(nearby) do
                local uid = tostring(d.plr.UserId)
                if S.blacklist[uid] then continue end
                local hist = S.playerHistory[uid]
                if hist and #hist > 0 then contUid = uid; break end
        end

        local prompt
        if contUid and S.playerHistory[contUid] then
                local hist = S.playerHistory[contUid]
                local nm = S.playerNick[contUid] or S.playerNames[contUid] or "Player"
                local memLines = {}
                local si = math.max(1, #hist - 4)
                for i = si, #hist do
                        local h = hist[i]
                        local who = (h.role == "user") and nm or "You"
                        memLines[#memLines + 1] = who .. ": " .. h.content
                end
                prompt = "[Your past conversation with " .. nm .. ":\n"
                        .. table.concat(memLines, "\n")
                        .. "\n\nContinue this conversation naturally with " .. nm .. ". "
                        .. "If you already asked a question and got an answer, do NOT re-ask it in different words. "
                        .. "1 short sentence only. Do NOT say ANY player's name.]"
        else
                return
        end

        task.spawn(function()
                local w = math.min(S.responseDelay, 1.5)
                if w > 0 then task.wait(w) end
                if not S.talkOn or not S.connected then return end
                local reply = callAI(prompt, nil, nil, false)
                if reply then
                        local m = PX.capReply(reply):gsub("^%s+", ""):gsub("%s+$", "")
                        if m:match("%S") then sendChat(m) end
                end
        end)
end

Players.PlayerRemoving:Connect(function(p)
        if not p then return end
        S.lastActions[p.Name] = nil
        local uid = tostring(p.UserId)
        S.greetedPlayers[uid] = nil
        S.toxicTargets[uid] = nil
end)

-- ═══════════════════════════════════════════════════════════════
-- RANGE RING (heartbeat เฉพาะเมื่อมี ring เท่านั้น)
-- ═══════════════════════════════════════════════════════════════
local RING = { parts = {}, ang = 0 }

function PX.clearRing()
        for _, p in ipairs(RING.parts) do pcall(function() if p and p.Parent then p:Destroy() end end) end
        RING.parts = {}
end

local function makeRing()
        PX.clearRing()
        for _ = 1, 32 do
                local p = Instance.new("Part")
                p.Name = "SebasRing"; p.Size = Vector3.new(.7, .08, .08)
                p.Anchored = true; p.CanCollide = false; p.CastShadow = false
                p.Material = Enum.Material.Neon; p.Color = Color3.fromRGB(0, 190, 255)
                p.Transparency = .35; p.Parent = workspace
                RING.parts[#RING.parts + 1] = p
        end
end

RunService.Heartbeat:Connect(function(dt)
        if #RING.parts == 0 then return end
        RING.ang = (RING.ang + dt * 20) % 360
        if not HRP or not HRP.Parent then return end
        local r = S.range == 0 and 50 or S.range
        local y = HRP.Position.Y - HRP.Size.Y / 2 + .1
        for i, p in ipairs(RING.parts) do
                if not p or not p.Parent then continue end
                local a = math.rad(((i - 1) / #RING.parts) * 360 + RING.ang)
                p.CFrame = CFrame.new(
                        HRP.Position.X + math.cos(a) * r, y,
                        HRP.Position.Z + math.sin(a) * r
                ) * CFrame.fromEulerAnglesYXZ(0, a + math.pi / 2, 0)
        end
end)

LP.CharacterAdded:Connect(function() task.delay(1, makeRing) end)

do -- p03 SHELL (locals หมดอายุตอนจบ part — ลด local budget)

-- ═══════════════════════════════════════════════════════════════
-- SCREENGUI + CLEANUP
-- ═══════════════════════════════════════════════════════════════
pcall(function()
        if CoreGui then
                for _, old in ipairs({ "SebasAI_v7", "SebasAI_v8", "OpenRouterAI_v7", "OpenRouterAI_v6" }) do
                        local o = CoreGui:FindFirstChild(old)
                        if o then o:Destroy() end
                end
        end
end)

sg = Instance.new("ScreenGui")
sg.Name = "SebasAI_v7"; sg.ResetOnSpawn = false
sg.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
-- IgnoreGuiInset = true → พิกัด GUI ตรงกับ Camera.ViewportSize ทั้งระบบ
-- (แก้ tutorial วง/การ์ดเพี้ยน ~58px + กันหน้าต่าง/การ์ดหลุดขอบล่างจอ)
sg.DisplayOrder = 5; sg.IgnoreGuiInset = true

pcall(function() sg.Parent = CoreGui end)
if not sg.Parent then pcall(function() sg.Parent = LP:WaitForChild("PlayerGui") end) end
if not sg.Parent then warn("[Sebas AI] No GUI parent"); return end

BF, RF = Enum.Font.GothamBold, Enum.Font.Gotham -- global: ใช้ข้าม part

-- ═══════════════════════════════════════════════════════════════
-- UI PRIMITIVES (ลงทะเบียนธีมอัตโนมัติ)
-- ═══════════════════════════════════════════════════════════════
function F(par, sz, pos, bg, rad, zi)
        local f = Instance.new("Frame")
        f.Size = sz; f.Position = pos or UDim2.new()
        f.BackgroundColor3 = bg or C.CARD; f.BorderSizePixel = 0
        f.ZIndex = zi or 10; f.Parent = par
        Instance.new("UICorner", f).CornerRadius = UDim.new(0, rad or 10)
        return f
end

-- ลงทะเบียนสีอย่างถูกคีย์ (ใช้เมื่อต้องการ theme-follow แบบระบุคีย์ชัด ๆ)
function L(par, txt, sz, pos, fs, ft, col, ax, zi)
        local l = Instance.new("TextLabel")
        l.Size = sz; l.Position = pos or UDim2.new()
        l.BackgroundTransparency = 1
        l.Text = txt or ""; l.Font = ft or RF; l.TextSize = fs or 12
        l.TextColor3 = col or C.T1
        l.TextXAlignment = ax or Enum.TextXAlignment.Left
        l.TextYAlignment = Enum.TextYAlignment.Center
        l.ZIndex = zi or 10; l.Parent = par
        return l
end

function Lk(par, txt, sz, pos, fs, ft, key, ax, zi)
        local l = L(par, txt, sz, pos, fs, ft, C[key] or C.T1, ax, zi)
        if key then themed(l, "TextColor3", key) end
        return l
end

function Sk(obj, key, thick, trans)
        local s = Instance.new("UIStroke", obj)
        s.Color = C[key] or C.BD; s.Thickness = thick or 1
        s.Transparency = trans or 0
        if key then themed(s, "Color", key) end
        return s
end

-- ═══════════════════════════════════════════════════════════════
-- MAIN WINDOW
-- ═══════════════════════════════════════════════════════════════
local TOP_H   = 52      -- top bar
local BOT_H   = 26      -- bottom drag bar
HDR_H   = 50      -- content header (global: ใช้ข้าม part)
CAR_H   = 86      -- cover flow carousel strip (global: ใช้ข้าม part)

gW, gH = nil, nil -- global: ใช้ข้าม part
local gX, gY
do
        local vp0 = Camera.ViewportSize
        -- ⚠ FIX "ขยาย GUI แล้วเด้งกลับขนาดเล็กเหมือนเดิม": mobile-fit ต้องย่อเฉพาะเมื่อ
        --   ใหญ่กว่าจอจริงเท่านั้น — รอบก่อน cap 330 ไว้ ทำให้ขยายเกิน 330 แล้วถูก
        --   hammer ดึงกลับเป็น 330 ทุก 0.4 วิ + ขนาดที่เซฟก็โดนบีบตอนบูต (ตัด cap นี้ทิ้ง)
        local function fitMax(vp)
                return math.max(vp - 12, 240)   -- ย่อได้ต่ำสุด 240 เมื่อจอจิ๋ว
        end
        -- guard ค่าจาก settings: NaN/ติดลบ/หลุดจอ (จากไฟล์เก่าหรือ viewport เปลี่ยน) → clamp กลับมาใช้ได้เสมอ
        local function safeNum(v, dflt, mn, mx)
                if type(v) ~= "number" or v ~= v then return dflt end
                return math.clamp(v, mn, mx)
        end
        -- ⊢ รีเซ็ตขนาดหน้าต่าง “ครั้งเดียว”: ล้างค่าที่เซฟไว้จากยุค GUI ใหญ่ (460×600)
        --   กับยุค compact (420×420) ให้กลับมาใช้ขนาด default เดิมของ v7 จริง ๆ
        --   (เซฟธงไว้ใน settings — ถ้าผู้ใช้ขยายใหม่หลังจากนี้จะไม่โดนล้างซ้ำ)
        if S.szBackOld ~= true then
                S.guiW, S.guiH = nil, nil
                S.szBackOld = true
        end
        gW = safeNum(S.guiW, math.clamp(vp0.X - 40, 340, 460), 240, 2000)
        gH = safeNum(S.guiH, math.clamp(vp0.Y - 130, 440, 600), 240, 2000)
        -- fit ทุกจอ: กันหน้าต่างใหญ่กว่าจอจริง → บีบลงให้พอดีเสมอ (คุยกับขนาดจอเท่านั้น ไม่ cap ตายตัว)
        gW = math.min(gW, fitMax(vp0.X))
        gH = math.min(gH, fitMax(vp0.Y))
        gX = safeNum(S.guiX, math.floor((vp0.X - gW) / 2), 70 - gW, math.max(70, vp0.X - 70))
        gY = safeNum(S.guiY, math.floor((vp0.Y - gH) / 2), 0, math.max(30, vp0.Y - 30))
        -- ยืด gY ให้อยู่ในจอ (กันข้อมูลเก่าจากจอใหญ่กว่า)
        gY = math.min(gY, math.max(0, vp0.Y - gH - 6))
end

