-- ═══════════════════════════════════════════════════════════════
-- PROVIDER PRESETS — เหลือ 3 ตัวตามคำขอเจ้าของ: เน้น Local AI ของ Ollama
--   ① 🖥️ Local AI (ค่าเริ่มต้น) — Ollama ในเครื่อง/วงแลน ไม่ต้องใช้คีย์
--   ② 🦙 Ollama Cloud          — คลาวด์ของ Ollama (ใช้คีย์จาก ollama.com)
--   ③ 🔀 OpenRouter            — รวมโมเดลคลาวด์ (ส่งราคามา → เรียงถูกสุดก่อน)
--   (ค่ายอื่น ๆ ถูกเอาออกหมดแล้ว — พิมพ์ URL เซิร์ฟเวอร์เองได้ผ่านช่อง Base URL)
-- ═══════════════════════════════════════════════════════════════
PROVIDERS = {
        { id = "ollamalocal", icon = "🖥️", name = "Local AI",     url = "http://localhost:11434/api", keyurl = nil },
        { id = "ollama",      icon = "🦙", name = "Ollama Cloud", url = "https://ollama.com/api",     keyurl = "ollama.com/settings/keys" },
        { id = "openrouter",  icon = "🔀", name = "OpenRouter",   url = "https://openrouter.ai/api/v1", keyurl = "openrouter.ai/settings/keys" },
}

-- ═══════════════════════════════════════════════════════════════
-- ENDPOINTS — ทุก request ประกอบ URL จาก Base URL สด ๆ
--   • Local AI (ค่าเริ่มต้น):  http://localhost:11434/api → /chat /tags /version
--     ไม่ต้องใช้คีย์ + รองรับ IP วงแลน (192.168.x / 10.x / 172.16-31.x)
--   • Ollama Cloud:            https://ollama.com/api → ใช้คีย์ ollama.com/settings/keys
--   • OpenRouter:              https://openrouter.ai/api/v1 (ลงท้าย /v1 → โหมด
--     OpenAI-compatible) → ใช้ /chat/completions + /models อัตโนมัติ
--   • พิมพ์ URL เซิร์ฟเวอร์เองได้ผ่านช่อง Base URL (เช่น LM Studio)
-- ═══════════════════════════════════════════════════════════════
EP = {
        DEFAULT = "http://localhost:11434/api",   -- 🖥️ เน้น Local AI เป็นค่าเริ่มต้น
        base = function()
                local b = type(S.baseURL) == "string" and S.baseURL or ""
                b = b:gsub("%s+", ""):gsub("/+$", "")
                if #b < 8 then return EP.DEFAULT end
                -- เครื่อง Ollama ที่พิมพ์สั้น ไม่มี path (เช่น http://localhost:11434 / http://192.168.1.50:11434)
                --   → เติม /api ให้เอง ให้ endpoint ครบ
                local lb = b:lower()
                local shortHost = lb:match("^https?://[^/]+$") ~= nil
                local homeHost = lb:find("localhost", 1, true) or lb:find("127.0.0.1", 1, true)
                                or lb:find("0.0.0.0", 1, true) or lb:find("ollama.com", 1, true)
                                or lb:match("^https?://192%.168%.") or lb:match("^https?://10%.")
                                or lb:match("^https?://172%.(1[6-9]|2%d|30|31)%.")
                if shortHost and homeHost then
                        b = b .. "/api"
                end
                return b
        end,
        oai = function()          -- โหมด OpenAI-compatible: Base URL ลงท้าย /v1 หรือ /openai
                local b = EP.base():lower()
                return b:sub(-3) == "/v1" or b:sub(-7) == "/openai"
        end,
        chat = function()  return EP.oai() and (EP.base() .. "/chat/completions") or (EP.base() .. "/chat")   end,
        tags = function()  return EP.oai() and (EP.base() .. "/models")          or (EP.base() .. "/tags")    end,
        ver  = function()  return EP.base() .. "/version"                                            end,
        isLocal = function()      -- 🖥️ Local AI (Ollama ในเครื่อง/วงแลนบ้าน) → ไม่ต้องใช้คีย์
                local b = EP.base():lower()
                -- ⚠ ต้องคืน boolean เสมอ (find คืนตัวเลข — เคยถูกเอาไปใส่ .Visible ตรง ๆ แล้วพัง)
                if b:find("localhost", 1, true) or b:find("127.0.0.1", 1, true) or b:find("0.0.0.0", 1, true) then
                        return true
                end
                -- IP วงแลนส่วนตัว (192.168.x.x / 10.x.x.x / 172.16-31.x.x) —
                --   Ollama บนคอมอื่นในบ้านเดียวกันก็ไม่ต้องใช้คีย์
                if b:match("^https?://192%.168%.") or b:match("^https?://10%.")
                                or b:match("^https?://172%.(1[6-9]|2%d|30|31)%.") then
                        return true
                end
                return false
        end,
        provider = function()     -- ตัวเลือกที่ตรงกับ Base URL ปัจจุบัน (nil = URL กำหนดเอง)
                local b = EP.base():lower()
                for _, p in ipairs(PROVIDERS) do
                        if b == p.url:lower() then return p end
                end
                -- 127.0.0.1 = Local AI แบบเดียวกับ localhost (หลัง fallback IPv4 อัตโนมัติ)
                if b == "http://127.0.0.1:11434/api" or b == "http://0.0.0.0:11434/api" then
                        return PROVIDERS[1]
                end
                return nil
        end,
}

-- ═══════════════════════════════════════════════════════════════
-- FILE I/O (settings / keys / memory)
-- ═══════════════════════════════════════════════════════════════
local function saveSettings()
        if not writefile or not HttpService then return end
        pcall(function()
                writefile(SET_FILE, HttpService:JSONEncode({
                        range = S.range, cooldown = S.cooldown, prefixName = S.prefixName,
                        responseDelay = S.responseDelay, traits = S.traits,
                        maxReply = S.maxReply,
                        userPersona = S.userPersona, observeInterval = S.observeInterval,
                        blacklist = S.blacklist, currentModel = S.currentModel,
                        holdDuration = S.holdDuration, whitelistOn = S.whitelistOn,
                        whitelist = S.whitelist, currentTheme = S.currentTheme,
                        soundOn = S.soundOn, sndMaster = S.sndMaster,
                        sndVol = S.sndVol, sndId = S.sndId, sndPresetVer = S.sndPresetVer,
                        guiX = S.guiX, guiY = S.guiY, guiW = S.guiW, guiH = S.guiH,
                        carAnim = S.carAnim, szBackOld = S.szBackOld,
                        baseURL = S.baseURL,
                }))
        end)
end

local function loadSettings()
        if not isfile or not readfile or not HttpService then return end
        if not isfile(SET_FILE) then return end
        pcall(function()
                local content = readfile(SET_FILE)
                if not content or content == "" then return end
                local d = HttpService:JSONDecode(content)
                if type(d) ~= "table" then return end
                for k, v in pairs(d) do
                        if k == "traits" and type(v) == "table" then
                                for tk, tv in pairs(v) do
                                        if S.traits[tk] ~= nil then S.traits[tk] = tonumber(tv) or S.traits[tk] end
                                end
                        elseif k == "blacklist" and type(v) == "table" then S.blacklist = v
                        elseif k == "whitelist" and type(v) == "table" then S.whitelist = v
                        elseif k == "sndVol" and type(v) == "table" then
                                for ck, cv in pairs(v) do S.sndVol[ck] = tonumber(cv) end
                        elseif k == "sndId" and type(v) == "table" then
                                for ck, cv in pairs(v) do
                                        if type(cv) == "string" and #cv > 5 then S.sndId[ck] = cv end
                                end
                        elseif k == "maxReply" then
                                local n = tonumber(v)
                                if n then S.maxReply = math.clamp(math.floor(n), 0, 4000) end
                        elseif k == "currentModel" and type(v) == "string" then S.currentModel = v; MODEL = v
                        elseif k == "baseURL" and type(v) == "string" then S.baseURL = v
                        elseif k == "currentTheme" and type(v) == "string" then S.currentTheme = v
                        elseif k == "carAnim" then S.carAnim = v ~= false
                        elseif k == "szBackOld" then S.szBackOld = true
                        elseif k == "guiX" or k == "guiY" or k == "guiW" or k == "guiH" then
                                if tonumber(v) then S[k] = tonumber(v) end
                        elseif S[k] ~= nil and k ~= "sndVol" and k ~= "sndId" then S[k] = v
                        end
                end
        end)
end
loadSettings()

-- Guard โมเดล: id ที่มี "/" (เช่น meta-llama/... ของ OpenRouter)
--   ใช้ได้เฉพาะค่ายแบบ OpenAI-compatible — ถ้า Base URL เป็น Ollama native
--   ให้รีเซ็ตเป็นค่าเริ่มต้น (id ของ Ollama ไม่มี "/")
--   ⚠ ยกเว้น Local AI (localhost/วงแลน) — เจ้าของพิมพ์ชื่อโมเดลเองได้ บางเซิร์ฟเวอร์
--   (LM Studio/llama.cpp) ใช้ id ที่มี "/" → เก็บไว้ตามที่พิมพ์
if type(S.currentModel) ~= "string" or #S.currentModel < 2
                or (S.currentModel:find("/", 1, true) and not EP.oai() and not EP.isLocal()) then
        S.currentModel = DEFAULT_MODEL; MODEL = DEFAULT_MODEL
end

-- Sound preset v7 — โวลุ่มเริ่มต้น 200% ทุกหมวด (ตามคำขอเจ้าของ):
--   ล้างโวลุ่มที่ผู้ใช้เคยปรับไว้หนึ่งครั้ง + รีเซ็ต master เป็น 100%
--   → ทุกเครื่องได้ยิน 200% ตั้งแต่รันรอบใหม่ (ID เสียงที่เปลี่ยนเองยังอยู่)
if S.sndPresetVer ~= 7 then
        S.sndVol = {}
        S.sndMaster = 1.0
        S.sndPresetVer = 7
end

local function saveKeys()
        if not writefile or not HttpService then return end
        pcall(function()
                writefile(KEY_FILE, HttpService:JSONEncode({
                        keys = S.keys, activeKeys = S.activeKeys,
                }))
        end)
end

local function loadKeys()
        if not isfile or not readfile or not HttpService then return end
        if not isfile(KEY_FILE) then return end
        pcall(function()
                local content = readfile(KEY_FILE)
                if not content or content == "" then return end
                local d = HttpService:JSONDecode(content)
                if type(d) ~= "table" then return end
                if type(d.keys) == "table" then
                        for i = 1, MAX_KEYS do
                                local k = d.keys[i]
                                S.keys[i] = type(k) == "string" and k or ""
                        end
                end
                S.activeKeys = math.clamp(tonumber(d.activeKeys) or 1, 1, MAX_KEYS)
                -- (โหมดหมุนเวียนถูกลบ — ตอนนี้ใช้คีย์ตามลำดับ 1→2→3 ตายตัว)
        end)
end
loadKeys()

-- ═══════════════════════════════════════════════════════════════
-- ⊢ AUTH HELPERS — hash รหัสผ่าน + session file (Google Sheets DB)
--   hash ฝั่ง client (dual polynomial) — ไม่ส่งรหัสแบบตรง ๆ เด็ดขาด
--   (ฝั่งแอดมิน SebasAI_Admin.html ใช้อัลกอริทึมเดียวกันจึงตรงกัน)
-- ═══════════════════════════════════════════════════════════════
function pwHash(s)
        s = "sebas::v1::" .. tostring(s or "")
        local h1, h2 = 5381, 52711
        for i = 1, #s do
                local c = s:byte(i)
                h1 = (h1 * 33 + c) % 2147483647
                h2 = (h2 * 65 + c) % 2147483647
        end
        local a = (h1 * 31 + h2 * 17) % 2147483647
        local b = (h2 * 13 + h1 * 29) % 2147483647
        return string.format("%07x%07x", a, b)
end

function saveSession(u, h, tier)
        if not writefile or not HttpService then return end
        pcall(function()
                writefile(AUTH_FILE, HttpService:JSONEncode({
                        u = u, h = h, tier = tier or "normal", t = os.time() }))
        end)
end

function clearSession()
        if not writefile then return end
        pcall(function() writefile(AUTH_FILE, "") end)
end

function loadSession()
        if not isfile or not readfile or not HttpService then return nil end
        local ok, d = pcall(function()
                if not isfile(AUTH_FILE) then return nil end
                local c = readfile(AUTH_FILE)
                if not c or #c < 5 then return nil end
                return HttpService:JSONDecode(c)
        end)
        if ok and type(d) == "table" and type(d.u) == "string" and type(d.h) == "string" then
                return d
        end
        return nil
end

local function saveMemory()
        if not writefile or not HttpService then return end
        pcall(function()
                writefile(MEM_FILE, HttpService:JSONEncode({
                        playerHistory = S.playerHistory, playerNames = S.playerNames,
                        nicks = S.playerNick, langs = S.playerLang
                }))
        end)
end

local function loadMemory()
        if not isfile or not readfile or not HttpService then return end
        if not isfile(MEM_FILE) then return end
        pcall(function()
                local content = readfile(MEM_FILE)
                if not content or content == "" then return end
                local d = HttpService:JSONDecode(content)
                if type(d) ~= "table" then return end
                if type(d.playerHistory) == "table" then S.playerHistory = d.playerHistory end
                if type(d.playerNames) == "table" then S.playerNames = d.playerNames end
                if type(d.nicks) == "table" then S.playerNick = d.nicks end
                if type(d.langs) == "table" then S.playerLang = d.langs end
        end)
end
loadMemory()

local function addPlayerMem(uid, role, content)
        if not uid or type(uid) ~= "string" then return end
        if not S.playerHistory[uid] then S.playerHistory[uid] = {} end
        table.insert(S.playerHistory[uid], { role = role, content = content })
        while #S.playerHistory[uid] > S.maxPlayerHist * 2 do
                table.remove(S.playerHistory[uid], 1)
        end
end

local function clearPlayerHistory(uid)
        if not uid then return end
        S.playerHistory[uid] = {}
        saveMemory()
end

-- ═══════════════════════════════════════════════════════════════
-- ⊢ SOUND SYSTEM — ระบบเสียงกลาง
--   เปลี่ยน ID/Volume ต่อประเภทได้จากตารางนี้ หรือจากหน้า Sound ใน GUI
--   ป้องกันเสียงซ้อน: debounce 45ms ต่อประเภท + 1 Sound instance ต่อประเภท
--   ⚠ ทุกหมวดใช้ ID ต่างกันหมด (ไม่มีเสียงซ้ำกันแม้แต่คู่เดียว)
--   · drag (Grab) = เสียงสั้น 0.3s ตอน "จับ" เริ่มลาก · place = 0.5s ตอน "วาง" ปล่อย
-- ═══════════════════════════════════════════════════════════════
local SND = {}

local SND_CFG = {
        -- ชุดเสียงที่ผู้ใช้จัดมาให้เอง (ชุดเดิม) — vol เริ่มต้น 200% ทุกหมวด ตามคำขอ
        --   (200% = ขยายจากสัญญาณต้นฉบับ 2 เท่า — บาง asset ที่เสียงแตกในตัวอาจได้ยินเพี้ยน
        --    หากอยากลด → ปรับทีละหมวดได้ 0-200% ในหน้า Sound Mixer ตามเดิม)
        -- pitch คงที่ 1.0 ทั้งหมด = ได้ยินเสียงตรงตามต้นฉบับ ไม่ถูกบิดเสียง
        --   min   9125539780 (Electronic Tinkles Falling 0.5s — ร่วงลง = ย่อ)
        --   popup 9119834422 (Sparkle Tone Burst 6 0.6s — เด้งสว่าง = โผล่)
        --   drag  9120130564 (Switch Tones 17 0.3s — สั้นสุด = จับ)
        --   place 9120136923 (Switch Tones 14 0.5s — เพื่อนร่วมชุด = วาง)
        --   ทั้งชุดมาจากคลัง ProSoundEffects (UI) เดียวกับของเดิม = เข้ากันทั้งระบบ
        click   = { id = "rbxassetid://113397864512278", vol = 2.0, spd = 1.0, label = "Click" },
        hover   = { id = "rbxassetid://408524543",       vol = 2.0, spd = 1.0, label = "Hover" },
        toggle  = { id = "rbxassetid://70452176150315",  vol = 2.0, spd = 1.0, label = "Toggle" },
        tab     = { id = "rbxassetid://137081214744553", vol = 2.0, spd = 1.0, label = "Tab" },
        open    = { id = "rbxassetid://9041056860",      vol = 2.0, spd = 1.0, label = "Open" },
        close   = { id = "rbxassetid://17628141786",     vol = 2.0, spd = 1.0, label = "Close" },
        min     = { id = "rbxassetid://9125539780",      vol = 2.0, spd = 1.0, label = "Minimize" },
        max     = { id = "rbxassetid://104530151078585", vol = 2.0, spd = 1.0, label = "Maximize" },
        theme   = { id = "rbxassetid://9120132783",      vol = 2.0, spd = 1.0, label = "Theme" },
        success = { id = "rbxassetid://6042053626",      vol = 2.0, spd = 1.0, label = "Success" },
        error   = { id = "rbxassetid://876939830",       vol = 2.0, spd = 1.0, label = "Error" },
        notify  = { id = "rbxassetid://9114648992",      vol = 2.0, spd = 1.0, label = "Notify" },
        popup   = { id = "rbxassetid://9119834422",      vol = 2.0, spd = 1.0, label = "Popup" },
        drag    = { id = "rbxassetid://9120130564",      vol = 2.0, spd = 1.0, label = "Grab (จับ)" },
        place   = { id = "rbxassetid://9120136923",      vol = 2.0, spd = 1.0, label = "Place (วาง)" },
        slide   = { id = "rbxassetid://9119834603",      vol = 2.0, spd = 1.0, label = "Slider" },
}

SND.CATS = { "click", "hover", "toggle", "tab", "open", "close", "min", "max",
        "theme", "success", "error", "notify", "popup", "drag", "place", "slide" }

pcall(function()
        if SoundService then SND._parent = SoundService end
end)
SND._pool = SND._pool or {}

function SND.getVol(cat)
        local cfg = SND_CFG[cat]
        if not cfg then return 0 end
        local v = S.sndVol[cat]
        if type(v) ~= "number" then v = cfg.vol end
        return math.clamp(v, 0, 2)   -- 100% = ต้นฉบับ, อนุญาตถึง 200% สำหรับเสียงเบา
end

-- ค่าดิบต่อประเภท (ยังไม่คูณ master) — ใช้กับ slider ในหน้า Sound
function SND.getRawVol(cat)
        local cfg = SND_CFG[cat]
        if not cfg then return 0 end
        local v = S.sndVol[cat]
        if type(v) ~= "number" then v = cfg.vol end
        return math.clamp(v, 0, 2)
end

-- เล่นจริง = raw * master (master 0-100%)
function SND.effVol(cat)
        return math.clamp(SND.getRawVol(cat) * math.clamp(tonumber(S.sndMaster) or 1.0, 0, 1), 0, 2)
end

function SND.setVol(cat, v)
        if not AUTH.on("mixer") then   -- 🔒 premium gate: Sound Mixer
                notify("🔒 Premium", "Sound Mixer เป็นฟีเจอร์ Premium — อัปเกรดที่หน้า Profile", "warn")
                SND.play("error")
                return
        end
        S.sndVol[cat] = math.clamp(tonumber(v) or 0, 0, 2)
        saveSettings()
end

-- อัปเดตค่าโดยไม่เขียนไฟล์ (ใช้ระหว่างลาก slider แล้วค่อย save ตอนปล่อย)
function SND.setVolNoSave(cat, v)
        if not AUTH.on("mixer") then return end   -- 🔒 premium gate
        S.sndVol[cat] = math.clamp(tonumber(v) or 0, 0, 2)
end

function SND.getId(cat)
        local cfg = SND_CFG[cat]
        if not cfg then return "" end
        local id = S.sndId[cat] or cfg.id
        -- ผู้ใช้วางเลข ID เปล่า ๆ ใน Mixer (เช่น 9120132783) → เติม prefix ให้อัตโนมัติ
        if type(id) == "string" and id:match("^%d+$") then id = "rbxassetid://" .. id end
        return id
end

function SND.setId(cat, id)
        if not AUTH.on("mixer") then   -- 🔒 premium gate: เปลี่ยน ID เสียงเอง
                notify("🔒 Premium", "Sound Mixer เป็นฟีเจอร์ Premium — อัปเกรดที่หน้า Profile", "warn")
                SND.play("error")
                return
        end
        if type(id) == "string" and #id > 5 then S.sndId[cat] = id else S.sndId[cat] = nil end
        saveSettings()
        local e = SND._pool and SND._pool[cat]
        if e and e.inst then
                pcall(function() e.inst.SoundId = SND.getId(cat) end)
        end
end

-- เล่นเสียงตามประเภท — กันซ้อนด้วย debounce + reuse instance
function SND.play(cat, spdOverride)
        if not S.soundOn then return end
        local cfg = SND_CFG[cat]
        if not cfg then return end

        local e = SND._pool[cat]
        if not e or not e.inst or not e.inst.Parent then
                local ok, inst = pcall(function()
                        local i2 = Instance.new("Sound")
                        i2.Name = "SebasSND_" .. cat
                        i2.SoundId = SND.getId(cat)
                        i2.Volume = SND.effVol(cat)
                        i2.Archivable = false
                        i2.Parent = SND._parent or game
                        return i2
                end)
                if ok and inst then
                        e = { inst = inst, last = 0 }
                        SND._pool[cat] = e
                else
                        return
                end
        end

        local now = tick()
        if now - e.last < 0.045 then return end   -- กันเสียงซ้อนรัว ๆ
        e.last = now

        pcall(function()
                local wantId = SND.getId(cat)
                if e.inst.SoundId ~= wantId then e.inst.SoundId = wantId end
                e.inst.Volume = SND.effVol(cat)
                e.inst.PlaybackSpeed = spdOverride or cfg.spd or 1
                e.inst:Play()
        end)
end

-- preload เสียงทั้งหมดล่วงหน้า (marketplace asset โหลดแบบ async — กันเงียบช่วงเล่นครั้งแรก)
pcall(function()
        if not (task and task.spawn) then return end
        task.spawn(function()
                pcall(function()
                        local CP = game:GetService("ContentProvider")
                        local list = {}
                        for _, cat in ipairs(SND.CATS) do
                                local sid = SND.getId(cat)
                                if type(sid) == "string" and #sid > 5 then table.insert(list, sid) end
                        end
                        if #list > 0 then CP:PreloadAsync(list) end
                end)
        end)
end)

-- ═══════════════════════════════════════════════════════════════
-- ⊢ ANIMATION SYSTEM — tween กลาง กันแอนิเมชั่นซ้อน/ค้าง
--   ANIM.play(inst, props, {t, style, dir, tag, cb})
--   tween เดิมของ instance เดียวกัน + tag เดียวกันจะถูก Cancel ทันที
-- ═══════════════════════════════════════════════════════════════
local ANIM = { reg = setmetatable({}, { __mode = "k" }) }

function ANIM.kill(inst, tag)
        local t = ANIM.reg[inst]
        if not t then return end
        local tw = t[tag]
        if tw then
                pcall(function() tw:Cancel() end)
                t[tag] = nil
        end
end

function ANIM.killAll(inst)
        local t = ANIM.reg[inst]
        if not t then return end
        for _, tw in pairs(t) do pcall(function() tw:Cancel() end) end
        ANIM.reg[inst] = nil
end

function ANIM.play(inst, props, o)
        o = o or {}
        if not inst or not inst.Parent or not TweenService then return nil end
        local tag = o.tag or "m"
        ANIM.kill(inst, tag)
        local ok, tw = pcall(function()
                return TweenService:Create(inst,
                        TweenInfo.new(o.t or 0.25, o.style or Enum.EasingStyle.Quad, o.dir or Enum.EasingDirection.Out),
                        props)
        end)
        if not ok or not tw then return nil end
        local t = ANIM.reg[inst]
        if not t then t = {}; ANIM.reg[inst] = t end
        t[tag] = tw
        tw.Completed:Connect(function(state)
                if ANIM.reg[inst] and ANIM.reg[inst][tag] == tw then ANIM.reg[inst][tag] = nil end
                -- ยิง cb เฉพาะเมื่อเล่นจบจริง (ไม่ใช่โดน Cancel จาก tween ใหม่แทนที่)
                if state ~= Enum.PlaybackState.Cancelled and o.cb then o.cb() end
        end)
        pcall(function() tw:Play() end)
        return tw
end

-- UIScale helper — สำหรับ pop/spring ที่ไม่ยุบ children
local function addScale(obj, s0)
        local us = obj:FindFirstChild("SebasScale")
        if not us then
                us = Instance.new("UIScale")
                us.Name = "SebasScale"
                us.Parent = obj
        end
        us.Scale = s0 or 1
        return us
end

function ANIM.popIn(obj, o)
        o = o or {}
        if not obj then return end
        local us = addScale(obj, o.from or 0.82)
        ANIM.play(us, { Scale = 1 }, { t = o.t or 0.26, style = Enum.EasingStyle.Back,
                dir = Enum.EasingDirection.Out, tag = "pop", cb = o.cb })
end

function ANIM.popOut(obj, o)
        o = o or {}
        if not obj then return end
        local us = addScale(obj, 1)
        ANIM.play(us, { Scale = o.to or 0.86 }, { t = o.t or 0.16, style = Enum.EasingStyle.Quart,
                dir = Enum.EasingDirection.In, tag = "pop", cb = o.cb })
end

function ANIM.fadeIn(obj, t, cb)
        if not obj then return end
        obj.Visible = true
        ANIM.play(obj, { BackgroundTransparency = obj.BackgroundTransparency }, { t = 0.01, tag = "vis" })
        ANIM.play(obj, { BackgroundTransparency = 0 }, { t = t or 0.22, tag = "fade", cb = cb })
end

function ANIM.fadeOut(obj, t, cb)
        if not obj then return end
        ANIM.play(obj, { BackgroundTransparency = 1 }, { t = t or 0.18, tag = "fade",
                cb = function()
                        if obj and obj.Parent then obj.Visible = false end
                        if cb then cb() end
                end })
end

